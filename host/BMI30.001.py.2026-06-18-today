function buildModes(){let b=byId('modeButtons');for(let i=0;i<=7;i++){let x=document.createElement('button');x.id='mode'+i;x.textContent=String(i);x.title=MODE_LABELS[i]||('Mode '+i);x.onclick=function(){if(i>0)lastRunMode=i;cmd('mode',{idx:i})};b.appendChild(x)}}
function statusMode(){return Number((((lastStatus||{}).mode)||{}).selected||0)}
