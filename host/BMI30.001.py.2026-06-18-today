function resizeCanvas(canvas){let r=canvas.getBoundingClientRect();let d=window.devicePixelRatio||1;let w=Math.max(1,Math.floor(r.width*d));let h=Math.max(1,Math.floor(r.height*d));if(canvas.width!==w||canvas.height!==h){canvas.width=w;canvas.height=h}return {w:w,h:h,d:d}}
function drawGrid(ctx,w,h,plotH,labelH,d){ctx.clearRect(0,0,w,h);ctx.fillStyle=cssVar('--plot-bg','#0c1117');ctx.fillRect(0,0,w,h);ctx.strokeStyle=cssVar('--grid','#263240');ctx.lineWidth=1;ctx.beginPath();for(let i=1;i<8;i++){let x=i*w/8;ctx.moveTo(x,0);ctx.lineTo(x,plotH)}for(let j=1;j<5;j++){let y=j*plotH/5;ctx.moveTo(0,y);ctx.lineTo(w,y)}ctx.stroke();ctx.strokeStyle=cssVar('--midline','#3b4654');ctx.beginPath();ctx.moveTo(0,plotH/2);ctx.lineTo(w,plotH/2);ctx.moveTo(0,plotH+.5*d);ctx.lineTo(w,plotH+.5*d);ctx.stroke()}
