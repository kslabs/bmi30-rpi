      <div class="scope-head"><h2>Lower Channel</h2><div class="legend"><span><i class="sw" style="background:#ff6b6b"></i>1</span><span><i class="sw" style="background:#00ffd5"></i>0</span></div></div>
      <div class="plot-wrap"><canvas id="lowerPlot"></canvas><div class="empty" id="lowerEmpty">waiting for frame</div></div>
    </article>
  </section>
</main>
<button class="theme-tab" type="button" data-theme-open>Theme</button>
