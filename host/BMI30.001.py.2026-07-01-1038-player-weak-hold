    @staticmethod
    def _frame_values(scope: Any, name: str, n: int, step: int) -> np.ndarray:
        arr = getattr(scope, name, None)
        if arr is None:
            return np.zeros(0, dtype=np.uint16)
        vals = np.asarray(arr[:n:step])
        if name.startswith("_xcorr_saved_prod") and bool(getattr(scope, "xcorr_norm_enabled", False)):
            vals = vals.astype(np.float32, copy=False)
            if vals.size <= 0:
                return vals
            hi = float(np.max(vals))
            if not np.isfinite(hi) or hi <= 1e-12:
                return np.zeros(vals.shape, dtype=np.uint16)
            vals = vals * (65535.0 / hi)
            return np.clip(vals, 0.0, 65535.0).astype(np.uint16)
        if np.issubdtype(vals.dtype, np.integer):
            return np.clip(vals, 0, 65535).astype(np.uint16, copy=False)
        vals = vals.astype(np.float32, copy=False)
        vals = np.nan_to_num(vals, nan=0.0, posinf=0.0, neginf=0.0)
        return np.clip(vals, 0.0, 65535.0).astype(np.uint16)

    @staticmethod
    def _frame_norm_stats(scope: Any, name: str, n: int, step: int) -> dict[str, Any] | None:
        if not bool(getattr(scope, "xcorr_norm_enabled", False)):
            return None
        arr = getattr(scope, name, None)
        if arr is None:
            return None
        try:
            vals = np.asarray(arr[:n:step], dtype=np.float64)
            vals = np.nan_to_num(vals, nan=0.0, posinf=0.0, neginf=0.0)
            if vals.size <= 0:
                return None
            lo = float(np.min(vals))
            hi = float(np.max(vals))
            span = hi - lo
            if not np.isfinite(span) or span <= 1e-12:
                scale = 0.0
            else:
                scale = float(65535.0 / span)
            det_min = lo
            det_max = hi
            det_span = span
            screen_per_det = float(65535.0 / det_span) if np.isfinite(det_span) and det_span > 1e-12 else 0.0
            try:
                display_scale = float(os.getenv("BMI30_PROD_SCALE", "") or _product_default_scale())
            except Exception:
                display_scale = _product_default_scale()
            if not np.isfinite(display_scale) or display_scale <= 0.0:
                display_scale = _product_default_scale()
            display_vals = np.clip(vals / display_scale, 0.0, 65535.0)
            display_min = float(np.min(display_vals))
            display_max = float(np.max(display_vals))
            display_span = float(display_max - display_min)
            return {
                "min": lo,
                "max": hi,
                "span": float(span),
                "scale": scale,
                "det_min": float(det_min),
                "det_max": float(det_max),
                "det_span": float(det_span),
                "screen_per_det": screen_per_det,
                "det_unit": "raw-product",
                "display_min": display_min,
                "display_max": display_max,
                "display_span": display_span,
                "display_scale": float(display_scale),
            }
        except Exception:
            return None

    def frame(self, max_points: int = 600) -> dict[str, Any]:
        scope = self.scope
        max_points = max(16, min(4096, int(max_points)))
        try:
            selected_mode = int(scope.num_group.checkedId())
        except Exception:
            selected_mode = 0
        show_product = bool(selected_mode >= 6)
        data_lock = getattr(scope, "data_lock", None)
        try:
            if data_lock is not None:
                data_lock.acquire()
            n = int(getattr(scope, "base_buf_len", 0) or 0)
            if n <= 0:
                return {"ok": True, "available": False, "base_buf_len": 0}
            n = min(n, int(getattr(scope, "max_samples", n) or n))
            step = max(1, int(np.ceil(float(n) / float(max_points))))

            def _arr(name: str) -> list[int]:
                try:
                    vals = self._frame_values(scope, name, n, step)
                    return vals.astype(np.uint16).astype(int).tolist()
                except Exception:
                    return []

            x = list(range(0, n, step))
            return {
                "ok": True,
                "available": True,
                "base_buf_len": n,
                "step": step,
                "x": x,
                "data0_even": _arr("data0_even"),
                "data0_odd": _arr("data0_odd"),
                "prod0": _arr("_xcorr_saved_prod0") if show_product else [],
                "prod_norm0": self._frame_norm_stats(scope, "_xcorr_saved_prod0", n, step) if show_product else None,
                "data1_even": _arr("data1_even"),
                "data1_odd": _arr("data1_odd"),
                "prod1": _arr("_xcorr_saved_prod1") if show_product else [],
                "prod_norm1": self._frame_norm_stats(scope, "_xcorr_saved_prod1", n, step) if show_product else None,
                "last_frame_t": float(getattr(scope, "last_frame_t", 0.0) or 0.0),
            }
        finally:
            try:
                if data_lock is not None:
                    data_lock.release()
            except Exception:
                pass

    def frame_binary(self, max_points: int = 600, channels: str = "both", since: float = 0.0) -> bytes:
        scope = self.scope
        max_points = max(16, min(4096, int(max_points)))
        channels = str(channels or "both").strip().lower()
        want_upper = channels not in {"lower", "l", "1", "adc1", "ch1"}
        want_lower = channels not in {"upper", "u", "0", "adc0", "ch0"}
        try:
            selected_mode = int(scope.num_group.checkedId())
        except Exception:
            selected_mode = 0
        show_product = bool(selected_mode >= 6)
        data_lock = getattr(scope, "data_lock", None)
        arrays: list[tuple[str, bytes]] = []
        try:
            if data_lock is not None:
                data_lock.acquire()
            n = int(getattr(scope, "base_buf_len", 0) or 0)
            frame_ts = float(getattr(scope, "last_frame_t", 0.0) or 0.0)
            if n <= 0:
                header = {"ok": True, "available": False, "base_buf_len": 0}
                return self._pack_frame_binary(header, arrays)
            if frame_ts > 0.0 and float(since or 0.0) >= frame_ts:
                header = {"ok": True, "available": False, "not_modified": True, "last_frame_t": frame_ts}
                return self._pack_frame_binary(header, arrays)
            n = min(n, int(getattr(scope, "max_samples", n) or n))
            step = max(1, int(np.ceil(float(n) / float(max_points))))
            count = int(len(range(0, n, step)))

            def _arr_bytes(name: str) -> bytes:
                try:
                    vals = self._frame_values(scope, name, n, step).astype(np.dtype("<u2"), copy=False)
                    return vals.tobytes(order="C")
                except Exception:
                    return b""

            if want_upper:
                arrays.append(("data0_even", _arr_bytes("data0_even")))
                arrays.append(("data0_odd", _arr_bytes("data0_odd")))
                if show_product:
                    arrays.append(("prod0", _arr_bytes("_xcorr_saved_prod0")))
            if want_lower:
                arrays.append(("data1_even", _arr_bytes("data1_even")))
                arrays.append(("data1_odd", _arr_bytes("data1_odd")))
                if show_product:
                    arrays.append(("prod1", _arr_bytes("_xcorr_saved_prod1")))
            header = {
                "ok": True,
                "available": True,
                "base_buf_len": n,
                "step": step,
                "count": count,
                "arrays": [name for name, payload in arrays if payload],
                "prod_norm0": self._frame_norm_stats(scope, "_xcorr_saved_prod0", n, step) if show_product and want_upper else None,
                "prod_norm1": self._frame_norm_stats(scope, "_xcorr_saved_prod1", n, step) if show_product and want_lower else None,
                "last_frame_t": frame_ts,
            }
            arrays = [(name, payload) for name, payload in arrays if payload]
            return self._pack_frame_binary(header, arrays)
        finally:
            try:
                if data_lock is not None:
                    data_lock.release()
            except Exception:
                pass

    @staticmethod
    def _pack_frame_binary(header: dict[str, Any], arrays: list[tuple[str, bytes]]) -> bytes:
        header_bytes = json.dumps(_json_safe(header), ensure_ascii=False, separators=(",", ":")).encode("utf-8")
        pad = b"\0" if (len(header_bytes) % 2) else b""
        return b"BMF1" + len(header_bytes).to_bytes(4, "little") + header_bytes + pad + b"".join(payload for _name, payload in arrays)


