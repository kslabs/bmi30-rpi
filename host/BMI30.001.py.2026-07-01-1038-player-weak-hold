	          <button id="playerClearWeakBtn" type="button" onpointerdown="playerWeakClearHoldStart(event)" onpointerup="playerWeakClearHoldStop(event)" onpointercancel="playerWeakClearHoldCancel(event)" onpointerleave="playerWeakClearHoldCancel(event)" onclick="playerClearWeakClick(event)" oncontextmenu="return false" title="Short press clears the current or nearest weak Tag mark. Hold for 2 seconds to clear the current continuous weak interval for that channel. Exact ranges stay.">Weak X</button>
	          <button class="player-download-btn" type="button" onclick="playerDownloadRecording()" title="Download the loaded or latest raw recording to this browser computer.">Download</button>
	          <button type="button" onclick="playerChooseLoadFile()" title="Load a .npz raw recording through the system file picker.">Load</button>
	          <input id="playerLoadInput" type="file" accept=".npz,application/octet-stream" onchange="playerLoadPickedFile(this.files&&this.files[0]);this.value='';" hidden>
	          <label class="player-file" title="Import a JSON player export into the browser.">Import<input id="playerImport" type="file" accept="application/json,.json" onchange="playerImportFile(this.files&&this.files[0])"></label>
	        </div>
	      </div>
	    </div>
	    <iframe id="playerDownloadFrame" title="Player recording download" hidden></iframe>
	  </section>
	</main>
