def _normalize_avg_n(value: Any, default: int = 24) -> int:
    try:
        avg_n = int(value)
    except Exception:
        avg_n = int(default)
    if avg_n in AVG_N_VALUES:
        return avg_n
    return int(default) if int(default) in AVG_N_VALUES else 24


def _load_default_avg_n() -> int:
    try:
        with open(CONFIG_JSON, "r", encoding="utf-8") as f:
            payload = json.load(f) or {}
    except Exception:
        payload = {}
    if not isinstance(payload, dict):
        payload = {}
    operation = payload.get("operation")
    operation_avg = operation.get("avg_n") if isinstance(operation, dict) else None
    return _normalize_avg_n(payload.get("avg_n", operation_avg), 24)


def _dc_float(value: Any, default: float, minimum: float = 0.0, maximum: float = DC_SETTLE_MAX_S) -> float:
    try:
        val = float(value)
    except Exception:
        val = float(default)
    try:
        if not np.isfinite(val):
            val = float(default)
    except Exception:
        val = float(default)
    return float(max(float(minimum), min(float(maximum), val)))


def _load_default_dc_config() -> dict[str, Any]:
    try:
        with open(CONFIG_JSON, "r", encoding="utf-8") as f:
            payload = json.load(f) or {}
    except Exception:
        payload = {}
    if not isinstance(payload, dict):
        payload = {}
    source = payload.get("dc_config")
    if not isinstance(source, dict):
        source = {}
    mode = str(source.get("mode", "WORK") or "WORK").strip().upper().replace("-", "_")
    if mode not in DC_MODE_VALUES or mode == "BOOT_FAST":
        mode = "WORK"
    detect_s = _dc_float(source.get("detect_settle_s", source.get("detect_initial_settle_s", 60.0)), 60.0)
    return {
        "mode": mode,
        "work_settle_s": _dc_float(source.get("work_settle_s", 900.0), 900.0),
        "detect_settle_s": detect_s,
        "fast_settle_s": _dc_float(source.get("fast_settle_s", 5.0), 5.0),
        "fast_duration_s": _dc_float(source.get("fast_duration_s", 30.0), 30.0),
    }


def _save_default_dc_config(cfg: dict[str, Any]) -> None:
    try:
        path = CONFIG_JSON
        try:
            with open(path, "r", encoding="utf-8") as f:
                payload = json.load(f) or {}
        except Exception:
            payload = {}
        if not isinstance(payload, dict):
            payload = {}
        mode_value = int(cfg.get("mode_value", 1) or 1)
        if mode_value == 3:
            mode_name = "WORK"
        else:
            mode_name = DC_MODE_NAMES.get(mode_value, "WORK")
        payload["dc_config"] = {
            "mode": mode_name,
            "work_settle_s": _dc_float(cfg.get("work_settle_s", 900.0), 900.0),
            "detect_settle_s": _dc_float(cfg.get("detect_settle_s", 60.0), 60.0),
            "detect_initial_settle_s": _dc_float(cfg.get("detect_settle_s", 60.0), 60.0),
            "detect_final_settle_s": _dc_float(cfg.get("detect_settle_s", 60.0), 60.0),
            "detect_ramp_s": 0.0,
            "fast_settle_s": _dc_float(cfg.get("fast_settle_s", 5.0), 5.0),
            "fast_duration_s": _dc_float(cfg.get("fast_duration_s", 30.0), 30.0),
        }
        payload["dc_config_updated_at"] = int(time.time())
        tmp = path.with_name(f".{path.name}.tmp")
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(payload, f, ensure_ascii=False, sort_keys=True)
            f.write("\n")
        os.replace(tmp, path)
    except Exception as exc:
        print(f"[DC] save default config failed: {exc}", flush=True)


def _dc_wire_seconds(value: Any, default: float) -> float:
    val = _dc_float(value, default)
    try:
        return max(0.001, float(int(round(float(val) * 1000.0))) / 1000.0)
    except Exception:
        return max(0.001, float(default))


def _expected_dc_config(profile: str | None = None, mode: int | None = None, cfg: dict[str, Any] | None = None) -> dict[str, Any]:
    source = dict(cfg or _load_default_dc_config())
    profile_name = str(profile or "").strip().lower()
    if profile_name in {"work", "operation"}:
        mode_value = 1
        active_settle_s = float(source["work_settle_s"])
        fast_settle_s = float(source["fast_settle_s"])
        fast_duration_s = float(source["fast_duration_s"])
    elif profile_name in {"acquisition", "acquire", "predetect", "pre_detect"}:
        mode_value = 2
        active_settle_s = float(source["detect_settle_s"])
        fast_settle_s = float(source["fast_settle_s"])
        fast_duration_s = float(source["fast_duration_s"])
    elif profile_name in {"detection", "detect"}:
        mode_value = 3
        active_settle_s = float(source["fast_settle_s"])
        fast_settle_s = float(source["fast_settle_s"])
        fast_duration_s = float(source["fast_duration_s"])
    elif profile_name in {"startup", "start", "boot_fast"}:
        mode_value = 3
        active_settle_s = float(source["fast_duration_s"])
        fast_settle_s = float(source["fast_settle_s"])
        fast_duration_s = float(source["fast_duration_s"])
    else:
        try:
            mode_value = int(DC_MODE_VALUES.get(str(source.get("mode", "WORK")), 1) if mode is None else mode)
        except Exception:
            mode_value = 1
        if mode_value == 2:
            active_settle_s = float(source["detect_settle_s"])
            profile_name = "acquisition"
        elif mode_value == 3:
            active_settle_s = float(source["fast_duration_s"])
            profile_name = "startup"
        else:
            active_settle_s = float(source["work_settle_s"])
            profile_name = "work"
        fast_settle_s = float(source["fast_settle_s"])
        fast_duration_s = float(source["fast_duration_s"])
        if mode_value == 3:
            fast_settle_s = float(source["fast_settle_s"])
            fast_duration_s = float(source["fast_duration_s"])
    fast_duration_wire_s = float(fast_duration_s)
    if profile_name in {"work", "acquisition", "detection"}:
        fast_duration_wire_s = float(active_settle_s)
    return {
        "profile": profile_name,
        "mode": DC_MODE_NAMES.get(int(mode_value), "WORK"),
        "mode_value": int(mode_value),
        "work_settle_s": _dc_wire_seconds(source.get("work_settle_s", 900.0), 900.0),
        "detect_settle_s": _dc_wire_seconds(source.get("detect_settle_s", 60.0), 60.0),
        "fast_settle_s": _dc_wire_seconds(fast_settle_s, 5.0),
        "fast_duration_s": _dc_wire_seconds(fast_duration_wire_s, 30.0),
        "active_settle_s": _dc_wire_seconds(active_settle_s, 0.0),
        "config_work_settle_s": float(source["work_settle_s"]),
        "config_detect_settle_s": float(source["detect_settle_s"]),
        "config_fast_settle_s": float(source["fast_settle_s"]),
        "config_fast_duration_s": float(source["fast_duration_s"]),
    }


def _dc_config_mismatches(readback: dict[str, Any], expected: dict[str, Any], tolerance_s: float = 0.02) -> list[str]:
    if not isinstance(readback, dict) or not bool(readback.get("available", False)):
        return ["unavailable"]
    mismatches: list[str] = []
    try:
        if int(readback.get("mode_value", -1)) != int(expected.get("mode_value", -2)):
            mismatches.append(f"mode:{readback.get('mode_value')}!={expected.get('mode_value')}")
    except Exception:
        mismatches.append("mode")
    for key in ("work_settle_s", "detect_settle_s", "fast_settle_s", "fast_duration_s", "active_settle_s"):
        try:
            actual = float(readback.get(key, -1.0))
            want = float(expected.get(key, -2.0))
            if abs(actual - want) > float(tolerance_s):
                mismatches.append(f"{key}:{actual:g}!={want:g}")
        except Exception:
            mismatches.append(key)
    return mismatches


