def _product_default_scale() -> float:
    return float(_PRODUCT_FULLSCALE_U16_SCALE)


def _product_display_scale() -> float:
    try:
        scale = float(os.getenv("BMI30_PROD_SCALE", "") or _product_default_scale())
    except Exception:
        scale = _product_default_scale()
    if not np.isfinite(scale) or scale <= 0.0:
        scale = _product_default_scale()
    return float(scale)


