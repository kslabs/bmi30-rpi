function setTooltip(el,text){if(!el)return;text=String(text||'');if(text){if(el.getAttribute('data-tooltip')!==text)el.setAttribute('data-tooltip',text)}else if(el.hasAttribute('data-tooltip')){el.removeAttribute('data-tooltip')}if(el.hasAttribute('title'))el.removeAttribute('title')}
