function setTopPanel(panel){panel=(panel==='controls')?'controls':'status';let root=document.documentElement;root.setAttribute('data-top-panel',panel);root.removeAttribute('data-controls-panel');let statusBtn=byId('mobileStatusTab'),controlsBtn=byId('mobileControlsTab');if(statusBtn)statusBtn.setAttribute('aria-pressed',panel==='status'?'true':'false');if(controlsBtn)controlsBtn.setAttribute('aria-pressed',panel==='controls'?'true':'false');frameRedrawNeeded=true;if(lastFrame)setTimeout(function(){renderFrame(lastFrame,true);frameRedrawNeeded=false},40)}
