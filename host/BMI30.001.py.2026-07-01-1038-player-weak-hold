def _sync_role_from_lcd_code(code: str) -> str:
    code = str(code or "").strip().upper()
    if code.startswith("M"):
        return "master"
    if code.startswith("S"):
        return "slave"
    return ""


def _sync_code_from_payload(sync: dict[str, Any]) -> str:
    for key in ("code", "lcd_code"):
        code = str(sync.get(key) or "").strip().upper()
        if _LCD_SYNC_CODE_RE.fullmatch(code):
            return code

    display_char = str(sync.get("display_char") or "").strip().upper()
    display_value = sync.get("display_value")
    if display_char:
        try:
            code = f"{display_char}{int(display_value):02d}"
        except Exception:
            code = display_char
        if _LCD_SYNC_CODE_RE.fullmatch(code):
            return code
    return ""


def _read_device_state_cache() -> dict[str, Any]:
    try:
        with open(DEVICE_STATE_JSON, "r", encoding="utf-8") as f:
            payload = json.load(f)
    except Exception:
        return {}
    if not isinstance(payload, dict):
        return {}
    try:
        ts = float(payload.get("updated_at", payload.get("cache_written_at", 0.0)) or 0.0)
    except Exception:
        ts = 0.0
    if ts <= 0.0 or (time.time() - ts) > DEVICE_STATE_MAX_AGE_S:
        return {}
    return payload


def _sync_status_snapshot() -> dict[str, Any]:
    cache = _read_device_state_cache()
    sync = cache.get("sync") if isinstance(cache.get("sync"), dict) else {}
    events = cache.get("events") if isinstance(cache.get("events"), dict) else {}
    if not sync and isinstance(events.get("sync_state"), dict):
        sync = events["sync_state"]
    if not isinstance(sync, dict) or not sync:
        return {"value": "---", "code": "", "source": "event-cache", "device_responded": False}

    value = str(sync.get("role") or "").strip().lower()
    code = _sync_code_from_payload(sync)
    role_from_code = _sync_role_from_lcd_code(code)
    if role_from_code:
        value = role_from_code
    if not value or value == "---":
        try:
            value = {0: "master", 1: "slave", 2: "off"}.get(int(sync.get("raw_mode")), "---")
        except Exception:
            value = "---"
    return {"value": value or "---", "code": code, "source": "event-cache", "device_responded": True}


def _set_scope_avg_n(scope: Any, avg_n: int) -> int:
    avg_n = _normalize_avg_n(avg_n, 24)
    try:
        scope.avg_n = avg_n
    except Exception:
        pass
    box = getattr(scope, "avg_box", None)
    if box is not None:
        try:
            box.blockSignals(True)
        except Exception:
            pass
        try:
            if hasattr(box, "findText") and box.findText(str(avg_n)) < 0:
                box.addItem(str(avg_n))
            box.setCurrentText(str(avg_n))
        except Exception:
            pass
        try:
            box.blockSignals(False)
        except Exception:
            pass
    return avg_n


def _apply_default_avg_n(scope: Any) -> int:
    return _set_scope_avg_n(scope, _load_default_avg_n())


def _apply_default_detector_settings(scope: Any) -> dict[str, Any] | None:
    settings = _load_default_detector_settings()
    if not settings or not hasattr(scope, "_set_detector_channel_settings"):
        return None
    try:
        return scope._set_detector_channel_settings(settings, persist=False)
    except TypeError:
        return scope._set_detector_channel_settings(settings)
    except Exception:
        traceback.print_exc()
        return None


def _install_detector_flash_hooks(scope: Any) -> None:
