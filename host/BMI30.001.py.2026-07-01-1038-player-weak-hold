def _apply_default_dc_config(scope: Any, mode: int | None = None, reason: str = "", profile: str | None = None) -> bool:
    stream = getattr(scope, "stream", None)
    if stream is None or not hasattr(stream, "set_dc_config_seconds"):
        return False
    expected = _expected_dc_config(profile=profile, mode=mode)
    try:
        stream.set_dc_config_seconds(
            mode=int(expected["mode_value"]),
            work_settle_s=float(expected["work_settle_s"]),
            detect_settle_s=float(expected["detect_settle_s"]),
            fast_settle_s=float(expected["fast_settle_s"]),
            fast_duration_s=float(expected["fast_duration_s"]),
        )
        print(
            f"[DC] default config applied mode={expected['mode']} "
            f"W={float(expected['config_work_settle_s']):g}s D={float(expected['config_detect_settle_s']):g}s "
            f"F={float(expected['config_fast_settle_s']):g}s active={float(expected['active_settle_s']):g}s "
            f"wire_active={float(expected['fast_duration_s']):g}s profile={expected['profile']} reason={reason}",
            flush=True,
        )
        try:
            profile_s = str(expected["profile"])
            scope._host_dc_profile = profile_s
            if profile_s not in {"startup", "start", "boot_fast"}:
                scope._host_dc_desired_profile = profile_s
            scope._host_dc_profile_t = time.time()
        except Exception:
            pass
        return True
    except Exception as exc:
        print(f"[DC] default config apply failed reason={reason}: {exc}", flush=True)
        return False


def _dc_startup_restore_delay_s() -> float:
    cfg = _load_default_dc_config()
    try:
        start_s = float(cfg.get("fast_duration_s", 0.0) or 0.0)
    except Exception:
        start_s = 0.0
    try:
        fastest_window = float(os.getenv("BMI30_DC_STARTUP_FASTEST_WINDOW_S", "3.0"))
    except Exception:
        fastest_window = 3.0
    try:
        max_window = float(os.getenv("BMI30_DC_STARTUP_MAX_WINDOW_S", "30.0"))
    except Exception:
        max_window = 30.0
    if start_s <= 0.0:
        return max(0.2, min(max_window, fastest_window))
    return max(0.2, min(max_window, start_s))


