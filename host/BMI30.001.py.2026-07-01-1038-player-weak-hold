    try:
        scope._web_det_flash_t0 = float(getattr(scope, "_web_det_flash_t0", 0.0) or 0.0)
        scope._web_det_flash_t1 = float(getattr(scope, "_web_det_flash_t1", 0.0) or 0.0)
        scope._web_det_flash_seq0 = int(getattr(scope, "_web_det_flash_seq0", 0) or 0)
        scope._web_det_flash_seq1 = int(getattr(scope, "_web_det_flash_seq1", 0) or 0)
        scope._web_det_flash_active0 = bool(getattr(scope, "_web_det_flash_active0", False))
        scope._web_det_flash_active1 = bool(getattr(scope, "_web_det_flash_active1", False))

        def _fired_arg(args: tuple[Any, ...], kwargs: dict[str, Any], index: int, name: str) -> bool:
            if name in kwargs:
                return bool(kwargs.get(name))
            if len(args) > index:
                return bool(args[index])
            return False

        def _mark(fired0: bool, fired1: bool) -> None:
            now = time.time()
            if fired0:
                if not bool(getattr(scope, "_web_det_flash_active0", False)):
                    scope._web_det_flash_t0 = now
                    scope._web_det_flash_seq0 = int(getattr(scope, "_web_det_flash_seq0", 0) or 0) + 1
                scope._web_det_flash_active0 = True
            if fired1:
                if not bool(getattr(scope, "_web_det_flash_active1", False)):
                    scope._web_det_flash_t1 = now
                    scope._web_det_flash_seq1 = int(getattr(scope, "_web_det_flash_seq1", 0) or 0) + 1
                scope._web_det_flash_active1 = True

        orig_fire_beep = getattr(scope, "_fire_beep", None)
        if callable(orig_fire_beep):
            def _fire_beep_wrapped(*args: Any, **kwargs: Any) -> Any:
                _mark(_fired_arg(args, kwargs, 0, "fired0"), _fired_arg(args, kwargs, 1, "fired1"))
                return orig_fire_beep(*args, **kwargs)

            scope._fire_beep = _fire_beep_wrapped

        orig_hold_start = getattr(scope, "_beep_hold_start", None)
        if callable(orig_hold_start):
            def _beep_hold_start_wrapped(*args: Any, **kwargs: Any) -> Any:
                _mark(_fired_arg(args, kwargs, 0, "fired0"), _fired_arg(args, kwargs, 1, "fired1"))
                return orig_hold_start(*args, **kwargs)

            scope._beep_hold_start = _beep_hold_start_wrapped

        scope._web_det_flash_hooks = True
    except Exception:
        traceback.print_exc()


def _load_engine_module(path: Path):
    path = path.resolve()
    if not path.exists():
        raise FileNotFoundError(f"BMI30 engine source not found: {path}")
    if str(path.parent) not in sys.path:
        sys.path.insert(0, str(path.parent))
    loader = SourceFileLoader("bmi30_engine_current", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise RuntimeError(f"Cannot load BMI30 engine source: {path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[loader.name] = module
    loader.exec_module(module)
    return module


def _json_safe(value: Any) -> Any:
    if isinstance(value, (np.integer,)):
        return int(value)
    if isinstance(value, (np.floating,)):
        return float(value)
    if isinstance(value, (np.bool_,)):
        return bool(value)
    if isinstance(value, dict):
        return {str(k): _json_safe(v) for k, v in value.items()}
    if isinstance(value, (list, tuple)):
        return [_json_safe(v) for v in value]
    return value


def _text_from_label(label: Any) -> str:
    try:
        return str(label.text())
    except Exception:
        return ""


def _int_env(name: str, default: int) -> int:
    try:
        return int(os.getenv(name, str(default)))
    except Exception:
        return int(default)


def _api_bool(value: Any, default: bool = False) -> bool:
    if value is None:
        return bool(default)
    if isinstance(value, bool):
        return bool(value)
    if isinstance(value, (int, float)):
        return bool(value)
    try:
        text = str(value).strip().lower()
    except Exception:
        return bool(default)
    if text in {"1", "true", "yes", "on", "y", "t"}:
        return True
    if text in {"0", "false", "no", "off", "n", "f"}:
        return False
    return bool(default)


def _dc_seconds_from_ms(raw: dict[str, Any], key: str, default: float = 0.0) -> float:
    try:
        return max(0.0, float(int(raw.get(key, int(default * 1000.0)) or 0)) / 1000.0)
    except Exception:
        return float(default)


def _dc_config_from_device(raw: Any) -> dict[str, Any]:
    if not isinstance(raw, dict):
        return {"available": False, "source": "device", "raw": raw}
    if "work_settle_ms" not in raw or "detect_settle_ms" not in raw:
        return {"available": False, "source": "device", "raw": raw}
    try:
        mode_value = int(raw.get("mode", 1) or 1)
    except Exception:
        mode_value = 1
    detect_s = _dc_seconds_from_ms(raw, "detect_settle_ms", 60.0)
    return {
        "available": True,
        "source": "device",
        "version": int(raw.get("version", 0) or 0),
        "mode": DC_MODE_NAMES.get(mode_value, "WORK"),
        "mode_value": mode_value,
        "flags": int(raw.get("flags", 0) or 0),
        "work_settle_s": _dc_seconds_from_ms(raw, "work_settle_ms", 900.0),
        "detect_settle_s": detect_s,
        "detect_initial_settle_s": detect_s,
        "detect_final_settle_s": detect_s,
        "detect_ramp_s": 0.0,
        "fast_settle_s": _dc_seconds_from_ms(raw, "fast_settle_ms", 5.0),
        "fast_duration_s": _dc_seconds_from_ms(raw, "fast_duration_ms", 30.0),
        "active_settle_s": _dc_seconds_from_ms(raw, "active_settle_ms", 0.0),
        "mode_enter_ms": int(raw.get("mode_enter_ms", 0) or 0),
        "fast_until_ms": int(raw.get("fast_until_ms", 0) or 0),
        "adapt_updates": int(raw.get("adapt_updates", 0) or 0),
        "dirty": bool(raw.get("dirty", False)),
        "raw": raw,
    }


def _dc_config_for_api(readback: dict[str, Any]) -> dict[str, Any]:
    cfg = _load_default_dc_config()
    result = dict(readback or {})
    for key in ("work_settle_s", "detect_settle_s", "fast_settle_s", "fast_duration_s"):
        if key in result:
            result[f"device_{key}"] = result.get(key)
    result["work_settle_s"] = float(cfg["work_settle_s"])
    result["detect_settle_s"] = float(cfg["detect_settle_s"])
    result["detect_initial_settle_s"] = float(cfg["detect_settle_s"])
    result["detect_final_settle_s"] = float(cfg["detect_settle_s"])
    result["fast_settle_s"] = float(cfg["fast_settle_s"])
    result["fast_duration_s"] = float(cfg["fast_duration_s"])
    result["configured"] = {
        "work_settle_s": float(cfg["work_settle_s"]),
        "detect_settle_s": float(cfg["detect_settle_s"]),
        "fast_settle_s": float(cfg["fast_settle_s"]),
        "fast_duration_s": float(cfg["fast_duration_s"]),
    }
    result["timing_source"] = "config"
    if str(result.get("source", "") or "") == "device":
        result["source"] = "device+config"
    return result


def _working_window_snapshot(scope: Any, base_len: int, selected_mode: int) -> dict[str, Any]:
    default_start = _int_env("BMI30_WORK_WINDOW_START", _int_env("BMI30_ROI_START", 280))
    default_len = _int_env("BMI30_WORK_WINDOW_LEN", _int_env("BMI30_ROI_LEN", 200))
    length = max(1, int(default_len))
    start = max(0, int(default_start))
    try:
        candidate = int(getattr(scope, "working_window_start"))
        if candidate >= 0:
            start = candidate
    except Exception:
        pass
    if base_len > 0:
        length = min(length, base_len)
        start = min(start, max(0, base_len - length))
    end = start + length
    return {
        "enabled": bool(int(selected_mode) in (1, 2, 3) and base_len > length),
        "start": start,
        "end": end,
        "length": length,
    }


class ScopeApi:
    def __init__(self, scope: Any, qtcore: Any):
        self.scope = scope
        self.qtcore = qtcore
        self.last_run_mode = 3
        self._restore_tim2_after_stop = False
        self._restore_tim2_valid = False
        try:
            selected = int(scope.num_group.checkedId())
            if 1 <= selected <= 7:
                self.last_run_mode = selected
        except Exception:
            pass
        self.commands: "queue.Queue[dict[str, Any]]" = queue.Queue()
        self._timer = qtcore.QTimer()
        self._timer.setInterval(40)
        self._timer.timeout.connect(self._drain_commands)
        self._timer.start()

    def submit(self, action: str, params: dict[str, Any] | None = None, timeout: float = 8.0) -> dict[str, Any]:
        item: dict[str, Any] = {
            "action": str(action),
            "params": dict(params or {}),
            "event": threading.Event(),
            "result": None,
        }
        self.commands.put(item)
        if not item["event"].wait(max(0.1, float(timeout))):
            return {"ok": False, "error": "command timeout", "action": action}
        result = item.get("result")
        if isinstance(result, dict):
            return result
        return {"ok": False, "error": "empty command result", "action": action}

    def _drain_commands(self) -> None:
        while True:
            try:
                item = self.commands.get_nowait()
            except queue.Empty:
                return
            try:
                item["result"] = self._execute(str(item.get("action") or ""), dict(item.get("params") or {}))
            except Exception as exc:
                item["result"] = {"ok": False, "error": str(exc), "trace": traceback.format_exc(limit=5)}
            finally:
                try:
                    item["event"].set()
                except Exception:
                    pass

    def _set_tim2_desired(self, enabled: bool) -> None:
        scope = self.scope
        enabled = bool(enabled)
        try:
            scope.tim2_enabled = enabled
        except Exception:
            pass
        try:
            btn = getattr(scope, "btn_tim2", None)
            if btn is not None:
                try:
                    old_blocked = btn.blockSignals(True)
                except Exception:
                    old_blocked = None
                try:
                    btn.setChecked(enabled)
                finally:
                    try:
                        if old_blocked is not None:
                            btn.blockSignals(old_blocked)
                    except Exception:
                        pass
        except Exception:
            pass
        try:
            scope._update_tim2_btn_style()
        except Exception:
            pass

    def _disable_tim2_for_stop(self) -> None:
        scope = self.scope
        try:
            self._restore_tim2_after_stop = bool(getattr(scope, "tim2_enabled", False))
            self._restore_tim2_valid = True
        except Exception:
            self._restore_tim2_after_stop = False
            self._restore_tim2_valid = True
        self._set_tim2_desired(False)
        try:
            scope.tim2_pending = False
            scope.tim2_applied = False
        except Exception:
            pass
        stream = getattr(scope, "stream", None)
        if stream is not None:
            try:
                scope._send_tim2_enable(False)
            except Exception:
                pass
            try:
                scope._send_tx_enable(False)
            except Exception:
                pass
        try:
            scope._update_tim2_btn_style()
        except Exception:
            pass

    def _restore_tim2_for_start(self) -> None:
        if not self._restore_tim2_valid:
            return
        self._set_tim2_desired(bool(self._restore_tim2_after_stop))
        self._restore_tim2_valid = False

    def _read_dc_config(self) -> dict[str, Any]:
        stream = getattr(self.scope, "stream", None)
        if stream is None:
            raise RuntimeError("stream is not connected")
        if not hasattr(stream, "get_dc_config"):
            raise RuntimeError("stream does not support get_dc_config")
        cfg = _dc_config_from_device(stream.get_dc_config())
        if not bool(cfg.get("available", False)):
            return {"ok": False, "error": "device returned unsupported DC config", "dc_config": cfg}
        return {"ok": True, "dc_config": _dc_config_for_api(cfg)}

    def _stop_stream_keep_mode(self) -> int:
        scope = self.scope
        try:
            selected = int(scope.num_group.checkedId())
        except Exception:
            selected = int(self.last_run_mode or 3)
        if 1 <= selected <= 7:
            self.last_run_mode = selected
        self._disable_tim2_for_stop()
        if hasattr(scope, "_reset_stream_runtime_state"):
            scope._reset_stream_runtime_state(reason="api_stop_keep_mode")
            try:
                scope._stream_user_stopped = True
            except Exception:
                pass
        else:
            try:
                scope._send_stop_stream()
            except Exception:
                pass
            try:
                stream = getattr(scope, "stream", None)
                if stream is not None:
                    stream.close()
            except Exception:
                pass
            try:
                scope.stream = None
            except Exception:
                pass
        try:
            scope._set_status(f"Stream stopped, mode {selected} preserved", hold_sec=2.0)
        except Exception:
            pass
        return selected

    def _restore_dc_after_startup(self, reason: str = "") -> None:
        try:
            selected = int(self.scope.num_group.checkedId())
        except Exception:
            selected = 0
        try:
            restore_profile = str(getattr(self.scope, "_host_dc_startup_restore_profile", "") or "").strip().lower()
        except Exception:
            restore_profile = ""
        if restore_profile not in {"work", "acquisition", "detection"}:
            profile = _dc_steady_profile_for_mode(selected)
        else:
            profile = restore_profile
        if profile:
            _apply_default_dc_config(self.scope, reason=f"{reason}:restore_{profile}", profile=profile)
        try:
            self.scope._host_dc_startup_restore_profile = ""
        except Exception:
            pass

    def _start_dc_startup_compensation(self, selected: int, reason: str = "") -> bool:
        try:
            selected = int(selected)
        except Exception:
            selected = 0
        if selected < 5:
            return False
        delay_s = _dc_startup_restore_delay_s()
        try:
            restore_profile = str(getattr(self.scope, "_host_dc_desired_profile", "") or "").strip().lower()
        except Exception:
            restore_profile = ""
        if restore_profile not in {"work", "acquisition", "detection"}:
            restore_profile = _dc_steady_profile_for_mode(selected)
        try:
            self.scope._host_dc_startup_restore_profile = restore_profile
        except Exception:
            pass
        try:
            self.scope._host_dc_startup_until = time.time() + max(0.2, delay_s)
        except Exception:
            pass
        ok = _apply_default_dc_config(self.scope, reason=f"{reason}:startup", profile="startup")
        if _dc_steady_profile_for_mode(selected):
            try:
                _call_qt_later_s(max(0.2, delay_s), lambda: self._restore_dc_after_startup(reason))
            except Exception:
                pass
        return bool(ok)

    def _apply_mode5_startup_dc(self, reason: str = "") -> None:
        try:
            if int(self.scope.num_group.checkedId()) != 5:
                return
        except Exception:
            return
        self._start_dc_startup_compensation(5, reason)

    def _execute(self, action: str, params: dict[str, Any]) -> dict[str, Any]:
        scope = self.scope
        action = action.strip().lower()
        if action in {"mode", "set_mode"}:
            idx = int(params.get("idx", params.get("mode", 0)))
            if idx < 0 or idx > 7:
                raise ValueError("mode must be 0..7")
            if idx > 0:
                self.last_run_mode = idx
            btn = scope.num_group.button(idx)
            if btn is not None:
                btn.setChecked(True)
            scope._num_clicked(idx)
            mode6_via5_pending = bool(idx >= 6 and getattr(scope, "_mode6_via5_pending", False))
            try:
                if not mode6_via5_pending:
                    scope._on_num_clicked_extra(idx)
            except Exception:
                pass
            if idx == 5:
                self._apply_mode5_startup_dc(f"api_mode_{idx}")
            elif idx > 0 and not mode6_via5_pending:
                _apply_default_dc_config(scope, reason=f"api_mode_{idx}:work", profile="work")
            return {"ok": True, "mode": idx, "pending": mode6_via5_pending, "via": 5 if mode6_via5_pending else None}
        if action in {"start", "connect"}:
            idx = int(params.get("idx", params.get("mode", self.last_run_mode)))
            if idx < 1 or idx > 7:
                idx = self.last_run_mode if 1 <= int(self.last_run_mode) <= 7 else 3
            self.last_run_mode = idx
            self._restore_tim2_for_start()
            btn = scope.num_group.button(idx)
            if btn is not None:
                btn.setChecked(True)
            scope._num_clicked(idx)
            mode6_via5_pending = bool(idx >= 6 and getattr(scope, "_mode6_via5_pending", False))
            try:
                if not mode6_via5_pending:
                    scope._on_num_clicked_extra(idx)
            except Exception:
                pass
            if idx == 5:
                self._apply_mode5_startup_dc(f"api_start_{idx}")
            elif idx > 0 and not mode6_via5_pending:
                _apply_default_dc_config(scope, reason=f"api_start_{idx}:work", profile="work")
            return {"ok": True, "action": action, "mode": idx, "pending": mode6_via5_pending, "via": 5 if mode6_via5_pending else None}
        if action in {"stop", "disconnect"}:
            selected = self._stop_stream_keep_mode()
            return {"ok": True, "mode": selected, "stopped": True}
        if action in {"frequency", "freq", "set_freq"}:
            freq = int(params.get("hz", params.get("freq", 200)))
            scope._on_freq_change(f"{freq} Hz")
            try:
                scope.freq_box.setCurrentText(f"{freq} Hz")
            except Exception:
                pass
            return {"ok": True, "freq_hz": freq}
        if action in {"avg", "avg_n", "set_avg"}:
            avg_n = _set_scope_avg_n(scope, params.get("avg_n", params.get("n", 24)))
            scope._on_avg_change(0)
            return {"ok": True, "avg_n": avg_n}
        if action in {"det_ratio", "ratio", "set_det_ratio"}:
            val = float(params.get("value", params.get("ratio", 2.0)))
            if hasattr(scope, "_set_detector_channel_settings"):
                scope._set_detector_channel_settings({"ratio0": val, "ratio1": val})
            else:
                scope._on_det_ratio_change(f"{val:.1f}")
            try:
                scope.det_ratio_box.setCurrentText(f"{val:.1f}")
            except Exception:
                pass
            return {"ok": True, "det_ratio": float(getattr(scope, "_det_ratio", val))}
        if action in {"tag_detection", "detector_settings", "set_detector_settings", "set_tag_detection"}:
            if not hasattr(scope, "_set_detector_channel_settings"):
                raise RuntimeError("engine does not support per-channel detector settings")
            persist = _api_bool(params.get("persist", params.get("save", True)), True)
            snapshot = scope._set_detector_channel_settings(params, persist=persist)
            return {"ok": True, "detector": snapshot, "persisted": persist}
        if action in {"runtime_detector_settings", "runtime_tag_detection", "detector_thresholds", "set_detector_thresholds"}:
            if not hasattr(scope, "_set_detector_channel_settings"):
                raise RuntimeError("engine does not support per-channel detector settings")
            snapshot = scope._set_detector_channel_settings(params, persist=False)
            return {"ok": True, "detector": snapshot, "persisted": False}
        if action in {"tim2", "tx", "set_tim2"}:
            enabled = bool(params.get("enabled", params.get("value", True)))
            self._restore_tim2_valid = False
            try:
                scope.btn_tim2.setChecked(enabled)
            except Exception:
                pass
            scope._on_toggle_tim2(enabled)
            return {"ok": True, "tim2_enabled": enabled}
        if action in {"sound", "set_sound"}:
            enabled = bool(params.get("enabled", params.get("value", True)))
            scope._set_sound_enabled(enabled, reason="api", announce=True)
            return {"ok": True, "sound_enabled": enabled}
        if action in {"optic_hold", "optic_delay", "set_optic_hold", "optic_hold_ds"}:
            raw = params.get("hold_ds", params.get("ds", None))
            if raw is None:
                sec = params.get("seconds", params.get("sec", params.get("value", None)))
                try:
                    hold_ds = int(round(float(sec) * 10)) if sec is not None else 30
                except Exception:
                    hold_ds = 30
            else:
                try:
                    hold_ds = int(raw)
                except Exception:
                    hold_ds = 30
            hold_ds = max(0, min(100, hold_ds))
            if not hasattr(scope, "_send_optic_hold_ds"):
                raise RuntimeError("engine does not support optic hold")
            ok = bool(scope._send_optic_hold_ds(hold_ds))
            return {"ok": ok, "optic_hold_ds": hold_ds, "optic_hold_seconds": round(hold_ds / 10.0, 1)}
        if action in {"optic_reaction", "set_optic_reaction", "optic_reaction_enabled"}:
            enabled = _api_bool(params.get("enabled", params.get("value", True)), True)
            if not hasattr(scope, "_set_optic_reaction_enabled"):
                raise RuntimeError("engine does not support optic reaction")
            scope._set_optic_reaction_enabled(enabled)
            return {"ok": True, "optic_reaction_enabled": bool(enabled)}
        if action in {"normalization", "normalize", "norm", "xcorr_norm"}:
            current = bool(getattr(scope, "xcorr_norm_enabled", False))
            enabled = _api_bool(params.get("enabled", params.get("value", not current)), not current)
            btn = getattr(scope, "btn_diag", None)
            if btn is not None:
                try:
                    btn.blockSignals(True)
                    btn.setChecked(enabled)
                except Exception:
                    pass
                finally:
                    try:
                        btn.blockSignals(False)
                    except Exception:
                        pass
            if hasattr(scope, "_on_toggle_xcorr_norm"):
                scope._on_toggle_xcorr_norm(enabled)
            else:
                scope.xcorr_norm_enabled = enabled
            return {"ok": True, "normalization_enabled": bool(getattr(scope, "xcorr_norm_enabled", enabled))}
        if action in {"optimize", "optimize_signal", "det_optimize"}:
            try:
                selected = int(scope.num_group.checkedId())
            except Exception:
                selected = 0
            if selected >= 5:
                self._start_dc_startup_compensation(selected, "api_optimize")
            if selected != 5:
                scope._reset_det_adapt()
            return {"ok": True, "action": action, "mode": int(scope.num_group.checkedId())}
        if action in {"stm32_reset", "reset_stm32", "hardware_reset", "hw_reset"}:
            try:
                selected = int(scope.num_group.checkedId())
            except Exception:
                selected = 0
            if selected == 0 and hasattr(scope, "_hardware_reset_device"):
                ok = bool(scope._hardware_reset_device())
                if ok and hasattr(scope, "_wait_after_usb_reset_for_reconnect"):
                    try:
                        scope._wait_after_usb_reset_for_reconnect("web_stm32_reset")
                    except Exception:
                        pass
                return {"ok": ok, "action": action, "mode": selected, "reset_only": True}
            if hasattr(scope, "_restart_stream"):
                scope._restart_stream(hardware_reset=True, reason="web_stm32_reset")
            else:
                scope._manual_reconnect()
            return {"ok": True, "action": action, "mode": selected}
        if action in {"reconnect", "restart"}:
            scope._manual_reconnect()
            return {"ok": True, "action": action}
        if action in {"reset_detector", "det_reset"}:
            scope._reset_det_adapt()
            return {"ok": True, "action": action}
        if action in {"player_record_start", "player_raw_record_start"}:
            if not hasattr(scope, "player_recording_start"):
                raise RuntimeError("engine does not support raw player recording")
            max_packets = params.get("max_packets", params.get("limit", None))
            result = scope.player_recording_start(max_packets=max_packets)
            result["action"] = action
            return result
        if action in {"player_record_stop", "player_raw_record_stop"}:
            if not hasattr(scope, "player_recording_stop"):
                raise RuntimeError("engine does not support raw player recording")
            save = _api_bool(params.get("save", True), True)
            result = scope.player_recording_stop(save=save)
            result["action"] = action
            return result
        if action in {"player_record_status", "player_raw_record_status"}:
            if not hasattr(scope, "player_recording_status"):
                raise RuntimeError("engine does not support raw player recording")
            result = scope.player_recording_status()
            result["action"] = action
            return result
        if action in {"player_record_mark", "player_raw_record_mark", "player_record_live_mark"}:
            if not hasattr(scope, "player_recording_mark"):
                raise RuntimeError("engine does not support raw player live marking")
            channel = str(params.get("channel", params.get("tag_channel", "upper")) or "upper")
            tag_type = str(params.get("tag_type", params.get("type", "casino")) or "casino")
            mark = str(params.get("mark", "tag") or "tag")
            begin = _api_bool(params.get("begin", params.get("start", False)), False)
            result = scope.player_recording_mark(channel=channel, tag_type=tag_type, mark=mark, begin=begin)
            result["action"] = action
            return result
        if action in {"player_playback_start", "player_raw_playback_start"}:
            if not hasattr(scope, "player_playback_start"):
                raise RuntimeError("engine does not support raw player playback state")
            result = scope.player_playback_start()
            result["action"] = action
            return result
        if action in {"player_playback_stop", "player_raw_playback_stop"}:
            if not hasattr(scope, "player_playback_stop"):
                raise RuntimeError("engine does not support raw player playback state")
            result = scope.player_playback_stop()
            result["action"] = action
            return result
        if action in {"player_record_files", "player_raw_record_files"}:
            if not hasattr(scope, "player_recording_files"):
                raise RuntimeError("engine does not support raw player recording")
            limit = int(params.get("limit", 50) or 50)
            result = scope.player_recording_files(limit=limit)
            result["action"] = action
            return result
        if action in {"player_record_save_marks", "player_raw_record_save_marks"}:
            if not hasattr(scope, "player_recording_save_marks"):
                raise RuntimeError("engine does not support raw player label saving")
            name = str(params.get("name", params.get("file", "latest")) or "latest")
            marks = params.get("marks", [])
            ranges = params.get("ranges", [])
            result = scope.player_recording_save_marks(name=name, marks=marks, ranges=ranges)
            result["action"] = action
            return result
        if action in {"player_record_load", "player_raw_record_load"}:
            if not hasattr(scope, "player_recording_load"):
                raise RuntimeError("engine does not support raw player recording")
            name = str(params.get("name", params.get("file", "latest")) or "latest")
            max_points = int(params.get("max_points", 600) or 600)
            max_frames = int(params.get("max_frames", 800) or 800)
            result = scope.player_recording_load(name=name, max_points=max_points, max_frames=max_frames)
            result["action"] = action
            return result
        if action in {"reset_detector_counts", "det_counts_reset"}:
            channel = str(params.get("channel", "all")).strip().lower()
            reset_upper = channel in {"all", "both", "upper", "u", "0", "adc0", "ch0"}
            reset_lower = channel in {"all", "both", "lower", "l", "1", "adc1", "ch1"}
            if not reset_upper and not reset_lower:
                raise ValueError("channel must be upper, lower, or all")
            if reset_upper:
                scope._web_det_flash_seq0 = 0
                scope._web_det_flash_t0 = 0.0
                scope._web_det_flash_active0 = False
            if reset_lower:
                scope._web_det_flash_seq1 = 0
                scope._web_det_flash_t1 = 0.0
                scope._web_det_flash_active1 = False
            return {
                "ok": True,
                "action": action,
                "fire_seq0": int(getattr(scope, "_web_det_flash_seq0", 0) or 0),
                "fire_seq1": int(getattr(scope, "_web_det_flash_seq1", 0) or 0),
            }
        if action in {"read_dc_config", "get_dc_config", "dc_config_read"}:
            return self._read_dc_config()
        if action == "dc_config":
            stream = getattr(scope, "stream", None)
            if stream is None:
                raise RuntimeError("stream is not connected")
            if not hasattr(stream, "set_dc_config_seconds"):
                raise RuntimeError("stream does not support set_dc_config_seconds")
            mode_value = int(params.get("mode", 1))
            work_settle_s = float(params.get("work_settle_s", 900.0))
            detect_settle_s = float(params.get("detect_settle_s", params.get("detect_initial_settle_s", 30.0)))
            fast_settle_s = float(params.get("fast_settle_s", 5.0))
            fast_duration_s = float(params.get("fast_duration_s", 30.0))
            if "active_settle_s" in params:
                active_settle_s = float(params.get("active_settle_s", work_settle_s))
            elif mode_value == 2:
                active_settle_s = detect_settle_s
            elif mode_value == 3:
                active_settle_s = fast_duration_s
            else:
                active_settle_s = work_settle_s
            requested_dc = {
                "mode_value": mode_value,
                "mode": DC_MODE_NAMES.get(int(mode_value), "WORK"),
                "work_settle_s": work_settle_s,
                "detect_settle_s": detect_settle_s,
                "fast_settle_s": fast_settle_s,
                "fast_duration_s": fast_duration_s,
            }
            _save_default_dc_config(requested_dc)
            try:
                selected_for_dc = int(scope.num_group.checkedId())
            except Exception:
                selected_for_dc = 0
            if selected_for_dc == 5:
                self._start_dc_startup_compensation(5, "api_dc_config_mode5")
            elif selected_for_dc > 0:
                _apply_default_dc_config(scope, reason="api_dc_config_work", profile="work")
            elif selected_for_dc <= 0:
                expected = _expected_dc_config(mode=mode_value, cfg=requested_dc)
                stream.set_dc_config_seconds(
                    mode=int(expected["mode_value"]),
                    work_settle_s=float(expected["work_settle_s"]),
                    detect_settle_s=float(expected["detect_settle_s"]),
                    fast_settle_s=float(expected["fast_settle_s"]),
                    fast_duration_s=float(expected["fast_duration_s"]),
                )
            result: dict[str, Any] = {"ok": True, "action": action}
            try:
                readback = self._read_dc_config()
                if bool(readback.get("ok", False)):
                    result["dc_config"] = readback.get("dc_config")
                else:
                    result["readback_error"] = readback.get("error", "readback failed")
            except Exception as exc:
                result["readback_error"] = str(exc)
            return result
        raise ValueError(f"unknown action: {action}")

