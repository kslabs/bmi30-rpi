def _send_json(handler: BaseHTTPRequestHandler, payload: dict[str, Any], status: HTTPStatus = HTTPStatus.OK) -> None:
    data = json.dumps(_json_safe(payload), ensure_ascii=False, separators=(",", ":")).encode("utf-8")
    handler.send_response(status)
    handler.send_header("Content-Type", "application/json; charset=utf-8")
    handler.send_header("Cache-Control", "no-store")
    handler.send_header("Content-Length", str(len(data)))
    handler.end_headers()
    handler.wfile.write(data)


def _send_binary(handler: BaseHTTPRequestHandler, data: bytes, content_type: str = "application/octet-stream", status: HTTPStatus = HTTPStatus.OK) -> None:
    handler.send_response(status)
    handler.send_header("Content-Type", content_type)
    handler.send_header("Cache-Control", "no-store")
    handler.send_header("Content-Length", str(len(data)))
    handler.end_headers()
    handler.wfile.write(data)


def _api_command_log_params(params: dict[str, Any]) -> dict[str, Any]:
    safe: dict[str, Any] = {}
    for key, value in (params or {}).items():
        name = str(key)
        lname = name.lower()
        if any(mark in lname for mark in ("pass", "token", "secret", "cookie", "auth")):
            safe[name] = "<redacted>"
            continue
        if isinstance(value, (bool, int, float)) or value is None:
            safe[name] = value
        elif isinstance(value, str):
            safe[name] = value[:120]
        elif isinstance(value, (list, tuple)):
            safe[name] = f"<{type(value).__name__}:{len(value)}>"
        elif isinstance(value, dict):
            safe[name] = f"<dict:{len(value)}>"
        else:
            safe[name] = f"<{type(value).__name__}>"
    return safe


def _log_api_command(handler: BaseHTTPRequestHandler, action: str, params: dict[str, Any]) -> None:
    try:
        peer = handler.client_address[0] if getattr(handler, "client_address", None) else "?"
        ua = str(handler.headers.get("User-Agent", ""))[:120]
        ref = str(handler.headers.get("Referer", ""))[:160]
        src = str(handler.headers.get("X-BMI30-Source", ""))[:80]
        safe_params = _api_command_log_params(params)
        print(
            f"[API-CMD] peer={peer} action={action} source={src or '-'} "
            f"params={json.dumps(_json_safe(safe_params), ensure_ascii=False, separators=(',', ':'))} "
            f"ref={ref or '-'} ua={ua or '-'}",
            flush=True,
        )
    except Exception as exc:
        print(f"[API-CMD] log failed action={action}: {exc}", flush=True)


def _player_upload_limit_bytes() -> int:
    try:
        mb = float(os.getenv("BMI30_PLAYER_UPLOAD_MAX_MB", "512") or 512.0)
    except Exception:
        mb = 512.0
    return max(1, int(mb * 1024 * 1024))


def _safe_player_upload_name(value: Any) -> str:
    raw = unquote(str(value or "").strip()).replace("\x00", "")
    name = os.path.basename(raw.replace("\\", "/")).strip()
    if not name:
        name = f"player_raw_import_{datetime.datetime.now().strftime('%Y%m%d_%H%M%S')}.npz"
    if not name.lower().endswith(".npz"):
        raise ValueError("select a .npz raw recording file")
    return name


def _sha256_file(path: str) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        while True:
            chunk = f.read(1024 * 1024)
            if not chunk:
                break
            h.update(chunk)
    return h.hexdigest()


def _unique_player_upload_path(record_dir: str, name: str) -> str:
    stem, ext = os.path.splitext(name)
    if not ext:
        ext = ".npz"
    stamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
    for i in range(1, 1000):
        suffix = f"_import_{stamp}" if i == 1 else f"_import_{stamp}_{i}"
        candidate = os.path.abspath(os.path.join(record_dir, f"{stem}{suffix}{ext}"))
        if os.path.dirname(candidate) == os.path.abspath(record_dir) and not os.path.exists(candidate):
            return candidate
    raise RuntimeError("cannot allocate upload filename")


def _player_record_dir_for_upload(api: "ScopeApi") -> str:
    scope = getattr(api, "scope", None)
    if scope is not None and hasattr(scope, "_player_record_dir_path"):
        return str(scope._player_record_dir_path())
    return str(HOST_DIR / "player_recordings")


def _player_recording_path_for_download(api: "ScopeApi", name: str) -> str:
    scope = getattr(api, "scope", None)
    record_dir = os.path.abspath(_player_record_dir_for_upload(api))
    if scope is not None and hasattr(scope, "_player_record_file_path"):
        path = os.path.abspath(str(scope._player_record_file_path(name)))
    else:
        name_s = os.path.basename(str(name or "").strip())
        if not name_s or name_s == "latest":
            candidates: list[tuple[float, str]] = []
            try:
                for item in os.listdir(record_dir):
                    if item.endswith(".npz"):
                        path_i = os.path.join(record_dir, item)
                        candidates.append((os.path.getmtime(path_i), path_i))
            except Exception:
                candidates = []
            if not candidates:
                return ""
            candidates.sort(reverse=True)
            path = os.path.abspath(candidates[0][1])
        else:
            path = os.path.abspath(os.path.join(record_dir, name_s))
    if not path or os.path.dirname(path) != record_dir or not path.lower().endswith(".npz"):
        raise ValueError("invalid recording file name")
    return path


def _send_player_recording_download(handler: BaseHTTPRequestHandler, api: "ScopeApi", parsed: Any) -> None:
    query = parse_qs(getattr(parsed, "query", "") or "")
    name = str((query.get("name") or ["latest"])[0] or "latest")
    path = _player_recording_path_for_download(api, name)
    if not path or not os.path.exists(path):
        _send_json(handler, {"ok": False, "error": "recording file not found"}, HTTPStatus.NOT_FOUND)
        return
    filename = os.path.basename(path).replace("\\", "_").replace('"', "_")
    size = os.path.getsize(path)
    handler.send_response(HTTPStatus.OK)
    handler.send_header("Content-Type", "application/octet-stream")
    handler.send_header("Content-Disposition", f'attachment; filename="{filename}"')
    handler.send_header("Cache-Control", "no-store")
    handler.send_header("Content-Length", str(size))
    handler.end_headers()
    with open(path, "rb") as f:
        while True:
            chunk = f.read(1024 * 1024)
            if not chunk:
                break
            handler.wfile.write(chunk)


def _handle_player_recording_upload(handler: BaseHTTPRequestHandler, api: "ScopeApi", parsed: Any) -> dict[str, Any]:
    try:
        length = int(handler.headers.get("Content-Length", "0") or "0")
    except Exception:
        length = 0
    if length <= 0:
        raise ValueError("empty upload")
    limit = _player_upload_limit_bytes()
    if length > limit:
        raise ValueError(f"upload too large ({length} bytes, limit {limit} bytes)")
    query = parse_qs(getattr(parsed, "query", "") or "")
    filename = _safe_player_upload_name(
        handler.headers.get("X-BMI30-Filename")
        or handler.headers.get("X-Filename")
        or (query.get("name") or [""])[0]
    )
    record_dir = os.path.abspath(_player_record_dir_for_upload(api))
    os.makedirs(record_dir, exist_ok=True)
    target = os.path.abspath(os.path.join(record_dir, filename))
    if os.path.dirname(target) != record_dir:
        raise ValueError("invalid recording file name")
    tmp_path = os.path.join(record_dir, f".{filename}.{os.getpid()}.{int(time.time() * 1000)}.upload")
    total = 0
    digest = hashlib.sha256()
    try:
        remaining = length
        with open(tmp_path, "wb") as f:
            while remaining > 0:
                chunk = handler.rfile.read(min(1024 * 1024, remaining))
                if not chunk:
                    break
                total += len(chunk)
                if total > limit:
                    raise ValueError("upload exceeded size limit")
                digest.update(chunk)
                f.write(chunk)
                remaining -= len(chunk)
        if total != length:
            raise ValueError(f"incomplete upload ({total}/{length} bytes)")
        uploaded_hash = digest.hexdigest()
        if os.path.exists(target):
            try:
                same = _sha256_file(target) == uploaded_hash
            except Exception:
                same = False
            if same:
                try:
                    os.unlink(tmp_path)
                except Exception:
                    pass
            else:
                target = _unique_player_upload_path(record_dir, filename)
                os.replace(tmp_path, target)
        else:
            os.replace(tmp_path, target)
    except Exception:
        try:
            if os.path.exists(tmp_path):
                os.unlink(tmp_path)
        except Exception:
            pass
        raise
    max_points = int((query.get("max_points") or ["600"])[0] or 600)
    max_frames = int((query.get("max_frames") or ["800"])[0] or 800)
    load_result = api.submit(
        "player_record_load",
        {"name": os.path.basename(target), "max_points": max_points, "max_frames": max_frames},
        timeout=45.0,
    )
    if isinstance(load_result, dict):
        load_result["uploaded_file"] = filename
        load_result["stored_file"] = os.path.basename(target)
        load_result["uploaded_bytes"] = int(total)
        return load_result
    return {"ok": False, "error": "upload load failed"}


class ServiceHandler(BaseHTTPRequestHandler):
    server_version = "BMI30CoreService/001"

    def log_message(self, fmt: str, *args: Any) -> None:
        if os.getenv("BMI30_SERVICE_HTTP_LOG", "0").lower() in {"1", "true", "yes", "on"}:
            super().log_message(fmt, *args)

    def do_GET(self) -> None:
        parsed = urlparse(self.path)
        api = API
        if api is None:
            _send_json(self, {"ok": False, "error": "service not ready"}, HTTPStatus.SERVICE_UNAVAILABLE)
            return
        if parsed.path in {"/", "/index.html"}:
            html = SERVICE_HTML.encode("utf-8")
            self.send_response(HTTPStatus.OK)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(html)))
            self.end_headers()
            self.wfile.write(html)
            return
        if parsed.path in {"/health", "/api/health"}:
            _send_json(self, {"ok": True, "service": "BMI30", "version": SERVICE_VERSION})
            return
        if parsed.path == "/api/status":
            _send_json(self, api.status())
            return
        if parsed.path == "/api/dc-config":
            _send_json(self, api.submit("read_dc_config", {}, timeout=3.0))
            return
        if parsed.path == "/api/frame":
            query = parse_qs(parsed.query)
            max_points = int((query.get("max_points") or ["600"])[0])
            _send_json(self, api.frame(max_points=max_points))
            return
        if parsed.path == "/api/frame.bin":
            query = parse_qs(parsed.query)
            max_points = int((query.get("max_points") or ["600"])[0])
            channels = (query.get("channels") or ["both"])[0]
            try:
                since = float((query.get("since") or ["0"])[0] or 0.0)
            except Exception:
                since = 0.0
            _send_binary(self, api.frame_binary(max_points=max_points, channels=channels, since=since))
            return
        if parsed.path == "/api/player-recording-download":
            try:
                _send_player_recording_download(self, api, parsed)
            except Exception as exc:
                _send_json(self, {"ok": False, "error": str(exc)}, HTTPStatus.BAD_REQUEST)
            return
        _send_json(self, {"ok": False, "error": "not found"}, HTTPStatus.NOT_FOUND)

    def do_POST(self) -> None:
        parsed = urlparse(self.path)
        api = API
        if api is None:
            _send_json(self, {"ok": False, "error": "service not ready"}, HTTPStatus.SERVICE_UNAVAILABLE)
            return
        if parsed.path == "/api/player-recording-upload":
            try:
                _send_json(self, _handle_player_recording_upload(self, api, parsed))
            except Exception as exc:
                _send_json(self, {"ok": False, "error": str(exc)}, HTTPStatus.BAD_REQUEST)
            return
        if parsed.path != "/api/command":
            _send_json(self, {"ok": False, "error": "not found"}, HTTPStatus.NOT_FOUND)
            return
        try:
            length = int(self.headers.get("Content-Length", "0") or "0")
            raw = self.rfile.read(min(length, 1024 * 1024))
            payload = json.loads(raw.decode("utf-8") or "{}") if raw else {}
            if not isinstance(payload, dict):
                raise ValueError("JSON object expected")
            action = str(payload.get("action") or "")
            params = payload.get("params")
            if not isinstance(params, dict):
                params = {k: v for k, v in payload.items() if k not in {"action", "params"}}
            if not action:
                raise ValueError("missing action")
            action_l = action.strip().lower()
            timeout = 60.0 if action_l.startswith(("player_", "player_raw_")) else 8.0
            _log_api_command(self, action_l, params)
            _send_json(self, api.submit(action, params, timeout=timeout))
        except Exception as exc:
            _send_json(self, {"ok": False, "error": str(exc)}, HTTPStatus.BAD_REQUEST)


