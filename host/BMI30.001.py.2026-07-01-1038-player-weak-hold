def _queue_qt_call(fn: Any) -> None:
    try:
        _QT_CALL_QUEUE.put(fn)
    except Exception as exc:
        print(f"[BMI30.001] queue Qt call failed: {exc}", flush=True)


def _call_qt_later_s(delay_s: float, fn: Any) -> None:
    try:
        delay = max(0.0, float(delay_s))
    except Exception:
        delay = 0.0
    if delay <= 0.0:
        _queue_qt_call(fn)
        return
    try:
        timer = threading.Timer(delay, lambda: _queue_qt_call(fn))
        timer.daemon = True
        timer.start()
    except Exception:
        _queue_qt_call(fn)


def _start_qt_call_pump(qtcore: Any) -> None:
    global _QT_CALL_PUMP_STARTED
    with _QT_CALL_PUMP_LOCK:
        if _QT_CALL_PUMP_STARTED:
            return
        _QT_CALL_PUMP_STARTED = True

    def _pump() -> None:
        global _QT_CALL_PUMP_STARTED
        while True:
            try:
                fn = _QT_CALL_QUEUE.get_nowait()
            except queue.Empty:
                break
            try:
                fn()
            except Exception as exc:
                print(f"[BMI30.001] Qt queued call failed: {exc}", flush=True)
        try:
            qtcore.QTimer.singleShot(50, _pump)
        except Exception as exc:
            print(f"[BMI30.001] Qt call pump stopped: {exc}", flush=True)
            with _QT_CALL_PUMP_LOCK:
                _QT_CALL_PUMP_STARTED = False

    try:
        qtcore.QTimer.singleShot(50, _pump)
    except Exception as exc:
        print(f"[BMI30.001] Qt call pump start failed: {exc}", flush=True)
        with _QT_CALL_PUMP_LOCK:
            _QT_CALL_PUMP_STARTED = False


