def start_http_server() -> ThreadingHTTPServer:
    server = ThreadingHTTPServer((API_HOST, API_PORT), ServiceHandler)
    th = threading.Thread(target=server.serve_forever, daemon=True)
    th.start()
    print(f"[BMI30.001] API listening on http://{API_HOST}:{API_PORT}", flush=True)
    return server


def main() -> int:
    os.environ.setdefault("QT_QPA_PLATFORM", "offscreen")
    os.environ.setdefault("BMI30_SERVICE_MODE", "1")
    os.chdir(str(REPO_DIR))
    engine = _load_engine_module(ENGINE_FILE)
    if getattr(engine, "PG_IMPORT_ERR", None):
        print(f"[BMI30.001] engine Qt import failed: {engine.PG_IMPORT_ERR}", flush=True)
        return 2
    scope = engine.ScopeWindow()
    _start_qt_call_pump(engine.QtCore)
    _install_detector_flash_hooks(scope)
    _apply_default_avg_n(scope)
    _apply_default_detector_settings(scope)
    try:
        orig_num_clicked = scope._num_clicked

        def _restore_default_dc_after_startup(selected: int, reason: str = "") -> None:
            try:
                selected_i = int(selected)
            except Exception:
                selected_i = 0
            try:
                current = int(scope.num_group.checkedId())
            except Exception:
                current = 0
            if selected_i == 5 and current != 5:
                return
            if selected_i >= 6 and current < 6:
                return
            profile = _dc_steady_profile_for_mode(selected_i)
            if profile:
                _apply_default_dc_config(scope, reason=f"{reason}:restore_{profile}", profile=profile)

        def _schedule_mode5_startup_dc(reason: str = "", attempt: int = 0) -> None:
            try:
                selected = int(scope.num_group.checkedId())
            except Exception:
                selected = 0
            if selected != 5:
                return
            applied = _apply_default_dc_config(scope, reason=f"{reason}:try{attempt}", profile="startup")
            if applied:
                delay_s = _dc_startup_restore_delay_s()
                try:
                    scope._host_dc_startup_until = time.time() + max(0.2, delay_s)
                except Exception:
                    pass
                try:
                    _call_later_s(max(0.2, delay_s), lambda: _restore_default_dc_after_startup(5, reason))
                except Exception:
                    pass
                return
            if attempt < 20:
                try:
                    _call_later_s(0.3, lambda: _schedule_mode5_startup_dc(reason, attempt + 1))
                except Exception:
                    pass

        def _schedule_default_dc_apply(reason: str = "", attempt: int = 0) -> None:
            try:
                selected = int(scope.num_group.checkedId())
            except Exception:
                selected = 0
            if selected == 5:
                return
            if selected >= 6:
                try:
                    stream_mode = int(getattr(scope, "stream_mode", 0) or 0)
                except Exception:
                    stream_mode = 0
                if stream_mode != 2:
                    if attempt < 12:
                        try:
                            _call_later_s(0.3, lambda: _schedule_default_dc_apply(reason, attempt + 1))
                        except Exception:
                            pass
                    return
                profile_name = "work"
            elif selected > 0:
                profile_name = "work"
            else:
                return
            if _apply_default_dc_config(scope, reason=f"{reason}:try{attempt}", profile=profile_name):
                return
            if attempt < 12:
                try:
                    _call_later_s(0.3, lambda: _schedule_default_dc_apply(reason, attempt + 1))
                except Exception:
                    pass

        def _call_later_s(delay_s: float, fn: Any) -> None:
            try:
                _call_qt_later_s(delay_s, fn)
            except Exception:
                _queue_qt_call(fn)

        def _dc_verify_profile() -> str:
            try:
                selected = int(scope.num_group.checkedId())
            except Exception:
                selected = 0
            if selected == 5:
                return "work"
            if selected >= 6:
                profile = str(getattr(scope, "_host_dc_desired_profile", "") or "").strip().lower()
                if profile in {"acquisition", "detection", "detect"}:
                    return "detection" if profile == "detect" else profile
                return "work"
            if selected > 0:
                return "work"
            return ""

        def _set_dc_verify_status(ok: bool, profile: str, reason: str, mismatches: list[str] | None = None) -> None:
            try:
                scope._host_dc_verify_last_t = time.time()
                scope._host_dc_verify_last_ok = bool(ok)
                scope._host_dc_verify_last_profile = str(profile or "")
                scope._host_dc_verify_last_reason = str(reason or "")
                scope._host_dc_verify_last_mismatches = list(mismatches or [])
            except Exception:
                pass

        def _periodic_dc_verify() -> None:
            interval_s = _dc_verify_interval_s()
            try:
                try:
                    scope._host_dc_verify_enabled = True
                except Exception:
                    pass
                profile = _dc_verify_profile()
                if not profile:
                    _set_dc_verify_status(True, "", "idle")
                    return
                try:
                    if time.time() < float(getattr(scope, "_host_dc_startup_until", 0.0) or 0.0):
                        _set_dc_verify_status(True, profile, "startup_window")
                        return
                except Exception:
                    pass
                stream = getattr(scope, "stream", None)
                if stream is None or not hasattr(stream, "get_dc_config"):
                    _set_dc_verify_status(False, profile, "no_stream")
                    return
                readback = _dc_config_from_device(stream.get_dc_config())
                expected = _expected_dc_config(profile=profile)
                mismatches = _dc_config_mismatches(readback, expected)
                if not mismatches:
                    _set_dc_verify_status(True, profile, "ok")
                    return
                if mismatches == ["unavailable"]:
                    _set_dc_verify_status(False, profile, "readback_unavailable", mismatches)
                    print(
                        f"[DC] verify unavailable profile={profile}; skip reapply",
                        flush=True,
                    )
                    return
                try:
                    scope._host_dc_verify_fix_count = int(getattr(scope, "_host_dc_verify_fix_count", 0) or 0) + 1
                except Exception:
                    pass
                _set_dc_verify_status(False, profile, "mismatch", mismatches)
                print(
                    f"[DC] verify mismatch profile={profile} mismatches={','.join(mismatches)}; reapplying",
                    flush=True,
                )
                _apply_default_dc_config(scope, reason=f"periodic_verify:{profile}", profile=profile)
            except Exception as exc:
                _set_dc_verify_status(False, "", f"error:{exc}")
                print(f"[DC] verify failed: {exc}", flush=True)
            finally:
                try:
                    _call_later_s(interval_s, _periodic_dc_verify)
                except Exception:
                    pass

        def _num_clicked_with_dc_restore(idx: int, *args: Any, **kwargs: Any):
            result = orig_num_clicked(idx, *args, **kwargs)
            try:
                idx_i = int(idx)
                if idx_i == 5:
                    _call_later_s(0.05, lambda: _schedule_mode5_startup_dc("mode_5_startup", 0))
                elif idx_i > 0:
                    _call_later_s(0.05, lambda: _schedule_default_dc_apply(f"mode_{int(idx)}", 0))
            except Exception:
                pass
            return result

        scope._num_clicked = _num_clicked_with_dc_restore
        try:
            orig_set_det_gpio = scope._set_det_gpio

            def _det_dc_cancel_pending() -> int:
                try:
                    seq = int(getattr(scope, "_host_dc_pending_seq", 0) or 0) + 1
                except Exception:
                    seq = 1
                try:
                    scope._host_dc_pending_seq = seq
                    scope._host_dc_pending_profile = ""
                except Exception:
                    pass
                return seq

            def _det_dc_selected_active() -> bool:
                try:
                    return int(scope.num_group.checkedId()) > 0
                except Exception:
                    return False

            def _det_dc_startup_active() -> bool:
                try:
                    return time.time() < float(getattr(scope, "_host_dc_startup_until", 0.0) or 0.0)
                except Exception:
                    return False

            def _det_dc_dynamic_profiles_enabled() -> bool:
                try:
                    return str(os.getenv("BMI30_DC_DYNAMIC_PROFILES", "0")).lower() not in ("0", "false", "no", "off")
                except Exception:
                    return False

            def _det_dc_set_desired(profile_name: str) -> None:
                try:
                    scope._host_dc_desired_profile = str(profile_name or "").strip().lower()
                except Exception:
                    pass

            def _det_dc_apply_profile(profile_name: str, reason: str) -> bool:
                profile_name = str(profile_name or "").strip().lower()
                if not profile_name:
                    return False
                if not _det_dc_selected_active():
                    return False
                last_profile = str(getattr(scope, "_host_dc_profile", "") or "")
                if profile_name == last_profile:
                    return False
                if _apply_default_dc_config(scope, reason=reason, profile=profile_name):
                    try:
                        scope._host_dc_profile = profile_name
                        scope._host_dc_profile_t = time.time()
                    except Exception:
                        pass
                    return True
                return False

            def _det_dc_restore_delay(env_name: str, default: float) -> float:
                try:
                    delay_s = float(os.getenv(env_name, str(default)))
                except Exception:
                    delay_s = float(default)
                try:
                    if not np.isfinite(delay_s):
                        delay_s = float(default)
                except Exception:
                    delay_s = float(default)
                return max(0.05, min(5.0, float(delay_s)))

            def _det_dc_apply_pending_work(seq: int, reason: str) -> None:
                if not _det_dc_selected_active():
                    return
                if _det_dc_startup_active():
                    return
                try:
                    if int(seq) != int(getattr(scope, "_host_dc_pending_seq", 0) or 0):
                        return
                    if str(getattr(scope, "_host_dc_pending_profile", "") or "") != "work":
                        return
                except Exception:
                    return
                try:
                    scope._host_dc_pending_profile = ""
                except Exception:
                    pass
                _det_dc_set_desired("work")
                _det_dc_apply_profile("work", reason)

            def _det_dc_schedule_work_restore(reason: str, delay_s: float, desired_now: bool = False) -> None:
                if desired_now:
                    _det_dc_set_desired("work")
                seq = _det_dc_cancel_pending()
                delay_s = max(0.05, min(5.0, float(delay_s)))
                try:
                    scope._host_dc_pending_profile = "work"
                    _call_later_s(delay_s, lambda seq=seq: _det_dc_apply_pending_work(seq, reason))
                except Exception:
                    _det_dc_apply_pending_work(seq, reason)

            def _det_dc_pre_fire(channel: Any, count: Any = 0, confirm_count: Any = 0) -> None:
                if not _det_dc_dynamic_profiles_enabled():
                    return
                if not _det_dc_selected_active() or _det_dc_startup_active():
                    return
                try:
                    if time.time() < float(getattr(scope, "_host_dc_detection_until", 0.0) or 0.0):
                        return
                    if str(getattr(scope, "_host_dc_desired_profile", "") or "") == "detection":
                        return
                except Exception:
                    pass
                try:
                    count_i = int(count)
                except Exception:
                    count_i = 0
                try:
                    confirm_i = max(1, int(confirm_count))
                except Exception:
                    confirm_i = 1
                if count_i <= 0 or count_i >= confirm_i:
                    return
                _det_dc_set_desired("acquisition")
                _det_dc_apply_profile("acquisition", f"pre_fire:ch{channel}:{count_i}/{confirm_i}")
                delay_s = _det_dc_restore_delay("BMI30_DC_PREFIRE_RESTORE_DELAY_S", 0.8)
                _det_dc_schedule_work_restore("pre_fire:restore_work", delay_s, desired_now=False)

            def _det_dc_detection_fire(fired0: Any = False, fired1: Any = False, reason: str = "det_fire") -> None:
                if not _det_dc_dynamic_profiles_enabled():
                    return
                if not _det_dc_selected_active() or _det_dc_startup_active():
                    return
                if not (bool(fired0) or bool(fired1)):
                    return
                now = time.time()
                delay_s = _det_dc_restore_delay("BMI30_DC_DETECTION_RESTORE_DELAY_S", 0.2)
                try:
                    if str(getattr(scope, "_host_dc_desired_profile", "") or "") == "detection":
                        if now < float(getattr(scope, "_host_dc_detection_until", 0.0) or 0.0):
                            return
                except Exception:
                    pass
                _det_dc_cancel_pending()
                _det_dc_set_desired("detection")
                try:
                    scope._host_dc_detection_until = now + delay_s
                except Exception:
                    pass
                _det_dc_apply_profile("detection", reason)
                _det_dc_schedule_work_restore("detection:restore_work", delay_s, desired_now=False)

            def _arg_value(args: tuple[Any, ...], kwargs: dict[str, Any], index: int, name: str, default: Any = None) -> Any:
                if name in kwargs:
                    return kwargs.get(name)
                if len(args) > index:
                    return args[index]
                return default

            orig_pre_fire = getattr(scope, "_mark_web_pre_fire", None)
            if callable(orig_pre_fire):
                def _mark_web_pre_fire_with_dc(*args: Any, **kwargs: Any) -> Any:
                    result = orig_pre_fire(*args, **kwargs)
                    _det_dc_pre_fire(
                        _arg_value(args, kwargs, 0, "channel", 0),
                        _arg_value(args, kwargs, 1, "count", 0),
                        _arg_value(args, kwargs, 2, "confirm_count", 0),
                    )
                    return result

                scope._mark_web_pre_fire = _mark_web_pre_fire_with_dc

            orig_detection_fire = getattr(scope, "_mark_web_detection_fire", None)
            if callable(orig_detection_fire):
                def _mark_web_detection_fire_with_dc(*args: Any, **kwargs: Any) -> Any:
                    result = orig_detection_fire(*args, **kwargs)
                    fired0 = _arg_value(args, kwargs, 0, "fired0", False)
                    fired1 = _arg_value(args, kwargs, 1, "fired1", False)
                    _det_dc_detection_fire(fired0, fired1, "det_fire:confirmed")
                    return result

                scope._mark_web_detection_fire = _mark_web_detection_fire_with_dc

            def _set_det_gpio_with_dc_profile(a_on: bool, b_on: bool, *args: Any, **kwargs: Any):
                result = orig_set_det_gpio(a_on, b_on, *args, **kwargs)
                if not _det_dc_dynamic_profiles_enabled():
                    return result
                if _det_dc_selected_active():
                    active = bool(a_on) or bool(b_on)
                    if active:
                        _det_dc_detection_fire(a_on, b_on, "det_output:detection")
                        return result
                    if _det_dc_startup_active():
                        return result
                    desired = str(getattr(scope, "_host_dc_desired_profile", "") or "")
                    if desired == "acquisition":
                        return result
                    if desired == "detection":
                        delay_s = _det_dc_restore_delay("BMI30_DC_DETECTION_RESTORE_DELAY_S", 0.2)
                        _det_dc_schedule_work_restore("det_output:restore_work", delay_s, desired_now=True)
                    else:
                        _det_dc_set_desired("work")
                        _det_dc_apply_profile("work", "det_output:work")
                return result

            scope._set_det_gpio = _set_det_gpio_with_dc_profile
        except Exception as exc:
            print(f"[DC] detector profile hook failed: {exc}", flush=True)
        _call_later_s(0.7, lambda: _schedule_mode5_startup_dc("initial_mode_5", 0))
        _call_later_s(0.7, lambda: _schedule_default_dc_apply("initial_mode_6plus", 0))
        _call_later_s(2.5, lambda: _schedule_default_dc_apply("initial_mode_settle", 0))
        _call_later_s(_dc_verify_interval_s(), _periodic_dc_verify)
    except Exception as exc:
        print(f"[DC] mode restore hook failed: {exc}", flush=True)
    try:
        scope.win.hide()
        scope.win.setWindowTitle(f"BMI30 core service {SERVICE_VERSION}")
    except Exception:
        pass
    global API
    API = ScopeApi(scope, engine.QtCore)
    server = start_http_server()
    try:
        _call_qt_later_s(0.02, scope._run_deferred_autostart)
    except Exception:
        scope._run_deferred_autostart()
    app = engine.QtWidgets.QApplication.instance()
    try:
        if hasattr(app, "exec_"):
            app.exec_()
        else:
            app.exec()
    finally:
        try:
            server.shutdown()
        except Exception:
            pass
        try:
            scope._rt_detector_process_stop()
        except Exception:
            pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
