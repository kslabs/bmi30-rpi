                "det_effective_ratio0": float(getattr(scope, "_det_ratio", 2.0) or 2.0),
                "det_effective_ratio1": float(getattr(scope, "_det_ratio", 2.0) or 2.0),
                "det_threshold_auto0": False,
                "det_threshold_auto1": False,
            }
        try:
            det_flash_t0 = float(getattr(scope, "_web_det_flash_t0", 0.0) or 0.0)
        except Exception:
            det_flash_t0 = 0.0
        try:
            det_flash_t1 = float(getattr(scope, "_web_det_flash_t1", 0.0) or 0.0)
