                data_lock.acquire()
            base_len = int(getattr(scope, "base_buf_len", 0) or 0)
            frame_ts = float(getattr(scope, "last_frame_t", 0.0) or 0.0)
            seq0_even = getattr(scope, "seq0_even", None)
            seq0_odd = getattr(scope, "seq0_odd", None)
