    @staticmethod
    def _frame_values(scope: Any, name: str, n: int, step: int) -> np.ndarray:
        arr = getattr(scope, name, None)
        if arr is None:
            return np.zeros(0, dtype=np.float64)
        vals = np.asarray(arr[:n:step], dtype=np.float64)
        vals = np.nan_to_num(vals, nan=0.0, posinf=0.0, neginf=0.0)
        if name.startswith("_xcorr_saved_prod") and bool(getattr(scope, "xcorr_norm_enabled", False)):
            if vals.size <= 0:
                return vals
            lo = float(np.min(vals))
            hi = float(np.max(vals))
            span = hi - lo
            if not np.isfinite(span) or span <= 1e-12:
                return np.full(vals.shape, 32767.0, dtype=np.float64)
            vals = (vals - lo) * (65535.0 / span)
        return np.clip(vals, 0.0, 65535.0)

    @staticmethod
    def _frame_norm_stats(scope: Any, name: str, n: int, step: int) -> dict[str, Any] | None:
        if not bool(getattr(scope, "xcorr_norm_enabled", False)):
            return None
        arr = getattr(scope, name, None)
        if arr is None:
            return None
        try:
            vals = np.asarray(arr[:n:step], dtype=np.float64)
            vals = np.nan_to_num(vals, nan=0.0, posinf=0.0, neginf=0.0)
            if vals.size <= 0:
                return None
            lo = float(np.min(vals))
            hi = float(np.max(vals))
            span = hi - lo
            if not np.isfinite(span) or span <= 1e-12:
                scale = 0.0
            else:
                scale = float(65535.0 / span)
            try:
                source = str(getattr(scope, "_det_last_source", getattr(scope, "_det_source", "prod")) or "prod").strip().lower()
            except Exception:
                source = "prod"
            if source == "norm":
                det_mul = float(65535.0 / ((32768.0 * 32768.0) + 1e-12))
                det_unit = "norm"
            else:
                try:
                    level_scale = float(getattr(scope, "_det_last_level_scale", 0.0) or 0.0)
                except Exception:
                    level_scale = 0.0
                if level_scale <= 0.0:
                    try:
                        level_scale = float(os.getenv("BMI30_DETECT_LEVEL_SCALE", "") or 0.0)
                    except Exception:
                        level_scale = 0.0
                if level_scale <= 0.0:
                    try:
                        level_scale = float(os.getenv("BMI30_PROD_SCALE", "100") or 100.0)
                    except Exception:
                        level_scale = 100.0
                if not np.isfinite(level_scale) or level_scale <= 0.0:
                    level_scale = 100.0
                det_mul = float(1.0 / level_scale)
                det_unit = f"raw/{level_scale:g}"
            det_min = lo * det_mul
            det_max = hi * det_mul
            det_span = span * det_mul
            screen_per_det = float(65535.0 / det_span) if np.isfinite(det_span) and det_span > 1e-12 else 0.0
            try:
                display_scale = float(os.getenv("BMI30_PROD_SCALE", "100") or 100.0)
            except Exception:
                display_scale = 100.0
            if not np.isfinite(display_scale) or display_scale <= 0.0:
                display_scale = 100.0
            display_vals = np.clip((vals / display_scale) + 32767.0, 0.0, 65535.0)
            display_min = float(np.min(display_vals))
            display_max = float(np.max(display_vals))
            display_span = float(display_max - display_min)
            return {
                "min": lo,
                "max": hi,
                "span": float(span),
                "scale": scale,
                "det_min": float(det_min),
                "det_max": float(det_max),
                "det_span": float(det_span),
                "screen_per_det": screen_per_det,
                "det_unit": det_unit,
                "display_min": display_min,
                "display_max": display_max,
                "display_span": display_span,
                "display_scale": float(display_scale),
            }
        except Exception:
            return None

    def frame(self, max_points: int = 600) -> dict[str, Any]:
        scope = self.scope
        max_points = max(16, min(4096, int(max_points)))
        try:
            selected_mode = int(scope.num_group.checkedId())
        except Exception:
            selected_mode = 0
        show_product = bool(selected_mode >= 6)
        data_lock = getattr(scope, "data_lock", None)
        try:
            if data_lock is not None:
                data_lock.acquire()
            n = int(getattr(scope, "base_buf_len", 0) or 0)
            if n <= 0:
                return {"ok": True, "available": False, "base_buf_len": 0}
            n = min(n, int(getattr(scope, "max_samples", n) or n))
            step = max(1, int(np.ceil(float(n) / float(max_points))))

            def _arr(name: str) -> list[int]:
                try:
                    vals = self._frame_values(scope, name, n, step)
                    return vals.astype(np.uint16).astype(int).tolist()
                except Exception:
                    return []

            x = list(range(0, n, step))
            return {
                "ok": True,
                "available": True,
                "base_buf_len": n,
                "step": step,
                "x": x,
                "data0_even": _arr("data0_even"),
                "data0_odd": _arr("data0_odd"),
                "prod0": _arr("_xcorr_saved_prod0") if show_product else [],
                "prod_norm0": self._frame_norm_stats(scope, "_xcorr_saved_prod0", n, step) if show_product else None,
                "data1_even": _arr("data1_even"),
                "data1_odd": _arr("data1_odd"),
                "prod1": _arr("_xcorr_saved_prod1") if show_product else [],
                "prod_norm1": self._frame_norm_stats(scope, "_xcorr_saved_prod1", n, step) if show_product else None,
                "last_frame_t": float(getattr(scope, "last_frame_t", 0.0) or 0.0),
            }
        finally:
            try:
                if data_lock is not None:
                    data_lock.release()
            except Exception:
                pass

    def frame_binary(self, max_points: int = 600, channels: str = "both", since: float = 0.0) -> bytes:
        scope = self.scope
        max_points = max(16, min(4096, int(max_points)))
        channels = str(channels or "both").strip().lower()
        want_upper = channels not in {"lower", "l", "1", "adc1", "ch1"}
        want_lower = channels not in {"upper", "u", "0", "adc0", "ch0"}
        try:
            selected_mode = int(scope.num_group.checkedId())
        except Exception:
            selected_mode = 0
        show_product = bool(selected_mode >= 6)
        data_lock = getattr(scope, "data_lock", None)
        arrays: list[tuple[str, bytes]] = []
        try:
            if data_lock is not None:
                data_lock.acquire()
            n = int(getattr(scope, "base_buf_len", 0) or 0)
            frame_ts = float(getattr(scope, "last_frame_t", 0.0) or 0.0)
            if n <= 0:
                header = {"ok": True, "available": False, "base_buf_len": 0}
                return self._pack_frame_binary(header, arrays)
            if frame_ts > 0.0 and float(since or 0.0) >= frame_ts:
                header = {"ok": True, "available": False, "not_modified": True, "last_frame_t": frame_ts}
                return self._pack_frame_binary(header, arrays)
            n = min(n, int(getattr(scope, "max_samples", n) or n))
            step = max(1, int(np.ceil(float(n) / float(max_points))))
            count = int(len(range(0, n, step)))

            def _arr_bytes(name: str) -> bytes:
                try:
                    vals = self._frame_values(scope, name, n, step).astype(np.dtype("<u2"))
                    return vals.tobytes(order="C")
                except Exception:
                    return b""

            if want_upper:
                arrays.append(("data0_even", _arr_bytes("data0_even")))
                arrays.append(("data0_odd", _arr_bytes("data0_odd")))
                if show_product:
                    arrays.append(("prod0", _arr_bytes("_xcorr_saved_prod0")))
            if want_lower:
                arrays.append(("data1_even", _arr_bytes("data1_even")))
                arrays.append(("data1_odd", _arr_bytes("data1_odd")))
                if show_product:
                    arrays.append(("prod1", _arr_bytes("_xcorr_saved_prod1")))
            header = {
                "ok": True,
                "available": True,
                "base_buf_len": n,
                "step": step,
                "count": count,
                "arrays": [name for name, payload in arrays if payload],
                "prod_norm0": self._frame_norm_stats(scope, "_xcorr_saved_prod0", n, step) if show_product and want_upper else None,
                "prod_norm1": self._frame_norm_stats(scope, "_xcorr_saved_prod1", n, step) if show_product and want_lower else None,
                "last_frame_t": frame_ts,
            }
            arrays = [(name, payload) for name, payload in arrays if payload]
            return self._pack_frame_binary(header, arrays)
        finally:
            try:
                if data_lock is not None:
                    data_lock.release()
            except Exception:
                pass

    @staticmethod
    def _pack_frame_binary(header: dict[str, Any], arrays: list[tuple[str, bytes]]) -> bytes:
        header_bytes = json.dumps(_json_safe(header), ensure_ascii=False, separators=(",", ":")).encode("utf-8")
        pad = b"\0" if (len(header_bytes) % 2) else b""
        return b"BMF1" + len(header_bytes).to_bytes(4, "little") + header_bytes + pad + b"".join(payload for _name, payload in arrays)


START_T = time.time()
API: ScopeApi | None = None


def _send_json(handler: BaseHTTPRequestHandler, payload: dict[str, Any], status: HTTPStatus = HTTPStatus.OK) -> None:
    data = json.dumps(_json_safe(payload), ensure_ascii=False, separators=(",", ":")).encode("utf-8")
    handler.send_response(status)
    handler.send_header("Content-Type", "application/json; charset=utf-8")
    handler.send_header("Cache-Control", "no-store")
    handler.send_header("Content-Length", str(len(data)))
    handler.end_headers()
    handler.wfile.write(data)


def _send_binary(handler: BaseHTTPRequestHandler, data: bytes, content_type: str = "application/octet-stream", status: HTTPStatus = HTTPStatus.OK) -> None:
    handler.send_response(status)
    handler.send_header("Content-Type", content_type)
    handler.send_header("Cache-Control", "no-store")
    handler.send_header("Content-Length", str(len(data)))
    handler.end_headers()
    handler.wfile.write(data)


class ServiceHandler(BaseHTTPRequestHandler):
    server_version = "BMI30CoreService/001"

    def log_message(self, fmt: str, *args: Any) -> None:
        if os.getenv("BMI30_SERVICE_HTTP_LOG", "0").lower() in {"1", "true", "yes", "on"}:
            super().log_message(fmt, *args)

    def do_GET(self) -> None:
        parsed = urlparse(self.path)
        api = API
        if api is None:
            _send_json(self, {"ok": False, "error": "service not ready"}, HTTPStatus.SERVICE_UNAVAILABLE)
            return
        if parsed.path in {"/", "/index.html"}:
            html = SERVICE_HTML.encode("utf-8")
            self.send_response(HTTPStatus.OK)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(html)))
            self.end_headers()
            self.wfile.write(html)
            return
        if parsed.path in {"/health", "/api/health"}:
            _send_json(self, {"ok": True, "service": "BMI30", "version": SERVICE_VERSION})
            return
        if parsed.path == "/api/status":
            _send_json(self, api.status())
            return
        if parsed.path == "/api/dc-config":
            _send_json(self, api.submit("read_dc_config", {}, timeout=3.0))
            return
        if parsed.path == "/api/frame":
            query = parse_qs(parsed.query)
            max_points = int((query.get("max_points") or ["600"])[0])
            _send_json(self, api.frame(max_points=max_points))
            return
        if parsed.path == "/api/frame.bin":
            query = parse_qs(parsed.query)
            max_points = int((query.get("max_points") or ["600"])[0])
            channels = (query.get("channels") or ["both"])[0]
            try:
                since = float((query.get("since") or ["0"])[0] or 0.0)
            except Exception:
                since = 0.0
            _send_binary(self, api.frame_binary(max_points=max_points, channels=channels, since=since))
            return
        _send_json(self, {"ok": False, "error": "not found"}, HTTPStatus.NOT_FOUND)

    def do_POST(self) -> None:
        parsed = urlparse(self.path)
        api = API
        if api is None:
            _send_json(self, {"ok": False, "error": "service not ready"}, HTTPStatus.SERVICE_UNAVAILABLE)
            return
        if parsed.path != "/api/command":
            _send_json(self, {"ok": False, "error": "not found"}, HTTPStatus.NOT_FOUND)
            return
        try:
            length = int(self.headers.get("Content-Length", "0") or "0")
            raw = self.rfile.read(min(length, 1024 * 1024))
            payload = json.loads(raw.decode("utf-8") or "{}") if raw else {}
            if not isinstance(payload, dict):
                raise ValueError("JSON object expected")
            action = str(payload.get("action") or "")
            params = payload.get("params")
            if not isinstance(params, dict):
                params = {k: v for k, v in payload.items() if k not in {"action", "params"}}
            if not action:
                raise ValueError("missing action")
            _send_json(self, api.submit(action, params))
        except Exception as exc:
            _send_json(self, {"ok": False, "error": str(exc)}, HTTPStatus.BAD_REQUEST)


