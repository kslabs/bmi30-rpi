def _int_env(name: str, default: int) -> int:
    try:
        return int(os.getenv(name, str(default)))
    except Exception:
        return int(default)


def _api_bool(value: Any, default: bool = False) -> bool:
    if value is None:
        return bool(default)
    if isinstance(value, bool):
        return bool(value)
    if isinstance(value, (int, float)):
        return bool(value)
    try:
        text = str(value).strip().lower()
    except Exception:
        return bool(default)
    if text in {"1", "true", "yes", "on", "y", "t"}:
        return True
    if text in {"0", "false", "no", "off", "n", "f"}:
        return False
    return bool(default)


def _dc_seconds_from_ms(raw: dict[str, Any], key: str, default: float = 0.0) -> float:
    try:
        return max(0.0, float(int(raw.get(key, int(default * 1000.0)) or 0)) / 1000.0)
    except Exception:
        return float(default)


def _dc_config_from_device(raw: Any) -> dict[str, Any]:
    if not isinstance(raw, dict):
        return {"available": False, "source": "device", "raw": raw}
    if "work_settle_ms" not in raw or "detect_settle_ms" not in raw:
        return {"available": False, "source": "device", "raw": raw}
    try:
        mode_value = int(raw.get("mode", 1) or 1)
    except Exception:
        mode_value = 1
    detect_s = _dc_seconds_from_ms(raw, "detect_settle_ms", 60.0)
    return {
        "available": True,
        "source": "device",
        "version": int(raw.get("version", 0) or 0),
        "mode": DC_MODE_NAMES.get(mode_value, "WORK"),
        "mode_value": mode_value,
        "flags": int(raw.get("flags", 0) or 0),
        "work_settle_s": _dc_seconds_from_ms(raw, "work_settle_ms", 900.0),
        "detect_settle_s": detect_s,
        "detect_initial_settle_s": detect_s,
        "detect_final_settle_s": detect_s,
        "detect_ramp_s": 0.0,
        "fast_settle_s": _dc_seconds_from_ms(raw, "fast_settle_ms", 5.0),
        "fast_duration_s": _dc_seconds_from_ms(raw, "fast_duration_ms", 30.0),
        "active_settle_s": _dc_seconds_from_ms(raw, "active_settle_ms", 0.0),
        "mode_enter_ms": int(raw.get("mode_enter_ms", 0) or 0),
        "fast_until_ms": int(raw.get("fast_until_ms", 0) or 0),
        "adapt_updates": int(raw.get("adapt_updates", 0) or 0),
        "dirty": bool(raw.get("dirty", False)),
        "raw": raw,
    }


def _working_window_snapshot(scope: Any, base_len: int, selected_mode: int) -> dict[str, Any]:
    default_start = _int_env("BMI30_WORK_WINDOW_START", _int_env("BMI30_ROI_START", 280))
    default_len = _int_env("BMI30_WORK_WINDOW_LEN", _int_env("BMI30_ROI_LEN", 200))
    length = max(1, int(default_len))
    start = max(0, int(default_start))
    try:
        candidate = int(getattr(scope, "working_window_start"))
        if candidate >= 0:
            start = candidate
    except Exception:
        pass
    if base_len > 0:
        length = min(length, base_len)
        start = min(start, max(0, base_len - length))
    end = start + length
    return {
        "enabled": bool(int(selected_mode) in (1, 2, 3) and base_len > length),
        "start": start,
        "end": end,
        "length": length,
    }


class ScopeApi:
    def __init__(self, scope: Any, qtcore: Any):
        self.scope = scope
        self.qtcore = qtcore
        self.last_run_mode = 3
        self._restore_tim2_after_stop = False
        self._restore_tim2_valid = False
        try:
            selected = int(scope.num_group.checkedId())
            if 1 <= selected <= 7:
                self.last_run_mode = selected
        except Exception:
            pass
        self.commands: "queue.Queue[dict[str, Any]]" = queue.Queue()
        self._timer = qtcore.QTimer()
        self._timer.setInterval(40)
        self._timer.timeout.connect(self._drain_commands)
        self._timer.start()

    def submit(self, action: str, params: dict[str, Any] | None = None, timeout: float = 8.0) -> dict[str, Any]:
        item: dict[str, Any] = {
            "action": str(action),
            "params": dict(params or {}),
            "event": threading.Event(),
            "result": None,
        }
        self.commands.put(item)
        if not item["event"].wait(max(0.1, float(timeout))):
            return {"ok": False, "error": "command timeout", "action": action}
        result = item.get("result")
        if isinstance(result, dict):
            return result
        return {"ok": False, "error": "empty command result", "action": action}

    def _drain_commands(self) -> None:
        while True:
            try:
                item = self.commands.get_nowait()
            except queue.Empty:
                return
            try:
                item["result"] = self._execute(str(item.get("action") or ""), dict(item.get("params") or {}))
            except Exception as exc:
                item["result"] = {"ok": False, "error": str(exc), "trace": traceback.format_exc(limit=5)}
            finally:
                try:
                    item["event"].set()
                except Exception:
                    pass

    def _set_tim2_desired(self, enabled: bool) -> None:
        scope = self.scope
        enabled = bool(enabled)
        try:
            scope.tim2_enabled = enabled
        except Exception:
            pass
        try:
            btn = getattr(scope, "btn_tim2", None)
            if btn is not None:
                try:
                    old_blocked = btn.blockSignals(True)
                except Exception:
                    old_blocked = None
                try:
                    btn.setChecked(enabled)
                finally:
                    try:
                        if old_blocked is not None:
                            btn.blockSignals(old_blocked)
                    except Exception:
                        pass
        except Exception:
            pass
        try:
            scope._update_tim2_btn_style()
        except Exception:
            pass

    def _disable_tim2_for_stop(self) -> None:
        scope = self.scope
        try:
            self._restore_tim2_after_stop = bool(getattr(scope, "tim2_enabled", False))
            self._restore_tim2_valid = True
        except Exception:
            self._restore_tim2_after_stop = False
            self._restore_tim2_valid = True
        self._set_tim2_desired(False)
        try:
            scope.tim2_pending = False
            scope.tim2_applied = False
        except Exception:
            pass
        stream = getattr(scope, "stream", None)
        if stream is not None:
            try:
                scope._send_tim2_enable(False)
            except Exception:
                pass
            try:
                scope._send_tx_enable(False)
            except Exception:
                pass
        try:
            scope._update_tim2_btn_style()
        except Exception:
            pass

    def _restore_tim2_for_start(self) -> None:
        if not self._restore_tim2_valid:
            return
        self._set_tim2_desired(bool(self._restore_tim2_after_stop))
        self._restore_tim2_valid = False

    def _read_dc_config(self) -> dict[str, Any]:
        stream = getattr(self.scope, "stream", None)
        if stream is None:
            raise RuntimeError("stream is not connected")
        if not hasattr(stream, "get_dc_config"):
            raise RuntimeError("stream does not support get_dc_config")
        cfg = _dc_config_from_device(stream.get_dc_config())
        if not bool(cfg.get("available", False)):
            return {"ok": False, "error": "device returned unsupported DC config", "dc_config": cfg}
        return {"ok": True, "dc_config": cfg}

    def _stop_stream_keep_mode(self) -> int:
        scope = self.scope
        try:
            selected = int(scope.num_group.checkedId())
        except Exception:
            selected = int(self.last_run_mode or 3)
        if 1 <= selected <= 7:
            self.last_run_mode = selected
        self._disable_tim2_for_stop()
        if hasattr(scope, "_reset_stream_runtime_state"):
            scope._reset_stream_runtime_state(reason="api_stop_keep_mode")
            try:
                scope._stream_user_stopped = True
            except Exception:
                pass
        else:
            try:
                scope._send_stop_stream()
            except Exception:
                pass
            try:
                stream = getattr(scope, "stream", None)
                if stream is not None:
                    stream.close()
            except Exception:
                pass
            try:
                scope.stream = None
            except Exception:
                pass
        try:
            scope._set_status(f"Stream stopped, mode {selected} preserved", hold_sec=2.0)
        except Exception:
            pass
        return selected

    def _execute(self, action: str, params: dict[str, Any]) -> dict[str, Any]:
        scope = self.scope
        action = action.strip().lower()
        if action in {"mode", "set_mode"}:
            idx = int(params.get("idx", params.get("mode", 0)))
            if idx < 0 or idx > 7:
                raise ValueError("mode must be 0..7")
            if idx > 0:
                self.last_run_mode = idx
            btn = scope.num_group.button(idx)
            if btn is not None:
                btn.setChecked(True)
            scope._num_clicked(idx)
            try:
                scope._on_num_clicked_extra(idx)
            except Exception:
                pass
            return {"ok": True, "mode": idx}
        if action in {"start", "connect"}:
            idx = int(params.get("idx", params.get("mode", self.last_run_mode)))
            if idx < 1 or idx > 7:
                idx = self.last_run_mode if 1 <= int(self.last_run_mode) <= 7 else 3
            self.last_run_mode = idx
            self._restore_tim2_for_start()
            btn = scope.num_group.button(idx)
            if btn is not None:
                btn.setChecked(True)
            scope._num_clicked(idx)
            try:
                scope._on_num_clicked_extra(idx)
            except Exception:
                pass
            return {"ok": True, "action": action, "mode": idx}
        if action in {"stop", "disconnect"}:
            selected = self._stop_stream_keep_mode()
            return {"ok": True, "mode": selected, "stopped": True}
        if action in {"frequency", "freq", "set_freq"}:
            freq = int(params.get("hz", params.get("freq", 200)))
            scope._on_freq_change(f"{freq} Hz")
            try:
                scope.freq_box.setCurrentText(f"{freq} Hz")
            except Exception:
                pass
            return {"ok": True, "freq_hz": freq}
        if action in {"avg", "avg_n", "set_avg"}:
            avg_n = _set_scope_avg_n(scope, params.get("avg_n", params.get("n", 24)))
            scope._on_avg_change(0)
            return {"ok": True, "avg_n": avg_n}
        if action in {"det_ratio", "ratio", "set_det_ratio"}:
            val = float(params.get("value", params.get("ratio", 2.0)))
            if hasattr(scope, "_set_detector_channel_settings"):
                scope._set_detector_channel_settings({"ratio0": val, "ratio1": val})
            else:
                scope._on_det_ratio_change(f"{val:.1f}")
            try:
                scope.det_ratio_box.setCurrentText(f"{val:.1f}")
            except Exception:
                pass
            return {"ok": True, "det_ratio": float(getattr(scope, "_det_ratio", val))}
        if action in {"tag_detection", "detector_settings", "set_detector_settings", "set_tag_detection"}:
            if not hasattr(scope, "_set_detector_channel_settings"):
                raise RuntimeError("engine does not support per-channel detector settings")
            persist = _api_bool(params.get("persist", params.get("save", True)), True)
            snapshot = scope._set_detector_channel_settings(params, persist=persist)
            return {"ok": True, "detector": snapshot, "persisted": persist}
        if action in {"runtime_detector_settings", "runtime_tag_detection", "detector_thresholds", "set_detector_thresholds"}:
            if not hasattr(scope, "_set_detector_channel_settings"):
                raise RuntimeError("engine does not support per-channel detector settings")
            snapshot = scope._set_detector_channel_settings(params, persist=False)
            return {"ok": True, "detector": snapshot, "persisted": False}
        if action in {"tim2", "tx", "set_tim2"}:
            enabled = bool(params.get("enabled", params.get("value", True)))
            self._restore_tim2_valid = False
            try:
                scope.btn_tim2.setChecked(enabled)
            except Exception:
                pass
            scope._on_toggle_tim2(enabled)
            return {"ok": True, "tim2_enabled": enabled}
        if action in {"sound", "set_sound"}:
            enabled = bool(params.get("enabled", params.get("value", True)))
            scope._set_sound_enabled(enabled, reason="api", announce=True)
            return {"ok": True, "sound_enabled": enabled}
        if action in {"normalization", "normalize", "norm", "xcorr_norm"}:
            current = bool(getattr(scope, "xcorr_norm_enabled", False))
            enabled = _api_bool(params.get("enabled", params.get("value", not current)), not current)
            btn = getattr(scope, "btn_diag", None)
            if btn is not None:
                try:
                    btn.blockSignals(True)
                    btn.setChecked(enabled)
                except Exception:
                    pass
                finally:
                    try:
                        btn.blockSignals(False)
                    except Exception:
                        pass
            if hasattr(scope, "_on_toggle_xcorr_norm"):
                scope._on_toggle_xcorr_norm(enabled)
            else:
                scope.xcorr_norm_enabled = enabled
            return {"ok": True, "normalization_enabled": bool(getattr(scope, "xcorr_norm_enabled", enabled))}
        if action in {"optimize", "optimize_signal", "det_optimize"}:
            scope._reset_det_adapt()
            return {"ok": True, "action": action, "mode": int(scope.num_group.checkedId())}
        if action in {"stm32_reset", "reset_stm32", "hardware_reset", "hw_reset"}:
            try:
                selected = int(scope.num_group.checkedId())
            except Exception:
                selected = 0
            if selected == 0 and hasattr(scope, "_hardware_reset_device"):
                ok = bool(scope._hardware_reset_device())
                if ok and hasattr(scope, "_wait_after_usb_reset_for_reconnect"):
                    try:
                        scope._wait_after_usb_reset_for_reconnect("web_stm32_reset")
                    except Exception:
                        pass
                return {"ok": ok, "action": action, "mode": selected, "reset_only": True}
            if hasattr(scope, "_restart_stream"):
                scope._restart_stream(hardware_reset=True, reason="web_stm32_reset")
            else:
                scope._manual_reconnect()
            return {"ok": True, "action": action, "mode": selected}
        if action in {"reconnect", "restart"}:
            scope._manual_reconnect()
            return {"ok": True, "action": action}
        if action in {"reset_detector", "det_reset"}:
            scope._reset_det_adapt()
            return {"ok": True, "action": action}
        if action in {"reset_detector_counts", "det_counts_reset"}:
            channel = str(params.get("channel", "all")).strip().lower()
            reset_upper = channel in {"all", "both", "upper", "u", "0", "adc0", "ch0"}
            reset_lower = channel in {"all", "both", "lower", "l", "1", "adc1", "ch1"}
            if not reset_upper and not reset_lower:
                raise ValueError("channel must be upper, lower, or all")
            if reset_upper:
                scope._web_det_flash_seq0 = 0
                scope._web_det_flash_t0 = 0.0
                scope._web_det_flash_active0 = False
            if reset_lower:
                scope._web_det_flash_seq1 = 0
                scope._web_det_flash_t1 = 0.0
                scope._web_det_flash_active1 = False
            return {
                "ok": True,
                "action": action,
                "fire_seq0": int(getattr(scope, "_web_det_flash_seq0", 0) or 0),
                "fire_seq1": int(getattr(scope, "_web_det_flash_seq1", 0) or 0),
            }
        if action in {"read_dc_config", "get_dc_config", "dc_config_read"}:
            return self._read_dc_config()
        if action == "dc_config":
            stream = getattr(scope, "stream", None)
            if stream is None:
                raise RuntimeError("stream is not connected")
            if not hasattr(stream, "set_dc_config_seconds"):
                raise RuntimeError("stream does not support set_dc_config_seconds")
            stream.set_dc_config_seconds(
                mode=int(params.get("mode", 1)),
                work_settle_s=float(params.get("work_settle_s", 900.0)),
                detect_settle_s=float(params.get("detect_settle_s", params.get("detect_initial_settle_s", 30.0))),
                fast_settle_s=float(params.get("fast_settle_s", 5.0)),
                fast_duration_s=float(params.get("fast_duration_s", 30.0)),
            )
            result: dict[str, Any] = {"ok": True, "action": action}
            try:
                readback = self._read_dc_config()
                if bool(readback.get("ok", False)):
                    result["dc_config"] = readback.get("dc_config")
                else:
                    result["readback_error"] = readback.get("error", "readback failed")
            except Exception as exc:
                result["readback_error"] = str(exc)
            return result
        raise ValueError(f"unknown action: {action}")

    def status(self) -> dict[str, Any]:
        scope = self.scope
        stream = getattr(scope, "stream", None)
        connected = bool(stream is not None and not bool(getattr(stream, "disconnected", False)))
        try:
            selected_mode = int(scope.num_group.checkedId())
        except Exception:
            selected_mode = 0
        try:
            data_lock = getattr(scope, "data_lock", None)
