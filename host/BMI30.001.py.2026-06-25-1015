        det_flash_age0 = (now - det_flash_t0) if det_flash_t0 > 0.0 else None
        det_flash_age1 = (now - det_flash_t1) if det_flash_t1 > 0.0 else None
        det_thr0 = int(getattr(scope, "_det_thr0", 0) or 0)
