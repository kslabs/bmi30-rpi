def _normalize_avg_n(value: Any, default: int = 24) -> int:
    try:
        avg_n = int(value)
    except Exception:
        avg_n = int(default)
    if avg_n in AVG_N_VALUES:
        return avg_n
    return int(default) if int(default) in AVG_N_VALUES else 24


def _load_default_avg_n() -> int:
    try:
        with open(CONFIG_JSON, "r", encoding="utf-8") as f:
            payload = json.load(f) or {}
    except Exception:
        payload = {}
    if not isinstance(payload, dict):
        payload = {}
    operation = payload.get("operation")
    operation_avg = operation.get("avg_n") if isinstance(operation, dict) else None
    return _normalize_avg_n(payload.get("avg_n", operation_avg), 24)


def _load_default_detector_settings() -> dict[str, Any] | None:
    try:
        with open(CONFIG_JSON, "r", encoding="utf-8") as f:
            payload = json.load(f) or {}
    except Exception:
        payload = {}
    if not isinstance(payload, dict):
        payload = {}
    raw = payload.get("tag_detection")
    source = raw if isinstance(raw, dict) else payload
    if not isinstance(source, dict):
        return None

    def _pick(*names: str) -> Any:
        for name in names:
            if name in source:
                return source.get(name)
        return None

    settings: dict[str, Any] = {}
    mapping = {
        "enabled0": ("enabled0", "upper_enabled", "det_channel_enabled0"),
        "enabled1": ("enabled1", "lower_enabled", "det_channel_enabled1"),
        "confirm0": ("confirm0", "count0", "upper_confirm", "det_confirm_count0"),
        "confirm1": ("confirm1", "count1", "lower_confirm", "det_confirm_count1"),
        "threshold0": ("threshold0", "ratio0", "upper_threshold", "det_ratio0", "det_threshold0"),
        "threshold1": ("threshold1", "ratio1", "lower_threshold", "det_ratio1", "det_threshold1"),
        "auto0": ("auto0", "threshold_auto0", "upper_auto", "det_threshold_auto0"),
        "auto1": ("auto1", "threshold_auto1", "lower_auto", "det_threshold_auto1"),
        "noise_up0": ("noise_up0", "upper_noise_up", "det_noise_up0", "det_step_idle_up0"),
        "noise_up1": ("noise_up1", "lower_noise_up", "det_noise_up1", "det_step_idle_up1"),
        "noise_down0": ("noise_down0", "upper_noise_down", "det_noise_down0", "det_step_idle_down0"),
        "noise_down1": ("noise_down1", "lower_noise_down", "det_noise_down1", "det_step_idle_down1"),
        "noise_unit0": ("noise_unit0", "upper_noise_unit", "det_noise_unit0", "det_step_idle_unit0"),
        "noise_unit1": ("noise_unit1", "lower_noise_unit", "det_noise_unit1", "det_step_idle_unit1"),
    }
    for target, names in mapping.items():
        val = _pick(*names)
        if val is not None:
            settings[target] = val
    return settings or None


def _sync_role_from_lcd_code(code: str) -> str:
    code = str(code or "").strip().upper()
    if code.startswith("M"):
        return "master"
    if code.startswith("S"):
        return "slave"
    return ""


def _sync_code_from_payload(sync: dict[str, Any]) -> str:
    for key in ("code", "lcd_code"):
        code = str(sync.get(key) or "").strip().upper()
        if _LCD_SYNC_CODE_RE.fullmatch(code):
            return code

    display_char = str(sync.get("display_char") or "").strip().upper()
    display_value = sync.get("display_value")
    if display_char:
        try:
            code = f"{display_char}{int(display_value):02d}"
        except Exception:
            code = display_char
        if _LCD_SYNC_CODE_RE.fullmatch(code):
            return code
    return ""


def _read_device_state_cache() -> dict[str, Any]:
    try:
        with open(DEVICE_STATE_JSON, "r", encoding="utf-8") as f:
            payload = json.load(f)
    except Exception:
        return {}
    if not isinstance(payload, dict):
        return {}
    try:
        ts = float(payload.get("updated_at", payload.get("cache_written_at", 0.0)) or 0.0)
    except Exception:
        ts = 0.0
    if ts <= 0.0 or (time.time() - ts) > DEVICE_STATE_MAX_AGE_S:
        return {}
    return payload


def _sync_status_snapshot() -> dict[str, Any]:
    cache = _read_device_state_cache()
    sync = cache.get("sync") if isinstance(cache.get("sync"), dict) else {}
    events = cache.get("events") if isinstance(cache.get("events"), dict) else {}
    if not sync and isinstance(events.get("sync_state"), dict):
        sync = events["sync_state"]
    if not isinstance(sync, dict) or not sync:
        return {"value": "---", "code": "", "source": "event-cache", "device_responded": False}

    value = str(sync.get("role") or "").strip().lower()
    code = _sync_code_from_payload(sync)
    role_from_code = _sync_role_from_lcd_code(code)
    if role_from_code:
        value = role_from_code
    if not value or value == "---":
        try:
            value = {0: "master", 1: "slave", 2: "off"}.get(int(sync.get("raw_mode")), "---")
        except Exception:
            value = "---"
    return {"value": value or "---", "code": code, "source": "event-cache", "device_responded": True}


def _set_scope_avg_n(scope: Any, avg_n: int) -> int:
    avg_n = _normalize_avg_n(avg_n, 24)
    try:
        scope.avg_n = avg_n
    except Exception:
        pass
    box = getattr(scope, "avg_box", None)
    if box is not None:
        try:
            box.blockSignals(True)
        except Exception:
            pass
        try:
            if hasattr(box, "findText") and box.findText(str(avg_n)) < 0:
                box.addItem(str(avg_n))
            box.setCurrentText(str(avg_n))
        except Exception:
            pass
        try:
            box.blockSignals(False)
        except Exception:
            pass
    return avg_n


def _apply_default_avg_n(scope: Any) -> int:
    return _set_scope_avg_n(scope, _load_default_avg_n())


def _apply_default_detector_settings(scope: Any) -> dict[str, Any] | None:
    settings = _load_default_detector_settings()
    if not settings or not hasattr(scope, "_set_detector_channel_settings"):
        return None
    try:
        return scope._set_detector_channel_settings(settings, persist=False)
    except TypeError:
        return scope._set_detector_channel_settings(settings)
    except Exception:
        traceback.print_exc()
        return None


def _install_detector_flash_hooks(scope: Any) -> None:
    if bool(getattr(scope, "_web_det_flash_hooks", False)):
        return
    try:
        scope._web_det_flash_t0 = float(getattr(scope, "_web_det_flash_t0", 0.0) or 0.0)
        scope._web_det_flash_t1 = float(getattr(scope, "_web_det_flash_t1", 0.0) or 0.0)
        scope._web_det_flash_seq0 = int(getattr(scope, "_web_det_flash_seq0", 0) or 0)
        scope._web_det_flash_seq1 = int(getattr(scope, "_web_det_flash_seq1", 0) or 0)
        scope._web_det_flash_active0 = bool(getattr(scope, "_web_det_flash_active0", False))
        scope._web_det_flash_active1 = bool(getattr(scope, "_web_det_flash_active1", False))

        def _fired_arg(args: tuple[Any, ...], kwargs: dict[str, Any], index: int, name: str) -> bool:
            if name in kwargs:
                return bool(kwargs.get(name))
            if len(args) > index:
                return bool(args[index])
            return False

        def _mark(fired0: bool, fired1: bool) -> None:
            now = time.time()
            if fired0:
                if not bool(getattr(scope, "_web_det_flash_active0", False)):
                    scope._web_det_flash_t0 = now
                    scope._web_det_flash_seq0 = int(getattr(scope, "_web_det_flash_seq0", 0) or 0) + 1
                scope._web_det_flash_active0 = True
            if fired1:
                if not bool(getattr(scope, "_web_det_flash_active1", False)):
                    scope._web_det_flash_t1 = now
                    scope._web_det_flash_seq1 = int(getattr(scope, "_web_det_flash_seq1", 0) or 0) + 1
                scope._web_det_flash_active1 = True

        orig_fire_beep = getattr(scope, "_fire_beep", None)
        if callable(orig_fire_beep):
            def _fire_beep_wrapped(*args: Any, **kwargs: Any) -> Any:
                _mark(_fired_arg(args, kwargs, 0, "fired0"), _fired_arg(args, kwargs, 1, "fired1"))
                return orig_fire_beep(*args, **kwargs)

            scope._fire_beep = _fire_beep_wrapped

        orig_hold_start = getattr(scope, "_beep_hold_start", None)
        if callable(orig_hold_start):
            def _beep_hold_start_wrapped(*args: Any, **kwargs: Any) -> Any:
                _mark(_fired_arg(args, kwargs, 0, "fired0"), _fired_arg(args, kwargs, 1, "fired1"))
                return orig_hold_start(*args, **kwargs)

            scope._beep_hold_start = _beep_hold_start_wrapped

        scope._web_det_flash_hooks = True
    except Exception:
        traceback.print_exc()


def _load_engine_module(path: Path):
    path = path.resolve()
    if not path.exists():
        raise FileNotFoundError(f"BMI30 engine source not found: {path}")
    if str(path.parent) not in sys.path:
        sys.path.insert(0, str(path.parent))
    loader = SourceFileLoader("bmi30_engine_current", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise RuntimeError(f"Cannot load BMI30 engine source: {path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[loader.name] = module
    loader.exec_module(module)
    return module


def _json_safe(value: Any) -> Any:
    if isinstance(value, (np.integer,)):
        return int(value)
    if isinstance(value, (np.floating,)):
        return float(value)
    if isinstance(value, (np.bool_,)):
        return bool(value)
    if isinstance(value, dict):
        return {str(k): _json_safe(v) for k, v in value.items()}
    if isinstance(value, (list, tuple)):
        return [_json_safe(v) for v in value]
    return value


