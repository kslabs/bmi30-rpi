	def _find_cdc_port(self):
		ports = sorted(glob.glob('/dev/ttyACM*'))
		if not ports:
			return None
		return ports[0]

	def _send_soft_reset_via_cdc(self):
		try:
			port = self._find_cdc_port()
			if port is None:
				print("[RESET] CDC порт не найден, пропускаем SOFT_RESET")
				return False
			with serial.Serial(port, 115200, timeout=0.2, write_timeout=0.2) as ser:
				try:
					self._remember_command(CMD_SOFT_RESET, b"", "SOFT_RESET_CDC")
				except Exception:
					pass
				ser.write(bytes([CMD_SOFT_RESET]))
				time.sleep(0.1)
				print("[RESET] SOFT_RESET sent via CDC")
				return True
		except Exception as e:
			print(f"[RESET] SOFT_RESET via CDC failed: {e}")
			return False

	def _send_deep_reset_ep0_direct(self) -> bool:
		"""Send DEEP_RESET over EP0 without relying on an already-open USBStream."""
		try:
			import usb.core  # type: ignore
			import usb.util  # type: ignore
		except Exception as e:
			print(f"[RESET] direct EP0 unavailable: {e}", flush=True)
			return False
		dev = None
		try:
			dev = usb.core.find(idVendor=0xCAFE, idProduct=0x4001)
			if dev is None:
				print("[RESET] direct EP0 device not found, пропускаем DEEP_RESET", flush=True)
				return False
			try:
				self._remember_command(CMD_DEEP_RESET, b"", "DEEP_RESET_EP0_DIRECT")
			except Exception:
				pass
			dev.ctrl_transfer(0x40, CMD_DEEP_RESET, 0, 0, None, timeout=800)
			time.sleep(0.1)
			print("[RESET] DEEP_RESET sent via direct EP0", flush=True)
			return True
		except Exception as e:
			print(f"[RESET] DEEP_RESET direct EP0 failed: {e}", flush=True)
			return False
		finally:
			try:
				if dev is not None:
					usb.util.dispose_resources(dev)
			except Exception:
				pass

	def _wait_device_ready_ep0_direct(self, timeout_s: float = 3.0, poll_s: float = 0.05) -> tuple[bool, str]:
		"""Poll direct EP0 GET_STATUS after reset; return as soon as the device answers."""
		try:
			import usb.core  # type: ignore
			import usb.util  # type: ignore
		except Exception as e:
			return False, f"usb import unavailable: {e}"
		try:
			timeout_s = max(0.1, float(timeout_s))
		except Exception:
			timeout_s = 3.0
		try:
			poll_s = max(0.01, min(0.5, float(poll_s)))
		except Exception:
			poll_s = 0.05
		deadline = time.time() + timeout_s
		last_msg = "not polled"
		attempts = 0
		while time.time() < deadline:
			dev = None
			attempts += 1
			try:
				dev = usb.core.find(idVendor=0xCAFE, idProduct=0x4001)
				if dev is None:
					last_msg = "device not enumerated"
				else:
					try:
						stat_len = max(64, min(192, int(os.getenv("BMI30_STAT_LEN", "136"))))
					except Exception:
						stat_len = 136
					data = dev.ctrl_transfer(0xC0, CMD_GET_STATUS, 0, 0, stat_len, timeout=80)
					bs = bytes(data) if data is not None else b""
					if len(bs) > 0:
						msg = f"ready len={len(bs)} attempts={attempts}"
						print(f"[STARTUP-RESET] EP0 {msg}", flush=True)
						return True, msg
					last_msg = "empty status"
			except Exception as e:
				last_msg = str(e)
			finally:
				try:
					if dev is not None:
						usb.util.dispose_resources(dev)
				except Exception:
					pass
			time.sleep(poll_s)
		msg = f"timeout {timeout_s:g}s, last={last_msg}"
		print(f"[STARTUP-RESET] EP0 wait {msg}", flush=True)
		return False, msg

	def _set_usb_reconnect_backoff(self, delay_s: float, reason: str = ""):
		try:
			delay = max(0.0, min(10.0, float(delay_s)))
		except Exception:
			delay = 0.0
		if delay <= 0.0:
			return
		try:
			until = time.time() + delay
			self._usb_reconnect_not_before_t = max(float(getattr(self, '_usb_reconnect_not_before_t', 0.0) or 0.0), until)
			if bool(getattr(self, 'debug', False)):
				print(f"[USB-RECOVERY] reconnect backoff {delay:.2f}s reason={reason}", flush=True)
		except Exception:
			pass

	def _wait_after_usb_reset_for_reconnect(self, reason: str = "") -> bool:
		try:
			timeout_s = float(os.getenv("BMI30_RECOVERY_READY_TIMEOUT_S", "3.0"))
		except Exception:
			timeout_s = 3.0
		try:
			poll_s = float(os.getenv("BMI30_RECOVERY_READY_POLL_S", "0.05"))
		except Exception:
			poll_s = 0.05
		ready_ok, ready_msg = self._wait_device_ready_ep0_direct(timeout_s=timeout_s, poll_s=poll_s)
		try:
			settle_s = float(os.getenv("BMI30_RECONNECT_SETTLE_S", "0.35" if ready_ok else "1.2"))
		except Exception:
			settle_s = 0.35 if ready_ok else 1.2
		self._set_usb_reconnect_backoff(settle_s, reason or ready_msg)
		try:
			self._fault_log_line(
				f"[recovery] ts={self._fault_timestamp()} action=wait_usb_ready "
				f"reason={reason} ok={int(bool(ready_ok))} msg={ready_msg}"
			)
		except Exception:
			pass
		return bool(ready_ok)

	def _soft_recover_stm32_stream(self, reason: str = "stream_fault") -> dict:
		"""Recover STM32 USB TX without GPIO power/reset.

		Device guidance: for stm32_tx_stalled/stm32_adc_stalled keep the last
		200-sample configuration, log STAT/commands, then use soft recovery.
		GPIO/hard reset is reserved for the last rung.
		"""
		results = {}
		try:
			reason_s = str(reason or "stream_fault")
		except Exception:
			reason_s = "stream_fault"
		try:
			print(f"[SOFT-RECOVERY] begin reason={reason_s}", flush=True)
		except Exception:
			pass
		try:
			self._set_status(f"Soft recovery STM32 USB TX… ({reason_s})", hold_sec=1.5)
		except Exception:
			pass
		try:
			min_s = float(os.getenv("BMI30_SOFT_RECOVERY_MIN_INTERVAL_S", "1.0"))
		except Exception:
			min_s = 1.0
		try:
			last_t = float(getattr(self, "_soft_recovery_last_t", 0.0) or 0.0)
		except Exception:
			last_t = 0.0
		now = time.time()
		if min_s > 0.0 and last_t > 0.0 and (now - last_t) < min_s:
			try:
				delay = max(0.2, min_s - (now - last_t))
				self._set_usb_reconnect_backoff(delay, f"soft_recovery_cooldown:{reason_s}")
			except Exception:
				pass
			results["cooldown"] = True
			return results
		self._soft_recovery_last_t = now
		try:
			mode = str(os.getenv("BMI30_STM32_SOFT_RECOVERY_MODE", "ep0_deep")).strip().lower()
		except Exception:
			mode = "ep0_deep"
		if mode in ("0", "off", "none", "no", "false", "reopen_only"):
			results["skipped"] = True
			try:
				self._set_usb_reconnect_backoff(float(os.getenv("BMI30_RECONNECT_SETTLE_S", "0.35")), f"soft_recovery_skipped:{reason_s}")
			except Exception:
				pass
			return results
		deep_ok = False
		if mode in ("ep0", "ep0_deep", "deep", "deep_first", "both"):
			try:
				if self.stream is not None and hasattr(self.stream, "deep_reset"):
					try:
						self._remember_command(CMD_DEEP_RESET, b"", "DEEP_RESET_EP0_SOFT_RECOVERY")
					except Exception:
						pass
					self.stream.deep_reset()
					time.sleep(0.08)
					deep_ok = True
					print("[SOFT-RECOVERY] ep0_deep via stream=OK", flush=True)
			except Exception as e:
				print(f"[SOFT-RECOVERY] ep0_deep via stream failed: {e}", flush=True)
			if not deep_ok:
				try:
					deep_ok = bool(self._send_deep_reset_ep0_direct())
				except Exception as e:
					deep_ok = False
					print(f"[SOFT-RECOVERY] ep0_deep direct exception: {e}", flush=True)
		results["ep0_deep"] = bool(deep_ok)
		cdc_ok = False
		if (not deep_ok) or mode in ("cdc", "cdc_soft", "soft", "both"):
			try:
				cdc_ok = bool(self._send_soft_reset_via_cdc())
			except Exception as e:
				cdc_ok = False
				print(f"[SOFT-RECOVERY] cdc_soft exception: {e}", flush=True)
		results["cdc_soft"] = bool(cdc_ok)
		if deep_ok or cdc_ok:
			try:
				self._usb_last_reset_t = time.time()
			except Exception:
				pass
			try:
				results["ready_after_reset"] = bool(self._wait_after_usb_reset_for_reconnect(f"soft_recovery:{reason_s}"))
			except Exception as e:
				results["ready_after_reset"] = False
				print(f"[SOFT-RECOVERY] wait ready exception: {e}", flush=True)
		else:
			try:
				self._set_usb_reconnect_backoff(float(os.getenv("BMI30_RECONNECT_SETTLE_S", "0.35")), f"soft_recovery_no_reset:{reason_s}")
			except Exception:
				pass
		try:
			self._fault_log_line(
				f"[recovery] ts={self._fault_timestamp()} action=soft_recovery_result "
				f"reason={reason_s} ep0_deep={int(bool(deep_ok))} cdc_soft={int(bool(cdc_ok))} "
				f"ready={int(bool(results.get('ready_after_reset', False)))}"
			)
		except Exception:
			pass
		try:
			print(f"[SOFT-RECOVERY] done reason={reason_s} results={results}", flush=True)
		except Exception:
			pass
		return results

	def _reset_device_three_stage(self, reason: str = "manual") -> dict:
		"""Attempt the full recovery chain: CDC soft reset, EP0 deep reset, GPIO hardware reset."""
		results = {}
		try:
			reason_s = str(reason or "manual")
		except Exception:
			reason_s = "manual"
		try:
			print(f"[RESET-3STAGE] begin reason={reason_s}", flush=True)
		except Exception:
			pass
		try:
			self._set_status(f"Сброс устройства 1/3 CDC… ({reason_s})", hold_sec=1.0)
		except Exception:
			pass
		try:
			results["cdc_soft"] = bool(self._send_soft_reset_via_cdc())
		except Exception as e:
			results["cdc_soft"] = False
			print(f"[RESET-3STAGE] stage1 cdc_soft exception: {e}", flush=True)
		try:
			print(f"[RESET-3STAGE] stage1 cdc_soft={'OK' if results.get('cdc_soft') else 'SKIP/FAIL'}", flush=True)
		except Exception:
			pass
		try:
			self._set_status(f"Сброс устройства 2/3 EP0… ({reason_s})", hold_sec=1.0)
		except Exception:
			pass
		deep_ok = False
		try:
			if self.stream is not None and hasattr(self.stream, 'deep_reset'):
				try:
					self._remember_command(CMD_DEEP_RESET, b"", "DEEP_RESET_EP0")
				except Exception:
					pass
				self.stream.deep_reset()
				time.sleep(0.1)
				deep_ok = True
				print("[RESET-3STAGE] stage2 ep0_deep via stream=OK", flush=True)
		except Exception as e:
			print(f"[RESET-3STAGE] stage2 ep0_deep via stream failed: {e}", flush=True)
		if not deep_ok:
			try:
				deep_ok = bool(self._send_deep_reset_ep0_direct())
			except Exception as e:
				deep_ok = False
				print(f"[RESET-3STAGE] stage2 ep0_deep direct exception: {e}", flush=True)
		results["ep0_deep"] = bool(deep_ok)
		try:
			print(f"[RESET-3STAGE] stage2 ep0_deep={'OK' if deep_ok else 'SKIP/FAIL'}", flush=True)
		except Exception:
			pass
		try:
			self._set_status(f"Сброс устройства 3/3 GPIO… ({reason_s})", hold_sec=1.5)
		except Exception:
			pass
		try:
			results["gpio_hard"] = bool(self._hardware_reset_device())
		except Exception as e:
			results["gpio_hard"] = False
			print(f"[RESET-3STAGE] stage3 gpio_hard exception: {e}", flush=True)
		if bool(results.get("gpio_hard")):
			try:
				self._hard_reset_last_t = time.time()
			except Exception:
				pass
		if bool(results.get("gpio_hard")) or bool(results.get("ep0_deep")):
			try:
				self._usb_last_reset_t = time.time()
			except Exception:
				pass
			try:
				results["ready_after_reset"] = bool(self._wait_after_usb_reset_for_reconnect(f"three_stage:{reason_s}"))
			except Exception as e:
				results["ready_after_reset"] = False
				print(f"[RESET-3STAGE] wait ready exception: {e}", flush=True)
		try:
			print(f"[RESET-3STAGE] stage3 gpio_hard={'OK' if results.get('gpio_hard') else 'FAIL'}", flush=True)
			print(f"[RESET-3STAGE] done reason={reason_s} results={results}", flush=True)
		except Exception:
			pass
		return results

	def _hw_reset_release_pins(self, main_pin: int | None = None) -> list[int]:
		pins: list[int] = []
		raw = str(os.getenv("BMI30_HW_RESET_RELEASE_GPIOS", "3,17") or "")
		for part in raw.replace(";", ",").split(","):
			try:
				pin = int(part.strip())
			except Exception:
				continue
			if pin > 0 and pin not in pins:
				pins.append(pin)
		try:
			if main_pin is not None and int(main_pin) > 0 and int(main_pin) not in pins:
				pins.append(int(main_pin))
		except Exception:
			pass
		return pins

	def _release_hw_reset_lines(self, main_pin: int | None = None) -> bool:
		"""Отпустить reset-связанные GPIO в input/Hi-Z, чтобы RPi ничего не удерживал."""
		pins = self._hw_reset_release_pins(main_pin)
		if not pins:
			return False
		try:
			lgpio = _import_gpio_module('lgpio')  # type: ignore
			chip = lgpio.gpiochip_open(0)
			try:
				for gpio_pin in pins:
					try:
						lgpio.gpio_claim_input(chip, int(gpio_pin))
					except Exception:
						pass
					try:
						lgpio.gpio_free(chip, int(gpio_pin))
					except Exception:
						pass
			finally:
				lgpio.gpiochip_close(chip)
			print(f"[HW-RESET] release lines pins={pins} backend=lgpio", flush=True)
			return True
		except Exception:
			pass
		try:
			pigpio = _import_gpio_module('pigpio')  # type: ignore
			pi = pigpio.pi()
			if getattr(pi, 'connected', False):
				for gpio_pin in pins:
					try:
						pi.set_pull_up_down(int(gpio_pin), pigpio.PUD_OFF)
					except Exception:
						pass
					try:
						pi.set_mode(int(gpio_pin), pigpio.INPUT)
					except Exception:
						pass
				pi.stop()
				print(f"[HW-RESET] release lines pins={pins} backend=pigpio", flush=True)
				return True
		except Exception:
			pass
		try:
			GPIO = _import_gpio_module('RPi.GPIO')  # type: ignore
			GPIO.setwarnings(False)
			GPIO.setmode(GPIO.BCM)
			for gpio_pin in pins:
				try:
					GPIO.setup(int(gpio_pin), GPIO.IN, pull_up_down=GPIO.PUD_OFF)
				except Exception:
					pass
				try:
					GPIO.cleanup(int(gpio_pin))
				except Exception:
					pass
			print(f"[HW-RESET] release lines pins={pins} backend=RPi.GPIO", flush=True)
			return True
		except Exception:
			pass
		print(f"[HW-RESET] release lines pins={pins} failed", flush=True)
		return False

	def _hardware_reset_device(self, pulse_ms: int | None = None, wait_s: float | None = None) -> bool:
		"""Аппаратный сброс через GPIO (open-collector): краткий LOW, затем Hi-Z."""
		try:
			gpio_pin = int(os.getenv("BMI30_HW_RESET_GPIO", "17"))
		except Exception:
			gpio_pin = 17
		if pulse_ms is None:
			try:
				pulse_ms = int(os.getenv("BMI30_HW_RESET_PULSE_MS", "10"))
			except Exception:
				pulse_ms = 10
		if wait_s is None:
			try:
				wait_s = float(os.getenv("BMI30_HW_RESET_WAIT_S", "0.2"))
			except Exception:
				wait_s = 0.2
		if gpio_pin <= 0:
			return False
		if pulse_ms <= 0:
			pulse_ms = 10
		if wait_s < 0:
			wait_s = 0.0
		try:
			self._release_hw_reset_lines(gpio_pin)
		except Exception:
			pass
		try:
			print(f"[HW-RESET] begin pin={gpio_pin} pulse_ms={pulse_ms} wait_s={wait_s}", flush=True)
		except Exception:
			pass
		try:
			self._set_status(f"Аппаратный сброс GPIO{gpio_pin}…", hold_sec=1.5)
		except Exception:
			pass
		# Try lgpio first on Pi5/CM5 to avoid noisy pigpio fallback.
		try:
			lgpio = _import_gpio_module('lgpio')  # type: ignore
			chip = lgpio.gpiochip_open(0)
			try:
				lgpio.gpio_claim_output(chip, gpio_pin, 0)
				time.sleep(max(0.001, pulse_ms / 1000.0))
				try:
					lgpio.gpio_free(chip, gpio_pin)
				except Exception:
					pass
				try:
					lgpio.gpio_claim_input(chip, gpio_pin)
					lgpio.gpio_free(chip, gpio_pin)
				except Exception:
					pass
			finally:
				lgpio.gpiochip_close(chip)
			try:
				self._release_hw_reset_lines(gpio_pin)
			except Exception:
				pass
			time.sleep(wait_s)
			try:
				print("[HW-RESET] done backend=lgpio result=OK", flush=True)
			except Exception:
				pass
			return True
		except Exception as e_lgpio:
			try:
				print(f"[HW-RESET] lgpio failed: {e_lgpio}", flush=True)
			except Exception:
				pass
		# Try pigpio after lgpio
		try:
			pigpio = _import_gpio_module('pigpio')  # type: ignore
			pi = pigpio.pi()
			if getattr(pi, 'connected', False):
				pi.set_mode(gpio_pin, pigpio.OUTPUT)
				pi.write(gpio_pin, 0)
				time.sleep(max(0.001, pulse_ms / 1000.0))
				try:
					pi.set_pull_up_down(gpio_pin, pigpio.PUD_OFF)
				except Exception:
					pass
				pi.set_mode(gpio_pin, pigpio.INPUT)  # Hi-Z
				pi.stop()
				try:
					self._release_hw_reset_lines(gpio_pin)
				except Exception:
					pass
				time.sleep(wait_s)
				try:
					print("[HW-RESET] done backend=pigpio result=OK", flush=True)
				except Exception:
					pass
				return True
		except Exception as e_pigpio:
			try:
				print(f"[HW-RESET] pigpio failed: {e_pigpio}", flush=True)
			except Exception:
				pass
		# Fallback: RPi.GPIO
		try:
			GPIO = _import_gpio_module('RPi.GPIO')  # type: ignore
			GPIO.setwarnings(False)
			GPIO.setmode(GPIO.BCM)
			GPIO.setup(gpio_pin, GPIO.OUT, initial=GPIO.LOW)
			time.sleep(max(0.001, pulse_ms / 1000.0))
			GPIO.setup(gpio_pin, GPIO.IN, pull_up_down=GPIO.PUD_OFF)
			GPIO.cleanup(gpio_pin)
			try:
				self._release_hw_reset_lines(gpio_pin)
			except Exception:
				pass
			time.sleep(wait_s)
			try:
				print("[HW-RESET] done backend=RPi.GPIO result=OK", flush=True)
			except Exception:
				pass
			return True
		except Exception as e_gpio:
			try:
				print(f"[HW-RESET] all backends failed, last=RPi.GPIO err={e_gpio}", flush=True)
			except Exception:
				pass
			return False

	def _startup_reset_device(self) -> dict:
		"""Fast startup reset; full three-stage reset remains for stall recovery."""
		try:
			mode = str(os.getenv("BMI30_STARTUP_RESET_MODE", "fast_gpio")).strip().lower()
		except Exception:
			mode = "fast_gpio"
		if mode in ("0", "off", "none", "no", "false"):
			print("[STARTUP-RESET] skipped by BMI30_STARTUP_RESET_MODE", flush=True)
			return {"skipped": True}
		if mode in ("3", "3stage", "three_stage", "full"):
			return self._reset_device_three_stage("startup")
		try:
			pulse_ms = int(os.getenv("BMI30_STARTUP_RESET_PULSE_MS", "10"))
		except Exception:
			pulse_ms = 10
		try:
			wait_s = float(os.getenv("BMI30_STARTUP_RESET_WAIT_S", "0.0"))
		except Exception:
			wait_s = 0.0
		try:
			ready_timeout_s = float(os.getenv("BMI30_STARTUP_READY_TIMEOUT_S", "3.0"))
		except Exception:
			ready_timeout_s = 3.0
		try:
			ready_poll_s = float(os.getenv("BMI30_STARTUP_READY_POLL_S", "0.05"))
		except Exception:
			ready_poll_s = 0.05
		pulse_ms = max(1, min(1000, int(pulse_ms)))
		wait_s = max(0.0, min(2.0, float(wait_s)))
		ready_timeout_s = max(0.2, min(10.0, float(ready_timeout_s)))
		ready_poll_s = max(0.01, min(0.5, float(ready_poll_s)))
		try:
			self._set_status("Быстрый стартовый сброс GPIO...", hold_sec=0.7)
		except Exception:
			pass
		ok = bool(self._hardware_reset_device(pulse_ms=pulse_ms, wait_s=wait_s))
		print(f"[STARTUP-RESET] fast_gpio={'OK' if ok else 'FAIL'} pulse_ms={pulse_ms} wait_s={wait_s:g}", flush=True)
		ready_ok, ready_msg = self._wait_device_ready_ep0_direct(timeout_s=ready_timeout_s, poll_s=ready_poll_s)
		return {
			"fast_gpio": ok,
			"pulse_ms": pulse_ms,
			"wait_s": wait_s,
			"ready": ready_ok,
			"ready_msg": ready_msg,
		}

	def _fault_timestamp(self) -> str:
		try:
			return datetime.datetime.now().isoformat(timespec="seconds")
		except Exception:
			return f"{time.time():.3f}"

	def _fault_log_line(self, line: str):
		try:
			line_s = str(line)
		except Exception:
			line_s = repr(line)
		try:
			with self._fault_log_lock:
				path = str(getattr(self, "fault_log_path", "") or "")
				if not path:
					return
				parent = os.path.dirname(path)
				if parent:
					os.makedirs(parent, exist_ok=True)
				with open(path, "a", encoding="utf-8") as fp:
					fp.write(line_s.rstrip() + "\n")
		except Exception:
			pass

	def _snapshot_diag_from_frame(self, frame) -> dict:
		try:
			r2 = int(getattr(frame, 'reserved2', 0) or 0) & 0xFFFF
		except Exception:
			r2 = 0
		try:
			reserved = int(getattr(frame, 'reserved', 0) or 0) & 0xFFFFFFFF
		except Exception:
			reserved = 0
		return {
			"reserved": reserved,
			"reserved2": r2,
			"buffer_index": r2 & 0x0007,
			"source_slot": (r2 >> 3) & 0x001F,
			"snapshot_used": bool(r2 & 0x0100),
			"generation_changed": bool(r2 & 0x0200),
			"fifo_guard_near_reuse": bool(r2 & 0x0400),
			"source_consumed_after_snapshot": bool(r2 & 0x0800),
			"txcplt_low": (r2 >> 12) & 0x000F,
		}

	def _latest_stat_diag(self) -> dict:
		try:
			st_obj = getattr(self, 'stream', None)
			raw = getattr(st_obj, 'last_stat', None) if st_obj is not None else None
			parsed = self._parse_fault_stat(raw, "last_stat")
		except Exception:
			parsed = {"valid": False}
			st_obj = getattr(self, 'stream', None)
		try:
			last_t = float(getattr(st_obj, 'last_stat_t', 0.0) or 0.0) if st_obj is not None else 0.0
			age_s = max(0.0, time.time() - last_t) if last_t > 0 else None
		except Exception:
			age_s = None
		def _i(name):
			try:
				val = parsed.get(name)
				return None if val is None else int(val)
			except Exception:
				return None
		return {
			"stat_valid": bool(parsed.get("valid")),
			"stat_age_s": age_s,
			"stat_prod": _i("produced_seq"),
			"stat_sent0": _i("sent0"),
			"stat_sent1": _i("sent1"),
			"stat_txcplt": _i("dbg_tx_cplt"),
			"stat_dma0": _i("dma0"),
			"stat_dma1": _i("dma1"),
			"stat_wr": _i("wr"),
			"stat_seq": _i("cur_stream_seq"),
			"stat_flags_rt": _i("flags_rt"),
			"stat_flags2": _i("flags2"),
			"stat_now_ms": _i("now_ms"),
			"stat_last_full0_ms": _i("last_full0_ms"),
			"stat_last_full1_ms": _i("last_full1_ms"),
			"stat_packets": int(getattr(st_obj, 'stat_packets', 0) or 0) if st_obj is not None else 0,
			"service_packets": int(getattr(st_obj, 'service_packets', 0) or 0) if st_obj is not None else 0,
		}

	def _trace_frame_integrity(self, channel: str, samples, frame):
		"""Log physically unlikely in-frame jumps with firmware snapshot diagnostics.

		This is observation-only: it never drops, smooths, or modifies a frame.
		"""
		try:
			if not bool(getattr(self, 'frame_integrity_trace', True)):
				return
			limit = int(getattr(self, 'frame_integrity_limit', 200) or 0)
			if limit >= 0 and int(getattr(self, '_frame_integrity_count', 0) or 0) >= limit:
				return
			if samples is None:
				return
			arr = np.asarray(samples, dtype=np.int32)
			if arr.size < 2:
				return
			jump_thr = max(1, int(getattr(self, 'frame_integrity_jump', 7000) or 7000))
			mid_min = int(getattr(self, 'frame_integrity_mid_min', 8000) or 8000)
			mid_max = int(getattr(self, 'frame_integrity_mid_max', 57000) or 57000)
			a0 = arr[:-1]
			a1 = arr[1:]
			d = a1 - a0
			mask = (np.abs(d) >= jump_thr) & (a0 > mid_min) & (a0 < mid_max) & (a1 > mid_min) & (a1 < mid_max)
			if not bool(np.any(mask)):
				return
			idxs = np.nonzero(mask)[0]
			if idxs.size <= 0:
				return
			absd = np.abs(d[idxs])
			idx = int(idxs[int(np.argmax(absd))])
			v0 = int(a0[idx])
			v1 = int(a1[idx])
			dv = int(v1 - v0)
			now = time.time()
			# Keep the log readable if a bad firmware build produces many identical frames.
			last_t = float(getattr(self, '_frame_integrity_last_t', 0.0) or 0.0)
			if (now - last_t) < max(0.0, float(getattr(self, 'frame_integrity_min_interval_s', 0.10) or 0.0)):
				return
			self._frame_integrity_last_t = now
			self._frame_integrity_count = int(getattr(self, '_frame_integrity_count', 0) or 0) + 1
			lo = max(0, idx - 8)
			hi = min(int(arr.size), idx + 9)
			window = [int(x) for x in arr[lo:hi].tolist()]
			diag = self._snapshot_diag_from_frame(frame)
			try:
				seq = int(getattr(frame, 'seq', -1))
			except Exception:
				seq = -1
			try:
				ts = int(getattr(frame, 'timestamp', -1))
			except Exception:
				ts = -1
			try:
				flags = int(getattr(frame, 'flags', 0) or 0)
			except Exception:
				flags = 0
			try:
				crc_bad = int(getattr(getattr(self, 'stream', None), 'crc_bad', 0) or 0)
			except Exception:
				crc_bad = 0
			info = {
				"channel": str(channel),
				"seq": seq,
				"timestamp": ts,
				"flags": flags,
				"samples": int(arr.size),
				"idx": idx,
				"prev": v0,
				"curr": v1,
				"jump": dv,
				"window_start": lo,
				"window": window,
				"crc_bad": crc_bad,
				**diag,
			}
			self._frame_integrity_last = info
			self._fault_log_line(
				f"[frame_integrity] ts={self._fault_timestamp()} ch={channel} seq={seq} dev_ts={ts} "
				f"flags=0x{flags & 0xFF:02X} samples={int(arr.size)} idx={idx} "
				f"{v0}->{v1} jump={dv} reserved={diag['reserved']} reserved2=0x{diag['reserved2']:04X} "
				f"buf_idx={diag['buffer_index']} src_slot={diag['source_slot']} "
				f"snapshot={int(diag['snapshot_used'])} gen_changed={int(diag['generation_changed'])} "
				f"fifo_guard={int(diag['fifo_guard_near_reuse'])} consumed_after={int(diag['source_consumed_after_snapshot'])} "
				f"txcplt_low={diag['txcplt_low']} crc_bad={crc_bad} win_start={lo} win={window}"
			)
			if bool(getattr(self, 'reader_debug', False)):
				print(f"[frame_integrity] {channel} seq={seq} idx={idx} {v0}->{v1} r2=0x{diag['reserved2']:04X}", flush=True)
		except Exception:
			pass

	def _trace_frame_amplitude(self, channel: str, samples, frame):
		"""Log whole-frame amplitude excursions without changing the stream."""
		try:
			if not bool(getattr(self, 'frame_amp_trace', True)) or samples is None:
				return
			arr = np.asarray(samples, dtype=np.float64)
			if arr.size < 20:
				return
			arr = np.nan_to_num(arr, nan=0.0, posinf=0.0, neginf=0.0)
			try:
				r2 = int(getattr(frame, 'reserved2', 0) or 0) & 0xFFFF
			except Exception:
				r2 = 0
			key = f"{str(channel)}{r2 & 1}"
			vmin, p05, med, p95, vmax = [float(x) for x in np.percentile(arr, [0, 5, 50, 95, 100])]
			span = max(0.0, float(p95 - p05))
			if not np.isfinite(span):
				return
			window = max(8, int(getattr(self, 'frame_amp_window', 80) or 80))
			base_map = getattr(self, '_frame_amp_baseline', None)
			center_map = getattr(self, '_frame_amp_center_baseline', None)
			active_map = getattr(self, '_frame_amp_active', None)
			last_t_map = getattr(self, '_frame_amp_last_t', None)
			if not isinstance(base_map, dict):
				base_map = {}
				self._frame_amp_baseline = base_map
			if not isinstance(center_map, dict):
				center_map = {}
				self._frame_amp_center_baseline = center_map
			if not isinstance(active_map, dict):
				active_map = {}
				self._frame_amp_active = active_map
			if not isinstance(last_t_map, dict):
				last_t_map = {}
				self._frame_amp_last_t = last_t_map
			hist = base_map.get(key)
			if hist is None or getattr(hist, 'maxlen', None) != window:
				hist = deque(maxlen=window)
				base_map[key] = hist
			center_hist = center_map.get(key)
			if center_hist is None or getattr(center_hist, 'maxlen', None) != window:
				center_hist = deque(maxlen=window)
				center_map[key] = center_hist
			min_base = max(4, int(getattr(self, 'frame_amp_min_baseline', 18) or 18))
			if len(hist) < min_base:
				hist.append(span)
				center_hist.append(med)
				return
			base_span = float(np.median(np.asarray(hist, dtype=np.float64)))
			base_center = float(np.median(np.asarray(center_hist, dtype=np.float64))) if len(center_hist) else med
			if not np.isfinite(base_span) or base_span <= 1e-9:
				hist.append(span)
				center_hist.append(med)
				return
			ratio = float(span / base_span)
			center_shift = float(med - base_center)
			reasons = []
			if ratio >= max(1.1, float(getattr(self, 'frame_amp_up_ratio', 2.8) or 2.8)):
				reasons.append(f"span_up={ratio:.2f}x")
			elif ratio <= min(0.95, max(0.05, float(getattr(self, 'frame_amp_down_ratio', 0.40) or 0.40))):
				reasons.append(f"span_down={ratio:.2f}x")
			if abs(center_shift) >= max(float(getattr(self, 'frame_amp_center_adc', 1500) or 1500), base_span * 1.4):
				reasons.append(f"center_shift={center_shift:+.0f}")
			active = bool(active_map.get(key, False))
			state = "anom" if reasons else ("recover" if active else "normal")
			now = time.time()
			should_log = bool(reasons) or active
			if reasons and active and (now - float(last_t_map.get(key, 0.0) or 0.0)) < max(0.0, float(getattr(self, 'frame_amp_log_interval_s', 0.5) or 0.0)):
				should_log = False
			active_map[key] = bool(reasons)
			# Keep the baseline adaptive so a several-second level change becomes one event
			# with recovery, not an endless stream of identical anomaly lines.
			hist.append(span)
			center_hist.append(med)
			if not should_log:
				return
			last_t_map[key] = now
			try:
				seq = int(getattr(frame, 'seq', -1))
				ts = int(getattr(frame, 'timestamp', -1))
				flags = int(getattr(frame, 'flags', 0) or 0)
			except Exception:
				seq, ts, flags = -1, -1, 0
			try:
				crc_bad = int(getattr(getattr(self, 'stream', None), 'crc_bad', 0) or 0)
			except Exception:
				crc_bad = 0
			diag = self._snapshot_diag_from_frame(frame)
			try:
				if bool(getattr(self, 'frame_amp_ep0_stat', True)):
					ep0_now = time.time()
					ep0_last = float(getattr(self, '_frame_amp_ep0_last_t', 0.0) or 0.0)
					ep0_min = float(getattr(self, 'frame_amp_ep0_min_interval_s', 0.75) or 0.75)
					if (ep0_now - ep0_last) >= ep0_min:
						self._frame_amp_ep0_last_t = ep0_now
						self._read_ep0_stat_136(timeout_ms=int(getattr(self, 'frame_amp_ep0_timeout_ms', 60) or 60))
			except Exception:
				pass
			stat_diag = self._latest_stat_diag()
			head = [int(x) for x in arr[:min(8, int(arr.size))].tolist()]
			info = {
				"channel": str(channel), "key": key, "state": state,
				"reason": ",".join(reasons) if reasons else "back_to_baseline",
				"seq": seq, "timestamp": ts, "flags": flags, "samples": int(arr.size),
				"min": int(vmin), "p05": int(p05), "median": int(med), "p95": int(p95), "max": int(vmax),
				"span": int(span), "base_span": int(base_span), "ratio": ratio,
				"center_shift": int(center_shift), "crc_bad": crc_bad, "head": head, **diag, **stat_diag,
			}
			self._frame_amp_count = int(getattr(self, '_frame_amp_count', 0) or 0) + 1
			self._frame_amp_last = info
			self._fault_log_line(
				f"[frame_amplitude] ts={self._fault_timestamp()} ch={channel} key={key} state={state} "
				f"reason={info['reason']} seq={seq} dev_ts={ts} flags=0x{flags & 0xFF:02X} samples={int(arr.size)} "
				f"span={int(span)} base_span={int(base_span)} ratio={ratio:.2f} "
				f"p05={int(p05)} med={int(med)} p95={int(p95)} min={int(vmin)} max={int(vmax)} "
				f"center_shift={int(center_shift)} reserved={diag['reserved']} reserved2=0x{diag['reserved2']:04X} "
				f"buf_idx={diag['buffer_index']} src_slot={diag['source_slot']} "
				f"snapshot={int(diag['snapshot_used'])} gen_changed={int(diag['generation_changed'])} "
				f"fifo_guard={int(diag['fifo_guard_near_reuse'])} consumed_after={int(diag['source_consumed_after_snapshot'])} "
				f"txcplt_low={diag['txcplt_low']} crc_bad={crc_bad} "
				f"stat_valid={int(stat_diag['stat_valid'])} stat_age={stat_diag['stat_age_s'] if stat_diag['stat_age_s'] is not None else -1:.3f} "
				f"stat_prod={self._fmt_int(stat_diag['stat_prod'])} stat_sent={self._fmt_int(stat_diag['stat_sent0'])}/{self._fmt_int(stat_diag['stat_sent1'])} "
				f"stat_txcplt={self._fmt_int(stat_diag['stat_txcplt'])} stat_dma={self._fmt_int(stat_diag['stat_dma0'])}/{self._fmt_int(stat_diag['stat_dma1'])} "
				f"stat_wr={self._fmt_int(stat_diag['stat_wr'])} stat_seq={self._fmt_int(stat_diag['stat_seq'])} "
				f"stat_flags={self._fmt_hex16(stat_diag['stat_flags_rt'])}/{self._fmt_hex16(stat_diag['stat_flags2'])} "
				f"stat_now={self._fmt_int(stat_diag['stat_now_ms'])} stat_full={self._fmt_int(stat_diag['stat_last_full0_ms'])}/{self._fmt_int(stat_diag['stat_last_full1_ms'])} "
				f"stat_pkts={stat_diag['stat_packets']} svc_pkts={stat_diag['service_packets']} head={head}"
			)
		except Exception:
			pass

	def _cmd_name(self, cmd: int) -> str:
		try:
			cmd_i = int(cmd) & 0xFF
		except Exception:
			cmd_i = -1
		names = {
			0x10: "SET_WINDOWS",
			0x11: "SET_BLOCK_HZ",
			0x13: "SET_FULL_MODE",
			0x14: "SET_PROFILE",
			0x15: "SET_ROI_US",
			0x16: "SET_TRUNC_SAMPLES",
			0x17: "SET_FRAME_SAMPLES",
			0x18: "SET_ASYNC_MODE",
			0x19: "SET_CHMODE",
			0x1A: "SET_STREAM_MODE",
			0x1B: "SET_DC_ADAPT",
			0x1C: "SET_BUF_RATE_FINE",
			0x1D: "SET_SYNC_MODE",
			0x1E: "CALIB_DC_FAST",
			0x1F: "SET_DC_SPEED",
			0x20: "START_STREAM",
			0x21: "STOP_STREAM",
			0x22: "DEVICE_RESET",
			0x2B: "SAVE_DC_TO_FLASH",
			0x30: "GET_STATUS",
			0x32: "TOGGLE_TIM2CH3_INV",
			0x33: "SET_TX_ENABLE",
			0x34: "SET_OPTIC_POWER",
			0x35: "LED_EVENT",
			0x36: "HOST_RX_ACK",
			0x37: "HOST_RX_CLEAR",
			0x38: "GET_LCD_STATUS",
			0x39: "SET_OPTIC_HOLD",
			0x3A: "GET_DC_CONFIG",
			0x3B: "SET_LED_PATTERN",
			0x3C: "SET_DET_ADC",
			0x7E: "SOFT_RESET",
			0x7F: "DEEP_RESET",
		}
		return names.get(cmd_i, f"CMD_0x{cmd_i:02X}")

	def _remember_command(self, cmd: int, payload: bytes = b"", comment: str = ""):
		try:
			cmd_i = int(cmd) & 0xFF
		except Exception:
			cmd_i = 0
		try:
			payload_b = bytes(payload or b"")
		except Exception:
			payload_b = b""
		entry = {
			"ts": self._fault_timestamp(),
			"cmd": cmd_i,
			"payload": payload_b.hex(),
			"comment": str(comment or self._cmd_name(cmd_i)),
		}
		try:
			self._cmd_journal.append(entry)
		except Exception:
			pass
		try:
			if _env_bool("BMI30_FAULT_LOG_TX", True):
				self._fault_log_line(
					f"[tx] ts={entry['ts']} cmd=0x{cmd_i:02X} payload={entry['payload']} comment={entry['comment']}"
				)
		except Exception:
			pass

	def _install_stream_command_logger(self):
		try:
			st = getattr(self, "stream", None)
			if st is None or bool(getattr(st, "_bmi30_cmd_log_wrapped", False)):
				return
			orig_send_cmd = st.send_cmd

			def _logged_send_cmd(cmd, payload=b""):
				try:
					self._remember_command(int(cmd), bytes(payload or b""), self._cmd_name(int(cmd)))
				except Exception:
					pass
				return orig_send_cmd(cmd, payload)

			st.send_cmd = _logged_send_cmd
			st._bmi30_cmd_log_wrapped = True
		except Exception:
			pass

	def _current_role(self) -> str:
		try:
			return str(os.getenv("BMI30_ROLE", "master") or "master")
		except Exception:
			return "master"

	def _remember_desired_mode_for_button(self, idx: int, reason: str = ""):
		try:
			idx_i = int(idx)
		except Exception:
			return
		mode = None
		expected = None
		payload = None
		if idx_i in (1, 2, 3):
			mode, expected, payload = 0, 600, b"\x00"
		elif idx_i == 4:
			mode, expected, payload = 1, 200, b"\x01"
		elif idx_i == 5:
			try:
				avg_n = int(getattr(self, "avg_n", 20) or 20)
			except Exception:
				avg_n = 20
			avg_n = max(2, min(64, avg_n))
			mode, expected, payload = 2, 200, bytes([0x02, avg_n & 0xFF])
		elif idx_i >= 6:
			# Detection/overlay modes keep the last transport mode.
			return
		if mode is None:
			return
		self.desired_stream_mode = int(mode)
		self.desired_expected_samples = int(expected)
		self.desired_stream_payload = bytes(payload or b"")
		try:
			self._fault_log_line(
				f"[mode] ts={self._fault_timestamp()} selected_mode={idx_i} "
				f"desired_stream_mode={mode} expected_samples={expected} reason={reason}"
			)
		except Exception:
			pass

	def _desired_stream_fields(self):
		try:
			mode = int(getattr(self, "desired_stream_mode", getattr(self, "stream_mode", 0)) or 0)
		except Exception:
			mode = 0
		if mode == 2:
			try:
				avg_n = int(getattr(self, "avg_n", 20) or 20)
			except Exception:
				avg_n = 20
			avg_n = max(2, min(64, avg_n))
			return 2, bytes([0x02, avg_n & 0xFF]), 200
		if mode == 1:
			return 1, b"\x01", 200
		return 0, b"\x00", 600

	def _expected_samples_for_fault(self) -> int:
		try:
			exp = int(getattr(self, "desired_expected_samples", 0) or 0)
			if exp > 0:
				return exp
		except Exception:
			pass
		try:
			mode, _payload, exp = self._desired_stream_fields()
			return int(exp)
		except Exception:
			return int(getattr(self, "base_buf_len", 0) or 0)

	def _fault_context_line(self, reason: str) -> str:
		try:
			selected_mode = int(self.num_group.checkedId())
		except Exception:
			selected_mode = -1
		try:
			desired_mode, _payload, expected = self._desired_stream_fields()
		except Exception:
			desired_mode, expected = getattr(self, "stream_mode", 0), self._expected_samples_for_fault()
		try:
			rx_t = float(getattr(getattr(self, "stream", None), "last_rx_t", 0.0) or 0.0)
			idle_rx = (time.time() - rx_t) if rx_t > 0.0 else -1.0
		except Exception:
			idle_rx = -1.0
		try:
			frame_t = float(getattr(self, "last_frame_t", 0.0) or 0.0)
			idle_frame = (time.time() - frame_t) if frame_t > 0.0 else -1.0
		except Exception:
			idle_frame = -1.0
		try:
			disconnected = bool(getattr(getattr(self, "stream", None), "disconnected", False))
		except Exception:
			disconnected = False
		return (
			f"[fault] ts={self._fault_timestamp()} role={self._current_role()} reason={reason} "
			f"selected_mode={selected_mode} desired_stream_mode={desired_mode} "
			f"expected_samples={expected} base_buf_len={getattr(self, 'base_buf_len', None)} "
			f"afps={float(getattr(self, 'afps', 0.0) or 0.0):.2f} "
			f"bfps={float(getattr(self, 'bfps', 0.0) or 0.0):.2f} "
			f"idle_rx={idle_rx:.3f} idle_frame={idle_frame:.3f} disconnected={int(disconnected)}"
		)

	def _stat_u8(self, data: bytes, off: int):
		try:
			if len(data) > off:
				return int(data[off])
		except Exception:
			pass
		return None

	def _stat_u16(self, data: bytes, off: int):
		try:
			if len(data) >= off + 2:
				return int.from_bytes(data[off:off + 2], "little")
		except Exception:
			pass
		return None

	def _stat_u32(self, data: bytes, off: int):
		try:
			if len(data) >= off + 4:
				return int.from_bytes(data[off:off + 4], "little")
		except Exception:
			pass
		return None

	def _parse_fault_stat(self, data: bytes | None, msg: str = "") -> dict:
		bs = bytes(data or b"")
		st = {
			"valid": False,
			"len": len(bs),
			"msg": str(msg or ""),
			"raw_hex": bs.hex(),
		}
		if len(bs) < 4 or bs[:4] != b"STAT":
			return st
		st.update({
			"valid": True,
			"ver": self._stat_u8(bs, 4),
			"cur_samples": self._stat_u16(bs, 6),
			"frame_bytes": self._stat_u16(bs, 8),
			"test_frames": self._stat_u16(bs, 10),
			"produced_seq": self._stat_u32(bs, 12),
			"sent0": self._stat_u32(bs, 16),
			"sent1": self._stat_u32(bs, 20),
			"dbg_tx_cplt": self._stat_u32(bs, 24),
			"dbg_partial": self._stat_u32(bs, 28),
			"dbg_size_mismatch": self._stat_u32(bs, 32),
			"dma0": self._stat_u32(bs, 36),
			"dma1": self._stat_u32(bs, 40),
			"wr": self._stat_u32(bs, 44),
			"flags_rt": self._stat_u16(bs, 48),
			"flags2": self._stat_u16(bs, 50),
			"sending_ch": self._stat_u8(bs, 52),
			"reserved2": self._stat_u8(bs, 53),
			"pair_idx": self._stat_u16(bs, 54),
			"last_tx_len": self._stat_u16(bs, 56),
			"cur_stream_seq": self._stat_u32(bs, 58),
			# Current docs require these v2+ fields; current firmware places them after the 64B base STAT.
			"now_ms": self._stat_u32(bs, 64),
			"last_full0_ms": self._stat_u32(bs, 68),
			"last_full1_ms": self._stat_u32(bs, 72),
			"optic_hold_ds": self._stat_u16(bs, 96),
			"led_pattern": self._stat_u8(bs, 98),
			"sync_local_status": self._stat_u8(bs, 99),
			"sync_seen_mask": self._stat_u32(bs, 100),
			"sync_node_count": self._stat_u8(bs, 104),
		})
		return st

	def _fmt_int(self, value, default: str = "-") -> str:
		try:
			if value is None:
				return default
			return str(int(value))
		except Exception:
			return default

	def _fmt_hex16(self, value) -> str:
		try:
			if value is None:
				return "0x----"
			return f"0x{int(value) & 0xFFFF:04X}"
		except Exception:
			return "0x----"

	def _format_fault_stat(self, tag: str, st: dict) -> str:
		if not st.get("valid"):
			return f"[fault_probe] {tag} len={int(st.get('len', 0) or 0)} invalid msg={st.get('msg', '')}"
		return (
			f"[fault_probe] {tag} len={self._fmt_int(st.get('len'))} "
			f"flags_rt={self._fmt_hex16(st.get('flags_rt'))} flags2={self._fmt_hex16(st.get('flags2'))} "
			f"cur={self._fmt_int(st.get('cur_samples'))} frame_bytes={self._fmt_int(st.get('frame_bytes'))} "
			f"prod={self._fmt_int(st.get('produced_seq'))} "
			f"sentA/B={self._fmt_int(st.get('sent0'))}/{self._fmt_int(st.get('sent1'))} "
			f"txcplt={self._fmt_int(st.get('dbg_tx_cplt'))} "
			f"dma={self._fmt_int(st.get('dma0'))}/{self._fmt_int(st.get('dma1'))} "
			f"wr={self._fmt_int(st.get('wr'))} seq={self._fmt_int(st.get('cur_stream_seq'))} "
			f"lastTX={self._fmt_int(st.get('last_tx_len'))} now={self._fmt_int(st.get('now_ms'))} "
			f"last_full={self._fmt_int(st.get('last_full0_ms'))}/{self._fmt_int(st.get('last_full1_ms'))}"
		)

	def _u32_delta(self, a, b):
		try:
			if a is None or b is None:
				return None
			return (int(b) - int(a)) & 0xFFFFFFFF
		except Exception:
			return None

	def _fault_probe_delta(self, st0: dict, st1: dict) -> dict:
		keys = ("produced_seq", "sent0", "sent1", "dbg_tx_cplt", "dma0", "dma1", "wr", "cur_stream_seq")
		return {k: self._u32_delta(st0.get(k), st1.get(k)) for k in keys}

	def _format_fault_delta(self, delta: dict) -> str:
		return (
			f"[fault_probe] delta prod={self._fmt_int(delta.get('produced_seq'))} "
			f"sentA/B={self._fmt_int(delta.get('sent0'))}/{self._fmt_int(delta.get('sent1'))} "
			f"txcplt={self._fmt_int(delta.get('dbg_tx_cplt'))} "
			f"dma={self._fmt_int(delta.get('dma0'))}/{self._fmt_int(delta.get('dma1'))} "
			f"wr={self._fmt_int(delta.get('wr'))} seq={self._fmt_int(delta.get('cur_stream_seq'))}"
		)

	def _fault_probe_verdict(self, st0: dict, st1: dict, delta: dict) -> str:
		if not st0.get("valid") or not st1.get("valid"):
			return "usb_control_lost"
		try:
			flags_rt = int(st1.get("flags_rt") or 0)
		except Exception:
			flags_rt = 0
		if (flags_rt & 0x0001) == 0:
			return "stream_stopped"
		def _grow(name: str) -> bool:
			try:
				return int(delta.get(name) or 0) > 0
			except Exception:
				return False
		tx_grow = _grow("sent0") or _grow("sent1") or _grow("dbg_tx_cplt")
		producer_grow = _grow("produced_seq") or _grow("cur_stream_seq")
		dma_grow = _grow("dma0") or _grow("dma1") or _grow("wr")
		if tx_grow:
			return "host_bulk_lost"
		if dma_grow or producer_grow:
			return "stm32_tx_stalled"
		return "stm32_adc_stalled"

	def _read_ep0_stat_136(self, timeout_ms: int = 500):
		stat_len = 136
		try:
			stat_len = int(os.getenv("BMI30_STAT_LEN", "136"))
		except Exception:
			stat_len = 136
		stat_len = max(64, min(192, stat_len))
		last_msg = ""
		for source in ("stream", "direct"):
			dev = None
			dispose = False
			try:
				if source == "stream":
					st = getattr(self, "stream", None)
					dev = getattr(st, "dev", None) if st is not None else None
					if dev is None:
						last_msg = "stream dev unavailable"
						continue
				else:
					try:
						import usb.core  # type: ignore
						import usb.util  # type: ignore
					except Exception as e:
						last_msg = f"usb import unavailable: {e}"
						continue
					dev = usb.core.find(idVendor=0xCAFE, idProduct=0x4001)
					dispose = True
					if dev is None:
						last_msg = "direct device not found"
						continue
				data = dev.ctrl_transfer(0xC0, CMD_GET_STATUS, 0, 0, stat_len, timeout=int(timeout_ms))
				bs = bytes(data) if data is not None else b""
				if bs:
					try:
						if getattr(self, "stream", None) is not None:
							self.stream.last_stat = bs
							self.stream.last_stat_t = time.time()
					except Exception:
						pass
					return bs, f"{source} EP0 len={len(bs)}"
				last_msg = f"{source} EP0 empty"
			except Exception as e:
				last_msg = f"{source} EP0 err: {e}"
			finally:
				if dispose:
					try:
						import usb.util  # type: ignore
						usb.util.dispose_resources(dev)
					except Exception:
						pass
		return b"", last_msg

	def _log_recent_commands_for_fault(self):
		try:
			recent = list(getattr(self, "_cmd_journal", []))[-32:]
		except Exception:
			recent = []
		for entry in recent:
			try:
				self._fault_log_line(
					f"[tx_recent] ts={entry.get('ts')} cmd=0x{int(entry.get('cmd')) & 0xFF:02X} "
					f"payload={entry.get('payload', '')} comment={entry.get('comment', '')}"
				)
			except Exception:
				pass

	def _fault_probe_and_log(self, reason: str) -> dict:
		if not self._fault_probe_lock.acquire(False):
				try:
					return dict(getattr(self, "_last_fault_probe_result", {}) or {})
				except Exception:
					return {}
		try:
			self._fault_probe_inflight = True
			reason_s = str(reason or "fault")
			self._fault_log_line(self._fault_context_line(reason_s))
			self._fault_log_line(f"[fault_probe] reason={reason_s}")
			stat0_raw, msg0 = self._read_ep0_stat_136(timeout_ms=500)
			stat0 = self._parse_fault_stat(stat0_raw, msg0)
			self._fault_log_line(self._format_fault_stat("stat0", stat0))
			try:
				gap_s = float(os.getenv("BMI30_FAULT_PROBE_GAP_S", "1.0"))
			except Exception:
				gap_s = 1.0
			gap_s = max(0.2, min(2.0, gap_s))
			time.sleep(gap_s)
			stat1_raw, msg1 = self._read_ep0_stat_136(timeout_ms=500)
			stat1 = self._parse_fault_stat(stat1_raw, msg1)
			self._fault_log_line(self._format_fault_stat("stat1", stat1))
			delta = self._fault_probe_delta(stat0, stat1)
			verdict = self._fault_probe_verdict(stat0, stat1, delta)
			self._fault_log_line(self._format_fault_delta(delta))
			self._fault_log_line(f"[fault_probe] verdict={verdict}")
			self._log_recent_commands_for_fault()
			result = {"verdict": verdict, "stat0": stat0, "stat1": stat1, "delta": delta}
			self._last_fault_probe_result = result
			return result
		finally:
			self._fault_probe_inflight = False
			try:
				self._fault_probe_lock.release()
			except Exception:
				pass

	def _log_recovery_action(self, action: str, reason: str = ""):
		try:
			mode, _payload, expected = self._desired_stream_fields()
		except Exception:
			mode, expected = getattr(self, "stream_mode", 0), self._expected_samples_for_fault()
		self._fault_log_line(
			f"[recovery] ts={self._fault_timestamp()} action={action} reason={reason} "
			f"restore_stream_mode={mode} restore_samples={expected}"
		)

	def _mute_detection_after_fault(self, reason: str = ""):
		self._set_sound_enabled(False, reason=reason, announce=False)
		try:
			self._group_led_fault_active = True
			self._group_led_apply_current_state(force=True)
		except Exception:
			pass
		try:
			self._rt_detection_mode_enabled = False
			self._phase_search_enabled = False
			self._det_dc_frozen = False
			self._det_hold0 = False
			self._det_hold1 = False
			self._det_exceed0 = 0
			self._det_exceed1 = 0
			self._prev_beep_state = False
			self._prev_freeze_state = False
		except Exception:
			pass
		try:
			if hasattr(self, '_corr_timer') and self._corr_timer is not None:
				self._corr_timer.stop()
			self.corr0.setData([], [])
			self.corr1.setData([], [])
			self.corr0.setVisible(False)
			self.corr1.setVisible(False)
		except Exception:
			pass

	def _apply_desired_stream_config(self, start: bool = True, stop_first: bool = False, source: str = "recovery"):
		if self.stream is None:
			raise RuntimeError("нет активного stream")
		mode, payload, expected = self._desired_stream_fields()
		if mode == 1:
			windows_data = struct.pack("<HHHH", 280, 200, 0, 0)
			async_payload = b"\x00"
		elif mode == 2:
			windows_data = struct.pack("<HHHH", 280, 200, 280, 200)
			async_payload = b"\x01"
		else:
			windows_data = struct.pack("<HHHH", 0, 0, 0, 0)
			async_payload = b"\x01"
		self._fault_log_line(
			f"[recovery] ts={self._fault_timestamp()} action=restore_config source={source} "
			f"restore_stream_mode={mode} restore_samples={expected}"
		)
		if stop_first:
			self._send_stop_stream()
			time.sleep(0.02)
		self.stream.send_cmd(CMD_SET_WINDOWS, windows_data)
		time.sleep(0.02)
		self.stream.send_cmd(CMD_SET_STREAM_MODE, payload)
		time.sleep(0.02)
		self.stream.send_cmd(CMD_ASYNC, async_payload)
		time.sleep(0.02)
		try:
			self.stream.send_cmd(0x13 if 'CMD_FULL_MODE' not in globals() else CMD_FULL_MODE, b"\x01")
		except Exception:
			pass
		try:
			prof = self.desired_profile if self.desired_profile in (1, 2) else 1
			self.stream.send_cmd(CMD_SET_PROFILE, bytes([prof]))
		except Exception:
			pass
		try:
			self.stream.send_cmd(0x19 if 'CMD_CHMODE' not in globals() else CMD_CHMODE, b"\x02")
		except Exception:
			pass
		try:
			bhz = int(self.block_hz) if getattr(self, "block_hz", None) else None
			if bhz and 1 <= bhz <= 1000:
				self.stream.send_cmd(0x11 if 'CMD_BLOCK_HZ' not in globals() else CMD_BLOCK_HZ, int(bhz).to_bytes(2, "little"))
		except Exception:
			pass
		if start:
			self._send_start_stream()
		self.stream_mode = int(mode)
		self.desired_stream_mode = int(mode)
		self.desired_expected_samples = int(expected)
		self.desired_stream_payload = bytes(payload)

	def _probe_device_status_ep0(self, force: bool = False):
		"""Проверить, отвечает ли устройство на GET_STATUS по EP0."""
		now = time.time()
		try:
			last_t = float(getattr(self, '_stream_fault_probe_t', 0.0) or 0.0)
		except Exception:
			last_t = 0.0
		if (not force) and (now - last_t) < 0.7:
			return getattr(self, '_stream_fault_probe_ok', None), str(getattr(self, '_stream_fault_probe_msg', '') or '')
		ok = None
		msg = ""
		try:
			st = getattr(self, 'stream', None)
			dev = getattr(st, 'dev', None) if st is not None else None
			if dev is None:
				ok = None
				msg = "нет USB device"
			else:
				bs, read_msg = self._read_ep0_stat_136(timeout_ms=250)
				if st is not None and bs:
					try:
						st.last_stat = bs
					except Exception:
						pass
				if len(bs) >= 4 and bs[:4] == b'STAT':
					ok = True
					msg = f"EP0 OK len={len(bs)}"
				elif len(bs) > 0:
					ok = True
					msg = f"EP0 resp len={len(bs)}"
				else:
					ok = False
					msg = read_msg or "EP0 empty"
		except Exception as e:
			ok = False
			try:
				errno = getattr(e, 'errno', None)
			except Exception:
				errno = None
			if errno is not None:
				msg = f"EP0 err errno={errno}: {e}"
			else:
				msg = f"EP0 err: {e}"
		self._stream_fault_probe_t = now
		self._stream_fault_probe_ok = ok
		self._stream_fault_probe_msg = msg
		return ok, msg

	def _classify_stream_fault(self, now_t: float | None = None):
		"""Классифицировать пропажу потока: USB/RPi vs STM32 vs парирование."""
		if now_t is None:
			now_t = time.time()
		if self.stream is None:
			return ("stream_off", "Поток остановлен")
		try:
			if bool(getattr(self.stream, 'disconnected', False)):
				return ("usb_disconnected", "RPi/USB: устройство исчезло или переоткрылось")
		except Exception:
			pass
		try:
			stop_after = float(getattr(self, 'stop_warn_after', 5.0) or 5.0)
		except Exception:
			stop_after = 5.0
		try:
			rx_t = float(getattr(self.stream, 'last_rx_t', 0.0) or 0.0)
		except Exception:
			rx_t = 0.0
		try:
			frame_t = float(getattr(self, 'last_frame_t', 0.0) or 0.0)
		except Exception:
			frame_t = 0.0
		has_frames = bool(getattr(self, 'base_buf_len', None) is not None)
		idle_rx = (float(now_t) - rx_t) if rx_t > 0.0 else float('inf')
		idle_frame = (float(now_t) - frame_t) if frame_t > 0.0 else float('inf')
		if idle_rx <= stop_after:
			if has_frames and idle_frame > stop_after:
				return ("pairing_stall", "RPi получает USB, но нет новых стереопар")
			if not has_frames:
				return ("waiting_frames", "USB жив, но рабочих кадров ещё нет")
			return ("ok", "Поток жив")
		ep0_ok, ep0_msg = self._probe_device_status_ep0(force=False)
		if ep0_ok is True:
			return ("stm32_stream_stall", f"STM32 отвечает на EP0, но bulk поток молчит ({ep0_msg})")
		if ep0_ok is False:
			return ("rpi_usb_fault", f"RPi/USB не получает даже EP0 ({ep0_msg})")
		return ("no_rx_unknown", "Нет USB приёма, причина пока не определена")

	def _update_stream_fault_state(self, now_t: float | None = None):
		"""Обновить кэш диагноза пропажи потока."""
		try:
			kind, msg = self._classify_stream_fault(now_t=now_t)
		except Exception as e:
			kind, msg = ("fault_unknown", f"Диагностика потока недоступна: {e}")
		self._stream_fault_kind = str(kind)
		self._stream_fault_msg = str(msg)
		return kind, msg

	def _format_run_duration(self, seconds: float) -> str:
		try:
			total = max(0, int(float(seconds)))
		except Exception:
			total = 0
		total_minutes = total // 60
		if total_minutes <= 0:
			return "-"
		h = total_minutes // 60
		m = total_minutes % 60
		if h > 0 and m > 0:
			return f"{h:d}h{m:d}m"
		if h > 0:
			return f"{h:d}h"
		return f"{m:d}m"

	def _mark_stream_good(self, reason: str = ""):
		"""Start/restart the uninterrupted-run timer when real frames are flowing."""
		try:
			if bool(getattr(self, '_stable_waiting_good', True)) or float(getattr(self, '_stable_since_t', 0.0) or 0.0) <= 0.0:
				self._stable_since_t = time.time()
				self._stable_waiting_good = False
				if bool(getattr(self, 'debug', False)):
					print(f"[RUN] stable timer started ({reason})", flush=True)
		except Exception:
			pass

	def _note_stream_fault(self, reason: str = ""):
		"""Record a stream/device fault and update shortest completed uninterrupted run."""
		try:
			now = time.time()
			last_t = float(getattr(self, '_stable_last_fault_t', 0.0) or 0.0)
			# Avoid double-counting the same physical failure through watchdog + disconnected path.
			if last_t > 0.0 and (now - last_t) < 2.0:
				return False
			start_t = float(getattr(self, '_stable_since_t', 0.0) or 0.0)
			waiting = bool(getattr(self, '_stable_waiting_good', True))
			elapsed = (now - start_t) if (start_t > 0.0 and not waiting) else 0.0
			try:
				fault_mode_idx = int(self.num_group.checkedId())
			except Exception:
				fault_mode_idx = None
			self._stable_fault_count = int(getattr(self, '_stable_fault_count', 0) or 0) + 1
			if elapsed > 0.1:
				prev_min = getattr(self, '_stable_min_s', None)
				if prev_min is None:
					self._stable_min_s = float(elapsed)
				else:
					self._stable_min_s = min(float(prev_min), float(elapsed))
			self._stable_last_fault_t = now
			self._stable_last_fault_reason = str(reason or "")
			self._stable_last_fault_mode_idx = fault_mode_idx
			self._stable_since_t = 0.0
			self._stable_waiting_good = True
			print(
				f"[RUN] fault #{int(self._stable_fault_count)} after "
				f"{self._format_run_duration(elapsed)} mode={fault_mode_idx} reason={reason}",
				flush=True,
			)
			try:
				self._fault_probe_and_log(str(reason or "fault"))
			except Exception as e:
				try:
					self._fault_log_line(f"[fault_probe] exception={e}")
				except Exception:
					pass
			return True
		except Exception:
			return False

	def _recent_stream_fault_for_mode_transition(self) -> bool:
		"""True only for automatic fallback after a fault that started in mode 6."""
		now = time.time()
		try:
			click_idx = int(getattr(self, "_last_mode_button_click_idx", -1) or -1)
			click_t = float(getattr(self, "_last_mode_button_click_t", 0.0) or 0.0)
			if click_idx in (3, 5) and click_t > 0.0 and (now - click_t) < 2.0:
				return False
		except Exception:
			pass
		try:
			last_t_for_click = float(getattr(self, "_stable_last_fault_t", 0.0) or 0.0)
			click_idx = int(getattr(self, "_last_mode_button_click_idx", -1) or -1)
			click_t = float(getattr(self, "_last_mode_button_click_t", 0.0) or 0.0)
			if click_idx in (3, 5) and last_t_for_click > 0.0 and click_t >= last_t_for_click:
				return False
		except Exception:
			pass
		try:
			if bool(getattr(self, "_auto_reset_just_occurred", False)):
				restore_idx = int(getattr(self, "_auto_reset_restore_idx", 0) or 0)
				origin_mode = int(getattr(self, "_stable_last_fault_mode_idx", -1) or -1)
				if restore_idx == 6 and origin_mode == 6:
					return True
		except Exception:
			pass
		try:
			window_s = float(os.getenv("BMI30_FAULT_MODE_TRANSITION_WINDOW_S", "30.0"))
		except Exception:
			window_s = 30.0
		try:
			last_t = float(getattr(self, "_stable_last_fault_t", 0.0) or 0.0)
		except Exception:
			last_t = 0.0
		try:
			click_idx = int(getattr(self, "_last_mode_button_click_idx", -1) or -1)
			click_t = float(getattr(self, "_last_mode_button_click_t", 0.0) or 0.0)
			if click_idx in (3, 5) and last_t > 0.0 and click_t >= last_t:
				return False
		except Exception:
			pass
		try:
			last_mode = int(getattr(self, "_stable_last_fault_mode_idx", -1) or -1)
		except Exception:
			last_mode = -1
		try:
			if last_mode == 6 and last_t > 0.0 and window_s > 0.0 and (now - last_t) <= window_s:
				return True
		except Exception:
			pass
		return False

	def _fault_mode_counter_text(self) -> str:
		try:
			counts = getattr(self, "_stream_fault_mode_counts", {}) or {}
			c3 = int(counts.get(3, 0) or 0)
			c5 = int(counts.get(5, 0) or 0)
			return f" | F3:{c3} F5:{c5}"
		except Exception:
			pass
		return " | F3:0 F5:0"

	def _record_fault_mode_transition(self, idx: int, reason: str = "", source: str = "") -> bool:
		"""Count fault recoveries that forced the UI into mode 3/5."""
		try:
			idx = int(idx)
		except Exception:
			return False
		if idx not in (3, 5):
			return False
		if not bool(self._recent_stream_fault_for_mode_transition()):
			return False
		now = time.time()
		try:
			counts = getattr(self, "_stream_fault_mode_counts", None)
			if not isinstance(counts, dict):
				counts = {3: 0, 5: 0}
				self._stream_fault_mode_counts = counts
		except Exception:
			counts = {3: 0, 5: 0}
			self._stream_fault_mode_counts = counts
		try:
			fault_id = int(getattr(self, "_stable_fault_count", 0) or 0)
		except Exception:
			fault_id = 0
		try:
			origin_mode = int(getattr(self, "_stable_last_fault_mode_idx", -1) or -1)
		except Exception:
			origin_mode = -1
		key = (idx, fault_id) if fault_id > 0 else (idx, int(now // 2))
		try:
			counted = getattr(self, "_stream_fault_mode_counted_keys", None)
			if not isinstance(counted, set):
				counted = set()
				self._stream_fault_mode_counted_keys = counted
			if key in counted:
				return False
			counted.add(key)
			if len(counted) > 256:
				self._stream_fault_mode_counted_keys = set(list(counted)[-128:])
		except Exception:
			pass
		try:
			counts[idx] = int(counts.get(idx, 0) or 0) + 1
		except Exception:
			counts[idx] = 1
		try:
			reason_s = str(reason or "")
			source_s = str(source or "")
			self._stream_fault_mode_last = f"mode={idx} reason={reason_s} source={source_s}"
			self._stream_fault_mode_last_t = now
			self._fault_log_line(
				f"[fault_mode_transition] ts={self._fault_timestamp()} mode={idx} "
				f"count3={int(counts.get(3, 0) or 0)} count5={int(counts.get(5, 0) or 0)} "
				f"fault_id={fault_id} origin_mode={origin_mode} source={source_s} reason={reason_s}"
			)
			print(
				f"[fault-mode] fallback to mode {idx}: "
				f"F3={int(counts.get(3, 0) or 0)} F5={int(counts.get(5, 0) or 0)} "
				f"reason={reason_s}",
				flush=True,
			)
		except Exception:
			pass
		return True

	def _runtime_run_text(self, now_t: float | None = None) -> str:
		try:
			now = time.time() if now_t is None else float(now_t)
			start_t = float(getattr(self, '_stable_since_t', 0.0) or 0.0)
			if start_t <= 0.0 or bool(getattr(self, '_stable_waiting_good', True)):
				cur_txt = "--:--"
			else:
				cur_txt = self._format_run_duration(now - start_t)
			try:
				fault_count = int(getattr(self, '_stable_fault_count', 0) or 0)
			except Exception:
				fault_count = 0
			min_s = getattr(self, '_stable_min_s', None)
			if fault_count >= 2 and min_s is not None:
				cur_txt = f"{cur_txt}/{self._format_run_duration(float(min_s))}"
			return f"RUN:{cur_txt}"
		except Exception:
			return "RUN:--:--"

	def _maybe_auto_reset_on_stall(self, reason: str, idle_s: float):
		"""Авто-сброс STM32 при зависании потока (best-effort, с троттлингом)."""
		try:
			try:
				mode_idx = int(self.num_group.checkedId())
			except Exception:
				mode_idx = -1
			reason_s = str(reason or '')
			if bool(getattr(self, '_stream_user_stopped', False)):
				return
			if not bool(getattr(self, 'auto_reset_on_stall', False)):
				return
			if self.stream is None:
				return
			try:
				thr = float(getattr(self, 'stall_reset_after', 0.0) or 0.0)
			except Exception:
				thr = 0.0
			if mode_idx in (5, 6):
				try:
					thr = max(float(thr), float(os.getenv('BMI30_WD_MODES56_STALL_S', '5.0')))
				except Exception:
					thr = max(float(thr), 5.0)
			if thr <= 0 or float(idle_s) < thr:
				return
			if bool(getattr(self, '_stall_reset_inflight', False)):
				return
			now = time.time()
			try:
				cooldown = float(getattr(self, 'stall_reset_cooldown', 0.0) or 0.0)
			except Exception:
				cooldown = 0.0
			
			# На ранней стадии подключения (первые 5 сек) — это ускорение cooldown
			try:
				ct = float(self.connect_t or 0.0)
				if ct > 0 and (now - ct) < 5.0:
					cooldown = max(1.0, cooldown * 0.5)  # вполовину меньше cooldown
			except Exception:
				pass
			
			last_t = float(getattr(self, '_stall_reset_last_t', 0.0) or 0.0)
			if cooldown > 0 and (now - last_t) < cooldown:
				return
			try:
				restore_idx = int(self.num_group.checkedId())
			except Exception:
				restore_idx = 6
			if restore_idx not in (1, 2, 3, 4, 5, 6, 7):
				restore_idx = 6
			self._note_stream_fault(reason_s or "stall")
			try:
				probe_result = dict(getattr(self, "_last_fault_probe_result", {}) or {})
			except Exception:
				probe_result = {}
			verdict = str(probe_result.get("verdict") or "")
			try:
				self._auto_reset_restore_sound = self._sound_restore_target()
			except Exception:
				self._auto_reset_restore_sound = None
			self._mute_detection_after_fault(reason_s or "stall")
			self._auto_reset_restore_idx = restore_idx
			self._sample_len_mode_pending = None
			self._sample_len_mode_sync_armed = True
			self._stall_reset_inflight = True
			self._stall_reset_last_t = now
			self._auto_reset_just_occurred = True
			try:
				if verdict == "host_bulk_lost":
					self._set_status(f"Bulk reader потерян ({reason}) — reopen без reset, возврат {restore_idx}…", hold_sec=2.5)
				elif verdict == "stream_stopped":
					self._set_status(f"Поток остановлен ({reason}) — повтор конфигурации режима {restore_idx}…", hold_sec=2.5)
				elif verdict in ("stm32_tx_stalled", "stm32_adc_stalled"):
					self._set_status(f"STM32 TX/ADC stall ({reason}) — soft recovery, возврат {restore_idx}…", hold_sec=2.5)
				elif verdict == "usb_control_lost":
					self._set_status(f"USB control потерян ({reason}) — жду re-enum, возврат {restore_idx}…", hold_sec=2.5)
				else:
					self._set_status(f"Поток пропал ({reason}) — reopen/recovery, возврат {restore_idx}…", hold_sec=2.5)
			except Exception:
				pass

			def _worker():
				try:
					if verdict == "host_bulk_lost":
						self._log_recovery_action("bulk_reopen", reason_s or "stall")
						try:
							self._preserve_mode_on_next_disconnect = True
							self._usb_err_need_hw_reset = False
							self._skip_next_disconnected_hw_reset = True
						except Exception:
							pass
						try:
							if self.stream is not None:
								self.stream.disconnected = True
						except Exception:
							pass
					elif verdict == "stream_stopped":
						self._log_recovery_action("restore_config_start", reason_s or "stall")
						try:
							self._apply_desired_stream_config(start=True, stop_first=False, source="stream_stopped")
						except Exception as e:
							print(f"[recovery] restore_config_start failed: {e}", flush=True)
							try:
								if self.stream is not None:
									self.stream.disconnected = True
							except Exception:
								pass
					elif verdict in ("stm32_tx_stalled", "stm32_adc_stalled"):
						self._log_recovery_action("soft_reset_reconnect", f"{reason_s or 'stall'}:{verdict}")
						try:
							self._soft_recover_stm32_stream(f"{reason_s or 'stall'}:{verdict}")
						except Exception as e:
							print(f"[SOFT-RECOVERY] worker failed: {e}", flush=True)
						try:
							self._usb_err_need_hw_reset = False
							self._skip_next_disconnected_hw_reset = True
						except Exception:
							pass
						try:
							if self.stream is not None:
								self.stream.disconnected = True
						except Exception:
							pass
					elif verdict == "usb_control_lost":
						self._log_recovery_action("wait_reenum", reason_s or "stall")
						try:
							self._usb_err_need_hw_reset = False
							self._skip_next_disconnected_hw_reset = True
							self._set_usb_reconnect_backoff(float(os.getenv("BMI30_USB_REENUM_BACKOFF_S", "0.8")), reason_s or "usb_control_lost")
						except Exception:
							pass
						try:
							if self.stream is not None:
								self.stream.disconnected = True
						except Exception:
							pass
					else:
						self._log_recovery_action("bulk_reopen_unknown", reason_s or "stall")
						try:
							self._usb_err_need_hw_reset = False
							self._skip_next_disconnected_hw_reset = True
						except Exception:
							pass
						try:
							if self.stream is not None:
								self.stream.disconnected = True
						except Exception:
							pass
				finally:
					try:
						self._stall_reset_inflight = False
					except Exception:
						pass

			threading.Thread(target=_worker, daemon=True).start()
		except Exception:
			try:
				self._stall_reset_inflight = False
			except Exception:
				pass

	def _init_det_gpio(self):
		"""Initialize the single shared non-addressable detection LED on GPIO22."""
		self._det_gpio_backend = None
		self._det_gpio_chip = None
		self._det_gpio_last_a = None
		self._det_gpio_last_b = None
		try:
			self._det_gpio_pin_b = int(os.getenv("BMI30_NON_ADDRESSABLE_LED_GPIO", os.getenv("BMI30_DET_GPIO_B", "22")))
		except Exception:
			self._det_gpio_pin_b = 22
		# Try lgpio first
		chip = None
		try:
			import lgpio  # type: ignore
			chip = lgpio.gpiochip_open(0)
			lgpio.gpio_claim_output(chip, int(self._det_gpio_pin_b), 0)
			self._det_gpio_backend = 'lgpio'
			self._det_gpio_chip = chip
			return
		except Exception as exc:
			if chip is not None:
				try:
					lgpio.gpiochip_close(chip)
				except Exception:
					pass
			print(f"[GPIO22] lgpio init failed: {exc}", flush=True)
		# Fallback: RPi.GPIO
		try:
			import RPi.GPIO as GPIO  # type: ignore
			GPIO.setwarnings(False)
			GPIO.setmode(GPIO.BCM)
			GPIO.setup(int(self._det_gpio_pin_b), GPIO.OUT, initial=GPIO.LOW)
			self._det_gpio_backend = 'rpi'
			self._det_gpio_chip = GPIO
			return
		except Exception as exc:
			print(f"[GPIO22] RPi.GPIO init failed: {exc}", flush=True)
			self._det_gpio_backend = None
			self._det_gpio_chip = None

	def _set_det_gpio(self, a_on: bool, b_on: bool):
		"""Set detection GPIOs; GPIO22 is the shared optional detection indicator."""
		try:
			requested_a = bool(a_on)
			requested_b = bool(b_on)
			self._det_gpio_requested_a = requested_a
			self._det_gpio_requested_b = requested_b
			b_on = bool(getattr(self, '_non_addressable_led_test_enabled', False)) or (
				bool(getattr(self, '_non_addressable_led_enabled', True))
				and bool(requested_a or requested_b)
			)
			if self._det_gpio_backend is None:
				return
			if self._det_gpio_last_b == b_on:
				self._det_gpio_last_a = requested_a
				return
			self._det_gpio_last_a = requested_a
			self._det_gpio_last_b = b_on
			if self._det_gpio_backend == 'lgpio':
				import lgpio  # type: ignore
				chip = self._det_gpio_chip
				lgpio.gpio_write(chip, int(self._det_gpio_pin_b), 1 if b_on else 0)
				return
			if self._det_gpio_backend == 'rpi':
				GPIO = self._det_gpio_chip
				GPIO.output(int(self._det_gpio_pin_b), GPIO.HIGH if b_on else GPIO.LOW)
				return
		except Exception:
			pass

	def _non_addressable_led_snapshot(self) -> dict:
		enabled = bool(getattr(self, '_non_addressable_led_enabled', True))
		test_enabled = bool(getattr(self, '_non_addressable_led_test_enabled', False))
		detection_active = bool(
			getattr(self, '_det_gpio_requested_a', False)
			or getattr(self, '_det_gpio_requested_b', False)
		)
		return {
			"enabled": enabled,
			"test_enabled": test_enabled,
			"detection_active": detection_active,
			"level": 1 if (test_enabled or (enabled and detection_active)) else 0,
			"gpio": int(getattr(self, '_det_gpio_pin_b', 22) or 22),
			"available": bool(getattr(self, '_det_gpio_backend', None)),
			"backend": str(getattr(self, '_det_gpio_backend', '') or ''),
		}

	def _set_non_addressable_led(self, enabled=None, test_enabled=None, persist: bool = False) -> dict:
		if enabled is not None:
			self._non_addressable_led_enabled = bool(enabled)
		if test_enabled is not None:
			self._non_addressable_led_test_enabled = bool(test_enabled)
		if bool(persist):
			save_non_addressable_led_enabled(bool(getattr(self, '_non_addressable_led_enabled', True)))
		self._set_det_gpio(
			bool(getattr(self, '_det_gpio_requested_a', False)),
			bool(getattr(self, '_det_gpio_requested_b', False)),
		)
		return self._non_addressable_led_snapshot()

	def _cleanup_det_gpio(self):
		"""Drive the shared indicator low and release GPIO22."""
		try:
			if self._det_gpio_backend == 'lgpio':
				import lgpio  # type: ignore
				try:
					lgpio.gpio_write(self._det_gpio_chip, int(self._det_gpio_pin_b), 0)
				except Exception:
					pass
				try:
					lgpio.gpiochip_close(self._det_gpio_chip)
				except Exception:
					pass
			elif self._det_gpio_backend == 'rpi':
				GPIO = self._det_gpio_chip
				try:
					GPIO.output(int(self._det_gpio_pin_b), GPIO.LOW)
				except Exception:
					pass
				try:
					GPIO.cleanup(int(self._det_gpio_pin_b))
				except Exception:
					pass
		except Exception:
			pass

	def _reset_phase_splitter(self, reason: str = ""):
		"""Reset host-side even/odd splitter state.
		
		Why:
		- Stream restarts (STOP/START, reconnects) can re-anchor the device phase.
		- If we keep toggling across restarts, the displayed even/odd can appear to swap.
		
		We bias the *first* new frame after reset to be EVEN (par=0).
		"""
		try:
			# Make first non-duplicate return par=0:
			# toggle starts at 1, then toggles to 0 on first frame.
			self._phase_toggle_a = 1
			self._phase_toggle_b = 1
			self._phase_last_seq_a = None
			self._phase_last_seq_b = None
			self._phase_last_ts_a = None
			self._phase_last_ts_b = None
			self._phase_last_par_a = None
			self._phase_last_par_b = None
			self._phase_repeat_a = 0
			self._phase_repeat_b = 0
			self._phase_trace_n = 0
			# Also reset validity markers so GUI won't show stale phase buffers.
			self.seq0_even = None
			self.seq0_odd = None
			self.seq1_even = None
			self.seq1_odd = None
			# Clear buffers (optional but helps avoid confusing stale plots)
			try:
				self.data0_even[:] = 0
				self.data0_odd[:] = 0
				self.data1_even[:] = 0
				self.data1_odd[:] = 0
			except Exception:
				pass
			if getattr(self, 'phase_trace', False):
				msg = f"[PHASE_RESET] {reason}".strip()
				print(msg, flush=True)
		except Exception:
			pass

	def _xcorr_even_inverted(self, even: np.ndarray, odd: np.ndarray):
		"""Compute cross-correlation between `even` and inverted `odd`.
		Returns (best_shift, best_sum, norm_corr_full, best_prod_array).
		- even, odd: 1D arrays of equal length N
		- best_shift: integer in [-(N-1)..(N-1)] (odd index = i + shift)
		- best_sum: raw (un-normalized) sum at best_shift
		- norm_corr_full: float array length 2N-1 (normalized correlation)
		- best_prod_array: length N array with per-sample products for best_shift,
		  zeros outside overlap.
		"""
		try:
			N = int(len(even))
			if N != len(odd):
				raise ValueError("even and odd must have same length")
			# convert to signed centered values (0..65535 -> around 0)
			even_s = even.astype(np.int64) - 32768
			odd_s = odd.astype(np.int64) - 32768
			# invert odd arithmetically
			odd_inv = -odd_s

			# raw cross-correlation (lags -(N-1)..(N-1))
			corr = np.correlate(even_s, odd_inv, mode='full')  # int64

			# energy for normalization: sliding sums of squared samples
			even_sq = (even_s * even_s).astype(np.int64)
			odd_sq = (odd_inv * odd_inv).astype(np.int64)
			ones = np.ones(N, dtype=np.int64)
			sum_even_sq = np.convolve(even_sq, ones, mode='full').astype(np.float64)
			sum_odd_sq = np.convolve(odd_sq, ones, mode='full').astype(np.float64)
			den = np.sqrt(sum_even_sq * sum_odd_sq)
			# avoid div by zero
			with np.errstate(invalid='ignore', divide='ignore'):
				norm_corr = corr.astype(np.float64) / (den + 1e-12)

			# choose best lag by absolute normalized correlation (scan full range)
			# this avoids selecting edge zeros and finds strongest match magnitude
			with np.errstate(invalid='ignore'):
				abs_norm = np.abs(norm_corr)
			# if all NaN/zero, fall back to raw corr
			if np.all(np.isnan(abs_norm)) or np.nanmax(abs_norm) == 0:
				best_idx = int(np.argmax(corr))
				best_sum = float(corr[best_idx])
			else:
				best_idx = int(np.nanargmax(abs_norm))
				best_sum = float(norm_corr[best_idx])
			best_shift = best_idx - (N - 1)

			# build per-sample product array for that shift (zeros outside overlap)
			prod = np.zeros(N, dtype=np.float64)
			L = best_shift
			if L >= 0:
				# odd index = i + L in [0..N-1] => i in [0..N-1-L]
				end = N - L
				if end > 0:
					_i = np.arange(0, end)
					prod[_i] = (even_s[_i].astype(np.float64) * odd_inv[_i + L].astype(np.float64))
			else:
				# L < 0: odd index = i + L => i starts at -L
				start = -L
				if start < N:
					_i = np.arange(start, N)
					prod[_i] = (even_s[_i].astype(np.float64) * odd_inv[_i + L].astype(np.float64))

			return best_shift, best_sum, norm_corr, prod
		except Exception:
			# on error, return safe defaults
			N = int(len(even)) if hasattr(even, '__len__') else 0
			return 0, 0.0, np.zeros(2 * N - 1, dtype=np.float64), np.zeros(N, dtype=np.float64)

	def _find_optimal_phase_shift(self, even: np.ndarray, odd: np.ndarray, channel_name: str = ""):
		"""Find optimal phase shift between even and inverted odd by iterating all shifts.
		
		For each shift, compute element-wise product of even and shifted inverted odd,
		then find the shift that gives maximum positive sum of all products.
		
		Args:
			even: 1D array of even samples (0..65535)
			odd: 1D array of odd samples (0..65535)
			channel_name: "ADC0" or "ADC1" for debug output
		
		Returns:
			tuple: (best_shift, peak_idx, max_sum, best_prod_array)
			- best_shift: integer shift in samples (negative = shift odd left, positive = shift odd right)
			- peak_idx: sample index of maximum in best_prod_array
			- max_sum: sum of all products at best_shift
			- best_prod_array: length N array with per-sample products at best_shift
		"""
		try:
			N = int(len(even))
			if N != len(odd) or N == 0:
				return 0, 0, 0.0, np.zeros(N, dtype=np.float64)

			# Convert to signed centered values (0..65535 -> around 0)
			even_s = even.astype(np.int64) - 32768
			odd_s = odd.astype(np.int64) - 32768
			# Invert odd arithmetically
			odd_inv = -odd_s

			# Scan range: either full or limited by env
			max_shift = int(getattr(self, 'phase_search_max_shift', 0) or 0)
			if max_shift <= 0:
				shift_start = -(N - 1)
				shift_end = N - 1
			else:
				max_shift = min(max_shift, N - 1)
				shift_start = -max_shift
				shift_end = max_shift

			best_shift = 0
			max_sum = -np.inf

			# Compute sum for each shift WITHOUT allocating full prod array per shift
			for shift in range(shift_start, shift_end + 1):
				if shift >= 0:
					end = N - shift
					if end <= 0:
						continue
					current_sum = float(np.dot(even_s[:end], odd_inv[shift:shift + end]))
				else:
					start = -shift
					if start >= N:
						continue
					# overlap length = N-start
					current_sum = float(np.dot(even_s[start:], odd_inv[:N - start]))

				if current_sum > max_sum:
					max_sum = current_sum
					best_shift = shift

			# Build product array only once for best_shift
			best_prod = np.zeros(N, dtype=np.float64)
			if best_shift >= 0:
				end = N - best_shift
				if end > 0:
					best_prod[:end] = (even_s[:end].astype(np.float64) * odd_inv[best_shift:best_shift + end].astype(np.float64))
			else:
				start = -best_shift
				if start < N:
					best_prod[start:] = (even_s[start:].astype(np.float64) * odd_inv[:N - start].astype(np.float64))

			# Peak index: maximum POSITIVE value (as per requirement)
			best_peak_idx = int(np.argmax(best_prod)) if best_prod.size else 0

			if bool(getattr(self, 'xcorr_debug', False)):
				print(f"[PHASE_SHIFT_{channel_name}] best_shift={best_shift} peak_idx={best_peak_idx} max_sum={max_sum:.2e}", flush=True)

			return best_shift, best_peak_idx, max_sum, best_prod
		except Exception as e:
			if bool(getattr(self, 'xcorr_debug', False)):
				print(f"[PHASE_SHIFT_{channel_name}] ERROR: {e}", flush=True)
			N = int(len(even)) if hasattr(even, '__len__') else 0
			return 0, 0, 0.0, np.zeros(N, dtype=np.float64)

	def _phase_search_thread_main(self):
		"""Single long-lived worker: always processes the latest requested buffers.

		Important: this avoids spawning a new thread per packet. If packets arrive faster
		than computation, intermediate requests are dropped and only the latest snapshot
		is processed (which is what we want for live oscilloscope).
		"""
		try:
			if bool(getattr(self, 'xcorr_debug', False)):
				print("[PHASE_WORKER] thread started", flush=True)
			while True:
				self._phase_search_event.wait()
				self._phase_search_event.clear()
				if getattr(self, '_phase_search_stop', False):
					return
				with self._phase_search_req_lock:
					payload = self._phase_search_latest
					self._phase_search_latest = None
				if payload is None:
					continue
				N, e0, o0, e1, o1 = payload
				self._phase_search_running = True

				# Compute optimal phase shift for ADC0/ADC1
				shift0, peak_idx0, max_sum0, prod0 = self._find_optimal_phase_shift(e0, o0, "ADC0")
				shift1, peak_idx1, max_sum1, prod1 = self._find_optimal_phase_shift(e1, o1, "ADC1")

				with self.data_lock:
					self._phase_shift_adc0 = shift0
					self._phase_peak_idx_adc0 = peak_idx0
					self._phase_max_sum_adc0 = max_sum0
					if self._phase_prod_adc0 is None or len(self._phase_prod_adc0) != N:
						self._phase_prod_adc0 = np.zeros(N, dtype=np.float64)
					self._phase_prod_adc0[:N] = prod0[:N]

					self._phase_shift_adc1 = shift1
					self._phase_peak_idx_adc1 = peak_idx1
					self._phase_max_sum_adc1 = max_sum1
					if self._phase_prod_adc1 is None or len(self._phase_prod_adc1) != N:
						self._phase_prod_adc1 = np.zeros(N, dtype=np.float64)
					self._phase_prod_adc1[:N] = prod1[:N]

				if bool(getattr(self, 'xcorr_debug', False)):
					print(
						f"[PHASE_WORKER] done: ADC0 shift={shift0} sum={max_sum0:.2e} peak={peak_idx0}; "
						f"ADC1 shift={shift1} sum={max_sum1:.2e} peak={peak_idx1}",
						flush=True,
					)
				self._phase_search_running = False
		except Exception as e:
			self._phase_search_running = False
			if bool(getattr(self, 'xcorr_debug', False)):
				print(f"[PHASE_WORKER] ERROR: {e}", flush=True)

	def _ensure_phase_search_thread(self):
		if self._phase_search_thread is not None and self._phase_search_thread.is_alive():
			return
		self._phase_search_stop = False
		self._phase_search_thread = threading.Thread(target=self._phase_search_thread_main, daemon=True)
		self._phase_search_thread.start()

	def _request_phase_shift_search(self):
		"""Request (enqueue) phase shift search for the latest buffers.

		Called after each packet reception. This does not block and does not start
		new threads; it only updates the 'latest' snapshot for the worker.
		"""
		if not bool(getattr(self, 'phase_search_each_packet', True)):
			return
		if not bool(getattr(self, '_phase_search_enabled', False)):
			return
		# Copy current data under lock
		with self.data_lock:
			N = int(self.base_buf_len) if getattr(self, 'base_buf_len', None) else int(getattr(self, 'view_len', self.max_samples))
			N = max(1, min(N, self.max_samples))
			e0 = np.array(self.data0_even[:N], copy=True)
			o0 = np.array(self.data0_odd[:N], copy=True)
			e1 = np.array(self.data1_even[:N], copy=True)
			o1 = np.array(self.data1_odd[:N], copy=True)
		if N <= 1:
			return
		self._ensure_phase_search_thread()
		with self._phase_search_req_lock:
			self._phase_search_latest = (N, e0, o0, e1, o1)
		self._phase_search_event.set()

	def _on_num_clicked_extra(self, idx: int):
		"""Extra handler for numeric buttons — button 6 triggers cross-correlation display."""
		try:
			if int(idx) != 6:
				return
		except Exception:
			return

		# lazy-init timer for continuous recompute
		if not hasattr(self, '_corr_timer') or self._corr_timer is None:
			self._corr_timer = QtCore.QTimer()
			# call compute every 200 ms (5 Hz) — responsive but light
			self._corr_timer.setInterval(200)
			self._corr_timer.timeout.connect(self._compute_and_plot_xcorr)

		# if button is checked -> start continuous recompute, else stop
		try:
			if self.num_buttons[6].isChecked():
				try:
					show_xcorr = str(os.getenv('BMI30_REALTIME_SHOW_XCORR', '0')).lower() not in ('0', 'false', 'no')
				except Exception:
					show_xcorr = False
				if bool(getattr(self, 'realtime_prevbuf_detect', True)) and not show_xcorr:
					try:
						self.corr0.setVisible(True)
						self.corr1.setVisible(True)
					except Exception:
						pass
					try:
						self._corr_timer.stop()
					except Exception:
						pass
					try:
						self._rt_redraw_product_plots()
					except Exception:
						pass
					self._set_status('Realtime detect: product overlay', hold_sec=1.0)
					return
				# immediate compute once, then start timer
				# make correlation curves visible and compute
				try:
					self.corr0.setVisible(True)
					self.corr1.setVisible(True)
				except Exception:
					pass
				self._compute_and_plot_xcorr()
				self._corr_timer.start()
				self._set_status('XCorr: continuous', hold_sec=1.0)
			else:
				if hasattr(self, '_corr_timer'):
					self._corr_timer.stop()
				# hide and clear corr plots
				try:
					self.corr0.setData([], [])
					self.corr1.setData([], [])
					self.corr0.setVisible(False)
					self.corr1.setVisible(False)
				except Exception:
					pass
					# reset saved bests
					try:
						self._xcorr_saved_peak0 = 0.0
						self._xcorr_saved_peak1 = 0.0
						self._xcorr_saved_prod0.fill(0)
						self._xcorr_saved_prod1.fill(0)
					except Exception:
						pass
					self._set_status('XCorr: stopped', hold_sec=1.0)
		except Exception:
			pass

	def _compute_and_plot_xcorr(self):
		"""Compute cross-correlation for both channels and update plots/legend."""
		# Measure real update rate of this overlay (how often we actually redraw in mode 6)
		try:
			_now = time.time()
			self._xcorr_frames = int(getattr(self, '_xcorr_frames', 0)) + 1
			t0 = float(getattr(self, '_xcorr_fps_t0', _now))
			if (_now - t0) >= 1.0:
				self._xcorr_fps = float(self._xcorr_frames) / max(1e-6, (_now - t0))
				self._xcorr_frames = 0
				self._xcorr_fps_t0 = _now
		except Exception:
			pass

		with self.data_lock:
			N = int(self.base_buf_len) if getattr(self, 'base_buf_len', None) else int(getattr(self, 'view_len', self.max_samples))
			N = max(1, min(N, self.max_samples))
			# copy raw buffers (unsigned 0..65535 stored as ints) and keep as float for DC ops
			e0_raw = np.array(self.data0_even[:N], copy=True).astype(np.float64)
			o0_raw = np.array(self.data0_odd[:N], copy=True).astype(np.float64)
			e1_raw = np.array(self.data1_even[:N], copy=True).astype(np.float64)
			o1_raw = np.array(self.data1_odd[:N], copy=True).astype(np.float64)

		if N <= 1:
			return

		# Use raw inputs as-is (0..65535). Device already provides DC-compensated signals.
		# Keep *_raw arrays for computations and diagnostics; do not center/subtract DC here.
		e0 = e0_raw
		o0 = o0_raw
		e1 = e1_raw
		o1 = o1_raw

		# Diagnostic (optional): show means/std
		if bool(getattr(self, 'xcorr_debug', False)):
			try:
				print(f"[XCORR] N={N} stream_mode={getattr(self,'stream_mode',None)} avg_n={getattr(self,'avg_n',None)} avg20_enabled={getattr(self,'avg20_enabled',False)} dc_removal={getattr(self,'dc_removal_enabled',False)}")
				print(f"[XCORR] ch0 mean_even={float(np.mean(e0)):.2f} std_even={float(np.std(e0)):.2f} mean_odd={float(np.mean(o0)):.2f} std_odd={float(np.std(o0)):.2f}")
				print(f"[XCORR] ch1 mean_even={float(np.mean(e1)):.2f} std_even={float(np.std(e1)):.2f} mean_odd={float(np.mean(o1)):.2f} std_odd={float(np.std(o1)):.2f}")
			except Exception:
				pass

			# ---- Use optimal phase shift if available, otherwise simple per-sample product (no lag) ----
			# Compute centered product magnitude for display so detections always rise from zero.
			# В режиме XCorr-norm=ON показываем модуль продукта и авто-масштабируем от 0.
			# В режиме XCorr-norm=OFF фиксируем шкалу 0..65535 без сдвига к середине.
		try:
			# Check if optimal phase shift results are available.
			with self.data_lock:
				use_optimal = (self._phase_prod_adc0 is not None and self._phase_prod_adc1 is not None)
				if use_optimal:
					# Use pre-computed optimal phase-shifted products.
					prod0_center = np.array(self._phase_prod_adc0[:N], copy=True)
					prod1_center = np.array(self._phase_prod_adc1[:N], copy=True)
					shift0 = self._phase_shift_adc0
					shift1 = self._phase_shift_adc1
				else:
					shift0 = 0
					shift1 = 0

			if not use_optimal:
				# Fallback: compute simple per-sample product with no shift.
				# Center around 32768, then multiply the signed values.
				even0_c = e0_raw.astype(np.float64) - 32768.0
				odd0_c = o0_raw.astype(np.float64) - 32768.0
				even1_c = e1_raw.astype(np.float64) - 32768.0
				odd1_c = o1_raw.astype(np.float64) - 32768.0

				odd0_inv_c = -odd0_c
				odd1_inv_c = -odd1_c
				prod0_center = even0_c * odd0_inv_c
				prod1_center = even1_c * odd1_inv_c

			prod0_mag = np.abs(prod0_center)
			prod1_mag = np.abs(prod1_center)

			denom = (32768.0 * 32768.0)
			prod0_norm = prod0_mag / (denom + 1e-12)
			prod1_norm = prod1_mag / (denom + 1e-12)

			xcorr_norm = bool(getattr(self, 'xcorr_norm_enabled', False))
			if xcorr_norm:
				self._xcorr_prod_scale = 1.0
				prod0_raw = prod0_mag
				prod1_raw = prod1_mag
			else:
				try:
					scale = float(self._rt_product_display_scale())
				except Exception:
					scale = _rt_product_default_scale()
				if not np.isfinite(scale) or scale == 0.0:
					scale = _rt_product_default_scale()
				self._xcorr_prod_scale = float(scale)
				prod0_raw = prod0_mag / scale
				prod1_raw = prod1_mag / scale
				try:
					prod0_raw = np.clip(prod0_raw, 0.0, 65535.0)
					prod1_raw = np.clip(prod1_raw, 0.0, 65535.0)
				except Exception:
					pass

			# Keep signed product for diagnostics/legend; display uses magnitudes.
			prod0 = prod0_center
			prod1 = prod1_center
		except Exception:
			prod0_raw = np.zeros_like(e0_raw)
			prod1_raw = np.zeros_like(e1_raw)
			prod0 = np.zeros_like(e0_raw)
			prod1 = np.zeros_like(e1_raw)
			use_optimal = False
			shift0 = 0
			shift1 = 0

		# Only display correlation when button 6 is active; otherwise clear/hide
		try:
			if not (hasattr(self, 'num_buttons') and len(self.num_buttons) > 6 and self.num_buttons[6].isChecked()):
				# ensure cleared
				try:
					self.corr0.setData([], [])
					self.corr1.setData([], [])
				except Exception:
					pass
				return
		except Exception:
			# if anything goes wrong, bail safely
			return

			# prod0_raw/prod1_raw are product magnitudes for display; sanitize NaNs
		try:
			prod0_raw = np.nan_to_num(prod0_raw)
			prod1_raw = np.nan_to_num(prod1_raw)
		except Exception:
			prod0_raw = np.zeros(N, dtype=np.float64)
			prod1_raw = np.zeros(N, dtype=np.float64)
		# display length (pad to at least 200 for consistency)
		try:
			min_display = max(200, N)
			pad0 = np.zeros(min_display, dtype=np.float64)
			pad1 = np.zeros(min_display, dtype=np.float64)
			pad0[:N] = prod0_raw[:N]
			pad1[:N] = prod1_raw[:N]
			self._xcorr_saved_prod0[:min_display] = pad0
			self._xcorr_saved_prod1[:min_display] = pad1
		except Exception:
			min_display = N

		if bool(getattr(self, 'xcorr_debug', False)):
			try:
				print(f"[XCORR-PROD] signed ch0 min={float(np.min(prod0)):.3f} max={float(np.max(prod0)):.3f} mean={float(np.mean(prod0)):.3f}")
				print(f"[XCORR-PROD] signed ch1 min={float(np.min(prod1)):.3f} max={float(np.max(prod1)):.3f} mean={float(np.mean(prod1)):.3f}")
				print(f"[XCORR-DISP] ch0 disp prod min={float(np.min(prod0_raw)):.3f} max={float(np.max(prod0_raw)):.3f} mean={float(np.mean(prod0_raw)):.3f}")
				print(f"[XCORR-DISP] ch1 disp prod min={float(np.min(prod1_raw)):.3f} max={float(np.max(prod1_raw)):.3f} mean={float(np.mean(prod1_raw)):.3f}")
			except Exception:
				pass

		try:
			x = np.arange(0, min_display, dtype=np.int32)
			self.corr0.setData(x, self._xcorr_saved_prod0[:min_display])
			self.corr1.setData(x, self._xcorr_saved_prod1[:min_display])
			xcorr_norm = bool(getattr(self, 'xcorr_norm_enabled', False))
			try:
				if hasattr(self, 'vb_corr0'):
					if xcorr_norm:
						vals = self._xcorr_saved_prod0[:min_display]
						mag_cur = float(np.max(vals)) if vals.size else 1.0
						mag_cur = max(1.0, mag_cur)
						mag_prev = float(getattr(self, '_xcorr_mag0', mag_cur))
						mag = max(mag_cur, mag_prev * 0.90)
						self._xcorr_mag0 = mag
						self.vb_corr0.setYRange(0.0, mag * 1.05, padding=0.0)
					else:
						self.vb_corr0.setYRange(0.0, 65535.0, padding=0.0)
			except Exception:
				try:
					self.vb_corr0.autoRange()
				except Exception:
					pass
			try:
				if hasattr(self, 'vb_corr1'):
					if xcorr_norm:
						vals = self._xcorr_saved_prod1[:min_display]
						mag_cur = float(np.max(vals)) if vals.size else 1.0
						mag_cur = max(1.0, mag_cur)
						mag_prev = float(getattr(self, '_xcorr_mag1', mag_cur))
						mag = max(mag_cur, mag_prev * 0.90)
						self._xcorr_mag1 = mag
						self.vb_corr1.setYRange(0.0, mag * 1.05, padding=0.0)
					else:
						self.vb_corr1.setYRange(0.0, 65535.0, padding=0.0)
			except Exception:
				try:
					self.vb_corr1.autoRange()
				except Exception:
					pass
		except Exception:
			try:
				self.corr0.setData([], [])
				self.corr1.setData([], [])
			except Exception:
				pass

		# legend text is updated centrally in _tick (stable 3 lines)
		try:
			xcorr_norm = bool(getattr(self, 'xcorr_norm_enabled', False))
			mode = "norm" if xcorr_norm else "0..65535"
			try:
				_sc = float(getattr(self, '_xcorr_prod_scale', 1.0))
				if not np.isfinite(_sc) or _sc == 0.0:
					_sc = 1.0
			except Exception:
				_sc = 1.0
			mean0 = float(np.mean(prod0))
			mean1 = float(np.mean(prod1))
			if not xcorr_norm:
				mean0 = mean0 / _sc
				mean1 = mean1 / _sc
			if use_optimal:
				self._xcorr_last_summary = f"XCORR[{mode}] sh0={int(shift0)} sh1={int(shift1)} mean0={mean0:.1f} mean1={mean1:.1f}"
			else:
				self._xcorr_last_summary = f"XCORR[{mode}] no-shift mean0={mean0:.1f} mean1={mean1:.1f}"
		except Exception:
			self._xcorr_last_summary = "XCORR: error"

		# --- Signal detection hook: use product-array maximum (same data as corr graph) ---
		try:
			# Robust fallback: if centered product arrays are not available (due to earlier error),
			# fall back to whatever `prod0/prod1` contain (zeros-safe).
			try:
				prod0c = prod0_center
				prod1c = prod1_center
			except NameError:
				prod0c = prod0
				prod1c = prod1
			# Also track raw amplitude (what you visually see on the oscilloscope): abs(u16-32768)
			try:
				amp0 = float(max(np.nanmax(np.abs(e0_raw - 32768.0)), np.nanmax(np.abs(o0_raw - 32768.0))))
				amp1 = float(max(np.nanmax(np.abs(e1_raw - 32768.0)), np.nanmax(np.abs(o1_raw - 32768.0))))
				self._det_last_amp0 = int(max(0, min(32768, int(amp0))))
				self._det_last_amp1 = int(max(0, min(32768, int(amp1))))
			except Exception:
				pass
			# Always record raw product maxima for diagnostics (centered product units).
			try:
				with np.errstate(invalid='ignore'):
					self._det_last_prodmax0 = float(np.nanmax(np.abs(prod0c))) if prod0c is not None and getattr(prod0c, 'size', 0) else 0.0
					self._det_last_prodmax1 = float(np.nanmax(np.abs(prod1c))) if prod1c is not None and getattr(prod1c, 'size', 0) else 0.0
			except Exception:
				pass
				# In this realtime build, detection is driven by the USB reader:
				# every newly received buffer is compared with the previous real buffer.
			if not bool(getattr(self, 'realtime_prevbuf_detect', True)):
					src = str(getattr(self, '_det_source', 'norm') or 'norm').strip().lower()
					if src in ('raw', 'product'):
						src = 'prod'
					if src == 'prod':
						self._update_signal_detection(prod0c, prod1c, int(shift0), int(shift1), source='prod')
					else:
						self._update_signal_detection(prod0_norm, prod1_norm, int(shift0), int(shift1), source='norm')
			# Optional: continuous PWM output proportional to current phase shift while correlation view is active.
			try:
				if str(getattr(self, '_beep_mode', 'pattern')) == 'continuous':
					if not bool(self._sound_allowed()):
						self._stop_sound_now()
						return
					try:
						out0 = bool(self._det_output_active(0))
						out1 = bool(self._det_output_active(1))
					except Exception:
						out0 = out1 = False
					if not (out0 or out1):
						self._stop_sound_now()
						return
					# Choose a representative shift (largest magnitude) and map into a frequency band.
					s0 = int(shift0)
					s1 = int(shift1)
					if out0 and not out1:
						use_s = s0
					elif out1 and not out0:
						use_s = s1
					else:
						use_s = s0 if abs(s0) >= abs(s1) else s1
					# If shift is near zero, silence output to avoid constant tone.
					if abs(int(use_s)) <= 0:
						self._beeper.set_continuous(None)
					else:
						# Use a broad band so it's visible on scope.
						f = self._shift_to_beep_freq(use_s, 1000.0, 4000.0)
						self._beeper.set_continuous(float(f))
			except Exception:
				pass
		except Exception:
			pass

	def _device_set_dc_adapt(self, enabled: bool):
		"""Compatibility no-op: RPi core sends only SET_DC_SPEED (0x1F)."""
		return None

	def _device_calib_dc_fast(self, frames: int):
		"""Compatibility no-op: the lightning action selects 1000 ms on RPi."""
		return None

	def _det_reset_and_arm_warmup(self, reason: str = ""):
		"""Force detector into RUN state and arm warmup window.

		Goal: right after startup/connect, we should never remain FROZEN.
		Warmup starts from the first connection/stream start (not from GUI launch).
		"""
		_now = time.time()
		try:
			warm = float(getattr(self, '_det_warmup_sec', 2.0) or 0.0)
			if (not np.isfinite(warm)) or warm < 0.0:
				warm = 2.0
		except Exception:
			warm = 2.0
		try:
			self._det_warmup_until = float(_now + warm)
		except Exception:
			self._det_warmup_until = float(_now)
		try:
			self._det_warmup_dc_fix_last_t = 0.0
			self._det_dc_frozen = False
			self._det_hold0 = False
			self._det_hold1 = False
			self._det_exceed0 = 0
			self._det_exceed1 = 0
			self._det_freeze_thr0 = 0
			self._det_freeze_thr1 = 0
			# Reset threshold adaptation to avoid inheriting stale values across reconnects.
			# НО: если пороги уже были восстановлены (>0), сохраняем их для быстрой подстройки
			if not (hasattr(self, '_det_thr0') and self._det_thr0 > 0):
				self._det_thr0 = int(getattr(self, '_det_thr_init', 0) or 0)
			if not (hasattr(self, '_det_thr1') and self._det_thr1 > 0):
				self._det_thr1 = int(getattr(self, '_det_thr_init', 0) or 0)
			self._det_last_fire_t = 0.0
			self._det_last_present_t0 = float(_now)
			self._det_last_present_t1 = float(_now)
			self._rt_det_prev0 = None
			self._rt_det_prev1 = None
			self._det_reset_noise_accumulators()
		except Exception:
			pass
		# Best effort: ensure device DC adaptation is ON immediately.
		try:
			self._device_set_dc_adapt(True)
		except Exception:
			pass
		try:
			self._beep_hold_stop()
		except Exception:
			pass
		try:
			self._set_det_gpio(False, False)
		except Exception:
			pass

	def _arm_detector_noise_adaptation(self, reason: str = "", announce: bool = False, duration_s: float | None = None, reset_thr: bool | None = None):
		"""Arm fast detector threshold adaptation after automatic return to mode 6."""
		_now = time.time()
		if duration_s is None:
			try:
				adapt_s = float(os.getenv("BMI30_DETECT_AUTO_NOISE_ADAPT_SEC", os.getenv("BMI30_DETECT_FAST_SEC", "3.0")))
				if (not np.isfinite(adapt_s)) or adapt_s <= 0.0:
					adapt_s = 3.0
			except Exception:
				adapt_s = 3.0
		else:
			try:
				adapt_s = float(duration_s)
				if (not np.isfinite(adapt_s)) or adapt_s <= 0.0:
					adapt_s = 3.0
			except Exception:
				adapt_s = 3.0
		if reset_thr is None:
			try:
				reset_thr = _env_bool("BMI30_DETECT_AUTO_NOISE_RESET_THR", True)
			except Exception:
				reset_thr = True
		else:
			reset_thr = bool(reset_thr)
		try:
			if reset_thr:
				init_thr = int(getattr(self, "_det_thr_init", 0) or 0)
				self._det_thr0 = init_thr
				self._det_thr1 = init_thr
				self._det_saved_thr0 = init_thr
				self._det_saved_thr1 = init_thr
				self._det_reset_noise_accumulators()
			try:
				mode_idx = int(self.num_group.checkedId())
			except Exception:
				mode_idx = 6
			self._rt_detection_mode_enabled = bool(mode_idx >= 6)
			self._phase_search_enabled = bool(mode_idx >= 6 and not bool(getattr(self, 'realtime_prevbuf_detect', True)))
			if mode_idx >= 6 and bool(getattr(self, '_rt_det_process_enabled', False)):
				try:
					self._rt_detector_process_start()
				except Exception:
					pass
			self._det_exceed0 = 0
			self._det_exceed1 = 0
			self._det_exceed_peak0 = None
			self._det_exceed_peak1 = None
			self._det_hold0 = False
			self._det_hold1 = False
			self._prev_beep_state = False
			self._prev_freeze_state = False
			self._beep_consecutive0 = 0
			self._beep_consecutive1 = 0
			self._det_dc_frozen = False
			self._det_freeze_thr0 = 0
			self._det_freeze_thr1 = 0
			self._det_last_fire_t = 0.0
			self._det_fast_adapt_until = max(float(getattr(self, "_det_fast_adapt_until", 0.0) or 0.0), _now + adapt_s)
			self._det_warmup_until = max(float(getattr(self, "_det_warmup_until", 0.0) or 0.0), _now + adapt_s)
			self._det_warmup_dc_fix_last_t = 0.0
			self._rt_det_prev0 = None
			self._rt_det_prev1 = None
		except Exception:
			pass
		try:
			self._device_set_dc_adapt(True)
		except Exception:
			pass
		try:
			self._rt_stop_detection_outputs()
		except Exception:
			pass
		try:
			self._beep_hold_stop()
		except Exception:
			pass
		try:
			self._set_det_gpio(False, False)
		except Exception:
			pass
		try:
			print(f"[DETECT] noise adaptation armed {adapt_s:.1f}s reason={reason}", flush=True)
			self._fault_log_line(
				f"[detect_noise_adapt] ts={self._fault_timestamp()} seconds={adapt_s:.3f} "
				f"reset_thr={int(bool(reset_thr))} reason={reason}"
			)
		except Exception:
			pass
		if announce:
			try:
				self._set_status(f"Адаптация шумов ~{adapt_s:.1f}с", hold_sec=2.0)
			except Exception:
				pass

	def _schedule_detector_noise_adaptation(self, reason: str = "", mode_guard: int = 6, reset_thr: bool | None = None):
		"""Wait for post-switch settling, then arm detector noise adaptation."""
		now = time.time()
		try:
			settle_s = float(os.getenv("BMI30_DETECT_AUTO_NOISE_SETTLE_S", "0.3"))
			if (not np.isfinite(settle_s)) or settle_s < 0.0:
				settle_s = 0.3
		except Exception:
			settle_s = 0.3
		try:
			adapt_s = float(os.getenv("BMI30_DETECT_AUTO_NOISE_ADAPT_SEC", os.getenv("BMI30_DETECT_FAST_SEC", "1.0")))
			if (not np.isfinite(adapt_s)) or adapt_s <= 0.0:
				adapt_s = 1.0
		except Exception:
			adapt_s = 1.0
		try:
			mode_guard = int(mode_guard)
		except Exception:
			mode_guard = 6
		try:
			self._noise_adapt_schedule_seq = int(getattr(self, "_noise_adapt_schedule_seq", 0) or 0) + 1
		except Exception:
			self._noise_adapt_schedule_seq = 1
		try:
			self._noise_adapt_pending_t = now + max(0.0, float(settle_s))
			self._noise_adapt_pending_reason = str(reason or "")
			self._noise_adapt_pending_mode_guard = int(mode_guard)
			self._noise_adapt_pending_reset_thr = reset_thr
		except Exception:
			pass
		try:
			self._det_noise_settle_until = now + max(0.0, float(settle_s))
			self._arm_detector_noise_adaptation(
				f"scheduled_total:{reason}",
				announce=False,
				duration_s=max(float(adapt_s), float(settle_s) + float(adapt_s)),
				reset_thr=reset_thr,
			)
			self._rt_stop_detection_outputs()
			self._beep_hold_stop()
			self._set_det_gpio(False, False)
		except Exception:
			pass
		if settle_s <= 0.0:
			self._process_scheduled_detector_noise_adaptation(force=True)
			return
		try:
			self._set_status(f"Стабилизация после переключения {settle_s:.1f}с, затем адаптация шумов…", hold_sec=max(1.0, min(3.0, settle_s + 0.4)))
		except Exception:
			pass
		try:
			print(f"[DETECT] noise adaptation scheduled settle={settle_s:.1f}s reason={reason}", flush=True)
			self._fault_log_line(
				f"[detect_noise_adapt_schedule] ts={self._fault_timestamp()} settle_s={settle_s:.3f} "
				f"adapt_s={adapt_s:.3f} mode_guard={mode_guard} reason={reason}"
			)
		except Exception:
			pass

	def _process_scheduled_detector_noise_adaptation(self, force: bool = False):
		"""Start pending post-settle noise adaptation from the GUI tick."""
		try:
			pending_t = float(getattr(self, "_noise_adapt_pending_t", 0.0) or 0.0)
		except Exception:
			pending_t = 0.0
		if pending_t <= 0.0:
			return
		now = time.time()
		if (not force) and now < pending_t:
			return
		try:
			mode_guard = int(getattr(self, "_noise_adapt_pending_mode_guard", 6) or 6)
		except Exception:
			mode_guard = 6
		try:
			reason = str(getattr(self, "_noise_adapt_pending_reason", "") or "")
		except Exception:
			reason = ""
		self._noise_adapt_pending_t = 0.0
		self._noise_adapt_pending_reason = ""
		try:
			reset_thr = getattr(self, "_noise_adapt_pending_reset_thr", None)
			self._noise_adapt_pending_reset_thr = None
		except Exception:
			reset_thr = None
		try:
			if int(self.num_group.checkedId()) != int(mode_guard):
				print(f"[DETECT] noise adaptation skipped: mode changed from guard {mode_guard}", flush=True)
				self._fault_log_line(
					f"[detect_noise_adapt_skip] ts={self._fault_timestamp()} mode_guard={mode_guard} reason={reason}"
				)
				return
		except Exception:
			return
		try:
			self._arm_detector_noise_adaptation(f"settled:{reason}", announce=True, reset_thr=reset_thr)
		except Exception as e:
			try:
				print(f"[DETECT] scheduled noise adaptation failed: {e}", flush=True)
			except Exception:
				pass

	def _shift_to_beep_freq(self, shift: int, f_min: float, f_max: float) -> float:
		"""Map absolute phase shift into a frequency within [f_min..f_max]."""
		try:
			max_shift = int(getattr(self, 'phase_search_max_shift', 0) or 0)
		except Exception:
			max_shift = 0
		den = float(max_shift) if max_shift > 0 else 32.0
		frac = min(1.0, max(0.0, float(abs(int(shift))) / den))
		return float(f_min + frac * (float(f_max) - float(f_min)))

	def _current_mode_idx(self) -> int:
		try:
			return int(self.num_group.checkedId())
		except Exception:
			try:
				return int(getattr(self, '_det_last_mode_idx', 0) or 0)
			except Exception:
				return 0

	def _sound_allowed(self) -> bool:
		"""True only when the user enabled sound and GUI mode is 6+."""
		try:
			if hasattr(self, 'btn_pwm'):
				self._sound_enabled = bool(self.btn_pwm.isChecked())
		except Exception:
			pass
		try:
			if not bool(getattr(self, '_sound_enabled', False)):
				return False
			if bool(getattr(self, '_sound_test_enabled', False)):
				return True
			if int(self._current_mode_idx()) < 6:
				return False
			if not bool(getattr(self, '_det_enabled', False)):
				return False
			return True
		except Exception:
			return False

	def _stop_sound_now(self):
		"""Immediately stop PWM and cancel any pending/repeating pattern."""
		try:
			self._sound_test_enabled = False
			self._sound_test_upper_enabled = False
			self._sound_test_lower_enabled = False
			self._beep_hold_active = False
			self._beep_hold_base_freq = 0.0
			self._beep_hold_freq = 0.0
			self._beep_hold_after_t = 0.0
			self._beep_hold_output_started = False
			self._beep_hold_channel = -1
			self._beep_hold_min_until_t = 0.0
			self._beep_hold_stop_requested = False
			self._beep_hold_filter_cycles = 0
			self._beep_info_busy_until = 0.0
			self._beep_force_enabled = False
			self._beep_force_mode = 0
		except Exception:
			pass
		try:
			stop_now = getattr(self._beeper, 'stop_now', None)
			if callable(stop_now):
				stop_now()
			else:
				self._beeper.set_continuous(None)
		except Exception:
			pass

	def _hardware_sound_output_active(self) -> bool:
		"""True only while the dedicated hardware PWM channel is physically enabled."""
		try:
			beeper = getattr(self, "_beeper", None)
			return bool(
				beeper is not None
				and getattr(beeper, "_backend", None) == "hw_pwm"
				and getattr(beeper, "_hw_pwm_enabled", False)
			)
		except Exception:
			return False

