_RT_ADC_CENTER = 32768.0
_RT_U16_MAX = 65535.0
_RT_PRODUCT_FULL_SCALE = _RT_ADC_CENTER * _RT_ADC_CENTER
_RT_PRODUCT_FULLSCALE_U16_SCALE = _RT_PRODUCT_FULL_SCALE / _RT_U16_MAX
_RT_DETECT_LEVEL_MAX = (1 << 63) - 1


def _rt_product_default_scale() -> float:
	return float(_RT_PRODUCT_FULLSCALE_U16_SCALE)


def _rt_detector_legacy_level_scale(level_scale: float | None = None) -> float:
	try:
		scale = float(level_scale if level_scale is not None else 0.0)
	except Exception:
		scale = 0.0
	if scale <= 0.0:
		try:
			scale = float(os.getenv('BMI30_DETECT_LEVEL_SCALE', '') or 0.0)
		except Exception:
			scale = 0.0
	if scale <= 0.0:
		try:
			scale = float(os.getenv('BMI30_PROD_SCALE', '') or _rt_product_default_scale())
		except Exception:
			scale = _rt_product_default_scale()
	if not np.isfinite(scale) or scale <= 0.0:
		scale = _rt_product_default_scale()
	return float(scale)


def _rt_clamp_detector_level(value, default: int = 0, minimum: int = 0) -> int:
	try:
		if isinstance(value, (int, np.integer)):
			val = int(value)
		else:
			val = int(round(float(value)))
	except Exception:
		val = int(default)
	if val < int(minimum):
		val = int(minimum)
	if val > _RT_DETECT_LEVEL_MAX:
		return int(_RT_DETECT_LEVEL_MAX)
	return int(val)


def _rt_legacy_level_to_product_units(value, level_scale: float | None = None, minimum: int = 0) -> int:
	try:
		val = float(value)
	except Exception:
		val = 0.0
	if not np.isfinite(val):
		val = 0.0
	if val <= 0.0 and int(minimum) <= 0:
		return 0
	scale = _rt_detector_legacy_level_scale(level_scale)
	return _rt_clamp_detector_level(val * scale, default=int(minimum), minimum=int(minimum))


def _rt_detector_level_from_peak(peak_value: float, source: str, level_scale: float) -> int:
	try:
		mx = float(peak_value)
	except Exception:
		mx = 0.0
	if not np.isfinite(mx) or mx <= 0.0:
		return 0
	return _rt_clamp_detector_level(mx)


def _rt_product_abs_array(prod_arr):
	try:
		arr = np.asarray(prod_arr)
		if arr.size <= 0:
			return arr
		if np.issubdtype(arr.dtype, np.integer):
			try:
				if int(np.min(arr)) >= 0:
					return arr
			except Exception:
				pass
			return np.abs(arr)
		arr = arr.astype(np.float32, copy=False)
		arr = np.nan_to_num(arr, nan=0.0, posinf=0.0, neginf=0.0)
		try:
			if float(np.min(arr)) >= 0.0:
				return arr
		except Exception:
			pass
		return np.abs(arr)
	except Exception:
		return np.asarray([], dtype=np.float32)


def _rt_detector_mask_run_count(mask) -> int:
	try:
		m = np.asarray(mask, dtype=bool)
		if m.size <= 0:
			return 0
		starts = m & np.concatenate(([True], ~m[:-1]))
		return int(np.count_nonzero(starts))
	except Exception:
		return 0


def _rt_detector_mark_window_bounds(n: int):
	try:
		n = int(n)
	except Exception:
		n = 0
	if n <= 0:
		return 0, 0
	try:
		guard = str(os.getenv('BMI30_RT_MARK_WINDOW_GUARD', '1')).lower() not in ('0', 'false', 'no')
	except Exception:
		guard = True
	if not guard:
		return 0, n
	try:
		start_env = str(os.getenv('BMI30_RT_MARK_WINDOW_START', '') or '').strip()
		start = int(start_env) if start_env else int(round(float(os.getenv('BMI30_RT_MARK_WINDOW_START_FRAC', '0.05')) * float(n)))
	except Exception:
		start = int(round(0.05 * float(n)))
	try:
		end_env = str(os.getenv('BMI30_RT_MARK_WINDOW_END', '') or '').strip()
		end = int(end_env) if end_env else int(round(float(os.getenv('BMI30_RT_MARK_WINDOW_END_FRAC', '0.45')) * float(n)))
	except Exception:
		end = int(round(0.45 * float(n)))
	start = max(0, min(n - 1, int(start)))
	end = max(start + 1, min(n, int(end)))
	return start, end


def _rt_detector_peak_supported(prod_abs: np.ndarray, peak_idx: int, peak_value: float) -> bool:
	"""Reject needle-like impulse noise: a valid mark must occupy nearby samples too."""
	try:
		guard = str(os.getenv('BMI30_RT_IMPULSE_GUARD', '1')).lower() not in ('0', 'false', 'no')
	except Exception:
		guard = True
	if not guard:
		return True
	try:
		if prod_abs is None or prod_abs.size <= 0:
			return False
		peak_value = float(peak_value)
		if not np.isfinite(peak_value) or peak_value <= 0.0:
			return False
		peak_idx = max(0, min(int(peak_idx), int(prod_abs.size) - 1))
		win = max(1, int(os.getenv('BMI30_RT_IMPULSE_WIN', '7')))
		min_width = max(1, int(os.getenv('BMI30_RT_IMPULSE_MIN_WIDTH', '3')))
		frac = float(os.getenv('BMI30_RT_IMPULSE_FRAC', '0.30'))
		if not np.isfinite(frac) or frac <= 0.0 or frac > 1.0:
			frac = 0.30
		half = max(1, win // 2)
		lo = max(0, peak_idx - half)
		hi = min(int(prod_abs.size), peak_idx + half + 1)
		local = np.asarray(prod_abs[lo:hi])
		if local.size <= 0:
			return False
		support = int(np.count_nonzero(local >= (peak_value * frac)))
		return support >= min_width
	except Exception:
		return True


def _rt_detector_named_filter_enabled(name: str, default: bool = False) -> bool:
	try:
		key = 'BMI30_DETECT_FILTER_' + str(name or '').strip().upper()
		return str(os.getenv(key, '1' if default else '0')).lower() not in ('0', 'false', 'no', 'off')
	except Exception:
		return bool(default)


def _rt_detector_named_filters_active() -> bool:
	return bool(
		_rt_detector_named_filter_enabled('CASINO', True)
		or _rt_detector_named_filter_enabled('BARKHAUSEN', False)
		or _rt_detector_named_filter_enabled('MICROWIRE', False)
		or _rt_detector_named_filter_enabled('PAPER', False)
	)


