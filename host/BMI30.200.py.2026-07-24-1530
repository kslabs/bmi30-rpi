		"""Подсветить кнопку ускорения, пока активен автодовод DC."""
		try:
			if bool(getattr(self, '_dc_autotune_active', False)):
				self.btn_power.setStyleSheet("background-color: #ffd34d; color: #000000; font-weight: bold;")
