		try:
			volume = float(getattr(getattr(self, "_beeper", None), "_volume_percent", 100.0))
		except Exception:
			volume = 100.0
		return _normalize_sound_settings({
			"enabled": bool(getattr(self, "_sound_enabled", False)),
			"volume_percent": volume,
			"upper_frequency_hz": getattr(self, "_beep_adc0_base", 4000.0),
