	def _lcd_role_overlay_snapshot(self) -> dict:
		cfg = _normalize_lcd_role_overlay(getattr(self, "_lcd_role_overlay_config", None))
		applied = bool(getattr(self, "_lcd_role_overlay_applied", False))
		return dict(cfg, applied=applied, pending=not applied)

	def _send_lcd_role_overlay(self, enabled, period_s, duration_s) -> bool:
		cfg = _normalize_lcd_role_overlay({
			"enabled": enabled, "period_s": period_s, "duration_s": duration_s,
		})
		stream = getattr(self, "stream", None)
		if stream is None or bool(getattr(stream, "disconnected", False)):
			self._lcd_role_overlay_applied = False
			self._lcd_role_overlay_error = "USB not connected"
			return False
		try:
			stream.send_cmd(CMD_SET_LCD_ROLE_OVERLAY, bytes([
				1 if cfg["enabled"] else 0, cfg["period_s"], cfg["duration_s"],
			]))
			self._lcd_role_overlay_applied = True
			self._lcd_role_overlay_error = ""
			return True
		except Exception as exc:
			self._lcd_role_overlay_applied = False
			self._lcd_role_overlay_error = str(exc)
			return False

	def _set_lcd_role_overlay(self, enabled, period_s=4, duration_s=4, persist=True) -> dict:
		cfg = _normalize_lcd_role_overlay({
			"enabled": enabled, "period_s": period_s, "duration_s": duration_s,
		})
		self._lcd_role_overlay_config = cfg
		if persist:
			save_lcd_role_overlay(cfg)
		self._send_lcd_role_overlay(**cfg)
		return self._lcd_role_overlay_snapshot()

	def _set_sound_test_enabled(self, enabled: bool, announce: bool = False, upper: bool | None = None, lower: bool | None = None) -> dict:
		en = bool(enabled)
		if upper is None:
			upper = en
		if lower is None:
			lower = en
		upper = bool(upper and en)
		lower = bool(lower and en)
		if upper and lower:
			# One hardware timer can output one exact frequency. The web UI
			# enforces the same mutual exclusion; keep API calls deterministic.
			lower = False
		en = bool(upper or lower)
		try:
			self._sound_test_enabled = en
			self._sound_test_upper_enabled = upper
			self._sound_test_lower_enabled = lower
			if en:
				if not bool(getattr(self, "_sound_enabled", False)):
					self._set_sound_enabled(True, reason="test", announce=False, persist=False)
					self._sound_test_enabled = en
					self._sound_test_upper_enabled = upper
					self._sound_test_lower_enabled = lower
				self._beep_hold_active = False
				self._beep_hold_base_freq = 0.0
				self._beep_hold_freq = 0.0
				self._beep_hold_after_t = 0.0
				self._beep_hold_output_started = False
				self._beep_hold_channel = -1
				self._beep_hold_min_until_t = 0.0
				self._beep_hold_stop_requested = False
				self._beep_hold_filter_cycles = 0
				base_freq = (
					float(getattr(self, "_beep_adc0_base", 4000.0) or 4000.0)
					if upper
					else float(getattr(self, "_beep_adc1_base", 1000.0) or 1000.0)
				)
				phase_freq = (
					float(getattr(self, "_beep_adc0_max", 3000.0) or 3000.0)
					if upper
					else float(getattr(self, "_beep_adc1_max", 4000.0) or 4000.0)
				)
				stop_now = getattr(self._beeper, "stop_now", None)
				if callable(stop_now):
					stop_now()
				started = bool(self._beeper.play_repeating_sequences(
					(((base_freq, 0.150), (phase_freq, 0.150)),),
					repeat_gap_s=0.0,
				))
				if not started:
					self._sound_test_enabled = False
					self._sound_test_upper_enabled = False
					self._sound_test_lower_enabled = False
			else:
				self._sound_test_upper_enabled = False
				self._sound_test_lower_enabled = False
				stop_now = getattr(self._beeper, "stop_now", None)
				if callable(stop_now):
					stop_now()
				else:
					self._beeper.set_continuous(None)
		except Exception:
			pass
		if announce:
			try:
				self._set_status("Sound test ON" if en else "Sound test off", hold_sec=1.2)
			except Exception:
				pass
		return self._sound_settings_snapshot()

	def _set_sound_settings(self, settings=None, persist: bool = True, announce: bool = False) -> dict:
		try:
			merged = self._sound_settings_snapshot()
			merged.update(dict(settings or {}))
		except Exception:
			merged = dict(settings or {})
		cfg = _normalize_sound_settings(merged, default_enabled=bool(getattr(self, "_sound_enabled", False)))
		if bool(cfg.get("test_enabled", False)):
			cfg["enabled"] = True
		try:
			self._sound_settings = dict(cfg)
			self._beep_adc0_base = float(cfg["upper_frequency_hz"])
			self._beep_adc1_base = float(cfg["lower_frequency_hz"])
			self._beep_adc0_min = float(cfg["phase_upper_min_hz"])
			self._beep_adc0_max = float(cfg["phase_upper_max_hz"])
			self._beep_adc1_min = float(cfg["phase_lower_min_hz"])
			self._beep_adc1_max = float(cfg["phase_lower_max_hz"])
			self._beep_min_duration_s = max(0.0, float(cfg["minimum_duration_ms"]) / 1000.0)
			self._beep_min_cycles = max(1, int(cfg["minimum_tone_cycles"]))
			self._beeper.set_volume_percent(float(cfg["volume_percent"]))
			self._set_sound_enabled(bool(cfg["enabled"]), reason="api", announce=False, persist=False)
			self._set_sound_test_enabled(
				bool(cfg.get("test_enabled", False)),
				announce=False,
				upper=bool(cfg.get("test_upper_enabled", False)),
				lower=bool(cfg.get("test_lower_enabled", False)),
			)
		except Exception:
			pass
		snapshot = self._sound_settings_snapshot()
		if persist:
			try:
				save_sound_settings(snapshot)
			except Exception:
				pass
		if announce:
			try:
				self._set_status("Sound settings saved", hold_sec=1.0)
			except Exception:
				pass
		return snapshot

	def _sound_output_active(self) -> bool:
		"""Best-effort check for PWM/pattern activity before stopping it from the tick guard."""
		try:
			if bool(getattr(self, '_beep_hold_active', False)):
				return True
			beeper = getattr(self, '_beeper', None)
			if beeper is None:
				return False
			return bool(
				getattr(beeper, '_continuous_on', False)
				or getattr(beeper, '_repeat_loop_active', False)
				or int(getattr(beeper, '_last_freq', 0) or 0) > 0
			)
		except Exception:
			return False

	def _set_sound_enabled(self, enabled: bool, reason: str = "", announce: bool = False, persist: bool | None = None):
		"""Set user sound permission; disabling always silences PWM immediately."""
		en = bool(enabled)
		try:
			self._sound_enabled = en
			self._beep_force_mode = 0
			self._beep_force_enabled = False
		except Exception:
			pass
		try:
			if hasattr(self, 'btn_pwm') and bool(self.btn_pwm.isChecked()) != en:
				self.btn_pwm.blockSignals(True)
				self.btn_pwm.setChecked(en)
				self.btn_pwm.blockSignals(False)
		except Exception:
			try:
				self.btn_pwm.blockSignals(False)
			except Exception:
				pass
		if not en:
			self._stop_sound_now()
		else:
			try:
				if int(self._current_mode_idx()) < 6:
					self._stop_sound_now()
			except Exception:
				pass
		try:
			self._update_pwm_btn_style()
		except Exception:
			pass
		if persist is None:
			persist = str(reason or "").strip().lower() in ("api", "ui", "user")
		if bool(persist):
			try:
				save_sound_enabled(en)
			except Exception:
				pass
		if announce:
			try:
				if en:
					if int(self._current_mode_idx()) >= 6:
						self._set_status("Звук разрешён: realtime, режимы 6+", hold_sec=2.0)
					else:
						self._set_status("Звук разрешён, но включится только в режимах 6+", hold_sec=2.0)
				else:
					msg = "Звук отключён"
					if reason:
						msg += f" ({reason})"
					self._set_status(msg, hold_sec=2.0)
			except Exception:
				pass

	def _sound_restore_target(self) -> bool:
		try:
			current = bool(getattr(self, '_sound_enabled', False))
		except Exception:
			current = False
		try:
			return bool(load_sound_enabled(current))
		except Exception:
			return current

	def _select_mode3_silent_after_fault(self, reason: str = ""):
		"""Select temporary safe mode 3 after a stall/USB fault without changing startup mode."""
		self._set_sound_enabled(False, reason=reason, announce=False)
		try:
			self._rt_detection_mode_enabled = False
			self._phase_search_enabled = False
			self._det_dc_frozen = False
			self._det_hold0 = False
			self._det_hold1 = False
			self._det_exceed0 = 0
			self._det_exceed1 = 0
			self._prev_beep_state = False
			self._prev_freeze_state = False
		except Exception:
			pass
		try:
			if hasattr(self, '_corr_timer') and self._corr_timer is not None:
				self._corr_timer.stop()
			self.corr0.setData([], [])
			self.corr1.setData([], [])
			self.corr0.setVisible(False)
			self.corr1.setVisible(False)
		except Exception:
			pass
		try:
			btn = self.num_group.button(3)
			if btn is not None:
				btn.setChecked(True)
		except Exception:
			pass
		try:
			self._fallback_mode_idx = 3
			self._record_fault_mode_transition(3, reason=reason or "select_mode3_silent_after_fault", source="select_mode3_silent_after_fault")
			print(f'[fallback] stall/usb fault => temporary mode 3, sound off ({reason})', flush=True)
		except Exception as e:
			try:
				print('[fallback] temporary mode 3 err', e, flush=True)
			except Exception:
				pass

	def _beep_hold_start(self, fired0: bool, fired1: bool, shift0: int, shift1: int, lvl0: int, lvl1: int):
		"""Latch one phase-dependent PWM tone on the detection rising edge."""
		try:
			if not bool(self._sound_allowed()):
				return
			if bool(getattr(self, '_sound_test_enabled', False)):
				return
			if not bool(self._optic_detection_gate_allowed()):
				self._stop_sound_now()
				return
			try:
				now = time.time()
				fired0 = bool(fired0) and bool(self._det_output_active(0, now))
				fired1 = bool(fired1) and bool(self._det_output_active(1, now))
			except Exception:
				fired0 = fired1 = False
			if not (bool(fired0) or bool(fired1)):
				self._stop_sound_now()
				return
			try:
				if int(getattr(self, '_beep_force_mode', 0)) == -1:
					return
			except Exception:
				pass
			if not bool(getattr(self, '_beep_hold_enabled', False)):
				return
			# Do not interfere with explicit debug modes
			bm = str(getattr(self, '_beep_mode', 'pattern') or 'pattern')
			if bm in ('continuous', 'sweep'):
				return
			if bool(getattr(self, '_beep_sweep_enabled', False)):
				return
			# The selected base/phase pair belongs to the whole HOLD interval.
			# Later detector updates must not restart its independent 150 ms loop.
			if bool(getattr(self, '_beep_hold_active', False)):
				self._beep_hold_stop_requested = False
				return
			# Choose the channel to represent when both fire
			use_ch = None
			if fired0 and fired1:
				use_ch = 0 if int(lvl0) >= int(lvl1) else 1
			elif fired0:
				use_ch = 0
			elif fired1:
				use_ch = 1
			if use_ch is None:
				return
			# Use the same mapping as the second tone (phase-dependent)
			if use_ch == 0:
				freq = float(self._shift_to_beep_freq(int(shift0), float(self._beep_adc0_min), float(self._beep_adc0_max)))
			else:
				freq = float(self._shift_to_beep_freq(int(shift1), float(self._beep_adc1_min), float(self._beep_adc1_max)))
			self._beep_hold_active = True
			self._beep_hold_base_freq = float(
				self._beep_adc0_base if use_ch == 0 else self._beep_adc1_base
			)
			self._beep_hold_freq = float(freq)
			self._beep_hold_channel = int(use_ch)
			self._beep_hold_output_started = False
			self._beep_hold_stop_requested = False
			self._beep_hold_filter_cycles = 0
			now = time.time()
			delay = float(getattr(self, '_beep_hold_delay_s', 0.0))
			self._beep_hold_after_t = now + max(0.0, delay)
		except Exception:
			pass

	def _beep_hold_begin_output(self, now: float | None = None) -> bool:
		"""Start the 150 ms base/phase pair once; the beeper repeats it in hardware."""
		try:
			if bool(getattr(self, '_beep_hold_output_started', False)):
				return True
			base_freq = float(getattr(self, '_beep_hold_base_freq', 0.0) or 0.0)
			phase_freq = float(getattr(self, '_beep_hold_freq', 0.0) or 0.0)
			if base_freq <= 0.0 or phase_freq <= 0.0:
				self._stop_sound_now()
				return False
			started = bool(self._beeper.play_repeating_sequences(
				(((base_freq, 0.150), (phase_freq, 0.150)),),
				repeat_gap_s=0.0,
			))
			if not started:
				self._stop_sound_now()
				return False
			start_t = time.time() if now is None else float(now)
			self._beep_hold_output_started = True
			minimum_s = max(0.0, float(getattr(self, '_beep_min_duration_s', 0.150) or 0.0))
			self._beep_hold_min_until_t = start_t + min(60.0, minimum_s)
			return True
		except Exception:
			self._stop_sound_now()
			return False

	def _beep_hold_filter_step(self, detector_active: bool):
		"""Count consecutive detector/phase cycles before starting hardware sound."""
		try:
			if not bool(getattr(self, '_beep_hold_active', False)):
				return
			if not bool(detector_active):
				self._beep_hold_stop()
				return
			self._beep_hold_stop_requested = False
			if bool(getattr(self, '_beep_hold_output_started', False)):
				return
			self._beep_hold_filter_cycles = int(getattr(self, '_beep_hold_filter_cycles', 0) or 0) + 1
			required = max(1, int(getattr(self, '_beep_min_cycles', 1) or 1))
			if int(self._beep_hold_filter_cycles) < required:
				return
			now = time.time()
			if now < float(getattr(self, '_beep_hold_after_t', 0.0) or 0.0):
				return
			self._beep_hold_begin_output(now)
		except Exception:
			pass

	def _beep_hold_stop(self):
		"""Stop HOLD tone, extending an already started tone to its minimum time."""
		try:
			# An explicit web test owns the sound output until its checkbox is
			# cleared. Detector cleanup runs continuously even with no HOLD and
			# must not cancel that manually requested repeating sequence.
			if bool(getattr(self, '_sound_test_enabled', False)):
				return
			now = time.time()
			if bool(getattr(self, '_beep_hold_active', False)):
				if not bool(getattr(self, '_beep_hold_output_started', False)):
					# A detection shorter than the requested consecutive-cycle
					# filter never reaches the hardware timer.
					self._stop_sound_now()
					return
				try:
					permitted = bool(self._sound_allowed()) and bool(self._optic_detection_gate_allowed())
				except Exception:
					permitted = False
				if permitted and now < float(getattr(self, '_beep_hold_min_until_t', 0.0) or 0.0):
					self._beep_hold_stop_requested = True
					return
			self._stop_sound_now()
		except Exception:
			pass

	def _fire_beep(self, fired0: bool, fired1: bool, shift0: int, shift1: int):
		"""Start detection sound once; HOLD end performs the matching stop."""
		try:
			if not bool(self._sound_allowed()):
				self._stop_sound_now()
				return
			if bool(getattr(self, '_sound_test_enabled', False)):
				return
			if not bool(self._optic_detection_gate_allowed()):
				self._stop_sound_now()
				return
			try:
				now = time.time()
				fired0 = bool(fired0) and bool(self._det_output_active(0, now))
				fired1 = bool(fired1) and bool(self._det_output_active(1, now))
			except Exception:
				fired0 = fired1 = False
			if not (bool(fired0) or bool(fired1)):
				self._stop_sound_now()
				return
			try:
				if int(getattr(self, '_beep_force_mode', 0)) == -1:
					self._stop_sound_now()
					return
			except Exception:
				pass
			# Compute second-tone frequencies
			f2_0 = self._shift_to_beep_freq(shift0, self._beep_adc0_min, self._beep_adc0_max)
			f2_1 = self._shift_to_beep_freq(shift1, self._beep_adc1_min, self._beep_adc1_max)
			# If both fired and phase shifts equal, enforce equal second-tone frequency (within intersection)
			if fired0 and fired1 and int(shift0) == int(shift1):
				f2_common = self._shift_to_beep_freq(shift0, 2000.0, 3000.0)
				f2_0 = float(np.clip(f2_common, self._beep_adc0_min, self._beep_adc0_max))
				f2_1 = float(np.clip(f2_common, self._beep_adc1_min, self._beep_adc1_max))
			if bool(getattr(self, '_beep_realtime_enabled', True)):
				try:
					self._mark_gpio22_sound(0.30)
				except Exception:
					pass
				self._beep_hold_start(
					bool(fired0),
					bool(fired1),
					int(shift0),
					int(shift1),
					int(getattr(self, '_det_last_lvl0', 0) or 0),
					int(getattr(self, '_det_last_lvl1', 0) or 0),
				)
				return
			if fired0:
				self._beeper.play_pattern(self._beep_adc0_base, f2_0)
			elif fired1:
				self._beeper.play_pattern(self._beep_adc1_base, f2_1)
			else:
				self._stop_sound_now()
		except Exception:
			pass

	def _player_record_dir_path(self):
		try:
			path = os.path.abspath(os.path.expanduser(str(getattr(self, '_player_record_dir', '') or 'player_recordings')))
		except Exception:
			path = os.path.abspath(os.path.join(os.path.dirname(__file__), 'player_recordings'))
		return path

	def _player_record_file_path(self, name: str = ''):
		record_dir = self._player_record_dir_path()
		try:
			os.makedirs(record_dir, exist_ok=True)
		except Exception:
			pass
		name_s = os.path.basename(str(name or '').strip())
		if not name_s or name_s == 'latest':
			candidates = []
			try:
				for item in os.listdir(record_dir):
					if item.endswith('.npz'):
						path = os.path.join(record_dir, item)
						candidates.append((os.path.getmtime(path), path))
			except Exception:
				candidates = []
			if not candidates:
				return ''
			candidates.sort(reverse=True)
			return candidates[0][1]
		path = os.path.abspath(os.path.join(record_dir, name_s))
		if os.path.dirname(path) != record_dir:
			raise ValueError('invalid recording file')
		return path

	def player_recording_status(self):
		with self._player_record_lock:
			started = float(getattr(self, '_player_record_started_t', 0.0) or 0.0)
			return {
				'ok': True,
				'recording': bool(getattr(self, '_player_recording', False)),
				'playback_active': bool(getattr(self, '_player_playback_active', False)),
				'packet_count': int(len(getattr(self, '_player_record_packets', []) or [])),
				'marker_count': int(len(getattr(self, '_player_record_markers', []) or [])),
				'live_mark_count': int(len(getattr(self, '_player_record_live_marks', []) or [])),
				'live_tag_votes': int(sum(int((m or {}).get('votes', 1) or 1) for m in (getattr(self, '_player_record_live_marks', []) or []))),
				'started_t': started,
				'duration_s': (time.time() - started) if started > 0.0 else 0.0,
				'max_packets': int(getattr(self, '_player_record_max_packets', 5000) or 5000),
				'saved_file': os.path.basename(str(getattr(self, '_player_record_saved_path', '') or '')),
				'directory': self._player_record_dir_path(),
				'last_error': str(getattr(self, '_player_record_last_error', '') or ''),
				'source': 'raw_usb_before_detection',
			}

	def _player_realtime_suspended(self) -> bool:
		return bool(getattr(self, '_player_recording', False) or getattr(self, '_player_playback_active', False))

	def _player_reset_realtime_detector_state(self) -> None:
		try:
			self._rt_stop_detection_outputs()
		except Exception:
			pass
		try:
			self._rt_det_prev0 = None
			self._rt_det_prev1 = None
			self._det_exceed0 = 0
			self._det_exceed1 = 0
			self._det_exceed_peak0 = None
			self._det_exceed_peak1 = None
		except Exception:
			pass

	def player_playback_start(self):
		with self._player_record_lock:
			self._player_playback_active = True
		self._player_reset_realtime_detector_state()
		return self.player_recording_status()

	def player_playback_stop(self):
		with self._player_record_lock:
			self._player_playback_active = False
		self._player_reset_realtime_detector_state()
		return self.player_recording_status()

	def player_recording_start(self, max_packets=None):
		try:
			if max_packets is not None:
				self._player_record_max_packets = max(1, int(max_packets))
		except Exception:
			pass
		record_dir = self._player_record_dir_path()
		os.makedirs(record_dir, exist_ok=True)
		self._player_reset_realtime_detector_state()
		with self._player_record_lock:
			self._player_playback_active = False
			self._player_recording = True
			self._player_record_started_t = time.time()
			self._player_record_packets = []
			self._player_record_markers = []
			self._player_record_live_marks = []
			self._player_record_saved_path = ''
			self._player_record_last_error = ''
			self._player_record_last_packet_idx0 = -1
			self._player_record_last_packet_idx1 = -1
			self._player_record_live_mark_cursor0 = -1
			self._player_record_live_mark_cursor1 = -1
			self._player_record_live_mark_hold_seq = 0
			self._player_record_live_mark_hold0 = 0
			self._player_record_live_mark_hold1 = 0
			self._player_record_det_seq_map = {}
		try:
			self._set_status('Raw player recording started; realtime detector suspended', hold_sec=1.8)
		except Exception:
			pass
		return self.player_recording_status()

	def player_recording_stop(self, save: bool = True):
		with self._player_record_lock:
			self._player_recording = False
			packets = list(getattr(self, '_player_record_packets', []) or [])
			markers = list(getattr(self, '_player_record_markers', []) or [])
			live_marks = list(getattr(self, '_player_record_live_marks', []) or [])
			started_t = float(getattr(self, '_player_record_started_t', 0.0) or 0.0)
			self._player_record_det_seq_map = {}
		self._player_reset_realtime_detector_state()
		saved_path = ''
		if bool(save) and packets:
			try:
				saved_path = self._player_record_save_snapshot(packets, markers, started_t, live_marks=live_marks)
				with self._player_record_lock:
					self._player_record_saved_path = saved_path
					self._player_record_last_error = ''
				try:
					self._set_status(f'Raw recording saved: {os.path.basename(saved_path)}', hold_sec=2.5)
				except Exception:
					pass
			except Exception as e:
				with self._player_record_lock:
					self._player_record_last_error = str(e)
				try:
					self._set_status(f'Raw recording save failed: {e}', hold_sec=3.0)
				except Exception:
					pass
		status = self.player_recording_status()
		status['saved_file'] = os.path.basename(saved_path or str(getattr(self, '_player_record_saved_path', '') or ''))
		status['packet_count'] = len(packets)
		status['marker_count'] = len(markers)
		status['live_mark_count'] = len(live_marks)
		status['live_tag_votes'] = int(sum(int((m or {}).get('votes', 1) or 1) for m in live_marks))
		return status

	def player_recording_mark(self, channel='upper', tag_type='casino', mark: str = 'tag', begin: bool = False):
		channel_s = self._player_label_channel_value(channel)
		if not channel_s:
			return {'ok': False, 'error': 'tag channel is required'}
		if channel_s == 'both':
			return {'ok': False, 'error': 'live recording tag channel must be upper or lower'}
		mark_s = str(mark or 'tag').strip().lower()
		if mark_s != 'tag':
			return {'ok': False, 'error': 'only tag live marks are supported'}
		tag_type_s = self._player_tag_type_value(tag_type, 'casino') or 'casino'
		ch = 0 if channel_s == 'upper' else 1
		with self._player_record_lock:
			if not bool(getattr(self, '_player_recording', False)):
				return {'ok': False, 'error': 'not recording'}
			packet_idx = int(getattr(self, '_player_record_last_packet_idx0' if ch == 0 else '_player_record_last_packet_idx1', -1))
			packets = getattr(self, '_player_record_packets', []) or []
			if packet_idx < 0 or packet_idx >= len(packets):
				return {'ok': False, 'error': f'no {channel_s} packet recorded yet'}
			now = time.time()
			live_marks = getattr(self, '_player_record_live_marks', None)
			if not isinstance(live_marks, list):
				live_marks = []
				self._player_record_live_marks = live_marks
			cursor_key = '_player_record_live_mark_cursor0' if ch == 0 else '_player_record_live_mark_cursor1'
			hold_key = '_player_record_live_mark_hold0' if ch == 0 else '_player_record_live_mark_hold1'
			try:
				cursor = int(getattr(self, cursor_key, -1))
			except Exception:
				cursor = -1
			try:
				hold_id = int(getattr(self, hold_key, 0) or 0)
			except Exception:
				hold_id = 0
			if bool(begin) or hold_id <= 0:
				try:
					hold_id = int(getattr(self, '_player_record_live_mark_hold_seq', 0) or 0) + 1
				except Exception:
					hold_id = 1
				try:
					self._player_record_live_mark_hold_seq = int(hold_id)
					setattr(self, hold_key, int(hold_id))
				except Exception:
					pass
			start_idx = packet_idx if bool(begin) or cursor < 0 else max(0, cursor + 1)
			targets = []
			for idx in range(max(0, start_idx), packet_idx + 1):
				try:
					if int((packets[idx] or {}).get('channel', 0) or 0) == ch:
						targets.append(idx)
				except Exception:
					continue
			if packet_idx > cursor:
				try:
					setattr(self, cursor_key, int(packet_idx))
				except Exception:
					pass
			marked = 0
			updated = 0
			last_votes = 0
			last_conf = 0.0
			for idx in targets:
				existing = None
				for item in live_marks:
					try:
						if int(item.get('packet_idx', -1)) == int(idx) and str(item.get('channel', '')) == channel_s:
							existing = item
							break
					except Exception:
						continue
				if existing is not None:
					if bool(begin) and int(idx) == int(packet_idx):
						votes = max(1, int(existing.get('votes', 1) or 1)) + 1
						existing['votes'] = votes
						existing['confidence'] = min(0.95, 0.55 + 0.08 * float(votes - 1))
						existing['hold_id'] = int(hold_id)
						existing['updated_host_t'] = now
						updated += 1
						last_votes = votes
						last_conf = float(existing['confidence'])
					continue
				item = {
					'packet_idx': int(idx),
					'mark': 'tag',
					'tag_type': tag_type_s,
					'channel': channel_s,
					'scope': 'frame',
					'position': 'unknown',
					'source': 'live_record',
					'hold_id': int(hold_id),
					'votes': 1,
					'confidence': 0.55,
					'host_t': now,
				}
				live_marks.append(item)
				marked += 1
				last_votes = 1
				last_conf = 0.55
			return {
				'ok': True,
				'recording': True,
				'packet_idx': int(packet_idx),
				'channel': channel_s,
				'tag_type': tag_type_s,
				'marked_count': int(marked),
				'updated_count': int(updated),
				'votes': int(last_votes),
				'confidence': float(last_conf),
				'hold_id': int(hold_id),
				'live_mark_count': len(live_marks),
				'live_tag_votes': int(sum(int((m or {}).get('votes', 1) or 1) for m in live_marks)),
			}

	def player_recording_files(self, limit: int = 50):
		record_dir = self._player_record_dir_path()
		items = []
		try:
			os.makedirs(record_dir, exist_ok=True)
			for name in os.listdir(record_dir):
				if not name.endswith('.npz'):
					continue
				path = os.path.join(record_dir, name)
				try:
					st = os.stat(path)
					items.append({
						'name': name,
						'size': int(st.st_size),
						'mtime': float(st.st_mtime),
					})
				except Exception:
					pass
		except Exception:
			items = []
		items.sort(key=lambda x: float(x.get('mtime', 0.0) or 0.0), reverse=True)
		return {'ok': True, 'directory': record_dir, 'files': items[:max(1, int(limit or 50))]}

	def _player_labels_path(self, recording_path: str):
		try:
			return str(recording_path) + '.labels.json'
		except Exception:
			return ''

	def _player_tag_type_value(self, value, default: str = '') -> str:
		try:
			raw = str(value or '').strip().lower()
		except Exception:
			raw = ''
		if not raw:
			try:
				raw = str(default or '').strip().lower()
			except Exception:
				raw = ''
		raw = raw.replace(' ', '_').replace('-', '_').replace('/', '_')
		if raw in ('casino', 'tag_casino', 'casino_tag', 'cas'):
			return 'casino'
		if raw in ('barkhausen', 'tag_barkhausen', 'barkhausen_tag', 'bark'):
			return 'barkhausen'
		if raw in ('microwire', 'tag_microwire', 'microwire_tag', 'micro', 'mic'):
			return 'microwire'
		if raw in ('paper', 'tag_paper', 'paper_tag', 'pap'):
			return 'paper'
		return ''

	def _player_label_meta_value(self, value, default: str = '') -> str:
		try:
			raw = str(value or '').strip().lower()
		except Exception:
			raw = ''
		if not raw:
			try:
				raw = str(default or '').strip().lower()
			except Exception:
				raw = ''
		raw = raw.replace(' ', '_').replace('-', '_').replace('/', '_')
		out = []
		for ch in raw:
			if ch.isalnum() or ch == '_':
				out.append(ch)
		return ''.join(out)[:32]

	def _player_label_channel_value(self, value) -> str:
		try:
			raw = str(value or '').strip().lower()
		except Exception:
			raw = ''
		if raw in ('both', 'all', 'u+l', 'l+u', 'upper+lower', 'lower+upper', 'upper,lower', 'lower,upper', '2'):
			return 'both'
		if raw in ('upper', 'u', '0', 'adc0', 'ch0'):
			return 'upper'
		if raw in ('lower', 'l', '1', 'adc1', 'ch1'):
			return 'lower'
		return ''

	def _player_normalize_user_labels_payload(self, payload):
		marks = {}
		mark_types = {}
		mark_channels = {}
		mark_scopes = {}
		mark_positions = {}
		mark_votes = {}
		mark_confidence = {}
		mark_sources = {}
		mark_hold_ids = {}
		ranges_by_packet = {}
		deleted_ranges_by_packet = {}
		def _label_payload() -> dict:
			return {'marks': marks, 'mark_types': mark_types, 'mark_channels': mark_channels, 'mark_scopes': mark_scopes, 'mark_positions': mark_positions, 'mark_votes': mark_votes, 'mark_confidence': mark_confidence, 'mark_sources': mark_sources, 'mark_hold_ids': mark_hold_ids, 'ranges': ranges_by_packet, 'deleted_ranges': deleted_ranges_by_packet}
		def _merge_channel(prev: str, channel: str) -> str:
			prev = self._player_label_channel_value(prev)
			channel = self._player_label_channel_value(channel)
			if not prev:
				return channel
			if not channel:
				return prev
			if prev == channel:
				return prev
			return 'both'
		if not isinstance(payload, dict):
			return _label_payload()
		try:
			for item in payload.get('marks', []) or []:
				if not isinstance(item, dict):
					continue
				try:
					packet_idx = int(item.get('packet_idx', -1))
				except Exception:
					packet_idx = -1
				if packet_idx < 0:
					continue
				mark = str(item.get('mark', '') or '').strip().lower()
				tag_type = self._player_tag_type_value(item.get('tag_type', item.get('type', item.get('label_type', ''))), '')
				if mark.startswith('tag:') or mark.startswith('tag_'):
					sep = ':' if ':' in mark else '_'
					parts = mark.split(sep, 1)
					mark = parts[0]
					tag_type = tag_type or self._player_tag_type_value(parts[1] if len(parts) > 1 else '', '')
				if mark in ('casino', 'barkhausen', 'microwire', 'paper'):
					tag_type = self._player_tag_type_value(mark, tag_type)
					mark = 'tag'
				channel = ''
				if mark == 'tag':
					channel = self._player_label_channel_value(item.get('channel', item.get('tag_channel', '')))
					if not channel:
						continue
				if mark:
					marks[packet_idx] = mark[:32]
					if mark == 'tag' and tag_type:
						mark_types[packet_idx] = tag_type
					if mark == 'tag':
						mark_channels[packet_idx] = _merge_channel(mark_channels.get(packet_idx, ''), channel)
						scope = self._player_label_meta_value(item.get('scope', item.get('tag_scope', '')), 'frame')
						position = self._player_label_meta_value(item.get('position', item.get('tag_position', '')), 'unknown')
						if scope:
							mark_scopes[packet_idx] = scope
						if position:
							mark_positions[packet_idx] = position
						try:
							votes = max(1, int(item.get('votes', 1) or 1))
						except Exception:
							votes = 1
						try:
							conf = float(item.get('confidence', 0.0) or 0.0)
						except Exception:
							conf = 0.0
						source = self._player_label_meta_value(item.get('source', ''), '')
						try:
							hold_id = max(0, int(item.get('hold_id', item.get('tag_hold_id', 0)) or 0))
						except Exception:
							hold_id = 0
						mark_votes[packet_idx] = votes
						if conf > 0.0:
							mark_confidence[packet_idx] = max(0.0, min(1.0, conf))
						if source:
							mark_sources[packet_idx] = source
						if hold_id > 0:
							mark_hold_ids[packet_idx] = hold_id
			for item in payload.get('ranges', []) or []:
				if not isinstance(item, dict):
					continue
				try:
					packet_idx = int(item.get('packet_idx', -1))
				except Exception:
					packet_idx = -1
				if packet_idx < 0:
					continue
				try:
					start = int(item.get('start', 0) or 0)
					end = int(item.get('end', start + 1) or (start + 1))
					peak = int(item.get('peak', (start + end) // 2) or ((start + end) // 2))
				except Exception:
					continue
				if end < start:
					start, end = end, start
				if end <= start:
					end = start + 1
				channel_s = str(item.get('channel', 'upper') or 'upper').strip().lower()
				channel = 'lower' if channel_s in ('lower', 'l', '1', 'adc1', 'ch1') else 'upper'
				marker = {
					'channel': channel,
					'start': max(0, int(start)),
					'end': max(0, int(end)),
					'peak': max(0, int(peak)),
					'kind': 'tag',
					'source': 'manual',
					'editable': True,
				}
				tag_type = self._player_tag_type_value(item.get('tag_type', item.get('type', item.get('label_type', ''))), '')
				if tag_type:
					marker['tag_type'] = tag_type
				ranges_by_packet.setdefault(packet_idx, []).append(marker)
			for item in (payload.get('deleted_ranges', []) or payload.get('deleted_markers', []) or []):
				if not isinstance(item, dict):
					continue
				try:
					packet_idx = int(item.get('packet_idx', -1))
				except Exception:
					packet_idx = -1
				if packet_idx < 0:
					continue
				try:
					start = int(item.get('start', 0) or 0)
					end = int(item.get('end', start + 1) or (start + 1))
					peak = int(item.get('peak', (start + end) // 2) or ((start + end) // 2))
				except Exception:
					continue
				if end < start:
					start, end = end, start
				if end <= start:
					end = start + 1
				channel = self._player_label_channel_value(item.get('channel', ''))
				if channel == 'both':
					channel = ''
				if not channel:
					channel = 'lower' if str(item.get('channel', '') or '').strip().lower() in ('lower', 'l', '1', 'adc1', 'ch1') else 'upper'
				kind = self._player_label_meta_value(item.get('kind', 'det'), 'det') or 'det'
				try:
					tol = max(0, int(item.get('tol', 2) or 2))
				except Exception:
					tol = 2
				deleted_ranges_by_packet.setdefault(packet_idx, []).append({
					'channel': 'lower' if channel == 'lower' else 'upper',
					'start': max(0, int(start)),
					'end': max(0, int(end)),
					'peak': max(0, int(peak)),
					'kind': kind[:32],
					'tol': int(tol),
				})
		except Exception:
			return {'marks': {}, 'mark_types': {}, 'mark_channels': {}, 'mark_scopes': {}, 'mark_positions': {}, 'mark_votes': {}, 'mark_confidence': {}, 'mark_sources': {}, 'mark_hold_ids': {}, 'ranges': {}, 'deleted_ranges': {}}
		return _label_payload()

	def _player_load_user_labels(self, recording_path: str):
		labels_path = self._player_labels_path(recording_path)
		if not labels_path or not os.path.exists(labels_path):
			return {'marks': {}, 'mark_types': {}, 'ranges': {}}
		try:
			with open(labels_path, 'r', encoding='utf-8') as f:
				payload = json.load(f) or {}
			return self._player_normalize_user_labels_payload(payload)
		except Exception:
			return {'marks': {}, 'mark_types': {}, 'ranges': {}}

	def _player_load_embedded_user_labels(self, data):
		try:
			files = set(getattr(data, 'files', []) or [])
			if 'user_labels_json' not in files:
				return {'marks': {}, 'mark_types': {}, 'ranges': {}}
			raw = np.asarray(data['user_labels_json']).reshape(-1)[0]
			payload = json.loads(str(raw or '{}'))
			return self._player_normalize_user_labels_payload(payload)
		except Exception:
			return {'marks': {}, 'mark_types': {}, 'ranges': {}}

	def _player_embed_user_labels(self, recording_path: str, payload: dict):
		tmp_path = ''
		try:
			recording_path = os.path.abspath(str(recording_path))
			tmp_path = f"{recording_path}.labels.{os.getpid()}.{int(time.time() * 1000)}.tmp.npz"
			label_json = json.dumps(payload, ensure_ascii=False, sort_keys=True, separators=(',', ':'))
			arrays = {}
			with np.load(recording_path, allow_pickle=False) as data:
				for name in getattr(data, 'files', []) or []:
					if name in ('user_labels_schema', 'user_labels_json'):
						continue
					arrays[name] = np.asarray(data[name])
			arrays['user_labels_schema'] = np.array([3], dtype=np.uint16)
			arrays['user_labels_json'] = np.array([label_json], dtype=f'U{max(1, len(label_json))}')
			np.savez_compressed(tmp_path, **arrays)
			os.replace(tmp_path, recording_path)
			return True
		except Exception:
			try:
				if tmp_path and os.path.exists(tmp_path):
					os.unlink(tmp_path)
			except Exception:
				pass
			return False

	def _player_load_user_marks(self, recording_path: str):
		try:
			return self._player_load_user_labels(recording_path).get('marks', {})
		except Exception:
			return {}

	def _player_marker_matches_deleted(self, marker, deleted) -> bool:
		if not isinstance(marker, dict) or not isinstance(deleted, dict):
			return False
		if str(marker.get('source', '') or '').strip().lower() == 'manual' or bool(marker.get('editable', False)):
			return False
		marker_ch = self._player_label_channel_value(marker.get('channel', 'upper')) or 'upper'
		deleted_ch = self._player_label_channel_value(deleted.get('channel', ''))
		if deleted_ch and deleted_ch != 'both' and marker_ch != deleted_ch:
			return False
		try:
			tol = max(0, int(deleted.get('tol', 2) or 2))
		except Exception:
			tol = 2
		def _ival(obj, key, default=0):
			try:
				return int(obj.get(key, default) or default)
			except Exception:
				return int(default)
		ms = _ival(marker, 'start', 0)
		me = _ival(marker, 'end', ms + 1)
		mp = _ival(marker, 'peak', (ms + me) // 2)
		ds = _ival(deleted, 'start', 0)
		de = _ival(deleted, 'end', ds + 1)
		dp = _ival(deleted, 'peak', (ds + de) // 2)
		if me < ms:
			ms, me = me, ms
		if de < ds:
			ds, de = de, ds
		return abs(ms - ds) <= tol and abs(me - de) <= tol and abs(mp - dp) <= tol

	def _player_filter_deleted_markers(self, markers, deleted_ranges):
		if not isinstance(markers, list) or not markers:
			return []
		if not isinstance(deleted_ranges, list) or not deleted_ranges:
			return list(markers)
		out = []
		for marker in markers:
			if any(self._player_marker_matches_deleted(marker, deleted) for deleted in deleted_ranges):
				continue
			out.append(marker)
		return out

	def player_recording_save_marks(self, name: str = 'latest', marks=None, ranges=None, deleted_ranges=None):
		path = self._player_record_file_path(name)
