				'score_norm': float(result.get('score_norm', 0.0) or 0.0),
				'sum_max_idx': int(result.get('sum_max_idx', 0) or 0),
				'sum_min_idx': int(result.get('sum_min_idx', 0) or 0),
				'sum_mid_idx': float(result.get('sum_mid_idx', 0.0) or 0.0),
				'sum_lobe_gap': int(result.get('sum_lobe_gap', 0) or 0),
				'sum_max_value': float(result.get('sum_max_value', 0.0) or 0.0),
