				if mark == 'tag' and tag_type:
					out_mark['tag_type'] = tag_type
				if mark == 'tag':
					channel = self._player_label_channel_value(item.get('channel', item.get('tag_channel', '')))
					if not channel:
						continue
					out_mark['channel'] = channel
					scope = self._player_label_meta_value(item.get('scope', item.get('tag_scope', '')), 'frame')
					position = self._player_label_meta_value(item.get('position', item.get('tag_position', '')), 'unknown')
					if scope:
						out_mark['scope'] = scope
					if position:
						out_mark['position'] = position
					try:
						votes = max(1, int(item.get('votes', 1) or 1))
					except Exception:
						votes = 1
					try:
						conf = float(item.get('confidence', 0.0) or 0.0)
					except Exception:
						conf = 0.0
					source = self._player_label_meta_value(item.get('source', ''), '')
					try:
						hold_id = max(0, int(item.get('hold_id', item.get('tag_hold_id', 0)) or 0))
					except Exception:
						hold_id = 0
					if votes > 1:
						out_mark['votes'] = votes
					if conf > 0.0:
						out_mark['confidence'] = max(0.0, min(1.0, conf))
					if source:
						out_mark['source'] = source
					if hold_id > 0:
						out_mark['hold_id'] = hold_id
				clean.append(out_mark)
		if ranges is None:
			ranges = []
		if isinstance(ranges, (list, tuple)):
			for item in ranges:
				if not isinstance(item, dict):
					continue
				try:
					packet_idx = int(item.get('packet_idx', -1))
				except Exception:
					packet_idx = -1
				if packet_idx < 0:
					continue
				try:
					start = int(item.get('start', 0) or 0)
					end = int(item.get('end', start + 1) or (start + 1))
					peak = int(item.get('peak', (start + end) // 2) or ((start + end) // 2))
				except Exception:
					continue
				if end < start:
					start, end = end, start
				if end <= start:
					end = start + 1
				channel_s = str(item.get('channel', 'upper') or 'upper').strip().lower()
				channel = 'lower' if channel_s in ('lower', 'l', '1', 'adc1', 'ch1') else 'upper'
				out_range = {
					'packet_idx': int(packet_idx),
					'channel': channel,
					'start': max(0, int(start)),
					'end': max(0, int(end)),
					'peak': max(0, int(peak)),
					'kind': 'tag',
				}
				tag_type = self._player_tag_type_value(item.get('tag_type', item.get('type', item.get('label_type', ''))), 'casino')
				if tag_type:
					out_range['tag_type'] = tag_type
				clean_ranges.append(out_range)
		if deleted_ranges is None:
			deleted_ranges = []
		if isinstance(deleted_ranges, (list, tuple)):
			for item in deleted_ranges:
				if not isinstance(item, dict):
					continue
				try:
					packet_idx = int(item.get('packet_idx', -1))
				except Exception:
					packet_idx = -1
				if packet_idx < 0:
					continue
				try:
					start = int(item.get('start', 0) or 0)
					end = int(item.get('end', start + 1) or (start + 1))
					peak = int(item.get('peak', (start + end) // 2) or ((start + end) // 2))
				except Exception:
					continue
				if end < start:
					start, end = end, start
				if end <= start:
					end = start + 1
				channel = self._player_label_channel_value(item.get('channel', 'upper')) or 'upper'
				if channel == 'both':
					channel = 'upper'
				kind = self._player_label_meta_value(item.get('kind', 'det'), 'det') or 'det'
				try:
					tol = max(0, int(item.get('tol', 2) or 2))
				except Exception:
					tol = 2
				clean_deleted_ranges.append({
					'packet_idx': int(packet_idx),
					'channel': 'lower' if channel == 'lower' else 'upper',
					'start': max(0, int(start)),
					'end': max(0, int(end)),
					'peak': max(0, int(peak)),
					'kind': kind[:32],
					'tol': int(tol),
				})
		labels_path = self._player_labels_path(path)
		payload = {
			'schema': 3,
			'source_file': os.path.basename(path),
			'updated_at': time.time(),
			'updated_iso': datetime.datetime.now().isoformat(timespec='seconds'),
			'marks': clean,
			'ranges': clean_ranges,
			'deleted_ranges': clean_deleted_ranges,
		}
		with open(labels_path, 'w', encoding='utf-8') as f:
			json.dump(payload, f, ensure_ascii=False, sort_keys=True)
			f.write('\n')
		embedded = self._player_embed_user_labels(path, payload)
		return {'ok': True, 'file': os.path.basename(path), 'labels_file': os.path.basename(labels_path), 'labels_embedded': bool(embedded), 'mark_count': len(clean), 'range_count': len(clean_ranges), 'deleted_range_count': len(clean_deleted_ranges)}

	def _player_record_save_snapshot(self, packets, markers, started_t: float, live_marks=None):
		record_dir = self._player_record_dir_path()
		os.makedirs(record_dir, exist_ok=True)
		ts = datetime.datetime.now().strftime('%Y%m%d_%H%M%S')
		filepath = os.path.join(record_dir, f'player_raw_{ts}.npz')
		packet_count = len(packets)
		max_len = max((int(p.get('length', 0) or 0) for p in packets), default=0)
		max_len = max(1, max_len)
		samples = np.zeros((packet_count, max_len), dtype=np.uint16)
		lengths = np.zeros(packet_count, dtype=np.uint16)
		channels = np.zeros(packet_count, dtype=np.uint8)
		phases = np.zeros(packet_count, dtype=np.uint8)
		seq = np.zeros(packet_count, dtype=np.uint32)
		dev_ts = np.zeros(packet_count, dtype=np.uint64)
		flags = np.zeros(packet_count, dtype=np.uint32)
		reserved = np.zeros(packet_count, dtype=np.uint32)
		reserved2 = np.zeros(packet_count, dtype=np.uint32)
		host_t = np.zeros(packet_count, dtype=np.float64)
		for i, packet in enumerate(packets):
			arr = packet.get('samples')
			n = min(max_len, int(packet.get('length', 0) or 0))
			if arr is not None and n > 0:
				samples[i, :n] = np.asarray(arr[:n], dtype=np.uint16)
			lengths[i] = max(0, min(65535, n))
			channels[i] = 0 if int(packet.get('channel', 0) or 0) == 0 else 1
			phases[i] = int(packet.get('phase', 0) or 0) & 1
			seq[i] = int(packet.get('seq', 0) or 0) & 0xFFFFFFFF
			dev_ts[i] = int(packet.get('timestamp_us', 0) or 0) & 0xFFFFFFFFFFFFFFFF
			flags[i] = int(packet.get('flags', 0) or 0) & 0xFFFFFFFF
			reserved[i] = int(packet.get('reserved', 0) or 0) & 0xFFFFFFFF
			reserved2[i] = int(packet.get('reserved2', 0) or 0) & 0xFFFFFFFF
			host_t[i] = float(packet.get('host_t', 0.0) or 0.0)
		marker_count = len(markers)
		m_packet = np.zeros(marker_count, dtype=np.int32)
		m_channel = np.zeros(marker_count, dtype=np.uint8)
		m_start = np.zeros(marker_count, dtype=np.uint16)
		m_end = np.zeros(marker_count, dtype=np.uint16)
		m_peak = np.zeros(marker_count, dtype=np.uint16)
		m_level = np.zeros(marker_count, dtype=np.uint64)
		m_shift = np.zeros(marker_count, dtype=np.int16)
		m_peak_value = np.zeros(marker_count, dtype=np.float64)
		m_kind = np.empty(marker_count, dtype='U16')
		m_host_t = np.zeros(marker_count, dtype=np.float64)
		for i, marker in enumerate(markers):
			try:
				packet_idx_val = marker.get('packet_idx', -1)
				m_packet[i] = int(packet_idx_val) if packet_idx_val is not None else -1
			except Exception:
				m_packet[i] = -1
			m_channel[i] = 0 if int(marker.get('channel', 0) or 0) == 0 else 1
			m_start[i] = max(0, min(65535, int(marker.get('start', 0) or 0)))
			m_end[i] = max(0, min(65535, int(marker.get('end', 0) or 0)))
			m_peak[i] = max(0, min(65535, int(marker.get('peak', 0) or 0)))
			m_level[i] = _rt_clamp_detector_level(marker.get('level', 0) or 0)
			m_shift[i] = max(-32768, min(32767, int(marker.get('shift', 0) or 0)))
			m_peak_value[i] = float(marker.get('peak_value', 0.0) or 0.0)
			m_kind[i] = str(marker.get('kind', 'tag') or 'tag')[:16]
			m_host_t[i] = float(marker.get('host_t', 0.0) or 0.0)
		try:
			mode_selected = int(self.num_group.checkedId())
		except Exception:
			mode_selected = 0
		np.savez_compressed(
			filepath,
			schema=np.array([2], dtype=np.uint16),
			source=np.array(['raw_usb_before_detection'], dtype='U32'),
			created_at=np.array([datetime.datetime.now().isoformat(timespec='seconds')], dtype='U32'),
			started_t=np.array([float(started_t or 0.0)], dtype=np.float64),
			packet_count=np.array([packet_count], dtype=np.int32),
			marker_count=np.array([marker_count], dtype=np.int32),
			max_len=np.array([max_len], dtype=np.int32),
			freq_hz=np.array([int(getattr(self, 'freq_hz', 0) or getattr(self, 'desired_freq', 0) or 0)], dtype=np.int32),
			stream_mode=np.array([int(getattr(self, 'stream_mode', 0) or 0)], dtype=np.int32),
			mode_selected=np.array([int(mode_selected)], dtype=np.int32),
			avg_n=np.array([int(getattr(self, 'avg_n', 0) or 0)], dtype=np.int32),
			samples=samples,
			lengths=lengths,
			channels=channels,
			phases=phases,
			seq=seq,
			timestamp_us=dev_ts,
			flags=flags,
			reserved=reserved,
			reserved2=reserved2,
			host_t=host_t,
			marker_packet=m_packet,
			marker_channel=m_channel,
			marker_start=m_start,
			marker_end=m_end,
			marker_peak=m_peak,
			marker_level=m_level,
			marker_shift=m_shift,
			marker_peak_value=m_peak_value,
			marker_kind=m_kind,
			marker_host_t=m_host_t,
		)
		if live_marks:
			clean_marks = []
			for item in live_marks:
				if not isinstance(item, dict):
					continue
				try:
					packet_idx = int(item.get('packet_idx', -1))
				except Exception:
					packet_idx = -1
				if packet_idx < 0 or packet_idx >= packet_count:
					continue
				channel = self._player_label_channel_value(item.get('channel', item.get('tag_channel', '')))
				if not channel:
					continue
				tag_type = self._player_tag_type_value(item.get('tag_type', item.get('type', '')), 'casino') or 'casino'
				try:
					votes = max(1, int(item.get('votes', 1) or 1))
				except Exception:
					votes = 1
				try:
					conf = float(item.get('confidence', 0.55) or 0.55)
				except Exception:
					conf = 0.55
				try:
					hold_id = max(0, int(item.get('hold_id', item.get('tag_hold_id', 0)) or 0))
				except Exception:
					hold_id = 0
				clean_mark = {
					'packet_idx': packet_idx,
					'mark': 'tag',
					'tag_type': tag_type,
					'channel': channel,
					'scope': 'frame',
					'position': 'unknown',
					'source': str(item.get('source', 'live_record') or 'live_record')[:32],
					'votes': votes,
					'confidence': max(0.0, min(1.0, conf)),
				}
				if hold_id > 0:
					clean_mark['hold_id'] = hold_id
				clean_marks.append(clean_mark)
			if clean_marks:
				payload = {
					'schema': 2,
					'source_file': os.path.basename(filepath),
					'updated_at': time.time(),
					'updated_iso': datetime.datetime.now().isoformat(timespec='seconds'),
					'marks': clean_marks,
					'ranges': [],
				}
				self._player_embed_user_labels(filepath, payload)
		return filepath

	def _player_packet_markers_for_load(self, data):
		by_packet = {}
		files = set(getattr(data, 'files', []) or [])
		if 'marker_packet' not in files:
			return by_packet
		try:
			packets = np.asarray(data['marker_packet'], dtype=np.int32)
			channels = np.asarray(data['marker_channel'], dtype=np.uint8) if 'marker_channel' in files else np.zeros(len(packets), dtype=np.uint8)
			starts = np.asarray(data['marker_start'], dtype=np.int32) if 'marker_start' in files else np.zeros(len(packets), dtype=np.int32)
			ends = np.asarray(data['marker_end'], dtype=np.int32) if 'marker_end' in files else starts + 1
			peaks = np.asarray(data['marker_peak'], dtype=np.int32) if 'marker_peak' in files else starts
			levels = np.asarray(data['marker_level'], dtype=np.int64) if 'marker_level' in files else np.zeros(len(packets), dtype=np.int64)
			shifts = np.asarray(data['marker_shift'], dtype=np.int32) if 'marker_shift' in files else np.zeros(len(packets), dtype=np.int32)
			kinds = np.asarray(data['marker_kind']) if 'marker_kind' in files else np.array(['tag'] * len(packets), dtype='U16')
			for i, pkt in enumerate(packets):
				if int(pkt) < 0:
					continue
				marker = {
					'channel': 'upper' if int(channels[i]) == 0 else 'lower',
					'start': int(starts[i]),
					'end': int(ends[i]),
					'peak': int(peaks[i]),
					'level': int(levels[i]),
					'shift': int(shifts[i]),
					'kind': str(kinds[i] or 'tag'),
				}
				by_packet.setdefault(int(pkt), []).append(marker)
		except Exception:
			return {}
		return by_packet

	def _player_product_display_u16(self, prod_arr, n: int, step: int):
		try:
			arr = np.asarray(prod_arr)
			if arr.size <= 0 or int(n) <= 0:
				return []
			n = min(int(n), int(arr.size))
			step = max(1, int(step or 1))
			try:
				scale = float(self._rt_product_display_scale())
			except Exception:
				try:
					scale = float(os.getenv('BMI30_PROD_SCALE', '') or _rt_product_default_scale())
				except Exception:
					scale = _rt_product_default_scale()
			if not np.isfinite(scale) or scale <= 0.0:
				scale = _rt_product_default_scale()
			vals = np.asarray(arr[:n:step], dtype=np.float64) / float(scale)
			vals = np.nan_to_num(vals, nan=0.0, posinf=65535.0, neginf=0.0)
			vals = np.clip(vals, 0.0, 65535.0).astype(np.uint16)
			return vals.astype(int).tolist()
		except Exception:
			return []

	def _player_product_normed_u16(self, prod_arr, n: int, step: int):
		try:
			arr = np.asarray(prod_arr, dtype=np.float64)
			if arr.size <= 0 or int(n) <= 0:
				return []
			n = min(int(n), int(arr.size))
			step = max(1, int(step or 1))
			vals = np.asarray(arr[:n:step], dtype=np.float64)
			vals = np.nan_to_num(vals, nan=0.0, posinf=0.0, neginf=0.0)
			hi = float(np.max(vals)) if vals.size else 0.0
			if not np.isfinite(hi) or hi <= 1e-12:
				return np.zeros(vals.shape, dtype=np.uint16).astype(int).tolist()
			vals = vals * (65535.0 / hi)
			vals = np.clip(vals, 0.0, 65535.0).astype(np.uint16)
			return vals.astype(int).tolist()
		except Exception:
			return []

	def _player_product_norm_stats(self, prod_arr, n: int, step: int):
		try:
			arr = np.asarray(prod_arr, dtype=np.float64)
			if arr.size <= 0 or int(n) <= 0:
				return None
			n = min(int(n), int(arr.size))
			step = max(1, int(step or 1))
			vals = np.asarray(arr[:n:step], dtype=np.float64)
			vals = np.nan_to_num(vals, nan=0.0, posinf=0.0, neginf=0.0)
			if vals.size <= 0:
				return None
			lo = float(np.min(vals))
			hi = float(np.max(vals))
			span = float(hi - lo)
			scale = float(65535.0 / span) if np.isfinite(span) and span > 1e-12 else 0.0
			try:
				display_scale = float(self._rt_product_display_scale())
			except Exception:
				try:
					display_scale = float(os.getenv('BMI30_PROD_SCALE', '') or _rt_product_default_scale())
				except Exception:
					display_scale = _rt_product_default_scale()
			if not np.isfinite(display_scale) or display_scale <= 0.0:
				display_scale = _rt_product_default_scale()
			display_vals = np.clip(vals / display_scale, 0.0, 65535.0)
			return {
					'min': lo,
					'max': hi,
					'span': span,
					'scale': scale,
					'det_min': lo,
					'det_max': hi,
					'det_span': span,
					'screen_per_det': float(65535.0 / span) if span > 1e-12 else 0.0,
					'det_unit': 'raw-product',
				'display_min': float(np.min(display_vals)),
				'display_max': float(np.max(display_vals)),
				'display_span': float(np.max(display_vals) - np.min(display_vals)),
				'display_scale': float(display_scale),
			}
		except Exception:
			return None

	def _player_v7_curve_u16(self, arr, n: int, step: int):
		try:
			vals = np.asarray(arr, dtype=np.float64)
			if vals.size <= 0 or int(n) <= 0:
				return []
			n = min(int(n), int(vals.size))
			step = max(1, int(step or 1))
			vals = vals[:n:step]
			vals = np.nan_to_num(vals, nan=0.0, posinf=0.0, neginf=0.0)
			lo = float(np.min(vals)) if vals.size else 0.0
			hi = float(np.max(vals)) if vals.size else 0.0
			span = float(hi - lo)
			if not np.isfinite(span) or span <= 1e-12:
				return np.zeros(vals.shape, dtype=np.uint16).astype(int).tolist()
			vals = (vals - lo) * (65535.0 / span)
			vals = np.clip(vals, 0.0, 65535.0).astype(np.uint16)
			return vals.astype(int).tolist()
		except Exception:
			return []

	def _player_v7_meta_for_frame(self, result):
		try:
			if not isinstance(result, dict):
				return None
			return {
				'score_kind': str(result.get('score_kind', '') or ''),
				'dc_filter_mode': str(result.get('dc_filter_mode', '') or ''),
