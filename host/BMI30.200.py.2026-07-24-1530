def _sound_clamp_float(value, default: float, minimum: float, maximum: float) -> float:
	try:
		val = float(value)
	except Exception:
		val = float(default)
	try:
		if not np.isfinite(val):
			val = float(default)
	except Exception:
		val = float(default)
	return float(max(float(minimum), min(float(maximum), val)))

def _sound_clamp_frequency(value, default: float) -> float:
	return _sound_clamp_float(value, default, 1.0, 20000.0)

def _sound_pick(source: dict, *keys, default=None):
	for key in keys:
		try:
			if key in source:
				return source.get(key)
		except Exception:
			pass
	return default

def _normalize_sound_settings(source: dict | None = None, default_enabled: bool = False) -> dict:
	try:
		src = dict(source or {})
	except Exception:
		src = {}
	settings = src.get("sound_settings") if isinstance(src.get("sound_settings"), dict) else {}
	sound_block = src.get("sound") if isinstance(src.get("sound"), dict) else {}
	merged = {}
	try:
		merged.update(sound_block)
		merged.update(settings)
		merged.update(src)
	except Exception:
		merged = dict(src)
	enabled_default = _det_parse_bool(
		_sound_pick(merged, "enabled", "sound_enabled", default=default_enabled),
		bool(default_enabled),
	)
	upper_base = _sound_clamp_frequency(
		_sound_pick(merged, "upper_frequency_hz", "upper_freq_hz", "beep_adc0_base", default=os.getenv("BMI30_BEEP_ADC0_BASE", "4000")),
		4000.0,
	)
	lower_base = _sound_clamp_frequency(
		_sound_pick(merged, "lower_frequency_hz", "lower_freq_hz", "beep_adc1_base", default=os.getenv("BMI30_BEEP_ADC1_BASE", "1000")),
		1000.0,
	)
	phase_upper_min = _sound_clamp_frequency(
		_sound_pick(merged, "phase_upper_min_hz", "upper_phase_min_hz", "beep_adc0_min", default=os.getenv("BMI30_BEEP_ADC0_MIN", "1000")),
		1000.0,
	)
	phase_upper_max = _sound_clamp_frequency(
		_sound_pick(merged, "phase_upper_max_hz", "upper_phase_max_hz", "beep_adc0_max", default=os.getenv("BMI30_BEEP_ADC0_MAX", "3000")),
		3000.0,
	)
	phase_lower_min = _sound_clamp_frequency(
		_sound_pick(merged, "phase_lower_min_hz", "lower_phase_min_hz", "beep_adc1_min", default=os.getenv("BMI30_BEEP_ADC1_MIN", "2000")),
		2000.0,
	)
	phase_lower_max = _sound_clamp_frequency(
		_sound_pick(merged, "phase_lower_max_hz", "lower_phase_max_hz", "beep_adc1_max", default=os.getenv("BMI30_BEEP_ADC1_MAX", "4000")),
		4000.0,
	)
	if phase_upper_max < phase_upper_min:
		phase_upper_min, phase_upper_max = phase_upper_max, phase_upper_min
	if phase_lower_max < phase_lower_min:
		phase_lower_min, phase_lower_max = phase_lower_max, phase_lower_min
	minimum_duration_ms = _sound_clamp_float(
		_sound_pick(merged, "minimum_duration_ms", "min_duration_ms", default=150.0),
		150.0,
		0.0,
		60000.0,
	)
	minimum_tone_cycles = int(round(_sound_clamp_float(
		_sound_pick(merged, "minimum_tone_cycles", "min_tone_cycles", "minimum_cycles", default=1),
		1.0,
		1.0,
		1000.0,
	)))
	legacy_test = _det_parse_bool(_sound_pick(merged, "test_enabled", "test", default=False), False)
	test_upper = _det_parse_bool(_sound_pick(merged, "test_upper_enabled", "upper_test_enabled", "test_upper", default=legacy_test), legacy_test)
	test_lower = _det_parse_bool(_sound_pick(merged, "test_lower_enabled", "lower_test_enabled", "test_lower", default=legacy_test), legacy_test)
	return {
		"enabled": bool(enabled_default),
		"volume_percent": round(_sound_clamp_float(_sound_pick(merged, "volume_percent", "volume", "beep_volume_percent", default=os.getenv("BMI30_BEEP_VOLUME_PERCENT", os.getenv("BMI30_BEEP_VOLUME", "100"))), 100.0, 0.0, 100.0), 1),
		"upper_frequency_hz": round(upper_base, 1),
		"lower_frequency_hz": round(lower_base, 1),
		"phase_upper_min_hz": round(phase_upper_min, 1),
		"phase_upper_max_hz": round(phase_upper_max, 1),
		"phase_lower_min_hz": round(phase_lower_min, 1),
		"phase_lower_max_hz": round(phase_lower_max, 1),
		"minimum_duration_ms": int(round(minimum_duration_ms)),
		"minimum_tone_cycles": int(minimum_tone_cycles),
		"test_enabled": bool(test_upper or test_lower),
		"test_upper_enabled": bool(test_upper),
		"test_lower_enabled": bool(test_lower),
		"volume_scale": "ui_0_100_pwm_0_50",
	}

