	def _player_offline_ratio(self, channel: int) -> float:
		try:
			return float(self._det_channel_ratio(0 if int(channel) == 0 else 1))
		except Exception:
			try:
				return float(getattr(self, '_det_ratio', 2.0) or 2.0)
			except Exception:
				return 2.0

	def _player_offline_confirm_count(self, channel: int) -> int:
		try:
			return max(1, int(self._det_channel_confirm_count(0 if int(channel) == 0 else 1)))
		except Exception:
			return 2

	def _player_offline_noise_steps(self, channel: int, in_detect: bool):
		ch = 0 if int(channel) == 0 else 1
		if bool(in_detect):
			try:
				up = int(getattr(self, '_det_step_detect_up', 2) or 2)
			except Exception:
				up = 2
			try:
				down = int(getattr(self, '_det_step_detect_down', 1) or 1)
			except Exception:
				down = 1
			return max(1, up), max(1, down)
		try:
			up = int(getattr(self, '_det_step_idle_up0' if ch == 0 else '_det_step_idle_up1', 24) or 24)
		except Exception:
			up = 24
		try:
			down = int(getattr(self, '_det_step_idle_down0' if ch == 0 else '_det_step_idle_down1', 3) or 3)
		except Exception:
			down = 3
		return max(1, up), max(1, down)

	def _player_offline_update_threshold(self, channel: int, threshold: int, level: int, in_detect: bool) -> int:
		try:
			threshold = _rt_clamp_detector_level(threshold or 1, default=1, minimum=1)
			level = _rt_clamp_detector_level(level or 0)
		except Exception:
			threshold, level = 1, 0
		up, down = self._player_offline_noise_steps(channel, bool(in_detect))
		up = self._rt_detector_step_to_level_units(up)
		down = self._rt_detector_step_to_level_units(down)
		if level > threshold:
			threshold += int(up)
		else:
			threshold -= int(down)
		return _rt_clamp_detector_level(threshold, default=1, minimum=1)

	def player_recording_load(self, name: str = 'latest', max_points: int = 600, max_frames: int = 800):
		path = self._player_record_file_path(name)
		if not path or not os.path.exists(path):
			return {'ok': False, 'error': 'recording file not found'}
		try:
			self.player_playback_start()
		except Exception:
			pass
		max_points = max(16, min(4096, int(max_points or 600)))
		max_frames = max(1, min(5000, int(max_frames or 800)))
		with np.load(path, allow_pickle=False) as data:
			samples = np.asarray(data['samples'], dtype=np.uint16)
			lengths = np.asarray(data['lengths'], dtype=np.int32)
			channels = np.asarray(data['channels'], dtype=np.uint8)
			phases = np.asarray(data['phases'], dtype=np.uint8)
			host_t = np.asarray(data['host_t'], dtype=np.float64) if 'host_t' in data.files else np.zeros(len(lengths), dtype=np.float64)
			packet_count = int(len(lengths))
			stored_markers_by_packet = self._player_packet_markers_for_load(data)
			try:
				use_stored_markers = str(os.getenv('BMI30_PLAYER_USE_STORED_MARKERS', '0')).lower() not in ('0', 'false', 'no')
			except Exception:
				use_stored_markers = False
			markers_by_packet = {int(k): list(v) for k, v in stored_markers_by_packet.items()} if use_stored_markers else {}
			user_labels = self._player_load_user_labels(path)
			if not (user_labels.get('marks') or user_labels.get('mark_types') or user_labels.get('ranges') or user_labels.get('deleted_ranges')):
				user_labels = self._player_load_embedded_user_labels(data)
			user_marks = user_labels.get('marks', {}) if isinstance(user_labels, dict) else {}
			user_mark_types = user_labels.get('mark_types', {}) if isinstance(user_labels, dict) else {}
			user_mark_channels = user_labels.get('mark_channels', {}) if isinstance(user_labels, dict) else {}
			user_mark_scopes = user_labels.get('mark_scopes', {}) if isinstance(user_labels, dict) else {}
			user_mark_positions = user_labels.get('mark_positions', {}) if isinstance(user_labels, dict) else {}
			user_mark_votes = user_labels.get('mark_votes', {}) if isinstance(user_labels, dict) else {}
			user_mark_confidence = user_labels.get('mark_confidence', {}) if isinstance(user_labels, dict) else {}
			user_mark_sources = user_labels.get('mark_sources', {}) if isinstance(user_labels, dict) else {}
			user_mark_hold_ids = user_labels.get('mark_hold_ids', {}) if isinstance(user_labels, dict) else {}
			user_ranges_by_packet = user_labels.get('ranges', {}) if isinstance(user_labels, dict) else {}
			user_deleted_ranges_by_packet = user_labels.get('deleted_ranges', {}) if isinstance(user_labels, dict) else {}
			for pkt, ranges in (user_ranges_by_packet or {}).items():
				try:
					pkt_i = int(pkt)
				except Exception:
					continue
				if isinstance(ranges, list):
					markers_by_packet.setdefault(pkt_i, []).extend(ranges)
			marker_packets = set(int(k) for k in markers_by_packet.keys())
			user_mark_packets = set(int(k) for k in user_marks.keys())
			user_range_packets = set(int(k) for k in (user_ranges_by_packet or {}).keys())
			user_deleted_range_packets = set(int(k) for k in (user_deleted_ranges_by_packet or {}).keys())
			if packet_count <= max_frames:
				selected = set(range(packet_count))
			else:
				stride = max(1, int(np.ceil(float(packet_count) / float(max_frames))))
				selected = set(range(0, packet_count, stride))
				selected.add(packet_count - 1)
				selected.update(marker_packets)
				selected.update(user_mark_packets)
				selected.update(user_range_packets)
				selected.update(user_deleted_range_packets)
			selected = set(i for i in selected if 0 <= int(i) < packet_count)
			state = {}
			state_len = {}
			prod_state = {}
			prod_meta = {}
			v7_state = {}
			frames = []
			det_thr = [0, 0]
			det_cnt = [0, 0]
			det_peak = [None, None]
			det_hold = [False, False]
			try:
				level_scale = float(self._rt_detector_level_scale())
			except Exception:
				try:
					level_scale = float(os.getenv('BMI30_DETECT_LEVEL_SCALE', '') or 0.0)
				except Exception:
					level_scale = 0.0
				if level_scale <= 0.0 or not np.isfinite(level_scale):
					try:
						level_scale = float(os.getenv('BMI30_PROD_SCALE', '') or _rt_product_default_scale())
					except Exception:
						level_scale = _rt_product_default_scale()
			if level_scale <= 0.0 or not np.isfinite(level_scale):
				level_scale = _rt_product_default_scale()
			try:
				max_shift = int(getattr(self, '_rt_det_max_shift', 0) or 0)
			except Exception:
				max_shift = 0
			try:
				v7_energy_radius = max(0, int(os.getenv('BMI30_MODE7_ENERGY_RADIUS', '12') or 12))
			except Exception:
				v7_energy_radius = 12
			try:
				v7_dc_mode = str(os.getenv('BMI30_MODE7_DC_MODE', 'OFF') or 'OFF').strip().upper()
			except Exception:
				v7_dc_mode = 'OFF'
			if v7_dc_mode not in ('OFF', 'LOCAL', 'HIGHPASS', 'BOTH'):
				v7_dc_mode = 'OFF'
			try:
				v7_score_kind = str(os.getenv('BMI30_MODE7_SCORE_KIND', 'BIPOLAR_GUIDED') or 'BIPOLAR_GUIDED').strip().upper()
			except Exception:
				v7_score_kind = 'BIPOLAR_GUIDED'
			if v7_score_kind not in _RT_V7_SCORE_KINDS:
				v7_score_kind = 'COMBINED'

			def scalar(name, default=0):
				try:
					return int(np.asarray(data[name]).reshape(-1)[0])
				except Exception:
					return int(default)

			freq_hz = scalar('freq_hz', int(getattr(self, 'desired_freq', 0) or 0))
			stream_mode = scalar('stream_mode', int(getattr(self, 'stream_mode', 0) or 0))
			avg_n = scalar('avg_n', int(getattr(self, 'avg_n', 0) or 0))

			def arr_for(key, n, step):
				arr = state.get(key)
				if arr is None or n <= 0:
					return []
				try:
					vals = np.asarray(arr[:n:step], dtype=np.uint16)
					return vals.astype(int).tolist()
				except Exception:
					return []

			def prod_for(ch, n, step):
				return self._player_product_display_u16(prod_state.get(ch), n, step)

			def prod_normed_for(ch, n, step):
				return self._player_product_normed_u16(prod_state.get(ch), n, step)

			def prod_stats_for(ch, n, step):
				return self._player_product_norm_stats(prod_state.get(ch), n, step)

			def v7_curve_for(ch, name, n, step):
				res = v7_state.get(0 if int(ch) == 0 else 1)
				if not isinstance(res, dict):
					return []
				return self._player_v7_curve_u16(res.get(str(name), None), n, step)

			def v7_meta_for(ch):
				return self._player_v7_meta_for_frame(v7_state.get(0 if int(ch) == 0 else 1))

			def process_offline_mode7(ch):
				ch = 0 if int(ch) == 0 else 1
				even = state.get((ch, 0))
				odd = state.get((ch, 1))
				if even is None or odd is None:
					return
				try:
					v7_state[ch] = analyze_phase_pair_v7(
						even,
						odd,
						int(max_shift),
						int(v7_energy_radius),
						str(v7_dc_mode),
						str(v7_score_kind),
					)
				except Exception:
					v7_state[ch] = None

			def process_offline_detection(packet_idx, ch, base_len):
				ch = 0 if int(ch) == 0 else 1
				even = state.get((ch, 0))
				odd = state.get((ch, 1))
				if even is None or odd is None:
					return
				made = _rt_detector_product_current_prev(even, odd, int(max_shift), 'prod', float(level_scale))
				if made is None:
					return
				level, shift, peak_idx, peak_value = made[:4]
				prod_arr = made[4] if len(made) >= 5 else None
				if prod_arr is None:
					prod_arr = _rt_detector_product_display(even, odd, int(shift))
				if prod_arr is not None:
					prod_state[ch] = prod_arr
					prod_meta[ch] = {
						'level': int(level),
						'shift': int(shift),
						'peak': int(peak_idx),
						'peak_value': float(peak_value),
					}
					level_i = _rt_clamp_detector_level(level or 0)
				if level_i <= 0:
					det_cnt[ch] = 0
					if det_hold[ch]:
						det_hold[ch] = False
					if det_thr[ch] <= 0:
						det_thr[ch] = 1
					det_thr[ch] = self._player_offline_update_threshold(ch, det_thr[ch], level_i, False)
					return
				if det_thr[ch] <= 0:
					det_thr[ch] = max(1, level_i)
				thr_prev = max(1, int(det_thr[ch] or 1))
				ratio = self._player_offline_ratio(ch)
				candidate = bool(float(level_i) > float(ratio) * float(thr_prev))
				try:
					candidate = bool(candidate or int(level_i) >= _rt_detector_quarter_trigger_min_level())
				except Exception:
					pass
				noise_ok = True
				shape_ok = True
				peak_position_ok = True
				if candidate:
					try:
						noise_ok, _noise_far, _noise_part, _q = _rt_detector_quarter_noise_supported(prod_arr, int(peak_idx), float(peak_value), float(ratio))
					except Exception:
						noise_ok = False
					if bool(noise_ok):
						try:
							shape_ok = bool(_rt_detector_mark_shape_supported(prod_arr, int(peak_idx), float(peak_value)))
							if bool(shape_ok):
								shape_ok = bool(_rt_detector_locality_supported(prod_arr, int(peak_idx), float(peak_value), float(ratio)))
							if bool(shape_ok):
								shape_ok = bool(_rt_detector_raw_frame_supported(even, odd, int(peak_idx), float(ratio)))
						except Exception:
							shape_ok = False
					try:
						sample_count = int(getattr(prod_arr, 'size', 0) or base_len or 0)
						peak_position_ok = bool(_rt_detector_peak_position_supported(int(peak_idx), sample_count))
					except Exception:
						peak_position_ok = False
				exceed = bool(candidate and noise_ok and shape_ok and peak_position_ok)
				if exceed:
					first_idx = det_peak[ch]
					if first_idx is None or det_cnt[ch] <= 0:
						det_cnt[ch] = 1
						det_peak[ch] = int(peak_idx)
					else:
						try:
							if abs(int(peak_idx) - int(first_idx)) <= 30:
								det_cnt[ch] += 1
							else:
								det_cnt[ch] = 1
								det_peak[ch] = int(peak_idx)
						except Exception:
							det_cnt[ch] = 1
							det_peak[ch] = int(peak_idx)
				else:
					det_cnt[ch] = 0
					det_peak[ch] = None
				fire = bool(exceed and (det_cnt[ch] >= self._player_offline_confirm_count(ch)) and not det_hold[ch])
				if fire:
					try:
						start, end, peak = self._player_record_marker_range(prod_arr, int(peak_idx), float(peak_value), int(base_len))
					except Exception:
						start, end, peak = max(0, int(peak_idx) - 12), min(max(1, int(base_len)) - 1, int(peak_idx) + 12), int(peak_idx)
					markers_by_packet.setdefault(int(packet_idx), []).append({
						'channel': 'upper' if ch == 0 else 'lower',
						'start': int(start),
						'end': int(end),
						'peak': int(peak),
						'level': int(level_i),
						'threshold': int(thr_prev),
						'ratio': float(ratio),
						'shift': int(shift),
						'kind': 'det',
					})
					marker_packets.add(int(packet_idx))
					selected.add(int(packet_idx))
					det_hold[ch] = True
				try:
					loss_ratio = float(getattr(self, '_det_loss_ratio', 1.4) or 1.4)
				except Exception:
					loss_ratio = 1.4
				if det_hold[ch] and float(level_i) < float(loss_ratio) * float(thr_prev):
					det_hold[ch] = False
				det_thr[ch] = self._player_offline_update_threshold(ch, thr_prev, level_i, exceed)

			for i in range(packet_count):
				n = max(0, min(int(lengths[i]), int(samples.shape[1])))
				ch = 0 if int(channels[i]) == 0 else 1
				phase = int(phases[i]) & 1
				key = (ch, phase)
				if n > 0:
					state[key] = np.array(samples[i, :n], dtype=np.uint16, copy=True)
					state_len[key] = n
				base_len = max(state_len.values(), default=n)
				if base_len > 0:
					process_offline_detection(i, ch, base_len)
					process_offline_mode7(0)
					process_offline_mode7(1)
				if i not in selected:
					continue
				if base_len <= 0:
					continue
				step = max(1, int(np.ceil(float(base_len) / float(max_points))))
				count = int(len(range(0, base_len, step)))
				frame = {
					'ok': True,
					'available': True,
					'base_buf_len': int(base_len),
					'step': int(step),
					'count': int(count),
					'last_frame_t': float(host_t[i]) if i < len(host_t) else float(i),
					'_channels': 'both',
					'data0_even': arr_for((0, 0), base_len, step),
					'data0_odd': arr_for((0, 1), base_len, step),
					'data1_even': arr_for((1, 0), base_len, step),
					'data1_odd': arr_for((1, 1), base_len, step),
					'prod0': prod_for(0, base_len, step),
					'prod1': prod_for(1, base_len, step),
					'prod0_normed': prod_normed_for(0, base_len, step),
					'prod1_normed': prod_normed_for(1, base_len, step),
					'prod_norm0': prod_stats_for(0, base_len, step),
					'prod_norm1': prod_stats_for(1, base_len, step),
					'v7_sum0': v7_curve_for(0, 'sum_signal', base_len, step),
					'v7_sum1': v7_curve_for(1, 'sum_signal', base_len, step),
					'v7_product0': v7_curve_for(0, 'product_signal', base_len, step),
					'v7_product1': v7_curve_for(1, 'product_signal', base_len, step),
					'v7_energy0': v7_curve_for(0, 'energy_curve', base_len, step),
					'v7_energy1': v7_curve_for(1, 'energy_curve', base_len, step),
					'v7_meta0': v7_meta_for(0),
					'v7_meta1': v7_meta_for(1),
				}
				frame_deleted_ranges = user_deleted_ranges_by_packet.get(i, [])
				frame_markers = self._player_filter_deleted_markers(markers_by_packet.get(i, []), frame_deleted_ranges)
				frames.append({
					'packet_idx': int(i),
					'captured_at': datetime.datetime.fromtimestamp(float(host_t[i]) if i < len(host_t) and host_t[i] > 0 else time.time()).isoformat(timespec='milliseconds'),
					'frame': frame,
					'status': {
						't': float(host_t[i]) if i < len(host_t) else float(i),
						'mode_selected': 6,
						'stream_mode': int(stream_mode),
						'base_buf_len': int(base_len),
						'freq_hz': int(freq_hz),
						'avg_n': int(avg_n),
						'working_window': None,
						'player_offline_detection': {
							'thr0': int(det_thr[0]),
							'thr1': int(det_thr[1]),
							'lvl0': int((prod_meta.get(0) or {}).get('level', 0) or 0),
							'lvl1': int((prod_meta.get(1) or {}).get('level', 0) or 0),
							'v7_score_kind': str(v7_score_kind),
							'v7_dc_mode': str(v7_dc_mode),
							'v7_energy_radius': int(v7_energy_radius),
						},
					},
					'mark': str(user_marks.get(int(i), '') or ''),
					'tag_type': str(user_mark_types.get(int(i), '') or ''),
					'tag_channel': str(user_mark_channels.get(int(i), '') or ''),
					'tag_scope': str(user_mark_scopes.get(int(i), '') or ''),
					'tag_position': str(user_mark_positions.get(int(i), '') or ''),
					'tag_votes': int(user_mark_votes.get(int(i), 0) or 0),
					'tag_confidence': float(user_mark_confidence.get(int(i), 0.0) or 0.0),
					'tag_source': str(user_mark_sources.get(int(i), '') or ''),
					'tag_hold_id': int(user_mark_hold_ids.get(int(i), 0) or 0),
					'markers': frame_markers,
					'deleted_ranges': frame_deleted_ranges,
				})
			try:
				created_at = str(np.asarray(data['created_at']).reshape(-1)[0]) if 'created_at' in data.files else ''
			except Exception:
				created_at = ''
			filtered_marker_count = int(sum(len(self._player_filter_deleted_markers(v, user_deleted_ranges_by_packet.get(int(k), []))) for k, v in markers_by_packet.items()))
			return {
				'ok': True,
				'file': os.path.basename(path),
				'path': path,
				'created_at': created_at,
				'source': 'raw_usb_before_detection',
				'packet_count': int(packet_count),
				'marker_count': filtered_marker_count,
				'user_mark_count': int(len(user_marks)),
				'deleted_range_count': int(sum(len(v) for v in (user_deleted_ranges_by_packet or {}).values() if isinstance(v, list))),
				'frame_count': int(len(frames)),
				'frames': frames,
			}

	def _player_record_raw_packet(self, channel: int, frame, samples, phase: int = 0):
		try:
			if not bool(getattr(self, '_player_recording', False)):
				return -1
			src = np.asarray(samples)
			if src.size <= 0:
				return -1
			limit = min(int(src.size), int(getattr(self, 'max_samples', src.size) or src.size), 65535)
			if limit <= 0:
				return -1
			arr = np.clip(src[:limit], 0, 65535).astype(np.uint16, copy=True)
			with self._player_record_lock:
				if not bool(getattr(self, '_player_recording', False)):
					return -1
				max_packets = int(getattr(self, '_player_record_max_packets', 5000) or 5000)
				if len(self._player_record_packets) >= max_packets:
					self._player_recording = False
					self._player_record_last_error = f'max packet limit reached ({max_packets})'
					return -1
				idx = len(self._player_record_packets)
				packet = {
					'channel': 0 if int(channel) == 0 else 1,
					'seq': int(getattr(frame, 'seq', 0) or 0) if frame is not None else 0,
					'timestamp_us': int(getattr(frame, 'timestamp', 0) or 0) if frame is not None else 0,
					'flags': int(getattr(frame, 'flags', 0) or 0) if frame is not None else 0,
					'reserved': int(getattr(frame, 'reserved', 0) or 0) if frame is not None else 0,
					'reserved2': int(getattr(frame, 'reserved2', 0) or 0) if frame is not None else 0,
					'phase': int(phase) & 1,
					'host_t': time.time(),
					'length': int(limit),
					'samples': arr,
				}
				self._player_record_packets.append(packet)
				if int(channel) == 0:
					self._player_record_last_packet_idx0 = idx
				else:
					self._player_record_last_packet_idx1 = idx
				return idx
		except Exception as e:
			try:
				with self._player_record_lock:
					self._player_record_last_error = str(e)
			except Exception:
				pass
			return -1

	def _player_record_marker_range(self, prod_arr, peak_idx: int, peak_value: float, n: int):
		n = max(1, int(n or 1))
		peak = max(0, min(n - 1, int(peak_idx or 0)))
		half = max(1, int(getattr(self, '_player_record_marker_half_width', 12) or 12))
		start = max(0, peak - half)
		end = min(n - 1, peak + half)
		try:
			if prod_arr is not None:
				arr = np.asarray(prod_arr)
			if arr.size > peak:
					arr = np.abs(arr.astype(np.float64, copy=False))
					pv = float(abs(peak_value)) if np.isfinite(float(peak_value or 0.0)) else 0.0
					pv = max(pv, float(arr[peak]))
					if pv > 0.0:
						thr = pv * 0.35
						left = peak
						right = peak
						max_width = max((half * 2) + 1, min(n, 160))
						while left > 0 and arr[left - 1] >= thr and (right - left) < max_width:
							left -= 1
						while right < min(n, arr.size) - 1 and arr[right + 1] >= thr and (right - left) < max_width:
							right += 1
						start = max(0, min(left, peak - half))
						end = min(n - 1, max(right, peak + half))
		except Exception:
			pass
		if end <= start:
			end = min(n - 1, start + 1)
		return int(start), int(end), int(peak)

	def _player_record_note_detection(self, channel: int, lvl: int, shift: int = 0, peak_idx: int = 0, peak_value: float = 0.0, prod_arr=None, det_seq=None, kind: str = 'tag'):
		try:
			if not bool(getattr(self, '_player_recording', False)):
				return
			ch = 0 if int(channel) == 0 else 1
			with self._player_record_lock:
				if det_seq is not None:
					packet_idx = int(self._player_record_det_seq_map.get((ch, int(det_seq)), -1))
				else:
					packet_idx = -1
				if packet_idx < 0:
					packet_idx = int(getattr(self, '_player_record_last_packet_idx0' if ch == 0 else '_player_record_last_packet_idx1', -1))
				if packet_idx < 0 or packet_idx >= len(self._player_record_packets):
					return
				packet = self._player_record_packets[packet_idx]
				n = int(packet.get('length', 0) or 0)
				start, end, peak = self._player_record_marker_range(prod_arr, int(peak_idx), float(peak_value or 0.0), n)
				if self._player_record_markers:
					last = self._player_record_markers[-1]
					if int(last.get('packet_idx', -2)) == packet_idx and int(last.get('channel', -1)) == ch:
						return
				self._player_record_markers.append({
					'packet_idx': int(packet_idx),
					'channel': int(ch),
						'start': int(start),
						'end': int(end),
						'peak': int(peak),
						'level': _rt_clamp_detector_level(lvl or 0),
						'shift': int(shift or 0),
					'peak_value': float(peak_value or 0.0),
					'kind': str(kind or 'tag')[:16],
					'host_t': time.time(),
				})
		except Exception:
			pass

	def _capture_current_key(self):
		"""Return a key that changes only when a new frame arrives."""
		try:
			se0 = getattr(self, 'seq0_even', None)
			so0 = getattr(self, 'seq0_odd', None)
			se1 = getattr(self, 'seq1_even', None)
			so1 = getattr(self, 'seq1_odd', None)
			lf = float(getattr(self, 'last_frame_t', 0.0) or 0.0)
			if se0 is None and so0 is None and se1 is None and so1 is None and lf <= 0.0:
				return None
			return (se0, so0, se1, so1, lf)
		except Exception:
			return None

	def _capture_push_frame(self):
		"""Push current frame data to circular buffer (called from _tick after data update)."""
		if not bool(getattr(self, '_auto_capture_enabled', False)):
			return
		try:
			# Skip if no new frame since last push (prevents duplicate ticks)
			cur_key = self._capture_current_key()
			if cur_key is None:
				return
			if cur_key == getattr(self, '_capture_last_key', None):
				return
			with self.data_lock:
				# Копируем корреляционные массивы (уже вычисленные в _xcorr_compute)
				prod0_arr = None
				prod1_arr = None
				if hasattr(self, '_xcorr_saved_prod0') and hasattr(self, '_xcorr_saved_prod1'):
					try:
						# Копируем корреляционные данные
						prod0_arr = np.copy(self._xcorr_saved_prod0[:self.base_buf_len]) if self.base_buf_len else None
						prod1_arr = np.copy(self._xcorr_saved_prod1[:self.base_buf_len]) if self.base_buf_len else None
					except Exception:
						pass
				
				# Copy current frame data (all 4 arrays: even/odd for both channels)
				frame = {
					'timestamp': time.time(),
					'seq0_even': getattr(self, 'seq0_even', None),
					'seq0_odd': getattr(self, 'seq0_odd', None),
					'seq1_even': getattr(self, 'seq1_even', None),
					'seq1_odd': getattr(self, 'seq1_odd', None),
					'data0_even': np.copy(self.data0_even[:self.base_buf_len]) if self.base_buf_len else None,
					'data0_odd': np.copy(self.data0_odd[:self.base_buf_len]) if self.base_buf_len else None,
					'data1_even': np.copy(self.data1_even[:self.base_buf_len]) if self.base_buf_len else None,
					'data1_odd': np.copy(self.data1_odd[:self.base_buf_len]) if self.base_buf_len else None,
					'prod0': prod0_arr,  # Корреляционный массив ch0
					'prod1': prod1_arr,  # Корреляционный массив ch1
					'base_buf_len': self.base_buf_len,
					'freq_hz': self.freq_hz,
					'avg_n': getattr(self, 'avg_n', 20),
					'stream_mode': getattr(self, 'stream_mode', 0),
					# Detector state
					'det_thr0': getattr(self, '_det_thr0', 0),
					'det_thr1': getattr(self, '_det_thr1', 0),
					'det_lvl0': getattr(self, '_det_last_lvl0', 0),
					'det_lvl1': getattr(self, '_det_last_lvl1', 0),
					'det_shift0': getattr(self, '_det_last_shift0', 0),
					'det_shift1': getattr(self, '_det_last_shift1', 0),
					'det_amp0': getattr(self, '_det_last_amp0', 0),
					'det_amp1': getattr(self, '_det_last_amp1', 0),
					'det_hold0': getattr(self, '_det_hold0', False),
					'det_hold1': getattr(self, '_det_hold1', False),
					'det_frozen': getattr(self, '_det_dc_frozen', False),
				}
			with self._capture_buffer_lock:
				self._capture_buffer.append(frame)
				# Keep only last N frames
				max_size = int(getattr(self, '_capture_buffer_size', 50))
				if len(self._capture_buffer) > max_size:
					self._capture_buffer.pop(0)
			# Mark last pushed key
			self._capture_last_key = cur_key
		except Exception as e:
			if bool(getattr(self, 'debug', False)):
				print(f"[CAPTURE] Error pushing frame: {e}", flush=True)

	def _capture_trigger(self, reason: str = ''):
		"""Trigger capture session on detection fire."""
		auto_cap = bool(getattr(self, '_auto_capture_enabled', False))
		if not auto_cap:
			return
		print(f"\n*** [CAPTURE] Trigger called: enabled={auto_cap}, reason={reason} ***\n", flush=True)
		try:
			state = str(getattr(self, '_capture_state', 'idle'))
			if state != 'idle':
				print(f"[CAPTURE] Trigger skipped - state={state}", flush=True)
				return  # Already capturing
			self._capture_state = 'triggered'
			print(f"[CAPTURE] Session starting...", flush=True)
			# Initialize session
			self._capture_session = {
				'trigger_time': time.time(),
				'reason': str(reason),
				'frames': [],  # Will collect PRE + HOLD + POST frames
				'metadata': {
					'profile': getattr(self, 'desired_profile', 1),
					'freq_hz': getattr(self, 'freq_hz', 200),
					'avg_n': getattr(self, 'avg_n', 20),
					'stream_mode': getattr(self, 'stream_mode', 0),
					'det_source': getattr(self, '_det_source', 'norm'),
					'det_ratio': getattr(self, '_det_ratio', 2.0),
					'pre_frames': int(getattr(self, '_capture_pre_frames', 30)),
				}
			}
			# Copy PRE frames from circular buffer
			with self._capture_buffer_lock:
				pre_count = min(len(self._capture_buffer), int(getattr(self, '_capture_pre_frames', 30)))
				if pre_count > 0:
					self._capture_session['frames'].extend(self._capture_buffer[-pre_count:])
			# Mark trigger index (frame after PRE)
			self._capture_trigger_index = len(self._capture_session['frames'])
			self._capture_last_record_key = None
			self._capture_frames_recorded = len(self._capture_session['frames'])
			self._capture_post_countdown = 0
			self._capture_state = 'recording'
			print(f"\n*** [CAPTURE] ✓✓✓ Session started: PRE={self._capture_frames_recorded} frames ***\n", flush=True)
		except Exception as e:
			print(f"[CAPTURE] Error triggering session: {e}", flush=True)
			self._capture_state = 'idle'

	def _capture_record_frame(self) -> bool:
		"""Record current frame during active capture session (HOLD phase)."""
		if not bool(getattr(self, '_auto_capture_enabled', False)):
			return False
		try:
			state = str(getattr(self, '_capture_state', 'idle'))
			if state not in ('recording', 'finalizing'):
				return False
			# Skip if no new frame since last record
			cur_key = self._capture_current_key()
			if cur_key is None:
				return False
			if cur_key == getattr(self, '_capture_last_record_key', None):
				return False
			# Проверка: если достигли максимума фреймов, переходим в POST фазу (только в recording)
			if state == 'recording':
				max_frames = int(getattr(self, '_capture_max_frames', 41))
				current_count = len(self._capture_session.get('frames', []))
				if current_count >= max_frames:
					# Переходим в POST фазу (досрочно)
					print(f"[CAPTURE] Max frames reached ({current_count}/{max_frames}), starting POST phase", flush=True)
					self._capture_start_post()
					return False
			# Copy current frame (same as _capture_push_frame but directly to session)
			with self.data_lock:
				# Копируем корреляционные массивы (уже вычисленные в _xcorr_compute)
				prod0_arr = None
				prod1_arr = None
				if hasattr(self, '_xcorr_saved_prod0') and hasattr(self, '_xcorr_saved_prod1'):
					try:
						# Копируем корреляционные данные
						prod0_arr = np.copy(self._xcorr_saved_prod0[:self.base_buf_len]) if self.base_buf_len else None
						prod1_arr = np.copy(self._xcorr_saved_prod1[:self.base_buf_len]) if self.base_buf_len else None
					except Exception:
						pass
				
				frame = {
					'timestamp': time.time(),
					'seq0_even': getattr(self, 'seq0_even', None),
					'seq0_odd': getattr(self, 'seq0_odd', None),
					'seq1_even': getattr(self, 'seq1_even', None),
					'seq1_odd': getattr(self, 'seq1_odd', None),
					'data0_even': np.copy(self.data0_even[:self.base_buf_len]) if self.base_buf_len else None,
					'data0_odd': np.copy(self.data0_odd[:self.base_buf_len]) if self.base_buf_len else None,
					'data1_even': np.copy(self.data1_even[:self.base_buf_len]) if self.base_buf_len else None,
					'data1_odd': np.copy(self.data1_odd[:self.base_buf_len]) if self.base_buf_len else None,
					'prod0': prod0_arr,  # Корреляционный массив ch0
					'prod1': prod1_arr,  # Корреляционный массив ch1
					'base_buf_len': self.base_buf_len,
					'freq_hz': self.freq_hz,
					'avg_n': getattr(self, 'avg_n', 20),
					'stream_mode': getattr(self, 'stream_mode', 0),
					'det_thr0': getattr(self, '_det_thr0', 0),
					'det_thr1': getattr(self, '_det_thr1', 0),
					'det_lvl0': getattr(self, '_det_last_lvl0', 0),
					'det_lvl1': getattr(self, '_det_last_lvl1', 0),
					'det_shift0': getattr(self, '_det_last_shift0', 0),
					'det_shift1': getattr(self, '_det_last_shift1', 0),
					'det_amp0': getattr(self, '_det_last_amp0', 0),
					'det_amp1': getattr(self, '_det_last_amp1', 0),
					'det_hold0': getattr(self, '_det_hold0', False),
					'det_hold1': getattr(self, '_det_hold1', False),
					'det_frozen': getattr(self, '_det_dc_frozen', False),
				}
			if hasattr(self, '_capture_session') and self._capture_session:
				self._capture_session['frames'].append(frame)
				self._capture_frames_recorded += 1
				self._capture_last_record_key = cur_key
				return True
		except Exception as e:
			if bool(getattr(self, 'debug', False)):
				print(f"[CAPTURE] Error recording frame: {e}", flush=True)
		return False

	def _capture_start_post(self):
		"""Start POST frame countdown (signal lost, capture last N frames)."""
		if not bool(getattr(self, '_auto_capture_enabled', False)):
			return
		try:
			state = str(getattr(self, '_capture_state', 'idle'))
			if state != 'recording':
				return
			self._capture_state = 'finalizing'
			post_frames = int(getattr(self, '_capture_post_frames', 10))
			# enforce at least 4 post frames
			self._capture_post_countdown = max(4, post_frames)
			self._capture_post_started = time.time()
			print(f"\n*** [CAPTURE] → POST phase, countdown={self._capture_post_countdown} ***\n", flush=True)
		except Exception as e:
			if bool(getattr(self, 'debug', False)):
				print(f"[CAPTURE] Error starting POST: {e}", flush=True)

	def _capture_finalize(self):
		"""Finalize and save capture session to NPZ file."""
		auto_cap = bool(getattr(self, '_auto_capture_enabled', False))
		if not auto_cap:
			return
		print(f"\n*** [CAPTURE] Finalize called: enabled={auto_cap} ***\n", flush=True)
		try:
			has_session = hasattr(self, '_capture_session') and bool(self._capture_session)
			print(f"[CAPTURE] Has session: {has_session}", flush=True)
			if not has_session:
				print(f"[CAPTURE] No session to finalize", flush=True)
				self._capture_state = 'idle'
				return
			# Generate filename with timestamp and label
			ts = datetime.datetime.now().strftime('%Y%m%d_%H%M%S')
			label_state = int(getattr(self, '_capture_label_state', 0))
			label_suffix = ["_unk", "_lbl", "_nolbl"][label_state]  # unknown/labeled/no-label
			filename = f"capture_{ts}{label_suffix}.npz"
			capture_dir = str(getattr(self, '_capture_dir', './captures'))
			# Ensure directory exists before saving
			try:
				os.makedirs(capture_dir, exist_ok=True)
			except Exception as e:
				print(f"[CAPTURE] Не удалось создать папку {capture_dir}: {e}", flush=True)
				self._capture_state = 'idle'
				self._capture_session = None
				return
			filepath = os.path.join(capture_dir, filename)
			
			# Prepare arrays for NPZ
			frames = self._capture_session.get('frames', [])
			n_frames = len(frames)
			if n_frames == 0:
				self._capture_state = 'idle'
				self._capture_session = None
				return
			
			# Determine max buffer length
			max_len = max((f.get('base_buf_len', 0) or 0) for f in frames)
			if max_len == 0:
				max_len = 2048  # fallback
			
			# Allocate arrays
			data0_even_arr = np.zeros((n_frames, max_len), dtype=np.uint16)
			data0_odd_arr = np.zeros((n_frames, max_len), dtype=np.uint16)
			data1_even_arr = np.zeros((n_frames, max_len), dtype=np.uint16)
			data1_odd_arr = np.zeros((n_frames, max_len), dtype=np.uint16)
			prod0_arr = np.zeros((n_frames, max_len), dtype=np.float32)  # Корреляция ch0
			prod1_arr = np.zeros((n_frames, max_len), dtype=np.float32)  # Корреляция ch1
			timestamps_arr = np.zeros(n_frames, dtype=np.float64)
			seq0_even_arr = np.zeros(n_frames, dtype=np.int32)
			seq0_odd_arr = np.zeros(n_frames, dtype=np.int32)
			seq1_even_arr = np.zeros(n_frames, dtype=np.int32)
			seq1_odd_arr = np.zeros(n_frames, dtype=np.int32)
			det_thr0_arr = np.zeros(n_frames, dtype=np.int64)
			det_thr1_arr = np.zeros(n_frames, dtype=np.int64)
			det_lvl0_arr = np.zeros(n_frames, dtype=np.int64)
			det_lvl1_arr = np.zeros(n_frames, dtype=np.int64)
			det_shift0_arr = np.zeros(n_frames, dtype=np.int32)
			det_shift1_arr = np.zeros(n_frames, dtype=np.int32)
			det_amp0_arr = np.zeros(n_frames, dtype=np.int32)
			det_amp1_arr = np.zeros(n_frames, dtype=np.int32)
			det_hold0_arr = np.zeros(n_frames, dtype=bool)
			det_hold1_arr = np.zeros(n_frames, dtype=bool)
			det_frozen_arr = np.zeros(n_frames, dtype=bool)
			
			# Fill arrays
			for i, frame in enumerate(frames):
				timestamps_arr[i] = frame.get('timestamp', 0.0)
				seq0_even_arr[i] = frame.get('seq0_even', -1) or -1
				seq0_odd_arr[i] = frame.get('seq0_odd', -1) or -1
				seq1_even_arr[i] = frame.get('seq1_even', -1) or -1
				seq1_odd_arr[i] = frame.get('seq1_odd', -1) or -1
				buf_len = frame.get('base_buf_len', 0) or 0
				if buf_len > 0:
					d0e = frame.get('data0_even')
					d0o = frame.get('data0_odd')
					d1e = frame.get('data1_even')
					d1o = frame.get('data1_odd')
					p0 = frame.get('prod0')  # Корреляция ch0
					p1 = frame.get('prod1')  # Корреляция ch1
					if d0e is not None:
						data0_even_arr[i, :buf_len] = d0e[:buf_len].astype(np.uint16)
					if d0o is not None:
						data0_odd_arr[i, :buf_len] = d0o[:buf_len].astype(np.uint16)
					if d1e is not None:
						data1_even_arr[i, :buf_len] = d1e[:buf_len].astype(np.uint16)
					if d1o is not None:
						data1_odd_arr[i, :buf_len] = d1o[:buf_len].astype(np.uint16)
					if p0 is not None:
						prod0_arr[i, :buf_len] = p0[:buf_len].astype(np.float32)
					if p1 is not None:
						prod1_arr[i, :buf_len] = p1[:buf_len].astype(np.float32)
				det_thr0_arr[i] = frame.get('det_thr0', 0)
				det_thr1_arr[i] = frame.get('det_thr1', 0)
				det_lvl0_arr[i] = frame.get('det_lvl0', 0)
				det_lvl1_arr[i] = frame.get('det_lvl1', 0)
				det_shift0_arr[i] = frame.get('det_shift0', 0)
				det_shift1_arr[i] = frame.get('det_shift1', 0)
				det_amp0_arr[i] = frame.get('det_amp0', 0)
				det_amp1_arr[i] = frame.get('det_amp1', 0)
				det_hold0_arr[i] = frame.get('det_hold0', False)
				det_hold1_arr[i] = frame.get('det_hold1', False)
				det_frozen_arr[i] = frame.get('det_frozen', False)
			
			# Save to NPZ
			metadata = self._capture_session.get('metadata', {})
			# Peak sample = номер сэмпла где был максимум при срабатывании
			peak_sample = int(getattr(self, '_capture_peak_sample', 0))
			peak_shift = int(getattr(self, '_capture_peak_shift', 0))
			peak_value = float(getattr(self, '_capture_peak_value', 0.0))
			# Trigger sample = PRE phase length (триггер случился перед началом HOLD)
			trigger_sample = int(metadata.get('pre_frames', 0))
			# Trigger frame index (first frame after PRE)
			trigger_frame_index = int(getattr(self, '_capture_trigger_index', -1) or -1)
			# Label state: 0=unknown, 1=labeled, 2=no-label
			label_state = int(getattr(self, '_capture_label_state', 0))
			np.savez_compressed(
				filepath,
				# Frame data
				data0_even=data0_even_arr,
				data0_odd=data0_odd_arr,
				data1_even=data1_even_arr,
				data1_odd=data1_odd_arr,
				prod0=prod0_arr,  # Корреляция ch0
				prod1=prod1_arr,  # Корреляция ch1
				timestamps=timestamps_arr,
				seq0_even=seq0_even_arr,
				seq0_odd=seq0_odd_arr,
				seq1_even=seq1_even_arr,
				seq1_odd=seq1_odd_arr,
				# Detector state
				det_thr0=det_thr0_arr,
				det_thr1=det_thr1_arr,
				det_lvl0=det_lvl0_arr,
				det_lvl1=det_lvl1_arr,
				det_shift0=det_shift0_arr,
				det_shift1=det_shift1_arr,
				det_amp0=det_amp0_arr,
				det_amp1=det_amp1_arr,
				det_hold0=det_hold0_arr,
				det_hold1=det_hold1_arr,
				det_frozen=det_frozen_arr,
				# Metadata
				n_frames=np.array([n_frames]),
				trigger_sample=np.array([trigger_sample]),
				trigger_frame_index=np.array([trigger_frame_index]),
				peak_sample=np.array([peak_sample]),  # Номер сэмпла с пиком в prod массиве
				peak_shift=np.array([peak_shift]),  # Фазовый сдвиг при котором найден пик
				peak_value=np.array([peak_value]),  # Значение корреляции в точке пика
				label_state=np.array([label_state]),  # Метка: 0=неизвестно, 1=с меткой, 2=без метки
				buf_len=np.array([max_len]),
				trigger_time=np.array([self._capture_session.get('trigger_time', 0.0)]),
				reason=np.array([self._capture_session.get('reason', '')], dtype='U256'),
				profile=np.array([metadata.get('profile', 1)]),
				freq_hz=np.array([metadata.get('freq_hz', 200)]),
				avg_n=np.array([metadata.get('avg_n', 20)]),
				stream_mode=np.array([metadata.get('stream_mode', 0)]),
				det_source=np.array([metadata.get('det_source', 'norm')], dtype='U16'),
				det_ratio=np.array([metadata.get('det_ratio', 2.0)]),
			)
			
			print(f"[CAPTURE] Saved {n_frames} frames to {filepath}", flush=True)
			self._set_status(f"Capture saved: {filename} ({n_frames} frames)", hold_sec=3.0)
		except Exception as e:
			print(f"[CAPTURE] Error finalizing session: {e}", flush=True)
		finally:
			self._capture_state = 'idle'
			self._capture_session = None
			self._capture_frames_recorded = 0
			self._capture_post_countdown = 0

	def _rt_detection_active(self) -> bool:
		try:
			if not bool(getattr(self, 'realtime_prevbuf_detect', True)):
				return False
			if not bool(getattr(self, '_det_enabled', False)):
				return False
			if bool(getattr(self, '_rt_detection_mode_enabled', False)):
				return True
			if int(self._current_mode_idx()) >= 6:
				self._rt_detection_mode_enabled = True
				return True
			return False
		except Exception:
			return False

	def _rt_product_current_prev(self, current: np.ndarray, previous: np.ndarray):
		try:
			n = min(int(len(current)), int(len(previous)), int(getattr(self, 'max_samples', 0) or 0))
		except Exception:
			n = 0
		if n <= 1:
			return None
		try:
			max_shift = abs(int(getattr(self, '_rt_det_max_shift', 0) or 0))
		except Exception:
			max_shift = 0
		try:
			source = str(getattr(self, '_det_source', 'prod') or 'prod')
			level_scale = float(self._rt_detector_level_scale())
		except Exception:
			source, level_scale = 'prod', _rt_product_default_scale()
		made = _rt_detector_product_current_prev(current[:n], previous[:n], int(max_shift), source, float(level_scale))
		if made is None:
			return None
		level, shift, peak_idx, peak_value = made[:4]
		return int(level), int(shift), int(peak_idx), float(peak_value)

	def _rt_level_from_peak(self, peak_value: float) -> int:
		try:
			mx = float(peak_value)
		except Exception:
			mx = 0.0
		if not np.isfinite(mx) or mx <= 0.0:
			return 0
		try:
			source = str(getattr(self, '_det_source', 'prod') or 'prod').strip().lower()
		except Exception:
			source = 'prod'
		try:
			level_scale = float(self._rt_detector_level_scale())
		except Exception:
			level_scale = _rt_detector_legacy_level_scale()
		return _rt_detector_level_from_peak(mx, source, level_scale)

	def _rt_detector_process_start(self) -> bool:
		if not bool(getattr(self, '_rt_det_process_enabled', False)):
			return False
		if _mp is None:
			self._rt_det_process_enabled = False
			return False
		try:
			proc = getattr(self, '_rt_det_proc', None)
			if proc is not None and proc.is_alive():
				return True
		except Exception:
			pass
		try:
			max_samples = max(2, int(getattr(self, 'max_samples', 4096) or 4096))
			ctx = _mp.get_context('fork')
			self._rt_det_req_q = ctx.Queue(maxsize=4)
			self._rt_det_res_q = ctx.Queue(maxsize=16)
			self._rt_det_stop_event = ctx.Event()
			self._rt_det_shms = []
			names = []
			self._rt_det_proc = ctx.Process(
				target=_rt_detector_process_main,
			args=(names, max_samples, self._rt_det_req_q, self._rt_det_res_q, self._rt_det_stop_event),
			daemon=True,
			)
			self._rt_det_proc.start()
			try:
				self._rt_det_proc_started_t = time.time()
				self._rt_det_proc_first_submit_t = 0.0
			except Exception:
				pass
			print(f"[RT-DETECT] process started pid={self._rt_det_proc.pid}", flush=True)
			return True
		except Exception as e:
			print(f"[RT-DETECT] process start failed, fallback sync: {e}", flush=True)
			self._rt_detector_process_stop()
			self._rt_det_process_enabled = False
			return False
	
	def _rt_detector_process_stop(self):
		try:
			ev = getattr(self, '_rt_det_stop_event', None)
			if ev is not None:
				ev.set()
		except Exception:
			pass
		try:
			proc = getattr(self, '_rt_det_proc', None)
			if proc is not None and proc.is_alive():
				proc.join(timeout=0.5)
				if proc.is_alive():
					proc.terminate()
		except Exception:
			pass
		self._rt_det_proc = None
		for shm in list(getattr(self, '_rt_det_shms', []) or []):
			try:
				shm.close()
			except Exception:
				pass
			try:
				shm.unlink()
			except Exception:
				pass
		self._rt_det_shms = []
		self._rt_det_req_q = None
		self._rt_det_res_q = None
		self._rt_det_stop_event = None
		self._rt_det_proc_submit_count = 0
		self._rt_det_proc_result_count = 0
		self._rt_det_proc_last_submit_t = 0.0
		self._rt_det_proc_last_result_t = 0.0
		self._rt_det_proc_started_t = 0.0
		self._rt_det_proc_first_submit_t = 0.0
	
	def _rt_detector_level_scale(self) -> float:
		try:
			level_scale = float(getattr(self, '_det_level_scale', 0.0) or 0.0)
		except Exception:
			level_scale = 0.0
		if level_scale <= 0.0:
			try:
				level_scale = float(os.getenv('BMI30_DETECT_LEVEL_SCALE', '') or 0.0)
			except Exception:
				level_scale = 0.0
		if level_scale <= 0.0:
			try:
				level_scale = float(os.getenv('BMI30_PROD_SCALE', '') or _rt_product_default_scale())
			except Exception:
				level_scale = _rt_product_default_scale()
		if not np.isfinite(level_scale) or level_scale <= 0.0:
			level_scale = _rt_product_default_scale()
		try:
			self._det_last_level_scale = float(level_scale)
		except Exception:
			pass
		return float(level_scale)

	def _rt_detector_step_to_level_units(self, value) -> int:
		try:
			scale = float(self._rt_detector_level_scale())
		except Exception:
			scale = _rt_detector_legacy_level_scale()
		return _rt_legacy_level_to_product_units(value, scale, minimum=1)

	def _det_channel_ratio(self, channel: int) -> float:
		ch = 0 if int(channel) == 0 else 1
		try:
			auto = bool(getattr(self, '_det_threshold_auto0' if ch == 0 else '_det_threshold_auto1', False))
		except Exception:
			auto = False
		if auto:
			try:
				return self._det_auto_slope_value()
			except Exception:
				return 5.0
		try:
			avg = getattr(self, '_det_noise_avg0' if ch == 0 else '_det_noise_avg1', 0.0)
			return self._det_manual_curve_ratio(ch, float(avg))
		except Exception:
			return 2.0

	def _det_channel_auto_enabled(self, channel: int) -> bool:
		ch = 0 if int(channel) == 0 else 1
		try:
			return bool(getattr(self, '_det_threshold_auto0' if ch == 0 else '_det_threshold_auto1', False))
		except Exception:
			return False

	def _det_ratio_noise_max_u16_value(self) -> float:
		try:
			val = float(getattr(self, '_det_ratio_noise_max_u16', 10.0))
		except Exception:
			val = 10.0
		try:
			if not np.isfinite(val):
				val = 10.0
		except Exception:
			val = 10.0
		return float(max(0.1, min(65535.0, val)))

	def _det_noise_display_units(self, noise_avg: float) -> float:
		try:
			scale = float(getattr(self, '_det_last_level_scale', 0.0) or 0.0)
		except Exception:
			scale = 0.0
		if scale <= 0.0:
			try:
				scale = float(self._rt_detector_level_scale())
			except Exception:
				scale = _rt_detector_legacy_level_scale()
		try:
			noise = float(noise_avg)
			return max(0.0, noise / max(1.0, float(scale)))
		except Exception:
			return 0.0

	def _det_manual_curve_ratio(self, channel: int, noise_avg: float) -> float:
		ch = 0 if int(channel) == 0 else 1
		try:
			low = _det_clamp_ratio(getattr(self, '_det_ratio0' if ch == 0 else '_det_ratio1', 2.0), 2.0)
		except Exception:
			low = 2.0
		try:
			high = _det_clamp_ratio(getattr(self, '_det_ratio_high0' if ch == 0 else '_det_ratio_high1', 5.0), 5.0)
		except Exception:
			high = 5.0
		try:
			t = self._det_noise_display_units(float(noise_avg)) / self._det_ratio_noise_max_u16_value()
			t = max(0.0, min(1.0, float(t)))
		except Exception:
			t = 0.0
		return float(low + (high - low) * t)

	def _det_auto_floor_u16_value(self) -> float:
		try:
			val = float(getattr(self, '_det_auto_floor_u16', 10.0))
		except Exception:
			val = 10.0
		try:
			if not np.isfinite(val):
				val = 10.0
		except Exception:
			val = 10.0
		return float(max(0.0, min(65535.0, val)))

	def _det_auto_slope_value(self) -> float:
		try:
			val = float(getattr(self, '_det_auto_slope', 5.0))
		except Exception:
			val = 5.0
		try:
			if not np.isfinite(val):
				val = 5.0
		except Exception:
			val = 5.0
		return float(max(0.1, min(100.0, val)))

	def _det_channel_effective_ratio(self, channel: int) -> float:
		ch = 0 if int(channel) == 0 else 1
		try:
			noise_avg = float(getattr(self, '_det_noise_avg0' if ch == 0 else '_det_noise_avg1', 0.0) or 0.0)
		except Exception:
			noise_avg = 0.0
		if self._det_channel_auto_enabled(ch):
			try:
				trigger = float(self._det_channel_trigger_level(ch, noise_avg, self._det_auto_slope_value()))
				if noise_avg > 0.0:
					return float(trigger / max(1.0, noise_avg))
			except Exception:
				pass
			return self._det_auto_slope_value()
		return self._det_manual_curve_ratio(ch, noise_avg)

	def _det_channel_trigger_level(self, channel: int, noise_avg: float, ratio: float, lvl: int = 0) -> int:
		ch = 0 if int(channel) == 0 else 1
		try:
			noise = float(noise_avg)
		except Exception:
			noise = 0.0
		if not np.isfinite(noise) or noise < 0.0:
			noise = 0.0
		if self._det_channel_auto_enabled(ch):
			try:
				floor_level = _rt_legacy_level_to_product_units(self._det_auto_floor_u16_value(), self._rt_detector_level_scale(), minimum=1)
				level = float(np.hypot(float(floor_level), float(noise) * self._det_auto_slope_value()))
				return _rt_clamp_detector_level(level, default=int(floor_level), minimum=1)
			except Exception:
				pass
		try:
			use_ratio = self._det_manual_curve_ratio(ch, noise)
		except Exception:
			use_ratio = float(ratio)
		return _rt_clamp_detector_level(max(1.0, float(noise) * float(use_ratio)), default=1, minimum=1)

	def _det_channel_confirm_count(self, channel: int) -> int:
		ch = 0 if int(channel) == 0 else 1
		try:
			return _det_clamp_confirm(getattr(self, '_rt_det_confirm_count0' if ch == 0 else '_rt_det_confirm_count1', 2), 2)
		except Exception:
			return 2

	def _det_noise_window_seconds(self) -> float:
		try:
			return _det_clamp_noise_window(getattr(self, '_det_noise_window_s', 1.0), 1.0)
		except Exception:
			return 1.0

	def _det_accumulated_reference_noise(self, channel: int, ref_noise: float, now: float | None = None) -> float:
		ch = 0 if int(channel) == 0 else 1
		try:
			t = float(time.time() if now is None else now)
		except Exception:
			t = time.time()
		hist_key = '_det_noise_hist0' if ch == 0 else '_det_noise_hist1'
		avg_key = '_det_noise_avg0' if ch == 0 else '_det_noise_avg1'
		try:
			hist = getattr(self, hist_key, None)
			if hist is None:
				hist = deque()
				setattr(self, hist_key, hist)
		except Exception:
			hist = deque()
			try:
				setattr(self, hist_key, hist)
			except Exception:
				pass
		try:
			val = float(ref_noise)
		except Exception:
			val = 0.0
		if not np.isfinite(val) or val < 0.0:
			val = 0.0
		try:
			hist.append((t, float(val)))
			window_s = self._det_noise_window_seconds()
			cutoff = t - float(window_s)
			while hist and float(hist[0][0]) < cutoff:
				hist.popleft()
			values = [float(x[1]) for x in hist if np.isfinite(float(x[1])) and float(x[1]) >= 0.0]
			if values:
				avg = float(sum(values) / float(len(values)))
			else:
				avg = float(getattr(self, avg_key, 0.0) or 0.0)
		except Exception:
			avg = float(val)
		if not np.isfinite(avg) or avg < 0.0:
			avg = 0.0
		try:
			setattr(self, avg_key, float(avg))
		except Exception:
			pass
		return float(avg)

	def _det_reset_noise_accumulators(self):
		for key in ('_det_noise_hist0', '_det_noise_hist1'):
			try:
				hist = getattr(self, key, None)
				if hist is not None:
					hist.clear()
			except Exception:
				try:
					setattr(self, key, deque())
				except Exception:
					pass
		for key in ('_det_noise_ref0', '_det_noise_ref1', '_det_noise_avg0', '_det_noise_avg1'):
			try:
				setattr(self, key, 0.0)
			except Exception:
				pass
		for key in ('_det_trigger0', '_det_trigger1'):
			try:
				setattr(self, key, 0)
			except Exception:
				pass

