			else:
				self.btn_power.setStyleSheet("")
				self.btn_power.setToolTip("Сбросить порог; в режиме 5 держать DC-подстройку до центра 32767")
		except Exception:
			pass

	def _start_dc_autotune(self, reason: str = "", return_to_mode: int | None = None, announce: bool = True) -> bool:
		"""Запустить автоцентрирование DC в режиме 5; опционально вернуться в режим после успеха."""
		try:
			if int(self.num_group.checkedId()) != 5:
				return False
		except Exception:
			return False
		try:
			fast_sec = float(os.getenv('BMI30_DETECT_FAST_SEC', '3.0'))
			if (not np.isfinite(fast_sec)) or fast_sec <= 0.0:
				fast_sec = 3.0
		except Exception:
			fast_sec = 3.0
		try:
			fast_frames = int(os.getenv('BMI30_DC_FAST_FRAMES', '100'))
		except Exception:
			fast_frames = 100
		if fast_frames < 0:
			fast_frames = 0
		try:
			self._det_fast_adapt_until = float(time.time() + fast_sec)
		except Exception:
			pass
		try:
			if return_to_mode is None:
				self._dc_autotune_return_mode = None
				self._dc_autotune_return_reason = ""
			else:
				self._dc_autotune_return_mode = int(return_to_mode)
				self._dc_autotune_return_reason = str(reason or "")
		except Exception:
			self._dc_autotune_return_mode = None
			self._dc_autotune_return_reason = ""
		try:
			self._det_thr0 = int(getattr(self, '_det_thr_init', 0) or 0)
			self._det_thr1 = int(getattr(self, '_det_thr_init', 0) or 0)
			self._det_reset_noise_accumulators()
			self._det_exceed0 = 0
			self._det_exceed1 = 0
			self._det_hold0 = False
			self._det_hold1 = False
			self._dc_autotune_active = True
			self._dc_autotune_started_t = time.time()
			self._dc_autotune_last_cmd_t = 0.0
			self._dc_autotune_last_status_t = 0.0
			self._dc_autotune_attempts = 0
			self._dc_autotune_fast_frames = int(fast_frames)
			try:
				self._device_set_dc_adapt(True)
			except Exception:
				pass
			self._update_dc_autotune_btn_style()
			self._run_dc_autotune_kick()
			if announce:
				txt = f"DC автоцентрирование до 32767 запущено | пороги ускорены ~{fast_sec:.1f}с"
				if fast_frames > 0:
					txt += f" | fast {int(fast_frames)}f"
				if return_to_mode is not None:
					txt += f" | затем режим {int(return_to_mode)}"
				self._set_status(txt, hold_sec=2.0)
			return True
		except Exception as e:
			try:
				print(f"[DC-AUTOTUNE] start failed: {e}", flush=True)
			except Exception:
				pass
			return False

	def _return_to_mode_after_dc_autotune(self, mode_idx: int, reason: str = ""):
		try:
			mode_idx = int(mode_idx)
		except Exception:
			mode_idx = 6
		if mode_idx not in (1, 2, 3, 4, 5, 6, 7):
			mode_idx = 6
		try:
			if int(self.num_group.checkedId()) != 5:
				return
		except Exception:
			return
		try:
			if int(getattr(self, '_auto_reset_restore_idx', 0) or 0) == mode_idx:
				self._auto_reset_just_occurred = False
				self._auto_reset_restore_idx = None
		except Exception:
			pass
		try:
			btn = self.num_group.button(mode_idx)
			if btn is not None:
				btn.setChecked(True)
			self._num_clicked(mode_idx)
			try:
				self._on_num_clicked_extra(mode_idx)
			except Exception:
				pass
			if mode_idx >= 6:
				try:
					# Match the manual button-6 path: keep the restored/saved thresholds,
					# only re-arm and speed up adaptation after fault recovery.
					self._schedule_detector_noise_adaptation(f"dc_autotune_return:{reason}", mode_guard=mode_idx, reset_thr=False)
				except Exception:
					pass
			msg = f"DC автоцентр завершён — возврат в режим {mode_idx}"
			if mode_idx >= 6:
				msg += ", стабилизация перед адаптацией шумов"
			if reason:
				msg += f" ({reason})"
			self._set_status(msg, hold_sec=2.5)
			print(f"[DC-AUTOTUNE] returned to mode {mode_idx} reason={reason}", flush=True)
		except Exception as e:
			try:
				print(f"[DC-AUTOTUNE] return to mode {mode_idx} failed: {e}", flush=True)
			except Exception:
				pass

	def _stop_dc_autotune(self, success: bool = False, reason: str = "", metrics: dict | None = None, announce: bool = True):
		"""Остановить режим автоцентрирования DC."""
		was_active = bool(getattr(self, '_dc_autotune_active', False))
		try:
			return_mode = getattr(self, '_dc_autotune_return_mode', None)
			return_reason = str(getattr(self, '_dc_autotune_return_reason', '') or reason or "")
		except Exception:
			return_mode = None
			return_reason = str(reason or "")
		self._dc_autotune_active = False
		self._dc_autotune_started_t = 0.0
		self._dc_autotune_last_cmd_t = 0.0
		self._dc_autotune_last_status_t = 0.0
		self._dc_autotune_attempts = 0
		self._dc_autotune_fast_frames = 0
		self._dc_autotune_return_mode = None
		self._dc_autotune_return_reason = ""
		self._update_dc_autotune_btn_style()
		if not was_active or not announce:
			return
		try:
			if success:
				max_off = float((metrics or {}).get('max_mean_off', 0.0) or 0.0)
				self._set_status(f"DC автоцентр завершён: max off={max_off:.0f}", hold_sec=2.5)
			elif reason:
				self._set_status(f"DC автоцентр остановлен: {reason}", hold_sec=2.0)
		except Exception:
			pass
		try:
			if success and return_mode is not None:
				self._return_to_mode_after_dc_autotune(int(return_mode), return_reason)
		except Exception:
			pass

	def _collect_dc_autotune_metrics(self) -> dict:
		"""Собрать метрики центрирования для всех активных буферов вокруг 32767."""
		try:
			center = float(os.getenv('BMI30_DC_AUTOTUNE_CENTER', '32767'))
		except Exception:
			center = 32767.0
		try:
			center_tol = float(os.getenv('BMI30_DC_AUTOTUNE_MEAN_TOL', '256'))
		except Exception:
			center_tol = 256.0
		try:
			min_side_frac = float(os.getenv('BMI30_DC_AUTOTUNE_SIDE_FRAC', '0.12'))
		except Exception:
			min_side_frac = 0.12
		try:
			min_span = float(os.getenv('BMI30_DC_AUTOTUNE_MIN_SPAN', '48'))
		except Exception:
			min_span = 48.0
		try:
			adc1_en, adc2_en = self._adc_enable_flags()
		except Exception:
			adc1_en, adc2_en = True, True
			with self.data_lock:
				n = int(self.base_buf_len or 0)
				if n <= 0:
					return {'ready': False, 'reason': 'ожидание буфера'}
				series = []
			if adc1_en:
				series.append(("ADC1 even", np.asarray(self.data0_even[:n], dtype=np.float64).copy()))
				series.append(("ADC1 odd", np.asarray(self.data0_odd[:n], dtype=np.float64).copy()))
			if adc2_en:
				series.append(("ADC2 even", np.asarray(self.data1_even[:n], dtype=np.float64).copy()))
				series.append(("ADC2 odd", np.asarray(self.data1_odd[:n], dtype=np.float64).copy()))
		if not series:
			return {'ready': False, 'reason': 'нет активных каналов'}
			rows = []
			centered_all = True
			max_mean_off = 0.0
			worst_name = ''
			worst_side_frac = 1.0
			for name, arr in series:
				if arr.size == 0:
					return {'ready': False, 'reason': 'ожидание данных'}
				try:
					finite = arr[np.isfinite(arr)]
				except Exception:
					finite = arr
				if finite.size == 0:
					return {'ready': False, 'reason': 'ожидание данных'}
				mean_val = float(np.mean(finite))
				mean_off = abs(mean_val - center)
				below_frac = float(np.count_nonzero(finite < center)) / float(finite.size)
				above_frac = float(np.count_nonzero(finite > center)) / float(finite.size)
				side_frac = min(below_frac, above_frac)
				span = float(np.max(finite) - np.min(finite))
				# Если сигнал почти плоский, достаточно попасть средним в центр.
				if span <= min_span:
					centered = (mean_off <= center_tol)
				else:
					centered = (mean_off <= center_tol) and (side_frac >= min_side_frac)
				rows.append({
					'name': name,
					'centered': bool(centered),
					'mean_off': float(mean_off),
					'side_frac': float(side_frac),
					'span': float(span),
				})
				if mean_off >= max_mean_off:
						max_mean_off = float(mean_off)
						worst_name = str(name)
						worst_side_frac = float(side_frac)
				if not centered:
					centered_all = False
		ok_count = sum(1 for row in rows if row.get('centered'))
		return {
			'ready': True,
			'centered': bool(centered_all),
			'rows': rows,
			'ok_count': int(ok_count),
			'total': int(len(rows)),
			'max_mean_off': float(max_mean_off),
			'worst_name': str(worst_name),
			'worst_side_frac': float(worst_side_frac),
			'center': float(center),
			'center_tol': float(center_tol),
		}

	def _run_dc_autotune_kick(self, metrics: dict | None = None):
		"""Отправить очередной импульс быстрой DC-калибровки."""
		if self.stream is None:
			return
		now = time.time()
		try:
			self._device_set_dc_adapt(True)
		except Exception:
			pass
		try:
			fast_frames = int(getattr(self, '_dc_autotune_fast_frames', 0) or 0)
		except Exception:
			fast_frames = 0
		if fast_frames > 0:
			try:
				self._device_calib_dc_fast(fast_frames)
			except Exception:
				pass
		try:
			self._det_fast_adapt_until = max(float(getattr(self, '_det_fast_adapt_until', 0.0) or 0.0), now + 1.0)
			self._det_warmup_until = max(float(getattr(self, '_det_warmup_until', 0.0) or 0.0), now + 1.0)
		except Exception:
			pass
		self._dc_autotune_last_cmd_t = now
		self._dc_autotune_last_status_t = now
		self._dc_autotune_attempts = int(getattr(self, '_dc_autotune_attempts', 0)) + 1
		try:
			if metrics and bool(metrics.get('ready', False)):
				ok_count = int(metrics.get('ok_count', 0) or 0)
				total = int(metrics.get('total', 0) or 0)
				max_off = float(metrics.get('max_mean_off', 0.0) or 0.0)
				worst_name = str(metrics.get('worst_name', '') or '')
				side = 100.0 * float(metrics.get('worst_side_frac', 0.0) or 0.0)
				txt = f"DC автоцентр: {ok_count}/{total} OK | {worst_name} off={max_off:.0f} side={side:.0f}% | kick {self._dc_autotune_attempts}"
			else:
				txt = f"DC автоцентр: ожидание данных | kick {self._dc_autotune_attempts}"
			self._set_status(txt, hold_sec=1.5)
		except Exception:
			pass

	def _tick_dc_autotune(self):
		"""Поддерживать ускоренную DC-подстройку, пока буферы не отцентрованы."""
		if not bool(getattr(self, '_dc_autotune_active', False)):
			return
		now = time.time()
		try:
			max_s = float(os.getenv('BMI30_DC_AUTOTUNE_MAX_S', '20.0'))
			if (not np.isfinite(max_s)) or max_s <= 0.0:
				max_s = 20.0
		except Exception:
			max_s = 20.0
		try:
			started_t = float(getattr(self, '_dc_autotune_started_t', 0.0) or 0.0)
		except Exception:
			started_t = 0.0
		if started_t > 0.0 and (now - started_t) >= max_s:
			self._stop_dc_autotune(reason=f'таймаут {max_s:.0f}с', announce=True)
			return
		try:
			if int(self.num_group.checkedId()) != 5:
				self._stop_dc_autotune(reason='выход из режима 5', announce=False)
				return
		except Exception:
			pass
		self._update_dc_autotune_btn_style()
		if self.stream is None:
			if started_t > 0.0 and (now - started_t) >= min(5.0, max_s):
				self._stop_dc_autotune(reason='нет потока', announce=False)
			return
		try:
			if int(getattr(self, 'stream_mode', -1)) != 2:
				return
		except Exception:
			return
		try:
			retry_s = float(os.getenv('BMI30_DC_AUTOTUNE_RETRY_S', '1.5'))
			if (not np.isfinite(retry_s)) or retry_s <= 0.0:
				retry_s = 1.5
		except Exception:
			retry_s = 1.5
		try:
			self._det_fast_adapt_until = max(float(getattr(self, '_det_fast_adapt_until', 0.0) or 0.0), now + 1.0)
			self._det_warmup_until = max(float(getattr(self, '_det_warmup_until', 0.0) or 0.0), now + 1.0)
		except Exception:
			pass
		metrics = self._collect_dc_autotune_metrics()
		if not bool(metrics.get('ready', False)):
			if (now - float(getattr(self, '_dc_autotune_last_cmd_t', 0.0) or 0.0)) >= retry_s:
				self._run_dc_autotune_kick(metrics)
			return
		if bool(metrics.get('centered', False)):
			try:
				self._det_fast_adapt_until = max(float(getattr(self, '_det_fast_adapt_until', 0.0) or 0.0), now + 0.5)
			except Exception:
				pass
			self._stop_dc_autotune(success=True, metrics=metrics, announce=True)
			return
		last_cmd_t = float(getattr(self, '_dc_autotune_last_cmd_t', 0.0) or 0.0)
		if (now - last_cmd_t) >= retry_s:
			self._run_dc_autotune_kick(metrics)
		else:
			last_status_t = float(getattr(self, '_dc_autotune_last_status_t', 0.0) or 0.0)
			if (now - last_status_t) >= 0.8:
				try:
					ok_count = int(metrics.get('ok_count', 0) or 0)
					total = int(metrics.get('total', 0) or 0)
					max_off = float(metrics.get('max_mean_off', 0.0) or 0.0)
					worst_name = str(metrics.get('worst_name', '') or '')
					side = 100.0 * float(metrics.get('worst_side_frac', 0.0) or 0.0)
					self._set_status(f"DC автоцентр: {ok_count}/{total} OK | {worst_name} off={max_off:.0f} side={side:.0f}%", hold_sec=1.0)
				except Exception:
					pass
				self._dc_autotune_last_status_t = now

	def _reset_det_adapt(self):
		"""Сбросить пороги детектора; режим 5 управляется host DC Start."""
		try:
			fast_sec = float(os.getenv('BMI30_DETECT_FAST_SEC', '3.0'))
			if (not np.isfinite(fast_sec)) or fast_sec <= 0.0:
				fast_sec = 3.0
		except Exception:
			fast_sec = 3.0
		try:
			fast_frames = int(os.getenv('BMI30_DC_FAST_FRAMES', '100'))
		except Exception:
			fast_frames = 100
		if fast_frames < 0:
			fast_frames = 0
		try:
			self._det_fast_adapt_until = float(time.time() + fast_sec)
		except Exception:
			pass
		try:
			mode5_selected = int(self.num_group.checkedId()) == 5
		except Exception:
			mode5_selected = False
		if mode5_selected and _env_bool("BMI30_MODE5_LEGACY_DC_AUTOTUNE", False):
			try:
				self._start_dc_autotune(reason='manual_reset_det_adapt', return_to_mode=None, announce=True)
			except Exception:
				pass
			return
		try:
			self._det_thr0 = int(getattr(self, '_det_thr_init', 0) or 0)
			self._det_thr1 = int(getattr(self, '_det_thr_init', 0) or 0)
			self._det_reset_noise_accumulators()
			self._det_exceed0 = 0
			self._det_exceed1 = 0
			self._det_hold0 = False
			self._det_hold1 = False
			try:
				self._stop_dc_autotune(announce=False)
			except Exception:
				pass
			self._set_status(f"Сброс порога: быстрая адаптация ~{fast_sec:.1f}с", hold_sec=2.0)
		except Exception:
			pass

	def _manual_reconnect(self):
		# Полный restart: teardown потока/reader + аппаратный reset STM32 + новое подключение.
		try:
			self._set_status("Ручное переподключение: аппаратный рестарт STM32…", hold_sec=2.0)
		except Exception:
			pass
		try:
			self._restart_stream(hardware_reset=True, reason='manual_reconnect')
		except Exception as e:
			try:
				self._set_status(f"Ошибка переподключения: {e}", hold_sec=2.5)
			except Exception:
				pass

	def _reset_stream_runtime_state(self, reason: str = ''):
		"""Сбросить runtime-состояние потока перед reconnect/restart."""
		try:
			self._stop_dc_autotune(reason='перезапуск потока', announce=False)
		except Exception:
			pass
		try:
			if self.usb_retry_timer.isActive():
				self.usb_retry_timer.stop()
		except Exception:
			pass
		old_thread = getattr(self, 'reader_thread', None)
		old_stream = getattr(self, 'stream', None)
		try:
			self.reader_running = False
		except Exception:
			pass
		try:
			self._connecting = False
		except Exception:
			pass
		# Сначала мягко останавливаем поток на устройстве, затем закрываем транспорт.
		try:
			if old_stream is not None:
				try:
					self._send_stop_stream()
					time.sleep(0.05)
				except Exception:
					pass
				try:
					setattr(old_stream, 'disconnected', True)
				except Exception:
					pass
				try:
					old_stream.close()
				except Exception:
					pass
		except Exception:
			pass
		try:
			if old_thread is not None and old_thread.is_alive() and threading.current_thread() is not old_thread:
				old_thread.join(timeout=0.6)
		except Exception:
			pass
		self.reader_thread = None
		self.stream = None
		self._stream_user_stopped = False
		self.base_buf_len = None
		self.base_buf_len_bytes = None
		self.freq_hz = None
		self._sample_len_mode_pending = None
		self._sample_len_mode_sync_armed = True
		self.data0 = np.zeros(self.max_samples, dtype=np.int32)
		self.data1 = np.zeros(self.max_samples, dtype=np.int32)
		self.data0_even = self.data0
		self.data1_even = self.data1
		self.data0_odd = np.zeros(self.max_samples, dtype=np.int32)
		self.data1_odd = np.zeros(self.max_samples, dtype=np.int32)
		self.timestamps = np.zeros(self.max_samples, dtype=np.float64)
		self.seq0_even = None
		self.seq0_odd = None
		self.seq1_even = None
		self.seq1_odd = None
		self._last_sample_ts = None
		self.last_frame_t = 0
		self.no_data_warned = False
		self.view_start = 0
		self.view_len = 0
		self.tim2_pending = False
		self.tim2_applied = False
		self._tim2_request_seq = int(getattr(self, '_tim2_request_seq', 0)) + 1
		try:
			while True:
				self._tim2_result_queue.get_nowait()
		except queue.Empty:
			pass
		try:
			self._usb_err_need_hw_reset = False
		except Exception:
			pass
		try:
			self._usb_connect_err_count = 0
		except Exception:
			pass
		try:
			self._reset_phase_splitter(f"restart:{reason or 'manual'}")
		except Exception:
			pass
		self._reset_sliders()
		self._update_tim2_btn_style()

	def _restart_stream(self, hardware_reset: bool = False, reason: str = ''):
		"""Полный restart потока с optional аппаратным reset STM32."""
		self._reset_stream_runtime_state(reason=reason)
		if self.num_group.checkedId() == 0:
			try:
				self._set_status("Поток остановлен", hold_sec=1.5)
			except Exception:
				pass
			return
		if hardware_reset:
			try:
				self._hardware_reset_device()
			except Exception:
				pass
		try:
			self._set_status("Перезапуск потока…", hold_sec=1.5)
		except Exception:
			pass
		self._activate_stream()

	def _toggle_capture(self):
		"""Переключение автозахвата осциллограмм."""
		self._auto_capture_enabled = self.btn_capture.isChecked()
		print(f"\n{'='*60}\n[CAPTURE] Toggle: auto_capture_enabled={self._auto_capture_enabled}\n{'='*60}\n", flush=True)
		# Создать папку captures при включении
		if self._auto_capture_enabled:
			try:
				os.makedirs(self._capture_dir, exist_ok=True)
			except Exception as e:
				print(f"[CAPTURE] Ошибка создания папки {self._capture_dir}: {e}", flush=True)
				self._auto_capture_enabled = False
				self.btn_capture.setChecked(False)
		self._update_capture_btn_style()
		status = "включён" if self._auto_capture_enabled else "выключен"
		self._set_status(f"Автозахват {status}", hold_sec=2.0)
	
	def _update_capture_btn_style(self):
		"""Обновление цвета кнопки capture: зелёная=включено, красная=выключено."""
		try:
			if self._auto_capture_enabled:
				self.btn_capture.setStyleSheet("background-color: #00cc00; color: white;")
			else:
				self.btn_capture.setStyleSheet("background-color: #cc0000; color: white;")
		except Exception:
			pass
	
	def _cycle_label_state(self):
		"""Переключение состояния метки: 0→1→2→0 (неизвестно→с меткой→без метки→неизвестно)."""
		self._capture_label_state = (self._capture_label_state + 1) % 3
		self._update_label_btn_style()
		labels = ["неизвестно", "с меткой", "без метки"]
		self._set_status(f"Метка: {labels[self._capture_label_state]}", hold_sec=1.5)
	
	def _update_label_btn_style(self):
		"""Обновление текста и цвета кнопки label."""
		try:
			if self._capture_label_state == 0:
				# Неизвестно
				self.btn_label.setText("?")
				self.btn_label.setStyleSheet("background-color: #888888; color: white;")
			elif self._capture_label_state == 1:
				# С меткой
				self.btn_label.setText("✓")
				self.btn_label.setStyleSheet("background-color: #0080ff; color: white;")
			else:
				# Без метки
				self.btn_label.setText("✗")
				self.btn_label.setStyleSheet("background-color: #ff8000; color: white;")
		except Exception:
			pass

	def _enqueue_mode_action(self, action: str, *args, **kwargs):
		"""Place a mode-switch action to background worker (non-blocking)."""
		if getattr(self, '_mode_worker', None) is None:
			# no worker: run synchronously as fallback
			try:
				if action == 'latest':
					self._switch_to_latest_mode()
				elif action == 'lossless':
					self._switch_to_lossless_roi(*args, **kwargs)
				elif action == 'avg':
					self._switch_to_avg_roi(*args, **kwargs)
			except Exception:
				pass
			return
		# enqueue for background execution
		try:
			self._mode_worker.enqueue(action, *args, **kwargs)
		except Exception:
			pass

	def _on_mode_action_done(self, action: str, *args, **kwargs):
		"""Called in GUI thread when worker finished an action; update buffers/UI."""
		try:
			if action == 'latest':
				with self.data_lock:
					self._reset_phase_splitter('switch_to_latest')
					self.base_buf_len = None
					self.base_buf_len_bytes = None
					self.freq_hz = None
					self._sliders_initialized = False
				self.stream_mode = 0
				self.desired_stream_mode = 0
				self.desired_expected_samples = 600
				self.desired_stream_payload = b"\x00"
				# restore GUI FPS
				try:
					gui_fps = int(os.getenv("BMI30_GUI_FPS", "16"))
				except Exception:
					gui_fps = 16
				self.qtimer.setInterval(max(10, int(1000 / gui_fps)))
				self._set_status("LATEST activated", hold_sec=2.0)
			elif action == 'lossless':
				with self.data_lock:
					self._reset_phase_splitter('switch_to_lossless')
					self.base_buf_len = None
					self.base_buf_len_bytes = None
					self.freq_hz = None
					self._sliders_initialized = False
				self.stream_mode = 1
				self.desired_stream_mode = 1
				self.desired_expected_samples = 200
				self.desired_stream_payload = b"\x01"
				self.qtimer.setInterval(200)
				self._set_status("LOSSLESS_ROI activated", hold_sec=2.0)
			elif action == 'avg':
				avg_n = int(args[0]) if args else int(kwargs.get('avg_n', getattr(self,'avg_n',20)))
				with self.data_lock:
					self._reset_phase_splitter(f'switch_to_avg_roi avg_n={avg_n}')
					self.base_buf_len = None
					self.base_buf_len_bytes = None
					self.freq_hz = None
					self._sliders_initialized = False
				self.stream_mode = 2
				self.desired_stream_mode = 2
				self.desired_expected_samples = 200
				self.desired_stream_payload = bytes([0x02, avg_n & 0xFF])
				self.qtimer.setInterval(200)
				self._set_status(f"AVG_ROI activated (avg_n={avg_n})", hold_sec=2.0)
			# refresh view immediately
			try:
				self._update_view()
			except Exception:
				pass
		except Exception as e:
			print(f"[ModeCallback] error on done({action}): {e}")

	def _reset_sliders(self):
		"""Вернуть слайдеры в исходное состояние и разрешить повторную инициализацию."""
		try:
			self.slider_start.blockSignals(True)
			self.slider_len.blockSignals(True)
		except Exception:
			pass
		self.slider_start.setEnabled(False)
		self.slider_len.setEnabled(False)
		self.slider_start.setMaximum(0)
		self.slider_len.setMaximum(0)
		self.slider_start.setValue(0)
		self.slider_len.setValue(0)
		self.lbl_start_value.setText("0")
		self.lbl_len_value.setText("0")
		self._sliders_initialized = False
		# forget last buffer length so init will run on next valid buf_len
		self._last_buf_len = None
		try:
			self.slider_start.blockSignals(False)
			self.slider_len.blockSignals(False)
		except Exception:
			pass

	def _init_sliders(self, buf_len: int):
		"""Настроить слайдеры под актуальную длину буфера."""
		if buf_len <= 0:
			return
		try:
			self.slider_start.blockSignals(True)
			self.slider_len.blockSignals(True)
		except Exception:
			pass
		self.view_start = 0
		self.view_len = buf_len
		self.slider_start.setEnabled(True)
		self.slider_len.setEnabled(True)
		self.slider_len.setMinimum(1)
		self.slider_len.setMaximum(buf_len)
		self.slider_len.setValue(buf_len)
		self.slider_start.setMaximum(max(0, buf_len - self.view_len))
		self.slider_start.setValue(0)
		self.lbl_start_value.setText(str(self.view_start))
		self.lbl_len_value.setText(str(self.view_len))
		self._sliders_initialized = True
		try:
			self.slider_start.blockSignals(False)
			self.slider_len.blockSignals(False)
		except Exception:
			pass
		try:
			self.slider_start.blockSignals(False)
			self.slider_len.blockSignals(False)
		except Exception:
			pass

	def _soft_kick_stream(self):
		"""Мягко переинициализировать параметры и запустить START без STOP, чтобы не ронять интерфейс."""
		if self.stream is None:
			raise RuntimeError("нет активного потока")
		if bool(getattr(self, '_stream_user_stopped', False)):
			return
		# Повторим текущие параметры и отправим START. Reset здесь не делаем:
		# по новому контракту прошивки сброс допустим только после fault-probe verdict
		# stm32_tx_stalled/stm32_adc_stalled или вручную.
		try:
			# профиль
			self.stream.send_cmd(CMD_SET_PROFILE, bytes([self.desired_profile]))
			try:
				import time as _t
				_t.sleep(0.02)
			except Exception:
				pass
			# размер кадра (SET_FRAME_SAMPLES) — ТОЛЬКО для профиля 2 и только если явно включено
			if getattr(self, 'send_ns', False) and int(getattr(self, 'desired_profile', 2) or 2) == 2:
				try:
					from usb_vendor.usb_stream import CMD_SET_FRAME_SAMPLES  # type: ignore
				except Exception:
					CMD_SET_FRAME_SAMPLES = 0x17
				ns = self.ns_map.get(self.desired_profile, self.initial_expected)
				try:
					self.stream.send_cmd(CMD_SET_FRAME_SAMPLES, int(ns).to_bytes(2,'little'))
					import time as _t
					_t.sleep(0.02)
				except Exception:
					pass
			# Устанавливаем выбранную частоту
			try:
				freq_to_set = getattr(self, 'desired_freq', 200)
				if hasattr(self.stream, 'set_block_rate'):
					self.stream.set_block_rate(freq_to_set)
					try:
						import time as _t
						_t.sleep(0.1)
					except Exception:
						pass
				else:
					# Fallback: отправляем команду напрямую
					import struct
					self.stream.send_cmd(0x11, struct.pack('<H', freq_to_set))
					try:
						import time as _t
						_t.sleep(0.1)
					except Exception:
						pass
			except Exception as e:
				try:
					print(f'[start] Failed to set frequency: {e}')
				except:
					pass
			# старт
			self._send_start_stream()
		except Exception as e:
			raise

	def _diagnose_and_kick(self):
		"""Проверить EP0, выполнить DEEP_RESET, установить alt=1, проверить готовность и запустить поток.

		Алгоритм восстановления без перезапитки.
		"""
		if self.stream is None:
			self._set_status("Нет активного потока. Нажмите 1 для подключения.", hold_sec=2.0)
			return
		# Шаг 1: Проверить EP0
		try:
			# Получим STAT через EP0 (recipient: interface)
			if hasattr(self.stream, '_get_status_ep0'):
				self.stream._get_status_ep0()
			self._set_status("EP0 проверен, STAT получен…", hold_sec=0.5)
		except Exception as e:
			self._set_status(f"EP0 не отвечает: {e}. Перезапуск интерфейса в ОС или power cycle.", hold_sec=2.0)
			# Сразу попробуем power cycle
			try:
				self._power_cycle_usb_port()
				return
			except Exception as pc_e:
				self._set_status(f"Power cycle не удался: {pc_e}. Требуется аппаратный сброс.", hold_sec=5.0)
			return
		# Шаг 2: DEEP_RESET
		try:
			if hasattr(self.stream, 'deep_reset'):
				self._set_status("DEEP_RESET…", hold_sec=0.8)
				self.stream.deep_reset()
				time.sleep(0.1)  # Пауза после DEEP_RESET
			else:
				self._set_status("DEEP_RESET не поддерживается, пропускаю…", hold_sec=0.5)
		except Exception as e:
			self._set_status(f"DEEP_RESET failed: {e}", hold_sec=1.0)
		# Шаг 3: Установить alt=1
		try:
			if hasattr(self.stream, 'set_alt'):
				self._set_status("Установка alt=1…", hold_sec=0.5)
				self.stream.set_alt(1)
				time.sleep(0.05)
			else:
				self._set_status("set_alt не поддерживается, пропускаю…", hold_sec=0.5)
		except Exception as e:
			self._set_status(f"set_alt failed: {e}", hold_sec=1.0)
		# Шаг 4: Проверить готовность через GET_STATUS
		try:
			if hasattr(self.stream, '_get_status_ep0'):
				self.stream._get_status_ep0()
			time.sleep(0.05)  # Дать время на обновление STAT
			st = getattr(self.stream, 'last_stat', None)
			if isinstance(st, (bytes, bytearray)) and len(st) >= 64 and st[:4] == b'STAT':
				# STAT v1: flags_runtime 48:50 (u16), flags2 50:52 (u16), sending_ch @52 (u8), reserved2 @53 (u8)
				flags_runtime = int.from_bytes(st[48:50], 'little')
				hang_latched = (flags_runtime & 0x0004) != 0
				flags2 = int.from_bytes(st[50:52], 'little')
				alt1 = (flags2 >> 15) & 1
				sending_ch = st[52]
				reserved2 = st[53]
				out_armed = (reserved2 >> 7) & 1
				deep_reset_count_mod4 = reserved2 & 3
				print(f"[diag] STAT parsed: alt1={alt1}, out_armed={out_armed}, hang_latched={hang_latched}, sending_ch={sending_ch}, deep_reset_count_mod4={deep_reset_count_mod4}")
				if alt1 == 1 and out_armed == 1:
					status_msg = f"Готовность подтверждена (alt1=1, out_armed=1"
					if hang_latched:
						status_msg += ", hang_latched=1"
					if deep_reset_count_mod4:
						status_msg += f", deep_resets={deep_reset_count_mod4}"
					status_msg += "). Запуск потока…"
					self._set_status(status_msg, hold_sec=1.0)
					# Шаг 5: Запустить поток
					try:
						self._soft_kick_stream()
						self.last_soft_kick_t = time.time()
						self._set_status("Команды прошли. Ожидание данных…", hold_sec=1.5)
						return
					except Exception as e:
						self._set_status(f"START failed: {e}", hold_sec=1.0)
				else:
					self._set_status(f"Не готово: alt1={alt1}, out_armed={out_armed}. Повторная попытка alt toggle…", hold_sec=1.0)
			else:
				self._set_status("STAT не получен после alt=1. Повторная попытка…", hold_sec=1.0)
		except Exception as e:
			self._set_status(f"Проверка готовности failed: {e}", hold_sec=1.0)
		# Fallback: Alt toggle
		try:
			if hasattr(self.stream, 'set_alt'):
				self._set_status("Alt toggle 0→1…", hold_sec=0.8)
				self.stream.set_alt(0)
				time.sleep(0.03)
				self.stream.set_alt(1)
				time.sleep(0.05)
				self._soft_kick_stream()
				self._set_status("Alt toggle + kick отправлены. Ожидаю данные…", hold_sec=1.2)
				return
		except Exception as e:
			pass
		# Последний шанс: Power cycle
		try:
			self._power_cycle_usb_port()
			return
		except Exception as pc_e:
			self._set_status(f"Все методы восстановления не удались: {pc_e}. Требуется аппаратный сброс.", hold_sec=5.0)

	def _power_cycle_usb_port(self):
		"""Попытаться перезапитать конкретный USB-порт через uhubctl.

		Алгоритм:
		- узнаём топологию у текущего stream (bus, hub_loc, hub_port)
		- пытаемся `uhubctl -l <hub_loc> -p <port> -a off/on` (если установлен)
		- если uhubctl недоступен/не поддерживает PPS – fallback через sysfs:
		  /sys/bus/usb/devices/<port_path>/authorized 0/1, затем unbind/bind
		- после включения запускаем обычное переподключение
		"""
		if self.stream is None and self.last_port_info is None:
			self._set_status("Нет активного потока и сохранённой информации о порте. Нажмите 1 для подключения и повторите.", hold_sec=2.0)
			return
		try:
			info = {}
			try:
				if self.stream is not None:
					info = self.stream.get_port_path_info()
				else:
					info = self.last_port_info
			except Exception:
				info = self.last_port_info if self.last_port_info else {}
			hub_loc = info.get('hub_loc')
			hub_port = info.get('hub_port')
			port_path = info.get('port_path')  # например, "1-1.3.2"
			if not hub_loc or not hub_port:
				self._set_status("Не удалось определить порт хаба. Откройте консоль и выполните: sudo uhubctl", hold_sec=3.0)
				return
			if self.stream is not None:
				# Закрыть текущий поток прежде чем дёргать питание
				try:
					self.stream.close()
				except Exception:
					pass
				self.stream = None
			import subprocess, shlex, shutil, time as _t, os as _os
			# Попытка через uhubctl (если установлен)
			uh_path = shutil.which("uhubctl")
			uh_ok = False
			uh_err = ""
			if uh_path:
				self._set_status(f"Отключаю питание USB {hub_loc} порт {hub_port} через uhubctl…", hold_sec=2.0)
				cmd_off = f"sudo {uh_path} -l {hub_loc} -p {hub_port} -a off"
				cmd_on  = f"sudo {uh_path} -l {hub_loc} -p {hub_port} -a on"
				try:
					res_off = subprocess.run(shlex.split(cmd_off), capture_output=True, text=True, timeout=6)
					_off_rc = res_off.returncode
					_off_out = (res_off.stdout or "") + ("\n" + (res_off.stderr or ""))
					_t.sleep(1.0)
					res_on = subprocess.run(shlex.split(cmd_on), capture_output=True, text=True, timeout=6)
					_on_rc = res_on.returncode
					_on_out = (res_on.stdout or "") + ("\n" + (res_on.stderr or ""))
					uh_ok = (_off_rc == 0 and _on_rc == 0)
					# Типичные признаки отсутствия поддержки: "No compatible devices", "not found", "Permission denied"
					if ("No compatible" in _off_out) or ("No compatible" in _on_out) or ("not found" in _off_out) or ("not found" in _on_out) or ("Permission denied" in _off_out) or ("Permission denied" in _on_out):
						uh_ok = False
					if not uh_ok:
						uh_err = f"uhubctl rc off:{_off_rc} on:{_on_rc}. off_out: {_off_out.strip()} | on_out: {_on_out.strip()}"
				except Exception as e:
					uh_err = f"uhubctl exec error: {e}"
			# Если uhubctl не сработал — fallback через sysfs
			if not uh_ok:
				if not uh_path:
					print("[power] uhubctl не найден в системе. apt install uhubctl для перезапитки PPS-хабов.")
				else:
					print("[power] uhubctl failed:", uh_err)
				# Нужен port_path вида "1-1.3.2" для sysfs
				if not port_path:
					self._set_status("Нет port_path для sysfs fallback. Установите uhubctl или подключите PPS-хаб.", hold_sec=3.0)
					return
				dev_dir = f"/sys/bus/usb/devices/{port_path}"
				auth_file = f"{dev_dir}/authorized"
				self._set_status("Пробую отключить устройство через sysfs authorized…", hold_sec=2.0)
				# authorized 0/1 через tee (чтобы не требовать /bin/sh в sudoers)
				try:
					is_root = False
					try:
						is_root = (os.geteuid() == 0)
					except Exception:
						pass
					if is_root:
						res0 = subprocess.run(["tee", auth_file], input="0\n", text=True, capture_output=True, timeout=6)
					else:
						res0 = subprocess.run(["sudo", "tee", auth_file], input="0\n", text=True, capture_output=True, timeout=6)
					_t.sleep(0.8)
					if is_root:
						res1 = subprocess.run(["tee", auth_file], input="1\n", text=True, capture_output=True, timeout=6)
					else:
						res1 = subprocess.run(["sudo", "tee", auth_file], input="1\n", text=True, capture_output=True, timeout=6)
					if res0.returncode != 0 or res1.returncode != 0:
						raise RuntimeError(f"authorized rc0={res0.returncode} rc1={res1.returncode} out0={res0.stderr or res0.stdout} out1={res1.stderr or res1.stdout}")
					auth_ok = True
				except Exception as e_auth:
					print("[power] sysfs authorized failed:", e_auth)
					# Попробуем unbind/bind через tee
					self._set_status("authorized не сработал, пробую unbind/bind…", hold_sec=2.0)
					try:
						ub = "/sys/bus/usb/drivers/usb/unbind"
						bb = "/sys/bus/usb/drivers/usb/bind"
						is_root = False
						try:
							is_root = (os.geteuid() == 0)
						except Exception:
							pass
						if is_root:
							res_u = subprocess.run(["tee", ub], input=f"{port_path}\n", text=True, capture_output=True, timeout=6)
						else:
							res_u = subprocess.run(["sudo", "tee", ub], input=f"{port_path}\n", text=True, capture_output=True, timeout=6)
						_t.sleep(0.8)
						if is_root:
							res_b = subprocess.run(["tee", bb], input=f"{port_path}\n", text=True, capture_output=True, timeout=6)
						else:
							res_b = subprocess.run(["sudo", "tee", bb], input=f"{port_path}\n", text=True, capture_output=True, timeout=6)
						if res_u.returncode != 0 or res_b.returncode != 0:
							raise RuntimeError(f"unbind/bind rcU={res_u.returncode} rcB={res_b.returncode} outU={res_u.stderr or res_u.stdout} outB={res_b.stderr or res_b.stdout}")
						if bool(getattr(self, 'debug', False)):
							print("[power] unbind/bind OK")
					except Exception as e_ub:
						self._set_status(f"Не удалось перезапустить порт: {e_ub}", hold_sec=3.0)
						return
			else:
				self._set_status("Питание через uhubctl включено. Жду переэнумерации…", hold_sec=2.0)
			# Небольшая пауза и обычное переподключение
			_t.sleep(1.0)
			self._activate_stream()
		except Exception as e:
			self._set_status(f"Power-cycle ошибка: {e}", hold_sec=3.0)

	def _queue_connect_result(self, kind: str, attempt_id: int, payload):
		try:
			self._connect_result_q.put_nowait((str(kind), int(attempt_id), payload))
		except Exception:
			if str(kind) == 'success' and payload is not None:
				try:
					payload.close()
				except Exception:
					pass

	def _process_connect_results(self):
		try:
			q = self._connect_result_q
		except Exception:
			return
		while True:
			try:
				kind, attempt_id, payload = q.get_nowait()
			except queue.Empty:
				break
			except Exception:
				break
			try:
				if str(kind) == 'success':
					self._finalize_connect_success(int(attempt_id), payload)
				elif str(kind) == 'error':
					self._finalize_connect_error(int(attempt_id), payload)
			except Exception as e:
				try:
					import traceback
					print(f"[GUI] connect-result handler failed: kind={kind} attempt={attempt_id} err={e}", flush=True)
					traceback.print_exc()
				except Exception:
					pass
				try:
					if str(kind) == 'success' and payload is not None:
						payload.close()
				except Exception:
					pass

	def _try_connect_safe(self):
		try:
			self._try_connect()
		except Exception as e:
			try:
				import traceback
				print(f"[GUI] _try_connect crashed: {e}", flush=True)
				traceback.print_exc()
			except Exception:
				pass
			try:
				self._connecting = False
			except Exception:
				pass
			try:
				if not self.usb_retry_timer.isActive():
					self.usb_retry_timer.start()
			except Exception:
				pass

	def _tick_safe(self):
		try:
			self._tick()
		except Exception as e:
			try:
				import traceback
				print(f"[GUI] _tick crashed: {e}", flush=True)
				traceback.print_exc()
			except Exception:
				pass
			try:
				self._set_status(f"GUI recovered after error: {e}", hold_sec=2.0)
			except Exception:
				pass

	def _finalize_connect_success(self, attempt_id: int, stream_obj):
		if stream_obj is None:
			return
		if int(getattr(self, '_connect_attempt_id', 0)) != int(attempt_id):
			try:
				stream_obj.close()
			except Exception:
				pass
			return
		self.stream = stream_obj
		self._connecting = False
		self._connect_started_t = 0.0
		try:
			self._usb_connect_err_count = 0
		except Exception:
			pass
		try:
			self._det_reset_and_arm_warmup('connect')
		except Exception:
			pass
		try:
			self.last_port_info = self.stream.port_info
		except Exception:
			pass
		try:
			self._install_stream_command_logger()
		except Exception:
			pass
		try:
			self._sample_len_mode_pending = None
			self._sample_len_mode_sync_armed = True
			self._sample_len_mode_last = None
			with self.data_lock:
				self.base_buf_len = None
				self.base_buf_len_bytes = None
				self._sliders_initialized = False
		except Exception:
			pass
		if self.apply_init_sequence:
			try:
				self._run_init_sequence()
			except Exception as e_init:
				print(f"[initseq] failed: {e_init}")
		try:
			self._apply_saved_device_settings()
		except Exception as e_saved:
			print(f"[CONNECT] apply_saved_device_settings failed: {e_saved}", flush=True)
		try:
			self._stream_fault_kind = "ok"
			self._stream_fault_msg = "Поток жив"
			self._stream_fault_probe_t = 0.0
			self._stream_fault_probe_ok = None
			self._stream_fault_probe_msg = ""
		except Exception:
			pass
		self._set_status("Устройство подключено, ожидание данных…", hold_sec=1.5)
		self.connect_t = time.time()
		self.last_frame_t = 0
		self.no_data_warned = False
		if not self.reader_running:
			self.reader_running = True
			self.reader_thread = threading.Thread(target=self._reader_thread_func, daemon=True)
			self.reader_thread.start()
		try:
			self._det_reset_and_arm_warmup('activate')
		except Exception:
			pass
		expected = self.expected_len_map.get(self.desired_profile, self.initial_expected)
		freq = 200 if self.desired_profile == 1 else 300 if self.desired_profile == 2 else None
		msg = f"Старт потока… ожидание данных… BUF≈{expected} семплов"
		if freq:
			msg += f" (профиль {freq} Гц)"
		self._set_status(msg, hold_sec=1.5)
		try:
			print(f"[start] Профиль={self.desired_profile} ожидаемый BUF={expected} семплов", flush=True)
		except Exception:
			pass
		try:
			self._send_start_stream()
			print("[activate] Sent CMD_START_STREAM (ensure streaming)", flush=True)
		except Exception:
			pass
		try:
			self.usb_retry_timer.stop()
		except Exception:
			pass

	def _finalize_connect_error(self, attempt_id: int, err):
		if int(getattr(self, '_connect_attempt_id', 0)) != int(attempt_id):
			return
		self.stream = None
		self._connecting = False
		self._connect_started_t = 0.0
		self.tim2_pending = False
		self.tim2_applied = False
		self._update_tim2_btn_style()
		try:
			if isinstance(err, SystemExit):
				print(f"[ERROR] SystemExit: {err}", flush=True)
				self._set_status(str(err), hold_sec=2.0)
			else:
				print(f"[CONNECT] Exception: {err}", flush=True)
				try:
					self._fault_log_line(self._fault_context_line(f"connect_error:{err}"))
				except Exception:
					pass
				msg = str(err)
				if "unable to set vendor interface alt=1" in msg:
					try:
						self._set_usb_reconnect_backoff(float(os.getenv("BMI30_ALT_CONNECT_RETRY_DELAY_S", "1.0")), "alt1_connect_error")
					except Exception:
						self._set_usb_reconnect_backoff(1.0, "alt1_connect_error")
				connect_error_hw_reset = str(os.getenv("BMI30_CONNECT_ERROR_HW_RESET", "0")).lower() not in ("0", "false", "no", "off")
				if connect_error_hw_reset and any(x in msg for x in ("Resource busy", "[Errno 16]", "[Errno 19]", "[Errno 32]", "[Errno 110]", "No such device", "disconnected", "timeout", "hung", "busy", "Errno")):
					try:
						now = time.time()
						last_reset = float(getattr(self, "_usb_connect_last_reset_t", 0.0) or 0.0)
						try:
							reset_interval_s = float(os.getenv("BMI30_CONNECT_ERROR_HW_RESET_MIN_INTERVAL_S", "60.0"))
						except Exception:
							reset_interval_s = 60.0
						reset_interval_s = max(5.0, reset_interval_s)
						if (now - last_reset) >= reset_interval_s:
							print("[CONNECT] Attempting immediate hardware reset", flush=True)
							if self._hardware_reset_device():
								self._usb_last_reset_t = time.time()
								self._wait_after_usb_reset_for_reconnect("connect_error_hw_reset")
							self._usb_connect_last_reset_t = now
					except Exception:
						pass
				self._set_status(f"Нет устройства ({err})", hold_sec=2.0)
		finally:
			try:
				if not self.usb_retry_timer.isActive():
					self.usb_retry_timer.start()
			except Exception:
				pass

	def _try_connect(self, first=False):
		if self.num_group.checkedId() == 0:
			return
		if self._connecting or self.stream is not None:
			return
		try:
			not_before = float(getattr(self, '_usb_reconnect_not_before_t', 0.0) or 0.0)
		except Exception:
			not_before = 0.0
		now = time.time()
		if not_before > now:
			try:
				self._set_status(f"Жду готовности USB {not_before - now:.1f}с…", hold_sec=0.8)
			except Exception:
				pass
			try:
				if not self.usb_retry_timer.isActive():
					self.usb_retry_timer.start()
			except Exception:
				pass
			return
		self._connect_attempt_id = int(getattr(self, '_connect_attempt_id', 0)) + 1
		attempt_id = int(self._connect_attempt_id)
		self._connecting = True
		self._connect_started_t = time.time()
		msg_prefix = "Подключение" if not first else "Инициализация"
		self._set_status(f"{msg_prefix} к устройству…", hold_sec=1.5)
		
		# Запустить подключение в отдельном потоке (без nested-thread гонок)
		def _connect_worker(_attempt_id: int):
			try:
				# восстановим глобальный флаг running в модуле usb_stream
				try:
					import usb_vendor.usb_stream as _usm  # type: ignore
					if getattr(_usm, 'running', True) is False:
						_usm.running = True
				except Exception:
					pass
				try:
					last_reset = float(getattr(self, '_usb_last_reset_t', 0.0) or 0.0)
				except Exception:
					last_reset = 0.0
				if last_reset > 0.0 and (time.time() - last_reset) < 20.0:
					try:
						ready_timeout = float(os.getenv("BMI30_CONNECT_READY_TIMEOUT_S", "1.2"))
					except Exception:
						ready_timeout = 1.2
					try:
						ready_poll = float(os.getenv("BMI30_CONNECT_READY_POLL_S", "0.05"))
					except Exception:
						ready_poll = 0.05
					ready_ok, ready_msg = self._wait_device_ready_ep0_direct(timeout_s=ready_timeout, poll_s=ready_poll)
					if not ready_ok:
						self._set_usb_reconnect_backoff(0.8, f"connect_not_ready:{ready_msg}")
						raise RuntimeError(f"USB device is not ready after reset: {ready_msg}")
				
				# Быстрая проверка перед созданием USBStream
				try:
					os.environ['BMI30_SEND_BLOCK_RATE'] = '1'
				except Exception:
					pass
				
				fs = self.expected_len_map.get(self.desired_profile, self.initial_expected) if (self.send_ns and int(self.desired_profile or 2) == 2) else None
				stream_obj = USBStream(profile=self.desired_profile, full=True, test_as_data=self.test_as_data, frame_samples=fs, fast_mode=True, assembler_independent=self.independent_channels)
				# Если эта попытка уже устарела, не трогаем текущее состояние.
				if int(getattr(self, '_connect_attempt_id', 0)) != int(_attempt_id):
					try:
						stream_obj.close()
					except Exception:
						pass
					return
				self._queue_connect_result('success', _attempt_id, stream_obj)
			except SystemExit as se:
				self._queue_connect_result('error', _attempt_id, se)
			except Exception as e:
				self._queue_connect_result('error', _attempt_id, e)
		
		# Запустить worker и сразу вернуться (НЕ дожидаться)
		threading.Thread(target=_connect_worker, args=(attempt_id,), daemon=True).start()

	def _activate_stream(self):
		if not self.usb_retry_timer.isActive():
			self.usb_retry_timer.start()
		try:
			self._release_hw_reset_lines()
		except Exception:
			pass
		# One-time startup reset: fast by default; full 3-stage reset is kept for stall recovery.
		try:
			if not bool(getattr(self, '_hw_reset_on_start_done', False)):
				reset_on_start = str(os.getenv("BMI30_RESET_ON_START", "1")).lower() not in ("0", "false", "no")
				if reset_on_start:
					startup_reset_result = self._startup_reset_device()
					try:
						if not bool((startup_reset_result or {}).get("skipped", False)):
							self._usb_last_reset_t = time.time()
							self._set_usb_reconnect_backoff(float(os.getenv("BMI30_STARTUP_RECONNECT_SETTLE_S", "0.20")), "startup_reset")
					except Exception:
						pass
				else:
					auto_hw = str(os.getenv("BMI30_HW_RESET_ON_START", "0")).lower() not in ("0", "false", "no")
					if auto_hw:
						hw_ok = bool(self._hardware_reset_device())
						if hw_ok:
							print("[HW-RESET] startup reset OK", flush=True)
							try:
								self._usb_last_reset_t = time.time()
								self._wait_after_usb_reset_for_reconnect("startup_hw_reset")
							except Exception:
								pass
						else:
							print("[HW-RESET] startup reset FAILED", flush=True)
				self._hw_reset_on_start_done = True
		except Exception:
			print("[HW-RESET] startup reset EXCEPTION", flush=True)
		# Legacy opt-in soft reset when the full startup reset is disabled.
		try:
			reset_on_start = str(os.getenv("BMI30_RESET_ON_START", "1")).lower() not in ("0", "false", "no")
			auto_soft = (not reset_on_start) and str(os.getenv("BMI30_SOFT_RESET_ON_START", "0")).lower() not in ("0", "false", "no")
			if auto_soft:
				self._send_soft_reset_via_cdc()
		except Exception:
			pass
		# Запустить подключение сразу.
		# Финализация подключения и обязательный START выполняются в _finalize_connect_success().
		self._try_connect(first=True)

	def _apply_saved_device_settings(self):
		"""Применить сохранённые параметры к устройству после подключения."""
		if self.stream is None:
			return
		# Номер режима после старта/сброса определяем только по первому BUF:
		# 600 семплов => режим 3, 200 семплов => режим 5.
		if _env_bool("BMI30_APPLY_SAVED_MODE_BEFORE_DATA", False):
			try:
				idx = int(self.sel_saved or self.num_group.checkedId())
			except Exception:
				idx = None
			if idx is not None and int(idx) != 0:
				try:
					self._num_clicked(int(idx))
					try:
						self._on_num_clicked_extra(int(idx))
					except Exception:
						pass
				except Exception:
					pass
		else:
			try:
				self._sample_len_mode_pending = None
				self._sample_len_mode_sync_armed = True
				print("[CONNECT] saved mode deferred; BUF will select 3/5", flush=True)
			except Exception:
				pass
		# Применим сохранённую частоту
		try:
			freq = int(getattr(self, 'desired_freq', 0) or 0)
		except Exception:
			freq = 0
		if freq:
			try:
				if hasattr(self.stream, 'set_buf_rate_fine'):
					self.stream.set_buf_rate_fine(freq)
				elif hasattr(self.stream, 'set_block_rate'):
					self.stream.set_block_rate(freq)
				else:
					import struct
					self.stream.send_cmd(0x11, struct.pack('<H', freq))
			except Exception:
				pass

	def _on_freq_change(self, text:str):
		# Парсим частоту из текста "XXX Hz"
		try:
			freq = int(text.split()[0])
		except:
			freq = 200
		self.desired_freq = freq
		# Для совместимости с существующим кодом сохраняем profile (используем 1 для всех частот)
		self.desired_profile = 1
		save_config(self.desired_profile, freq)  # сохраняем выбор
		if self.stream is None:
			self._set_status(f"Выбрана частота {freq} Гц (нажмите 1 для запуска)")
			return
		# Переключение на лету: не роняем поток, только отправляем частоту
		try:
			if hasattr(self.stream, 'set_buf_rate_fine'):
				self.stream.set_buf_rate_fine(self.desired_freq)
				print(f"[freq_change] Set rate to {self.desired_freq} Hz via set_buf_rate_fine()")
			elif hasattr(self.stream, 'set_block_rate'):
				self.stream.set_block_rate(self.desired_freq)
				print(f"[freq_change] Set block rate to {self.desired_freq} Hz via set_block_rate()")
			else:
				import struct
				self.stream.send_cmd(0x11, struct.pack('<H', self.desired_freq))
				print(f"[freq_change] Set block rate to {self.desired_freq} Hz via CMD_BLOCK_HZ")
			self._set_status(f"Частота установлена: {self.desired_freq} Гц", hold_sec=1.5)
		except Exception as e:
			self._set_status(f"Ошибка смены частоты: {e}", hold_sec=2.0)

	def _on_avg_change(self, idx: int):
		"""Handler for avg_n combo box: send AVG_ROI change to device and save setting."""
		try:
			text = self.avg_box.currentText()
			new_n = int(text)
		except Exception:
			new_n = 20
		# save selection
		save_avg_n(new_n)
		self.avg_n = new_n
		# Если поток не подключен или режим не AVG_ROI — только сохраняем значение
		if self.stream is None or getattr(self, 'stream_mode', 0) != 2:
			self._set_status(f"Сохранено avg_n={new_n} (применится в режиме AVG_ROI)", hold_sec=1.5)
			return
		# Если уже в AVG_ROI, отправим новое значение avg_n
		try:
			self.stream.send_cmd(CMD_SET_STREAM_MODE, bytes([0x02, new_n & 0xFF]))
			self._set_status(f"Отправлен AVG_ROI avg_n={new_n}", hold_sec=2.0)
			if bool(getattr(self, 'debug', False)):
				print(f"[AVG_ROI] SET_STREAM_MODE=2 (avg_n={new_n}) отправлен по изменению меню")
		except Exception as e:
			if bool(getattr(self, 'debug', False)):
				print(f"[AVG_ROI] Ошибка обработки avg_n={new_n}: {e}")

	def _on_det_ratio_change(self, text: str):
		"""Handler for detector ratio combo box."""
		try:
			val = float(str(text).strip())
		except Exception:
			val = 2.0
		# clamp to allowed range and step
		val = _det_clamp_ratio(val, 2.0)
		self._det_ratio = val
		try:
			self._det_ratio0 = val
			self._det_ratio1 = val
		except Exception:
			pass
		try:
			save_det_ratio(val)
		except Exception:
			pass
		try:
			self._set_status(f"Det ratio: {val:.1f}", hold_sec=1.0)
		except Exception:
			pass

