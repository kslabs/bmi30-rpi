def _import_gpio_module(module_name: str):
	"""Import GPIO-related module, falling back to system dist-packages from venv."""
	try:
		return importlib.import_module(module_name)
	except Exception:
		pass
	for extra_path in (
		"/usr/lib/python3/dist-packages",
		f"/usr/local/lib/python{sys.version_info.major}.{sys.version_info.minor}/dist-packages",
	):
		try:
			if os.path.isdir(extra_path) and extra_path not in sys.path:
				sys.path.append(extra_path)
		except Exception:
			pass
	return importlib.import_module(module_name)


class PwmBeeper:
	"""Hardware-only beeper for Raspberry Pi PWM0_CHAN0 on GPIO12."""
	def __init__(self, gpio_pin: int = 12):
		self.gpio_pin = int(gpio_pin)
		self._backend = None
		self._pi = None
		self._lg = None
		self._lg_h = None
		self._gpio = None
		self._pwm = None
		self._hw_pwm_path = None
		self._hw_pwm_period_ns = 0
		self._hw_pwm_enabled = False
		self._lock = threading.Lock()
		self._enabled = str(os.getenv("BMI30_BEEP_ENABLE", "1")).lower() not in ("0", "false", "no")
		self._continuous_on = False
		self._last_freq = 0
		self._pattern_token = 0
		self._pattern_playback_active = False
		self._repeat_loop_active = False
		self._repeat_loop_sequences = None
		self._repeat_loop_gap = 0.0
		self._repeat_loop_stop_requested = False
		self._volume_gamma = self._load_volume_gamma()
		self._volume_percent = self._clamp_volume(os.getenv("BMI30_BEEP_VOLUME_PERCENT", os.getenv("BMI30_BEEP_VOLUME", "100")))
		self._duty_percent = self._volume_to_duty(self._volume_percent)
		self._init_backend()

	def _clamp_volume(self, value, default: float = 100.0) -> float:
		try:
			val = float(value)
		except Exception:
			val = float(default)
		try:
			if not np.isfinite(val):
				val = float(default)
		except Exception:
			val = float(default)
		return float(max(0.0, min(100.0, val)))

	def _load_volume_gamma(self) -> float:
		try:
			gamma = float(os.getenv("BMI30_BEEP_VOLUME_GAMMA", "2.2"))
		except Exception:
			gamma = 2.2
		try:
			if not np.isfinite(gamma):
				gamma = 2.2
		except Exception:
			gamma = 2.2
		return float(max(1.0, min(5.0, gamma)))

	def _volume_to_duty(self, volume_percent: float) -> float:
		vol = self._clamp_volume(volume_percent)
		if vol <= 0.0:
			return 0.0
		gamma = float(getattr(self, "_volume_gamma", 2.2) or 2.2)
		return float(max(0.0, min(50.0, 50.0 * ((vol / 100.0) ** gamma))))

	def set_volume_percent(self, volume_percent: float):
		"""Set perceived volume 0..100%; internally maps through an audio taper to PWM duty 0..50%."""
		with self._lock:
			self._volume_percent = self._clamp_volume(volume_percent)
			self._duty_percent = self._volume_to_duty(self._volume_percent)
			if not self._enabled or self._backend is None:
				return
			last_freq = int(getattr(self, "_last_freq", 0) or 0)
			active = bool(getattr(self, "_continuous_on", False)) or bool(getattr(self, "_repeat_loop_active", False))
			if active and last_freq > 0:
				self._start(float(last_freq))

	def status(self) -> str:
		"""Return backend status for UI/logging."""
		try:
			if not bool(self._enabled):
				return 'OFF'
			b = str(self._backend or 'none')
			if b == 'none':
				return 'none'
			# include minimal runtime state to debug "no variable signal"
			try:
				if bool(getattr(self, '_continuous_on', False)) and int(getattr(self, '_last_freq', 0) or 0) > 0:
					return f"{b}@GPIO{int(self.gpio_pin)} f={int(self._last_freq)}"
			except Exception:
				pass
			return f"{b}@GPIO{int(self.gpio_pin)}"
		except Exception:
			return 'unknown'

	def _hw_pwm_write(self, name: str, value: int | str):
		path = os.path.join(str(self._hw_pwm_path), str(name))
		last_exc = None
		for _ in range(100):
			try:
				with open(path, "w", encoding="ascii") as handle:
					handle.write(str(value))
				return
			except OSError as exc:
				last_exc = exc
				if int(getattr(exc, "errno", 0) or 0) not in (errno.EACCES, errno.EPERM, errno.ENOENT):
					raise
				time.sleep(0.01)
		if last_exc is not None:
			raise last_exc
		raise OSError(f"PWM write failed: {path}")

	def _init_backend(self):
		if not self._enabled:
			return
		# Sound must never silently fall back to a software-timed square wave:
		# under GUI/USB load that produces audible jitter ("rasp"). GPIO12 is
		# PWM0_CHAN0 on RP1; pwm-2chan exposes it as pwmchip0/pwm0.
		try:
			if int(self.gpio_pin) != 12:
				raise RuntimeError(f"hardware PWM sound supports GPIO12 only, got GPIO{int(self.gpio_pin)}")
			chip_path = os.path.realpath(str(os.getenv("BMI30_PWM_CHIP_PATH", "/sys/class/pwm/pwmchip0")))
			channel = int(os.getenv("BMI30_PWM_CHANNEL", "0") or 0)
			if not os.path.isdir(chip_path):
				raise FileNotFoundError(chip_path)
			# pinctrl is non-root on the BMI30 image (techaid belongs to gpio).
			subprocess.run(
				["pinctrl", "set", str(int(self.gpio_pin)), "a0"],
				check=True,
				stdout=subprocess.DEVNULL,
				stderr=subprocess.DEVNULL,
				timeout=2.0,
			)
			pwm_path = os.path.join(chip_path, f"pwm{channel}")
			if not os.path.isdir(pwm_path):
				with open(os.path.join(chip_path, "export"), "w", encoding="ascii") as handle:
					handle.write(str(channel))
				for _ in range(200):
					if os.path.isdir(pwm_path):
						break
					time.sleep(0.01)
			if not os.path.isdir(pwm_path):
				raise RuntimeError(f"PWM channel was not exported: {pwm_path}")
			self._hw_pwm_path = pwm_path
			required = ("period", "duty_cycle", "enable")
			for _ in range(200):
				if all(
					os.path.isfile(os.path.join(pwm_path, name))
					and os.access(os.path.join(pwm_path, name), os.W_OK)
					for name in required
				):
					break
				time.sleep(0.01)
			if not all(
				os.path.isfile(os.path.join(pwm_path, name))
				and os.access(os.path.join(pwm_path, name), os.W_OK)
				for name in required
			):
				raise PermissionError(f"PWM channel files are not writable: {pwm_path}")
			# A previous process may have died with PWM enabled. Force a silent,
			# known edge state before accepting any detector event.
			self._hw_pwm_write("duty_cycle", 0)
			self._hw_pwm_write("enable", 0)
			self._hw_pwm_period_ns = 0
			self._hw_pwm_enabled = False
			self._backend = "hw_pwm"
		except Exception as exc:
			self._backend = None
			self._hw_pwm_path = None
			self._hw_pwm_period_ns = 0
			self._hw_pwm_enabled = False
			try:
				print(f"[BEEP] hardware PWM unavailable; software fallback is forbidden: {exc}", flush=True)
			except Exception:
				pass

	def _start(self, freq_hz: float):
		if not self._enabled or self._backend is None:
			return
		freq = int(max(1, float(freq_hz)))
		duty = float(max(0.0, min(50.0, float(getattr(self, "_duty_percent", 50.0) or 0.0))))
		if duty <= 0.0:
			self._stop()
			return
		if self._backend == "hw_pwm" and self._hw_pwm_path:
			try:
				period_ns = max(1, int(round(1_000_000_000.0 / float(freq))))
				duty_ns = max(0, min(period_ns - 1, int(round(period_ns * duty / 100.0))))
				if bool(getattr(self, "_hw_pwm_enabled", False)) and int(getattr(self, "_hw_pwm_period_ns", 0) or 0) == period_ns:
					self._hw_pwm_write("duty_cycle", duty_ns)
					return
				if bool(getattr(self, "_hw_pwm_enabled", False)):
					self._hw_pwm_write("duty_cycle", 0)
					self._hw_pwm_write("enable", 0)
				else:
					try:
						self._hw_pwm_write("duty_cycle", 0)
					except Exception:
						pass
				self._hw_pwm_write("period", period_ns)
				self._hw_pwm_write("duty_cycle", duty_ns)
				self._hw_pwm_write("enable", 1)
				self._hw_pwm_period_ns = period_ns
				self._hw_pwm_enabled = True
			except Exception:
				self._hw_pwm_enabled = False

	def _stop(self):
		if not self._enabled or self._backend is None:
			return
		if self._backend == "hw_pwm" and self._hw_pwm_path:
			try:
				self._hw_pwm_write("duty_cycle", 0)
			except Exception:
				pass
			try:
				self._hw_pwm_write("enable", 0)
			except Exception:
				pass
			self._hw_pwm_enabled = False

	def set_continuous(self, freq_hz: float | None):
		"""Enable/disable continuous tone (for scope/measurement).

		- freq_hz=None or <=0: stop output
		- else: set PWM frequency and keep running
		"""
		if not self._enabled or self._backend is None:
			return
		try:
			freq = int(max(0, float(freq_hz or 0.0)))
		except Exception:
			freq = 0
		with self._lock:
			if freq <= 0:
				was_active = bool(
					getattr(self, "_continuous_on", False)
					or getattr(self, "_pattern_playback_active", False)
					or getattr(self, "_repeat_loop_active", False)
					or int(getattr(self, "_last_freq", 0) or 0) > 0
				)
				if not was_active:
					return
				self._pattern_token = int(getattr(self, "_pattern_token", 0)) + 1
				self._pattern_playback_active = False
				self._repeat_loop_active = False
				self._repeat_loop_sequences = None
				self._repeat_loop_stop_requested = False
				self._continuous_on = False
				self._last_freq = 0
				self._stop()
				return
			# avoid needless reprogramming
			if self._continuous_on and self._last_freq == int(freq):
				return
			self._pattern_token = int(getattr(self, "_pattern_token", 0)) + 1
			self._pattern_playback_active = False
			self._repeat_loop_active = False
			self._repeat_loop_sequences = None
			self._repeat_loop_stop_requested = False
			self._continuous_on = True
			self._last_freq = int(freq)
			self._start(float(freq))

	def stop_now(self):
		"""Stop PWM immediately and cancel pending pattern playback."""
		if not self._enabled or self._backend is None:
			return
		with self._lock:
			was_active = bool(
				getattr(self, "_continuous_on", False)
				or getattr(self, "_pattern_playback_active", False)
				or getattr(self, "_repeat_loop_active", False)
				or int(getattr(self, "_last_freq", 0) or 0) > 0
			)
			if not was_active:
				return
			self._pattern_token = int(getattr(self, "_pattern_token", 0)) + 1
			self._pattern_playback_active = False
			self._repeat_loop_active = False
			self._repeat_loop_sequences = None
			self._repeat_loop_stop_requested = False
			self._continuous_on = False
			self._last_freq = 0
			self._stop()

	def _clean_sequence(self, segments):
		clean = []
		try:
			for freq_hz, seconds in list(segments or []):
				dur = max(0.0, float(seconds))
				if dur <= 0.0:
					continue
				if freq_hz is None:
					clean.append((None, dur))
				else:
					freq = float(freq_hz)
					clean.append((freq if freq > 0.0 else None, dur))
		except Exception:
			clean = []
		return tuple(clean)

	def play_sequence(self, segments):
		"""Play a non-blocking latest-wins sequence of (freq_hz, seconds)."""
		if not self._enabled or self._backend is None:
			return
		clean = self._clean_sequence(segments)
		if not clean:
			return
		with self._lock:
			self._pattern_token = int(getattr(self, "_pattern_token", 0)) + 1
			token = int(self._pattern_token)
			self._pattern_playback_active = True
			self._repeat_loop_active = False
			self._repeat_loop_sequences = None
			self._repeat_loop_stop_requested = False
			self._continuous_on = False
			self._last_freq = 0

		def _sleep_or_cancel(seconds: float) -> bool:
			end_t = time.time() + max(0.0, float(seconds))
			while time.time() < end_t:
				with self._lock:
					if int(getattr(self, "_pattern_token", 0)) != token or bool(getattr(self, "_continuous_on", False)):
						return False
				time.sleep(min(0.02, max(0.0, end_t - time.time())))
			return True

		def _run():
			try:
				for freq_hz, seconds in clean:
					with self._lock:
						if int(getattr(self, "_pattern_token", 0)) != token or bool(getattr(self, "_continuous_on", False)):
							return
						if freq_hz is None:
							self._last_freq = 0
							self._stop()
						else:
							self._last_freq = int(max(1, float(freq_hz)))
							self._start(float(freq_hz))
					if not _sleep_or_cancel(seconds):
						return
			finally:
				with self._lock:
					if int(getattr(self, "_pattern_token", 0)) == token and not bool(getattr(self, "_continuous_on", False)):
						self._pattern_playback_active = False
						self._last_freq = 0
						self._stop()

		threading.Thread(target=_run, daemon=True).start()

	def play_repeating_sequences(self, sequences, repeat_gap_s: float = 0.0):
		"""Repeat one or more two-tone sequences until stopped; latest state wins."""
		if not self._enabled or self._backend is None:
			return False
		clean_sequences = []
		try:
			for seq in list(sequences or []):
				clean = self._clean_sequence(seq)
				if clean:
					clean_sequences.append(clean)
		except Exception:
			clean_sequences = []
		if not clean_sequences:
			return False
		try:
			gap = max(0.0, float(repeat_gap_s))
		except Exception:
			gap = 0.0
		with self._lock:
			self._repeat_loop_sequences = tuple(clean_sequences)
			self._repeat_loop_gap = gap
			self._repeat_loop_stop_requested = False
			self._continuous_on = False
			if bool(getattr(self, "_repeat_loop_active", False)):
				return True
			self._pattern_token = int(getattr(self, "_pattern_token", 0)) + 1
			token = int(self._pattern_token)
			self._pattern_playback_active = False
			self._repeat_loop_active = True
			self._last_freq = 0

		def _sleep_or_cancel(seconds: float) -> bool:
			end_t = time.monotonic() + max(0.0, float(seconds))
			while time.monotonic() < end_t:
				with self._lock:
					if int(getattr(self, "_pattern_token", 0)) != token or bool(getattr(self, "_continuous_on", False)):
						return False
				time.sleep(min(0.01, max(0.0, end_t - time.monotonic())))
			return True

		def _run():
			seq_index = 0
			try:
				while True:
					with self._lock:
						if int(getattr(self, "_pattern_token", 0)) != token or bool(getattr(self, "_continuous_on", False)):
							return
						sequences_now = tuple(getattr(self, "_repeat_loop_sequences", None) or ())
						gap_now = float(getattr(self, "_repeat_loop_gap", 0.0) or 0.0)
					if not sequences_now:
						return
					sequence = sequences_now[seq_index % len(sequences_now)]
					seq_index += 1
					for freq_hz, seconds in sequence:
						with self._lock:
							if int(getattr(self, "_pattern_token", 0)) != token or bool(getattr(self, "_continuous_on", False)):
								return
							if freq_hz is None:
								self._last_freq = 0
								self._stop()
							else:
								self._last_freq = int(max(1, float(freq_hz)))
								self._start(float(freq_hz))
						if not _sleep_or_cancel(seconds):
							return
					with self._lock:
						if int(getattr(self, "_pattern_token", 0)) != token or bool(getattr(self, "_continuous_on", False)):
							return
						stop_requested = bool(getattr(self, "_repeat_loop_stop_requested", False))
						if stop_requested:
							self._last_freq = 0
							self._stop()
							return
						if gap_now > 0.0:
							self._last_freq = 0
							self._stop()
					if gap_now > 0.0:
						if not _sleep_or_cancel(gap_now):
							return
			finally:
				with self._lock:
					if int(getattr(self, "_pattern_token", 0)) == token:
						self._repeat_loop_active = False
						self._repeat_loop_sequences = None
						self._repeat_loop_stop_requested = False
						self._last_freq = 0
						self._stop()

		threading.Thread(target=_run, daemon=True).start()
		return True

	def stop_repeating_after_current_sequence(self) -> bool:
		if not self._enabled or self._backend is None:
			return False
		with self._lock:
			if not bool(getattr(self, "_repeat_loop_active", False)):
				return False
			self._repeat_loop_stop_requested = True
			return True

	def play_pattern(self, f1: float, f2: float, t_on1: float = 0.150, t_gap: float = 0.050, t_on2: float = 0.150):
		"""Play: ON(f1) -> OFF -> ON(f2). Latest call cancels older patterns."""
		self.play_sequence(((f1, t_on1), (None, t_gap), (f2, t_on2)))

