			else:
				style = "QPushButton { background:#f0b6b6; color:#000; border:1px solid #b36f6f; }"
				tt = "XCorr norm: OFF (0..65535)"
				self.btn_diag.setToolTip("XCorr: нормализация/автомасштаб ВЫКЛ (шкала 0..65535)")
