	def _on_close(self, ev):
		try:
			# Перед выходом сохраним DC offset (best-effort)
			try:
				self._save_dc_offset(force=True)
			except Exception:
				pass
			# stop background worker
			try:
				if getattr(self, '_mode_worker', None) is not None:
					self._mode_worker.stop()
			except Exception:
				pass
			try:
				self.stream.close()
			except Exception:
				pass
			try:
				self._cleanup_det_gpio()
			except Exception:
				pass
		except Exception:
			pass

	def _send_sync_mode(self, mode: int):
		"""Force and persist a timestamped role: 0=master, 1=sensor-slave."""
		try:
			if self.stream is None:
				return False
			mode_i = int(mode)
			if mode_i not in (0, 1):
				raise ValueError("role mode must be 0 (master) or 1 (slave)")
			unix_ms = time.time_ns() // 1_000_000
			payload = bytes([mode_i]) + struct.pack("<Q", unix_ms)
			self.stream.send_cmd(CMD_SET_SYNC_MODE, payload)
			self._last_sync_assignment_unix_ms = int(unix_ms)
			self._last_sync_assignment_role = "master" if mode_i == 0 else "slave"
			return True
		except Exception as e:
			try:
				self._set_status(f"SYNC: ошибка отправки ({e})", hold_sec=2.0)
			except Exception:
				pass
			return False

	def _adc_enable_flags(self):
		"""Return (adc1_enabled, adc2_enabled) based on adc_comm_mode."""
		try:
			mode = int(getattr(self, 'adc_comm_mode', 0))
		except Exception:
			mode = 0
		try:
			adc1_enabled = bool(getattr(self, '_det_channel_enabled0', True))
			adc2_enabled = bool(getattr(self, '_det_channel_enabled1', True))
		except Exception:
			adc1_enabled, adc2_enabled = True, True
		if mode == 1:
			return bool(adc1_enabled), False
		if mode == 2:
			return False, bool(adc2_enabled)
		return bool(adc1_enabled), bool(adc2_enabled)

	def _cycle_sync_mode(self):
		"""Переключить коммутацию ADC: оба -> ADC1 -> ADC2 -> оба."""
		try:
			cur = int(getattr(self, 'adc_comm_mode', 0))
		except Exception:
			cur = 0
		if cur == 0:
			next_mode = 1
		elif cur == 1:
			next_mode = 2
		else:
			next_mode = 0
		self.adc_comm_mode = next_mode
		self._update_sync_btn_style()
		try:
			label = {0: "ADC1+ADC2", 1: "ADC1", 2: "ADC2"}.get(next_mode, "ADC1+ADC2")
			self._set_status(f"ADC COMM: {label}", hold_sec=2.0)
		except Exception:
			pass

