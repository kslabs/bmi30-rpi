	def _send_tim2_enable(self, enabled: bool, update_ui: bool = True):
		"""Compatibility no-op: legacy 0x1E must never be sent.

		Tx200 is controlled exclusively by SET_TX_ENABLE (0x33).  Keeping this
		method as a no-op prevents old GUI call sites from colliding with the
		former DC fast-calibration opcode.
		"""
		return True

	def _send_tx_enable(self, enabled: bool, update_ui: bool = True):
		"""Отправить CMD_SET_TX_ENABLE (0x33)."""
		try:
			if self.stream is None:
				return False
			payload = b"\x01" if bool(enabled) else b"\x00"
			# через USBStream, если реализовано
			if hasattr(self.stream, 'set_tx_enable'):
				self.stream.set_tx_enable(bool(enabled))
			else:
				self.stream.send_cmd(CMD_SET_TX_ENABLE, payload)
			return True
		except Exception as e:
			if update_ui:
				try:
					self._set_status(f"TX: ошибка ({e})", hold_sec=2.0)
				except Exception:
					pass
			return False

	def _send_det_adc_status(self, detadc1: bool, detadc2: bool, force: bool = False) -> bool:
		"""Publish the held software-detection state in the local RS485 status byte."""
		try:
			stream = self.stream
			if stream is None:
				return False
			bits = (1 if bool(detadc1) else 0) | (2 if bool(detadc2) else 0)
			stream_token = id(stream)
			if (
				not bool(force)
				and int(getattr(self, "_det_adc_status_bits", -1)) == bits
				and int(getattr(self, "_det_adc_status_stream_token", 0)) == stream_token
			):
				return True
			if hasattr(stream, "set_det_adc"):
				stream.set_det_adc(bits=bits)
			else:
				stream.send_cmd(0x3C, bytes([bits & 0x03]))
			self._det_adc_status_bits = bits
			self._det_adc_status_stream_token = stream_token
			return True
		except Exception:
			return False

	def _send_optic_hold_ds(self, hold_ds, update_ui: bool = True):
		"""Отправить CMD_SET_OPTIC_HOLD (0x39): длительность удержания оптики в децисекундах (u16 LE, 0..100)."""
		try:
			if self.stream is None:
				return False
			try:
				ds = int(hold_ds)
			except Exception:
				ds = 0
			ds = max(0, min(100, ds))
			payload = int(ds).to_bytes(2, "little")
			self.stream.send_cmd(CMD_SET_OPTIC_HOLD, payload)
			return True
		except Exception as e:
			if update_ui:
				try:
					self._set_status(f"Optic hold: ошибка ({e})", hold_sec=2.0)
				except Exception:
					pass
			return False

	def _send_led_pattern(self, pattern_id, update_ui: bool = True, force: bool = False):
		"""Отправить CMD_SET_LED_PATTERN (0x3B): базовый паттерн адресных LED, u8."""
		try:
			if self.stream is None:
				return False
			try:
				pattern = int(pattern_id)
			except Exception:
				pattern = 0
			pattern = max(0, min(255, pattern))
			try:
				repeat_min_s = float(os.getenv("BMI30_LED_PATTERN_REPEAT_MIN_S", "1.0"))
				if repeat_min_s < 0.0:
					repeat_min_s = 0.0
			except Exception:
				repeat_min_s = 1.0
			now = time.time()
			try:
				last_pattern = getattr(self, "_led_pattern_last_sent", None)
				last_t = float(getattr(self, "_led_pattern_last_sent_t", 0.0) or 0.0)
			except Exception:
				last_pattern, last_t = None, 0.0
			if (
				not bool(force)
				and last_pattern is not None
				and int(last_pattern) == int(pattern)
				and repeat_min_s > 0.0
				and last_t > 0.0
				and (now - last_t) < repeat_min_s
			):
				return True
			self.stream.send_cmd(CMD_SET_LED_PATTERN, bytes([pattern]))
			try:
				self._led_pattern_last_sent = int(pattern)
				self._led_pattern_last_sent_t = now
			except Exception:
				pass
			return True
		except Exception as e:
			if update_ui:
				try:
					self._set_status(f"LED pattern: ошибка ({e})", hold_sec=2.0)
				except Exception:
					pass
			return False

	def _set_group_led_patterns(self, patterns):
		"""Update the event -> addressable LED pattern map used by automatic detection."""
		snapshot = _normalize_group_led_patterns(patterns)
		self._group_led_patterns = snapshot
		try:
			self._group_led_apply_current_state(force=True)
		except Exception:
			pass
		return dict(snapshot)

	def _group_led_patterns_snapshot(self) -> dict:
		try:
			raw = getattr(self, "_group_led_patterns", None)
			if not isinstance(raw, dict):
				raw = load_group_led_patterns()
			snapshot = _normalize_group_led_patterns(raw)
			self._group_led_patterns = snapshot
			return snapshot
		except Exception:
			return dict(DEFAULT_GROUP_LED_PATTERNS)

	def _group_led_event_key(self, upper: bool, lower: bool, neighbor: bool = False) -> str:
		if bool(upper) and bool(lower):
			return "neighbor_both_detection" if neighbor else "both_detection"
		if bool(upper):
			return "neighbor_upper_detection" if neighbor else "upper_detection"
		if bool(lower):
			return "neighbor_lower_detection" if neighbor else "lower_detection"
		return ""

	def _group_led_detection_allowed(self) -> bool:
		try:
			return int(self._current_mode_idx()) >= 6 and bool(self._optic_detection_gate_allowed())
		except Exception:
			return False

	def _group_led_clear_detection_state(self) -> bool:
		changed = (
			bool(getattr(self, "_group_led_local_upper_active", False))
			or bool(getattr(self, "_group_led_local_lower_active", False))
			or bool(getattr(self, "_group_led_neighbor_upper_active", False))
			or bool(getattr(self, "_group_led_neighbor_lower_active", False))
		)
		self._group_led_local_upper_active = False
		self._group_led_local_lower_active = False
		self._group_led_neighbor_upper_active = False
		self._group_led_neighbor_lower_active = False
		try:
			self._group_led_last_remote_sig = None
		except Exception:
			pass
		return bool(changed)

	def _group_led_apply_event(self, event_key: str, force: bool = False) -> bool:
		event = str(event_key or "").strip()
		if event not in GROUP_LED_PATTERN_EVENT_KEYS:
			return False
		try:
			pattern = _led_pattern_value(self._group_led_patterns_snapshot().get(event, 0))
		except Exception:
			pattern = 0
		try:
			active_event = str(getattr(self, "_group_led_active_event", "") or "")
			active_pattern = int(getattr(self, "_group_led_active_pattern", 0) or 0)
		except Exception:
			active_event, active_pattern = "", 0
		if pattern <= 0 and active_pattern <= 0 and not active_event:
			return True
		if not bool(force) and active_event == event and active_pattern == pattern:
			return True
		ok = bool(self._send_led_pattern(pattern, update_ui=False))
		if ok:
			self._group_led_active_event = event if pattern > 0 else ""
			self._group_led_active_pattern = int(pattern)
			self._group_led_active_t = time.time()
		return ok

	def _set_group_led_manual_test_pattern(self, pattern_id) -> bool:
		pattern = _led_pattern_value(pattern_id)
		ok = bool(self._send_led_pattern(pattern, update_ui=False))
		if ok:
			self._group_led_manual_test_pattern = int(pattern)
			self._group_led_active_event = "manual_test" if pattern > 0 else ""
			self._group_led_active_pattern = int(pattern)
			self._group_led_active_t = time.time()
		return ok

	def _group_led_actual_pattern_info(self) -> dict:
		info = {"pattern": None, "source": "none", "age_s": None}
		try:
			stream = getattr(self, "stream", None)
			if stream is None:
				return info
			if bool(getattr(stream, "disconnected", False)):
				return info
			st = getattr(stream, "last_stat", None)
			t = float(getattr(stream, "last_stat_t", 0.0) or 0.0)
		except Exception:
			stream = None
			st = None
			t = 0.0
		now = time.time()
		try:
			max_age = float(os.getenv("BMI30_OPTIC_STATE_MAX_AGE", "3.0"))
		except Exception:
			max_age = 3.0
		if isinstance(st, (bytes, bytearray)) and len(st) > 98 and bytes(st[:4]) == b"STAT":
			try:
				age_s = (now - t) if t > 0.0 else None
				if age_s is None or age_s <= max_age:
					return {"pattern": int(st[98]) & 0xFF, "source": "stat", "age_s": age_s}
			except Exception:
				pass
		try:
			cache = getattr(stream, "device_state_cache", {}) if stream is not None else {}
			if not isinstance(cache, dict):
				return info
			events = cache.get("events") if isinstance(cache.get("events"), dict) else {}
			optic = events.get("optic_state") if isinstance(events.get("optic_state"), dict) else {}
			value = optic.get("led_pattern")
			if value is not None:
				updates = cache.get("event_updates") if isinstance(cache.get("event_updates"), dict) else {}
				update = updates.get("optic_state") if isinstance(updates.get("optic_state"), dict) else {}
				updated_at = float(update.get("updated_at", 0.0) or 0.0)
				age_s = (now - updated_at) if updated_at > 0.0 else None
				return {"pattern": _led_pattern_value(value), "source": "optic_state", "age_s": age_s}
			local = cache.get("sensors", {}).get("local") if isinstance(cache.get("sensors"), dict) else {}
			if isinstance(local, dict) and local.get("led_pattern") is not None:
				return {"pattern": _led_pattern_value(local.get("led_pattern")), "source": "sensor_cache", "age_s": None}
			stat = cache.get("stat") if isinstance(cache.get("stat"), dict) else {}
			if stat.get("led_pattern") is not None:
				return {"pattern": _led_pattern_value(stat.get("led_pattern")), "source": "stat_cache", "age_s": None}
		except Exception:
			return info
		return info

	def _group_led_actual_pattern(self):
		try:
			return self._group_led_actual_pattern_info().get("pattern")
		except Exception:
			return None

	def _group_led_current_event(self) -> str:
		if bool(getattr(self, "_group_led_fault_active", False)):
			return "fault"
		try:
			if not self._group_led_detection_allowed():
				self._group_led_clear_detection_state()
				return ""
		except Exception:
			return ""
		local_upper = bool(getattr(self, "_group_led_local_upper_active", False))
		local_lower = bool(getattr(self, "_group_led_local_lower_active", False))
		event = self._group_led_event_key(local_upper, local_lower, neighbor=False)
		if event:
			return event
		try:
			self._group_led_clear_neighbor_state_if_no_peer()
		except Exception:
			pass
		neighbor_upper = bool(getattr(self, "_group_led_neighbor_upper_active", False))
		neighbor_lower = bool(getattr(self, "_group_led_neighbor_lower_active", False))
		return self._group_led_event_key(neighbor_upper, neighbor_lower, neighbor=True)

	def _group_led_apply_current_state(self, force: bool = False) -> bool:
		try:
			if not self._group_led_detection_allowed():
				if self._group_led_clear_detection_state():
					force = True
		except Exception:
			pass
		try:
			if self._group_led_clear_neighbor_state_if_no_peer():
				force = True
		except Exception:
			pass
		event = self._group_led_current_event()
		try:
			pattern = _led_pattern_value(self._group_led_patterns_snapshot().get(event, 0)) if event else 0
		except Exception:
			pattern = 0
		try:
			manual_pattern = _led_pattern_value(getattr(self, "_group_led_manual_test_pattern", 0))
		except Exception:
			manual_pattern = 0
		if manual_pattern > 0 and event != "fault":
			event = "manual_test"
			pattern = manual_pattern
		try:
			active_event = str(getattr(self, "_group_led_active_event", "") or "")
			active_pattern = int(getattr(self, "_group_led_active_pattern", 0) or 0)
		except Exception:
			active_event, active_pattern = "", 0
		try:
			actual_info = self._group_led_actual_pattern_info()
			actual_pattern = actual_info.get("pattern")
		except Exception:
			actual_info = {}
			actual_pattern = None
		try:
			verify_max_age = float(os.getenv("BMI30_LED_PATTERN_VERIFY_MAX_AGE_S", "3.0"))
		except Exception:
			verify_max_age = 3.0
		try:
			actual_age = actual_info.get("age_s")
			actual_fresh = actual_pattern is not None
			if actual_age is not None and float(actual_age) > verify_max_age:
				actual_fresh = False
			if str(actual_info.get("source") or "") not in ("stat", "optic_state"):
				actual_fresh = False
		except Exception:
			actual_fresh = False
		try:
			last_send_t = float(getattr(self, "_group_led_active_t", 0.0) or 0.0)
		except Exception:
			last_send_t = 0.0
		resend_due = False
		if actual_fresh and int(actual_pattern) != int(pattern):
			try:
				resend_due = (time.time() - last_send_t) >= 0.35
			except Exception:
				resend_due = True
		if (
			active_event == (event if pattern > 0 else "")
			and active_pattern == pattern
			and not resend_due
		):
			return True
		ok = bool(self._send_led_pattern(pattern, update_ui=False, force=bool(resend_due)))
		if ok:
			self._group_led_active_event = event if pattern > 0 else ""
			self._group_led_active_pattern = int(pattern)
			self._group_led_active_t = time.time()
		return ok

	def _group_led_clear_events(self, events) -> bool:
		try:
			event_set = set(events or [])
		except Exception:
			event_set = set()
		try:
			active_event = str(getattr(self, "_group_led_active_event", "") or "")
			active_pattern = int(getattr(self, "_group_led_active_pattern", 0) or 0)
		except Exception:
			active_event, active_pattern = "", 0
		if not active_event or (event_set and active_event not in event_set):
			return True
		ok = True
		if active_pattern > 0:
			ok = bool(self._send_led_pattern(0, update_ui=False))
		if ok:
			self._group_led_active_event = ""
			self._group_led_active_pattern = 0
			self._group_led_active_t = time.time()
		return ok

	def _group_led_apply_detection(self, upper: bool, lower: bool, neighbor: bool = False) -> bool:
		try:
			if not self._group_led_detection_allowed():
				changed = self._group_led_clear_detection_state()
				return self._group_led_apply_current_state(force=changed)
		except Exception:
			changed = self._group_led_clear_detection_state()
			return self._group_led_apply_current_state(force=changed)
		if bool(neighbor):
			try:
				presence = self._group_led_remote_presence()
			except Exception:
				presence = None
			if presence is not True:
				changed = bool(getattr(self, "_group_led_neighbor_upper_active", False)) or bool(getattr(self, "_group_led_neighbor_lower_active", False))
				self._group_led_neighbor_upper_active = False
				self._group_led_neighbor_lower_active = False
				return self._group_led_apply_current_state(force=changed)
			self._group_led_neighbor_upper_active = bool(upper)
			self._group_led_neighbor_lower_active = bool(lower)
		else:
			self._group_led_local_upper_active = bool(upper)
			self._group_led_local_lower_active = bool(lower)
		return self._group_led_apply_current_state()

	def _group_led_local_node_id(self) -> int:
		try:
			cache = getattr(getattr(self, "stream", None), "device_state_cache", {}) or {}
		except Exception:
			cache = {}
		sync_items = []
		try:
			events = cache.get("events") if isinstance(cache.get("events"), dict) else {}
			if isinstance(events.get("sync_state"), dict):
				sync_items.append(events.get("sync_state"))
		except Exception:
			pass
		try:
			sync = cache.get("sync") if isinstance(cache.get("sync"), dict) else {}
			if sync:
				sync_items.append(sync)
		except Exception:
			pass
		for sync in sync_items:
			try:
				node_id = int(sync.get("local_node_id", 0) or 0)
				if node_id > 0:
					return node_id
			except Exception:
				pass
		return 0

	def _group_led_remote_presence(self):
		try:
			stream = getattr(self, "stream", None)
			st = getattr(stream, "last_stat", None) if stream is not None else None
			t = float(getattr(stream, "last_stat_t", 0.0) or 0.0) if stream is not None else 0.0
			try:
				max_age = float(os.getenv("BMI30_OPTIC_STATE_MAX_AGE", "3.0"))
			except Exception:
				max_age = 3.0
			if isinstance(st, (bytes, bytearray)) and len(st) >= 105 and bytes(st[:4]) == b"STAT" and (t <= 0.0 or (time.time() - t) <= max_age):
				seen_mask = int.from_bytes(bytes(st)[100:104], "little")
				if seen_mask <= 0:
					return False
				local_node = self._group_led_local_node_id()
				if local_node > 0:
					try:
						seen_mask &= ~(1 << (int(local_node) - 1))
					except Exception:
						pass
				return bool(seen_mask)
		except Exception:
			pass
		try:
			cache = getattr(getattr(self, "stream", None), "device_state_cache", {}) or {}
		except Exception:
			cache = {}
		if not isinstance(cache, dict):
			return None
		sync_items = []
		try:
			events = cache.get("events") if isinstance(cache.get("events"), dict) else {}
			if isinstance(events.get("sync_state"), dict):
				sync_items.append(events.get("sync_state"))
		except Exception:
			pass
		try:
			sync = cache.get("sync") if isinstance(cache.get("sync"), dict) else {}
			if sync:
				sync_items.append(sync)
		except Exception:
			pass
		local_node = self._group_led_local_node_id()
		for sync in sync_items:
			if not isinstance(sync, dict):
				continue
			if "sync_seen_mask" in sync:
				try:
					seen_mask = int(sync.get("sync_seen_mask", 0) or 0)
				except Exception:
					seen_mask = 0
				if seen_mask <= 0:
					return False
				if local_node > 0:
					try:
						seen_mask &= ~(1 << (int(local_node) - 1))
					except Exception:
						pass
				return bool(seen_mask)
			for key in ("total_devices", "active_status_count", "sync_node_count"):
				if key in sync:
					try:
						return int(sync.get(key, 0) or 0) > (1 if key == "total_devices" else 0)
					except Exception:
						pass
		try:
			remote = cache.get("remote")
			if isinstance(remote, list):
				return bool(remote)
		except Exception:
			pass
		return None

	def _group_led_clear_neighbor_state_if_no_peer(self) -> bool:
		try:
			presence = self._group_led_remote_presence()
		except Exception:
			presence = None
		if presence is not False:
			return False
		changed = bool(getattr(self, "_group_led_neighbor_upper_active", False)) or bool(getattr(self, "_group_led_neighbor_lower_active", False))
		self._group_led_neighbor_upper_active = False
		self._group_led_neighbor_lower_active = False
		try:
			self._group_led_last_remote_sig = None
		except Exception:
			pass
		return bool(changed)

	def _group_led_poll_sync_status(self, force: bool = False) -> bool:
		try:
			stream = getattr(self, "stream", None)
			if stream is None:
				return self._group_led_apply_detection(False, False, neighbor=True)
			st = getattr(stream, "last_stat", None)
			last_t = float(getattr(stream, "last_stat_t", 0.0) or 0.0)
		except Exception:
			return False
		if not isinstance(st, (bytes, bytearray)) or len(st) < 105 or bytes(st[:4]) != b"STAT":
			if self._group_led_clear_neighbor_state_if_no_peer():
				return self._group_led_apply_current_state(force=True)
			return self._group_led_apply_current_state()
		try:
			if (not bool(force)) and last_t > 0.0 and last_t == float(getattr(self, "_group_led_last_stat_t", 0.0) or 0.0):
				return self._group_led_apply_current_state()
			self._group_led_last_stat_t = last_t
		except Exception:
			pass
		bs = bytes(st)
		try:
			seen_mask = int.from_bytes(bs[100:104], "little")
		except Exception:
			seen_mask = 0
		try:
			node_count = int(bs[104])
		except Exception:
			node_count = 0
		local_node = self._group_led_local_node_id()
		upper = False
		lower = False
		seen_remote = False
		values = []
		status_bytes = bs[105:min(len(bs), 136)]
		for idx, raw in enumerate(status_bytes):
			node_id = idx + 1
			if not bool(seen_mask & (1 << idx)):
				continue
			if local_node > 0 and node_id == local_node:
				continue
			value = int(raw) & 0xFF
			if value == 0:
				continue
			seen_remote = True
			values.append((node_id, value))
			upper = bool(upper or (value & 0x40))
			lower = bool(lower or (value & 0x80))
		if local_node <= 0:
			upper = False
			lower = False
			seen_remote = False
			values = []
		sig = (bool(upper), bool(lower), bool(seen_remote), int(seen_mask), int(local_node), tuple(values))
		try:
			if (not bool(force)) and sig == getattr(self, "_group_led_last_remote_sig", None):
				return self._group_led_apply_current_state()
			self._group_led_last_remote_sig = sig
		except Exception:
			pass
		return self._group_led_apply_detection(bool(upper), bool(lower), neighbor=True)

	def _group_led_update_fault_state(self, fault_kind: str) -> bool:
		kind = str(fault_kind or "").strip().lower()
		is_fault = bool(kind and kind not in ("ok", "stream_off", "waiting_frames"))
		was_fault = bool(getattr(self, "_group_led_fault_active", False))
		self._group_led_fault_active = bool(is_fault)
		changed = bool(was_fault) != bool(is_fault)
		if changed and not is_fault:
			try:
				self._group_led_poll_sync_status(force=True)
			except Exception:
				pass
		return self._group_led_apply_current_state(force=changed)

	def _set_optic_reaction_enabled(self, enabled: bool):
		"""Вкл/выкл зависимость sound/LED детекции от собственного optic."""
		self.optic_reaction_enabled = bool(enabled)
		try:
			save_optic_reaction_settings(
				bool(self.optic_reaction_enabled),
				bool(getattr(self, "optic_neighbor_reaction_enabled", False)),
			)
		except Exception:
			pass
		self._apply_optic_gate_change()
		return True

	def _set_optic_neighbor_reaction_enabled(self, enabled: bool):
		"""Вкл/выкл зависимость sound/LED детекции от optic соседей по RS485."""
		self.optic_neighbor_reaction_enabled = bool(enabled)
		try:
			save_optic_reaction_settings(
				bool(getattr(self, "optic_reaction_enabled", False)),
				bool(self.optic_neighbor_reaction_enabled),
			)
		except Exception:
			pass
		self._apply_optic_gate_change()
		return True

	def _apply_optic_gate_change(self):
		"""Immediately remove outputs when selected optic sources do not permit them."""
		try:
			allowed = bool(self._optic_detection_gate_allowed())
		except Exception:
			allowed = False
		if allowed:
			# Keep a previous False edge so the realtime output pass can restart
			# sound if detector HOLD is already active.
			return True
		self._optic_gate_last_allowed = False
		if not bool(getattr(self, '_sound_test_enabled', False)):
			try:
				self._stop_sound_now()
			except Exception:
				pass
		try:
			self._set_det_gpio(False, False)
		except Exception:
			pass
		try:
			self._group_led_apply_current_state(force=True)
		except Exception:
			pass
		return False

	def _current_optic_active(self):
		"""Состояние собственного оптического датчика из EVT1/cache или STAT.

		Returns True/False when a current device connection has a reading, otherwise
		None (unknown/stale).
		optic_active = flags_runtime (STAT offset 48, u16 LE) bit5 (0x0020).
		"""
		try:
			stream = getattr(self, "stream", None)
			if stream is None:
				return None
			if bool(getattr(stream, "disconnected", False)):
				return None
			cache = getattr(stream, "device_state_cache", {}) or {}
			events = cache.get("events") if isinstance(cache.get("events"), dict) else {}
			optic = events.get("optic_state") if isinstance(events.get("optic_state"), dict) else {}
			if isinstance(optic.get("optic_active"), bool):
				return bool(optic.get("optic_active"))
			sensors = cache.get("sensors") if isinstance(cache.get("sensors"), dict) else {}
			local = sensors.get("local") if isinstance(sensors.get("local"), dict) else {}
			for key in ("optic_active_event", "optic_active_flags_runtime", "optic_active"):
				if isinstance(local.get(key), bool):
					return bool(local.get(key))
			st = getattr(stream, "last_stat", None)
			t = float(getattr(stream, "last_stat_t", 0.0) or 0.0)
		except Exception:
			return None
		if not isinstance(st, (bytes, bytearray)) or len(st) < 50 or st[:4] != b"STAT":
			return None
		try:
			max_age = float(os.getenv("BMI30_OPTIC_STATE_MAX_AGE", "3.0"))
		except Exception:
			max_age = 3.0
		if t <= 0.0 or (time.time() - t) > max_age:
			return None
		flags_rt = int(st[48]) | (int(st[49]) << 8)
		return bool(flags_rt & 0x0020)

	def _current_neighbor_optic_active(self):
		"""Return whether any *other* RS485 device currently reports optic active."""
		try:
			stream = getattr(self, "stream", None)
			if stream is None or bool(getattr(stream, "disconnected", False)):
				return None
			cache = getattr(stream, "device_state_cache", {}) or {}
		except Exception:
			return None

		# Preferred source: direct SNS1 reads by device_id. This remains exact even
		# when local and neighboring optics are active at the same time.
		try:
			sensors = cache.get("sensors") if isinstance(cache.get("sensors"), dict) else {}
			remote = sensors.get("remote") if isinstance(sensors.get("remote"), list) else []
			remote_updated_at = float(sensors.get("remote_updated_at", 0.0) or 0.0)
			max_age = max(0.5, float(os.getenv("BMI30_RS485_SENSOR_MAX_AGE", "2.0")))
			if remote and remote_updated_at > 0.0 and (time.time() - remote_updated_at) <= max_age:
				known = False
				for item in remote:
					if not isinstance(item, dict):
						continue
					if item.get("seen") is False or item.get("recent") is False:
						continue
					value = item.get("optic_active")
					if isinstance(value, bool):
						known = True
						if value:
							return True
				if known:
					return False
		except Exception:
			pass

		# Compatibility fallback for firmware that only exposes the aggregate STAT
		# bits. It is exact while local optic is inactive; a slave can additionally
		# identify an active master through the dedicated master bit.
		try:
			st = getattr(stream, "last_stat", None)
			t = float(getattr(stream, "last_stat_t", 0.0) or 0.0)
			max_age = float(os.getenv("BMI30_OPTIC_STATE_MAX_AGE", "3.0"))
			if isinstance(st, (bytes, bytearray)) and len(st) >= 50 and st[:4] == b"STAT":
				if t > 0.0 and (time.time() - t) <= max_age:
					flags_rt = int(st[48]) | (int(st[49]) << 8)
					local_active = bool(flags_rt & 0x0020)
					master_active = bool(flags_rt & 0x0080)
					any_active = bool(flags_rt & 0x0100)
					if not local_active:
						return bool(any_active or master_active)
					sync = cache.get("sync") if isinstance(cache.get("sync"), dict) else {}
					if str(sync.get("role") or "").lower() == "slave" and master_active:
						return True
					return False
		except Exception:
			pass
		return None

	def _optic_detection_gate_allowed(self) -> bool:
		"""OR the independently selected local and neighboring optic sources.

		With both switches off, detection outputs keep the legacy ungated behavior.
		When at least one source is selected, unknown data is fail-closed so sound
		and LEDs cannot remain on after the selected sensor disappears.
		"""
		local_enabled = bool(getattr(self, "optic_reaction_enabled", False))
		neighbor_enabled = bool(getattr(self, "optic_neighbor_reaction_enabled", False))
		if not local_enabled and not neighbor_enabled:
			return True
		known = False
		if local_enabled:
			local_active = self._current_optic_active()
			if local_active is not None:
				known = True
				if bool(local_active):
					return True
		if neighbor_enabled:
			neighbor_active = self._current_neighbor_optic_active()
			if neighbor_active is not None:
				known = True
				if bool(neighbor_active):
					return True
		return False if known else False

	def _confirm_tim2_by_device_status(self, expected: bool, attempts: int = 3) -> bool:
		"""Best-effort подтверждение через ответ устройства STAT (GET_STATUS)."""
		try:
			if self.stream is None or not hasattr(self.stream, '_get_status_ep0'):
				return False
		except Exception:
			return False
		for _ in range(max(1, int(attempts))):
			try:
				self.stream._get_status_ep0()
				st = getattr(self.stream, 'last_stat', None)
				if isinstance(st, (bytes, bytearray)) and len(st) >= 64 and st[:4] == b'STAT':
					mask_s = os.getenv('BMI30_TX_STATUS_MASK', '').strip()
					if mask_s:
						off = int(os.getenv('BMI30_TX_STATUS_OFFSET', '48'))
						mask = int(mask_s, 0) & 0xFF
						if 0 <= off < len(st):
							bit_on = (int(st[off]) & mask) != 0
							return bool(bit_on) == bool(expected)
						return False
					return True
			except Exception:
				pass
			time.sleep(0.05)
		return False

	def _tim2_apply_worker(self, request_id: int, enabled: bool):
		"""Фоновое применение Tx200 через 0x33 и подтверждение по STAT."""
		ok_tx = self._send_tx_enable(bool(enabled), update_ui=False)
		status_ok = False
		if ok_tx:
			status_ok = self._confirm_tim2_by_device_status(bool(enabled), attempts=3)
		self._tim2_result_queue.put((int(request_id), bool(enabled), bool(ok_tx and status_ok)))

	def _send_start_stream(self):
		"""START потока с восстановлением Tx200 только через 0x33."""
		try:
			if self.stream is None:
				return
			# пользовательский стоп снят
			self._stream_user_stopped = False
			desired_tx = bool(getattr(self, 'tim2_enabled', False))
			try:
				self.stream.desired_tx_enabled = desired_tx
			except Exception:
				pass
			# Firmware STOP clears the TX request, therefore START must precede
			# the single authoritative SET_TX_ENABLE command.
			self.stream.send_cmd(CMD_START_STREAM, b"")
			time.sleep(0.02)
			ok_tx = self._send_tx_enable(desired_tx)
			self.tim2_applied = bool(desired_tx and ok_tx)
			self.tim2_pending = False
			self._update_tim2_btn_style()
			cfg = _normalize_lcd_role_overlay(getattr(self, "_lcd_role_overlay_config", None))
			self._send_lcd_role_overlay(**cfg)
		except Exception:
			pass

	def _send_stop_stream(self):
		"""STOP потока (предпочтительно через EP0 control)."""
		try:
			if self.stream is None:
				return
			# помечаем, что остановлено пользователем
			self._stream_user_stopped = True
			# Используем EP0 stop, если доступно
			if hasattr(self.stream, 'stop_stream'):
				try:
					use_ctrl = str(os.getenv("BMI30_STOP_CTRL", "1")).lower() not in ("0", "false", "no")
				except Exception:
					use_ctrl = True
				try:
					self._remember_command(CMD_STOP_STREAM, b"", "STOP_STREAM")
				except Exception:
					pass
				self.stream.stop_stream(use_ctrl=use_ctrl)
				return
			# Fallback: прямой EP0
			try:
				self._remember_command(CMD_STOP_STREAM, b"", "STOP_STREAM_EP0")
				self.stream.dev.ctrl_transfer(0x40, CMD_STOP_STREAM, 0, 0, None, timeout=300)
				return
			except Exception:
				pass
			# Final fallback: bulk
			self.stream.send_cmd(CMD_STOP_STREAM, b"")
		except Exception:
			pass

	def _on_toggle_tim2(self, enabled: bool):
		"""GUI: включить/выключить передачу TIM2."""
		try:
			self.tim2_enabled = bool(enabled)
		except Exception:
			self.tim2_enabled = False
		try:
			if self.stream is None:
				self.tim2_applied = False
				self.tim2_pending = False
				self._update_tim2_btn_style()
				self._set_status("TIM2/TX: нет USB, команда будет применена при подключении", hold_sec=1.5)
				return
			self._stream_user_stopped = False
			self.tim2_pending = True
			self.tim2_applied = False
			self._tim2_request_seq = int(getattr(self, '_tim2_request_seq', 0)) + 1
			req_id = int(self._tim2_request_seq)
			self._update_tim2_btn_style()
			threading.Thread(target=self._tim2_apply_worker, args=(req_id, bool(self.tim2_enabled)), daemon=True).start()
			self._set_status("TIM2/TX: отправка команды, ожидание ответа устройства…", hold_sec=1.2)
		except Exception:
			self.tim2_pending = False
			self.tim2_applied = False
		self._update_tim2_btn_style()

	def _run_deferred_autostart(self):
		try:
			idx = int(getattr(self, '_deferred_autostart_idx', 0) or 0)
			self._deferred_autostart_idx = None
		except Exception:
			idx = 0
		if idx == 0:
			return
		try:
			try:
				self._restore_mode_after_buf_idx = int(idx) if int(idx) >= 6 else 0
			except Exception:
				self._restore_mode_after_buf_idx = 0
			try:
				self._remember_desired_mode_for_button(int(idx), reason="autostart")
			except Exception:
				pass
			self._sample_len_mode_pending = None
			self._sample_len_mode_sync_armed = True
			if self.stream is None and not bool(getattr(self, '_connecting', False)):
				self._activate_stream()
			else:
				self._set_status("Автозапуск: ожидание BUF для выбора режима 3/5", hold_sec=1.5)
			print("[AUTOSTART] stream start only; waiting for BUF mode detect", flush=True)
		except Exception as e:
			try:
				print(f"[AUTOSTART] deferred start failed: {e}", flush=True)
			except Exception:
				pass

	def run(self):
		self.win.resize(900, 600)
		self.win.show()
		try:
			QtCore.QTimer.singleShot(20, self._run_deferred_autostart)
		except Exception:
			self._run_deferred_autostart()
		# Запускаем цикл событий Qt корректно как для PyQt5 (exec_()), так и для PyQt6 (exec())
		_app = QtWidgets.QApplication.instance()
		if hasattr(_app, 'exec_'):
			_app.exec_()
		else:
			_app.exec()
		try:
			self._rt_detector_process_stop()
		except Exception:
			pass


def main():
	if PG_IMPORT_ERR:
		print('[fatal] pyqtgraph/Qt не установлены. pip install pyqtgraph PyQt5')
		return 2
	ScopeWindow().run()
	return 0


if __name__ == '__main__':
	sys.exit(main())
