def _rt_detector_peak_index_bound(value, default: int) -> int:
	"""Return a detector-array index clamped to the configurable 0..199 range."""
	try:
		bound = int(value)
	except Exception:
		bound = int(default)
	return int(max(0, min(199, bound)))


def _rt_detector_peak_position_supported(peak_idx: int, sample_count: int) -> bool:
	"""Accept a peak only when its array index is inside the configured interval."""
	try:
		n = int(sample_count)
		idx = int(peak_idx)
	except Exception:
		return False
	if n <= 0 or idx < 0 or idx >= n:
		return False
	minimum = _rt_detector_peak_index_bound(os.getenv('BMI30_RT_PEAK_INDEX_MIN', '0'), 0)
	maximum = _rt_detector_peak_index_bound(os.getenv('BMI30_RT_PEAK_INDEX_MAX', '199'), 199)
	if maximum < minimum:
		maximum = minimum
	return bool(minimum <= idx <= maximum)


def _rt_detector_compact_shape_supported(prod_arr: np.ndarray, peak_idx: int, peak_value: float = 0.0, radius: int = 14, frac: float = 0.22, min_width: int = 4, max_span: int = 40) -> bool:
	try:
		arr = _rt_product_abs_array(prod_arr)
		n = int(arr.size)
		if n <= 3:
			return False
		peak_idx = max(0, min(int(peak_idx), n - 1))
		peak = float(abs(float(peak_value))) if peak_value is not None else 0.0
		if not np.isfinite(peak) or peak <= 0.0:
			peak = float(arr[peak_idx])
		if not np.isfinite(peak) or peak <= 0.0:
			return False
		window_start, window_end = _rt_detector_mark_window_bounds(n)
		if int(peak_idx) < int(window_start) or int(peak_idx) >= int(window_end):
			return False
		radius = max(1, int(radius))
		frac = min(1.0, max(0.01, float(frac)))
		min_width = max(1, int(min_width))
		max_span = max(min_width, int(max_span))
		lo = max(0, peak_idx - radius)
		hi = min(n, peak_idx + radius + 1)
		local = arr[lo:hi]
		if local.size <= 0:
			return False
		mask = local >= (peak * frac)
		if int(np.count_nonzero(mask)) < min_width:
			return False
		idx = np.flatnonzero(mask)
		if idx.size <= 0:
			return False
		return bool((int(idx[-1]) - int(idx[0]) + 1) <= max_span)
	except Exception:
		return True


def _rt_detector_barkhausen_shape_supported(prod_arr: np.ndarray, peak_idx: int, peak_value: float = 0.0) -> bool:
	try:
		radius = int(os.getenv('BMI30_RT_BARKHAUSEN_RADIUS', '24'))
	except Exception:
		radius = 24
	try:
		frac = float(os.getenv('BMI30_RT_BARKHAUSEN_FRAC', '0.22'))
	except Exception:
		frac = 0.22
	try:
		min_width = int(os.getenv('BMI30_RT_BARKHAUSEN_MIN_WIDTH', '4'))
	except Exception:
		min_width = 4
	try:
		max_span = int(os.getenv('BMI30_RT_BARKHAUSEN_MAX_SPAN', '140'))
	except Exception:
		max_span = 140
	try:
		min_product_level = int(float(os.getenv('BMI30_RT_BARKHAUSEN_MIN_PRODUCT_LEVEL', '0') or 0))
	except Exception:
		min_product_level = 0
	try:
		max_product_level = int(float(os.getenv('BMI30_RT_BARKHAUSEN_MAX_PRODUCT_LEVEL', '0') or 0))
	except Exception:
		max_product_level = 0
	try:
		arr = _rt_product_abs_array(prod_arr)
		peak_idx_i = max(0, min(int(peak_idx), int(arr.size) - 1))
		peak = float(abs(float(peak_value))) if peak_value is not None else 0.0
		if not np.isfinite(peak) or peak <= 0.0:
			peak = float(arr[peak_idx_i])
		if int(min_product_level) > 0 and float(peak) < float(min_product_level):
			return False
		if int(max_product_level) > 0 and float(peak) > float(max_product_level):
			return False
	except Exception:
		if int(min_product_level) > 0:
			return False
		if int(max_product_level) > 0:
			return False
	return _rt_detector_compact_shape_supported(prod_arr, peak_idx, peak_value, radius, frac, min_width, max_span)


def _rt_detector_barkhausen_level_supported(prod_arr: np.ndarray, peak_idx: int, peak_value: float = 0.0) -> bool:
	"""Barkhausen marks are broad, so use a broad-noise guard instead of casino two-hump rejection."""
	try:
		arr = _rt_product_abs_array(prod_arr).astype(np.float64, copy=False)
		n = int(arr.size)
		if n < 4:
			return False
		peak_idx = max(0, min(int(peak_idx), n - 1))
		peak = float(arr[peak_idx])
		try:
			peak = max(peak, float(abs(float(peak_value))))
		except Exception:
			pass
		if not np.isfinite(peak) or peak <= 0.0:
			return False
		try:
			max_total_fraction = float(os.getenv('BMI30_RT_BARKHAUSEN_MAX_TOTAL_FRACTION', '0.82'))
		except Exception:
			max_total_fraction = 0.82
		try:
			quarter_frac = float(os.getenv('BMI30_RT_BARKHAUSEN_ALL_QUARTER_FRAC', '0.45'))
		except Exception:
			quarter_frac = 0.45
		if np.isfinite(max_total_fraction) and max_total_fraction > 0.0:
			if float(np.count_nonzero(arr >= (peak * 0.35))) / float(max(1, n)) > min(1.0, max_total_fraction):
				return False
		if np.isfinite(quarter_frac) and quarter_frac > 0.0:
			hot_parts = 0
			for part in range(4):
				start = (part * n) // 4
				stop = ((part + 1) * n) // 4 if part < 3 else n
				seg = arr[start:stop]
				if seg.size and float(np.nanmax(seg)) >= peak * min(1.0, max(0.01, quarter_frac)):
					hot_parts += 1
			if hot_parts >= 4:
				return False
		return True
	except Exception:
		return True


