			if not bool(getattr(self, "_det_burst_gate1", True)):
				self._det_burst_gate_until1 = 0.0
				self._det_burst_gate_active1 = False
		except Exception:
			pass
		snapshot = self._detector_settings_snapshot()
		try:
			_rt_detector_apply_settings_env(snapshot)
		except Exception:
			pass
		if persist:
			try:
				save_det_channel_settings(snapshot)
			except Exception:
				pass
		try:
			self._set_status("Tag Detection settings saved", hold_sec=1.0)
		except Exception:
			pass
		return snapshot

