	def _det_channel_burst_gate_active(self, channel: int, now: float | None = None) -> bool:
		ch = 0 if int(channel) == 0 else 1
		try:
			t = float(time.time() if now is None else now)
		except Exception:
			t = time.time()
		until_key = '_det_burst_gate_until0' if ch == 0 else '_det_burst_gate_until1'
		active_key = '_det_burst_gate_active0' if ch == 0 else '_det_burst_gate_active1'
		try:
			active = float(getattr(self, until_key, 0.0) or 0.0) > t
		except Exception:
			active = False
		try:
			setattr(self, active_key, bool(active))
		except Exception:
			pass
		return bool(active)

