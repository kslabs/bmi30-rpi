			"phase_upper_min_hz": getattr(self, "_beep_adc0_min", 1000.0),
			"phase_upper_max_hz": getattr(self, "_beep_adc0_max", 3000.0),
			"phase_lower_min_hz": getattr(self, "_beep_adc1_min", 2000.0),
			"phase_lower_max_hz": getattr(self, "_beep_adc1_max", 4000.0),
			"minimum_duration_ms": int(round(float(getattr(self, "_beep_min_duration_s", 0.150) or 0.0) * 1000.0)),
			"minimum_tone_cycles": int(getattr(self, "_beep_min_cycles", 1) or 1),
