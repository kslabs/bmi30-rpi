def _det_clamp_step(value, default: int = 1) -> int:
	try:
		val = int(value)
	except Exception:
		val = int(default)
	return int(max(1, min(_RT_DETECT_LEVEL_MAX, val)))

def _det_clamp_noise_unit(value, default: str = "adc") -> str:
	try:
		val = str(value or default).strip().lower()
	except Exception:
		val = str(default or "adc")
	if val in ("percent", "pct", "%"):
		return "percent"
	return "adc"

def _det_clamp_gate_blank(value, default: float = 0.08) -> float:
	try:
		val = float(value)
	except Exception:
		val = float(default)
	try:
		if not np.isfinite(val):
			val = float(default)
	except Exception:
		val = float(default)
	return float(max(0.0, min(1.0, round(val, 3))))

def _det_clamp_gate_ratio(value, default: float = 8.0) -> float:
	try:
		val = float(value)
	except Exception:
		val = float(default)
	try:
		if not np.isfinite(val):
			val = float(default)
	except Exception:
		val = float(default)
	return float(max(0.0, min(100.0, round(val, 1))))

def _det_clamp_noise_window(value, default: float = 1.0) -> float:
	try:
		val = float(value)
	except Exception:
		val = float(default)
	try:
		if not np.isfinite(val):
			val = float(default)
	except Exception:
		val = float(default)
	return float(max(0.05, min(10.0, round(val, 3))))

def _det_clamp_int(value, default: int, minimum: int, maximum: int) -> int:
	try:
		val = int(value)
	except Exception:
		val = int(default)
	return int(max(int(minimum), min(int(maximum), val)))

def _det_clamp_float(value, default: float, minimum: float, maximum: float, ndigits: int = 4) -> float:
	try:
		val = float(value)
	except Exception:
		val = float(default)
	try:
		if not np.isfinite(val):
			val = float(default)
	except Exception:
		val = float(default)
	return float(max(float(minimum), min(float(maximum), round(val, int(ndigits)))))

