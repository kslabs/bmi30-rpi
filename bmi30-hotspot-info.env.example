# Copy to /etc/default/bmi30-hotspot-info and adjust values for the device.
#
# Main user account (existing behavior)
# BMI30_PORTAL_USERNAME=admin
# BMI30_PORTAL_PASSWORD=change-me
#
# Optional engineer account. Leave unset to disable it.
# Prefer the hash variable in production.
# BMI30_PORTAL_ENGINEER_USERNAME=TechAid
# BMI30_PORTAL_ENGINEER_PASSWORD_HASH=pbkdf2_sha256$390000$replace_salt$replace_hash
#
# Temporary fallback for local testing only. Prefer the hash variable above.
# BMI30_PORTAL_ENGINEER_PASSWORD=change-me
#
# Session lifetime in seconds; 604800 = 7 days.
# BMI30_PORTAL_SESSION_TTL_S=604800
#
# Hash generation example from the project directory:
# python3 -c "import getpass, hotspot_info_server as h; print(h.hash_portal_password(getpass.getpass('Engineer password: ')))"
